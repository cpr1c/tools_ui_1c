#Использовать fs
#Использовать logos
#Использовать tempfiles

///////////////////////////////////////////////////////////////////////////////
// Сборка расширений, необходимых для запуска модульных тестов:
//  - Инструменты - проверяемое расширение (один вариант сборки, без остальных вариантов);
//  - МодульныеТесты - расширение с тестами YAxUnit.
//
// Каталоги и имена файлов - как в основном сборщике (build/source, build/*.cfe).
// Если расширение Инструменты уже собрано в каталоге сборки (например, получено из файлов
// поставки), оно не пересобирается - тестируется ровно тот файл, который публикуется.
//
// Движок YAxUnit в репозитории не хранится, его подготавливает CI.

Перем Лог;
Перем МенеджерВременныхФайлов;
Перем КаталогСборки;
Перем КаталогИсходниковКонфигуратора;

Функция ВариантСборкиДляТестов()
	// База для тестов - пустая конфигурация без БСП, поэтому берем вариант без поддержки БСП
	Возврат ВариантыСборки.СТаблицамиБезБСП;
КонецФункции

Процедура ОписаниеКоманды(Команда) Экспорт

КонецПроцедуры

Процедура ВыполнитьКоманду(Знач Команда) Экспорт
	Инициализировать();

	КаталогПлатформы = Команда.ЗначениеОпции("platformSource");

	ИмяФайлаРасширенияТестов = ОбъединитьПути(КаталогСборки, "МодульныеТесты.cfe");
	Лог.Информация("Сборка расширения МодульныеТесты");
	СобратьРасширениеТестов(КаталогПлатформы, "МодульныеТесты", ИмяФайлаРасширенияТестов);

	Лог.Информация("Расширения для тестов готовы в каталоге: " + КаталогСборки);
КонецПроцедуры

Процедура Инициализировать()
	// Каталоги сборки определяет основной сборщик
	Сборщик = Новый СборщикОсновной();
	КаталогСборки = Сборщик.КаталогСборки;
	КаталогИсходниковКонфигуратора = Сборщик.КаталогИсходныхФайлов;

	МенеджерВременныхФайлов = Сборщик.МенеджерВременныхФайлов;

	Лог = Новый Лог("app.build.tools_ui_1c");
	Лог.УстановитьУровень(УровниЛога.Отладка);
КонецПроцедуры

Процедура СобратьРасширениеТестов(КаталогПлатформы, ИмяРасширения, ИмяФайлаРезультата)
	СборщикБинарников = Новый СборщикБинарныхФайлов1С;
	СборщикБинарников.УстановитьКаталогВременныхФайлов(МенеджерВременныхФайлов.СоздатьКаталог());
	СборщикБинарников.УстановитьЛог(Лог);
	СборщикБинарников.УстановитьПутьКПлатформе1С(КаталогПлатформы);
	СборщикБинарников.ВыполнитьСозданиеБинарногоФайлаРасширения(
		ОбъединитьПути(КаталогИсходниковКонфигуратора, ИмяРасширения),
		ИмяФайлаРезультата,
		ИмяРасширения);
КонецПроцедуры
