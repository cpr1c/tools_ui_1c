#Использовать fs
#Использовать logos
#Использовать tempfiles
#Использовать 1connector

///////////////////////////////////////////////////////////////////////////////
// Сборка расширений, необходимых для запуска модульных тестов:
//  - Инструменты - проверяемое расширение (один вариант сборки, без остальных вариантов);
//  - МодульныеТесты - расширение с тестами YAxUnit.
//
// Каталоги и имена файлов - как в основном сборщике (build/source, build/*.cfe).
// Если расширение Инструменты уже собрано в каталоге сборки (например, получено из файлов
// поставки), оно не пересобирается - тестируется ровно тот файл, который публикуется.
//
// Движок YAxUnit в репозитории не хранится, его подготавливает CI.

Перем Лог;
Перем МенеджерВременныхФайлов;
Перем КаталогРепозитория;
Перем КаталогСборки;
Перем КаталогТестирования;
Перем КаталогИсходниковКонфигуратора;
Перем КаталогБазы;
Перем КаталогПлатформы;
Перем ПутьКРасширениюТестов;
Перем ВерсияДвижкаТестирования;

Перем СборщикФайлов;

Функция ВариантСборкиДляТестов()
	// База для тестов - пустая конфигурация без БСП, поэтому берем вариант без поддержки БСП
	Возврат ВариантыСборки.СТаблицамиБезБСП;
КонецФункции

Процедура ОписаниеКоманды(Команда) Экспорт
	Команда
	.Опция("yaxunitpath", "", "Путь до расширения YAXUNIT")
	.ТСтрока()
	.ВОкружении("TOOLS_UI_1C_YAXUNIT_PATH");	
	Команда
	.Опция("yaxunitversion", "25.12", "версия расширения YAXUNIT")
	.ТСтрока()
	.ВОкружении("TOOLS_UI_1C_YAXUNIT_VERSION");
КонецПроцедуры

Процедура ВыполнитьКоманду(Знач Команда) Экспорт
	КаталогПлатформы = Команда.ЗначениеОпции("platformSource");
	ПутьКРасширениюТестов = Команда.ЗначениеОпции("yaxunitpath");
	ВерсияДвижкаТестирования = Команда.ЗначениеОпции("yaxunitversion");
	Инициализировать();

	СкачатьРасширениеYaxunit();
	СоздатьБазуДанных();
	ЗагрузитьРасширение("YAXUNIT", ПутьКРасширениюТестов, Ложь);
	ЗагрузитьРасширение("УниверсальныеИнструменты", ОбъединитьПути(КаталогСборки, "UI.cfe"), Ложь);
	ЗагрузитьРасширение("МодульныеТесты", ОбъединитьПути(КаталогСборки, "source","МодульныеТесты"), Истина);

	ПриЗавершении();
КонецПроцедуры

Процедура Инициализировать()
	// Каталоги сборки определяет основной сборщик
	Сборщик = Новый СборщикОсновной();
	КаталогСборки = Сборщик.КаталогСборки;
	КаталогТестирования = ОбъединитьПути(КаталогСборки, "unittests");
	КаталогИсходниковКонфигуратора = Сборщик.КаталогИсходныхФайлов;
	КаталогРепозитория = Сборщик.КаталогРепозитория;
	
	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	МенеджерВременныхФайлов.БазовыйКаталог = ОбъединитьПути(КаталогТестирования, "tmp");
	ФС.ОбеспечитьПустойКаталог(МенеджерВременныхФайлов.БазовыйКаталог);
	
	КаталогБазы = ОбъединитьПути(КаталогТестирования, "base");
	ФС.ОбеспечитьПустойКаталог(КаталогБазы);

	Лог = Новый Лог("unit.test.tools_ui_1c");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	
	СборщикФайлов = Новый СборщикБинарныхФайлов1С;
	СборщикФайлов.УстановитьПутьКПлатформе1С(КаталогПлатформы);
	СборщикФайлов.УстановитьИмяКаталогаВременнойБазы(КаталогБазы);
	СборщикФайлов.УстановитьЛог(Лог);
КонецПроцедуры

Процедура СоздатьБазуДанных()
	ИмяКонфигурацииДляЗагрузки = ОбъединитьПути(КаталогРепозитория, "tests", ОбъединитьПути("yaxunit", "fixtures", "config.cf"));
	СборщикФайлов.СоздатьФайловуюБазу(ИмяКонфигурацииДляЗагрузки);
 КонецПроцедуры

Процедура ЗагрузитьРасширение(ИмяРасширения, ПутьКфайлуРасширения, ИзФайлов)
	Лог.Информация("Загружаю расширение "+ИмяРасширения+" в базу тестов");
	Если ИзФайлов Тогда
		СборщикФайлов.ЗагрузитьКонфигурациюИзФайлов(ПутьКфайлуРасширения, ИмяРасширения);
	Иначе
		СборщикФайлов.ЗагрузитьКонфигурациюИзФайла(ПутьКфайлуРасширения, ИмяРасширения);
	КонецЕсли;
	СборщикФайлов.ОбновитьКонфигурациюБазыДанных(ИмяРасширения);
	СборщикФайлов.УстановитьНастройкиРасширенияБазы(ИмяРасширения, Ложь, Ложь);
КонецПроцедуры

Процедура СкачатьРасширениеYaxunit()
	Если ЗначениеЗаполнено(ПутьКРасширениюТестов) Тогда
		Возврат;
	КонецЕсли;
	
	Лог.Информация("Скачиваем YAXUNIT");
	ПутьКРасширениюТестов = ОбъединитьПути(КаталогТестирования, "yaxunit.cfe");
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("Таймаут", 1);

	УРЛРасширения = "https://github.com/bia-technologies/yaxunit/releases/download/" + ВерсияДвижкаТестирования + "/YAxUnit-" + ВерсияДвижкаТестирования + ".cfe";
	РезультатЗагрузки = КоннекторHTTP.Get(УРЛРасширения);
	ДвоичныеДанныеРасширения = РезультатЗагрузки.ДвоичныеДанные();
	ДвоичныеДанныеРасширения.Записать(ПутьКРасширениюТестов);	
КонецПроцедуры

// Собирает проверяемое расширение Инструменты (один вариант сборки)
Процедура СобратьПроверяемоеРасширение(КаталогПлатформы, ИмяФайлаРезультата)
	ВариантСборки = ВариантСборкиДляТестов();

	СборщикРасширения = Новый СборщикРасширения();
	СборщикРасширения.ИмяКаталогаПлатформы = КаталогПлатформы;
	СборщикРасширения.ВариантСборки = ВариантСборки;
	СборщикРасширения.УстановитьЛог(Лог);
	СборщикРасширения.УстановитьКаталогИсходныхФайлов(КаталогИсходниковКонфигуратора);
	СборщикРасширения.УстановитьКаталогРезультатаСборки(МенеджерВременныхФайлов.СоздатьКаталог());
	СборщикРасширения.ВыполнитьСборкуИсходников();
	СборщикРасширения.ВыполнитьСозданиеБинарногоФайла(ИмяФайлаРезультата);
КонецПроцедуры

Процедура СобратьРасширениеТестов(КаталогПлатформы, ИмяРасширения, ИмяФайлаРезультата)
	СборщикБинарников = Новый СборщикБинарныхФайлов1С;
	СборщикБинарников.УстановитьКаталогВременныхФайлов(МенеджерВременныхФайлов.СоздатьКаталог());
	СборщикБинарников.УстановитьЛог(Лог);
	СборщикБинарников.УстановитьПутьКПлатформе1С(КаталогПлатформы);
	СборщикБинарников.ВыполнитьСозданиеБинарногоФайлаРасширения(
		ОбъединитьПути(КаталогИсходниковКонфигуратора, ИмяРасширения),
		ИмяФайлаРезультата,
		ИмяРасширения);
КонецПроцедуры

Процедура ПриЗавершении()
	МенеджерВременныхФайлов.Удалить();
	УдалитьФайлы(МенеджерВременныхФайлов.БазовыйКаталог);

КонецПроцедуры