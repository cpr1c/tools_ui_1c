// Эмулирует повторное использование возвращаемых значений серверного общего модуля в портативной поставке.
// Общий модуль собирается во внешнюю обработку, у которой нет кэша повторного использования, поэтому плагин
// добавляет в каждую экспортную функцию модуля объекта запоминание результата по значениям параметров
// в переменной модуля. Результаты живут, пока жив экземпляр обработки: экземпляры общих модулей
// переиспользуются в пределах вызова сервера, см. ОбщийМодульПоИмени в плагине ДобавлениеВызоваОбщихМодулей.
// Плагин работает в одном проходе с ДобавлениеВызоваОбщихМодулей: тот объявляет переменную кэша и добавляет
// служебные функции запоминания, см. ДобавлениеВызоваОбщихМодулей.ТекстФункцийЗапоминанияРезультатов. Служебные
// функции в этом проходе только вставляются и не разбираются, поэтому запоминание к ним не добавляется.

Перем Типы;
Перем ТаблицаОшибок;
Перем ТаблицаЗамен;
Перем Директивы;

Перем Результат;
Перем ПрефиксПеременных;
Перем ТекущаяФункцияЗапоминается;

Процедура Открыть(Парсер, Параметры) Экспорт
	Типы = Парсер.Типы();
	ТаблицаОшибок = Парсер.ТаблицаОшибок();
	ТаблицаЗамен = Парсер.ТаблицаЗамен();
	Директивы = Парсер.Директивы();

	Результат = Новый Массив;
	ПрефиксПеременных = Параметры.ПрефиксПеременныхИПроцедур;
	ТекущаяФункцияЗапоминается = Ложь;
КонецПроцедуры

Функция Закрыть() Экспорт
	Возврат СтрСоединить(Результат);
КонецФункции

Функция Подписки() Экспорт
	Подписки = Новый Массив;
	Подписки.Добавить("ПосетитьОбъявлениеМетода");
	Подписки.Добавить("ПокинутьОбъявлениеМетода");
	Подписки.Добавить("ПосетитьОператорВозврат");
	Возврат Подписки;
КонецФункции

#Область РеализацияПодписок

// Вставляет в начало экспортной функции проверку кэша. Ключ вычисляется до операторов функции,
// пока значения параметров не изменены.
//
// Параметры:
//  ОбъявлениеМетода - Структура - объявление метода
Процедура ПосетитьОбъявлениеМетода(ОбъявлениеМетода) Экспорт
	Сигнатура = ОбъявлениеМетода.Сигнатура;
	ТекущаяФункцияЗапоминается = Сигнатура.Тип = Типы.ОбъявлениеСигнатурыФункции
		И Сигнатура.Экспорт
		И ОбъявлениеМетода.Операторы.Количество() > 0;
	Если Не ТекущаяФункцияЗапоминается Тогда
		Возврат;
	КонецЕсли;

	ТекстПроверкиКэша = Символы.ПС + ПрефиксПеременных + "ПараметрыКэша = Новый Массив;";
	Для Каждого Параметр Из Сигнатура.Параметры Цикл
		ТекстПроверкиКэша = ТекстПроверкиКэша + Символы.ПС + ПрефиксПеременных + "ПараметрыКэша.Добавить("
			+ Параметр.Имя + ");";
	КонецЦикла;
	ТекстПроверкиКэша = ТекстПроверкиКэша + Символы.ПС
		+ ПрефиксПеременных + "КлючКэша = " + ПрефиксПеременных + "КлючКэшаПовторногоИспользования("""
		+ Сигнатура.Имя + """, " + ПрефиксПеременных + "ПараметрыКэша);" + Символы.ПС
		+ ПрефиксПеременных + "ЗначениеКэша = " + ПрефиксПеременных + "ЗначениеИзКэшаПовторногоИспользования("
		+ ПрефиксПеременных + "КлючКэша);" + Символы.ПС
		+ "Если " + ПрефиксПеременных + "ЗначениеКэша <> Неопределено Тогда" + Символы.ПС
		+ "	Возврат " + ПрефиксПеременных + "ЗначениеКэша.Значение;" + Символы.ПС
		+ "КонецЕсли;" + Символы.ПС;

	Вставка(ТекстПроверкиКэша, ОбъявлениеМетода.Операторы[0].Начало.Позиция);
КонецПроцедуры

Процедура ПокинутьОбъявлениеМетода(ОбъявлениеМетода) Экспорт
	ТекущаяФункцияЗапоминается = Ложь;
КонецПроцедуры

Процедура ПосетитьОператорВозврат(ОператорВозврат) Экспорт
	Если Не ТекущаяФункцияЗапоминается Или ОператорВозврат.Выражение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выражение = ОператорВозврат.Выражение;
	Вставка(ПрефиксПеременных + "ЗапомнитьВКэшеПовторногоИспользования(" + ПрефиксПеременных + "КлючКэша, ",
		Выражение.Начало.Позиция);
	Вставка(")", Выражение.Конец.Позиция + Выражение.Конец.Длина);
КонецПроцедуры

#КонецОбласти

Процедура Вставка(Текст, Позиция)
	НоваяЗамена = ТаблицаЗамен.Добавить();
	НоваяЗамена.Источник = "ЗапоминаниеРезультатовФункцийПовторногоИспользования";
	НоваяЗамена.Текст = Текст;
	НоваяЗамена.Позиция = Позиция;
	НоваяЗамена.Длина = 0;
КонецПроцедуры
