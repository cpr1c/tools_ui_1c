
// Этот плагин выполняет переименование переменных если это возможно.
// При возникновении конфликтов регистрирует ошибку, которая указывает на конфликтную переменную.

// Пример ожидаемой структуры параметров (json):
// {"СтароеИмя1": "НовоеИмя1", "СтароеИмя2": "НовоеИмя2"}

Перем Типы;
Перем ТаблицаОшибок;
Перем ТаблицаЗамен;
Перем Директивы;

Перем Результат;

Перем ПрефиксПеременныхИПроцедур;
Перем ТекстЗаменыИменВнешнихОбработок;

Процедура Открыть(Парсер, Параметры) Экспорт
	Типы = Парсер.Типы();
	ТаблицаОшибок = Парсер.ТаблицаОшибок();
	ТаблицаЗамен = Парсер.ТаблицаЗамен();
	Директивы = Парсер.Директивы();

	Результат = Новый Массив;

	ПрефиксПеременныхИПроцедур=Параметры.ПрефиксПеременныхИПроцедур;

	// Имя модуля в ОбщийМодуль(Имя) известно только при выполнении, поэтому имена внешних обработок общих модулей,
	// которые отличаются от имен модулей, подставляются кодом,
	// см. СборщикПортативнойПоставки.ЗаполнитьИменаВнешнихОбработокОбщихМодулей
	ТекстЗаменыИменВнешнихОбработок = "";
	Для Каждого ОбщийМодуль Из Параметры.ОписаниеКонфигурации.ОбщиеМодули Цикл
		Если ОбщийМодуль.ИмяВнешнейОбработки = ОбщийМодуль.Имя Тогда
			Продолжить;
		КонецЕсли;
		ТекстЗаменыИменВнешнихОбработок = ТекстЗаменыИменВнешнихОбработок + "
		|	Если НРег(" + ПрефиксПеременныхИПроцедур + "ИмяВнешнейОбработки) = """ + НРег(ОбщийМодуль.Имя) + """ Тогда
		|		" + ПрефиксПеременныхИПроцедур + "ИмяВнешнейОбработки = """ + ОбщийМодуль.ИмяВнешнейОбработки + """;
		|	КонецЕсли;";
	КонецЦикла;
КонецПроцедуры // Открыть()

Функция Закрыть() Экспорт
	Возврат СтрСоединить(Результат);
КонецФункции // Закрыть()

Функция Подписки() Экспорт
	Перем Подписки;
	Подписки = Новый Массив;
	Подписки.Добавить("ПосетитьОбъявлениеМетода");
	Возврат Подписки;
КонецФункции // Подписки()

#Область РеализацияПодписок

Процедура ПосетитьОбъявлениеМетода(ОбъявлениеМетода) Экспорт
	Если ОбъявлениеМетода.Сигнатура.Имя <> "ОбщийМодуль" Тогда
		Возврат;
	КонецЕсли;
	
	// Вставка опирается на переменную Модуль самой реализации метода. Обертки, которые только вызывают ОбщийМодуль
	// другого модуля (например, в УИ_ОбщегоНазначенияПовтИсп), пропускаются: переменной Модуль в них нет, а число
	// операторов может вырасти из-за запоминания результатов, см. ЗапоминаниеРезультатовФункцийПовторногоИспользования.
	ЕстьПеременнаяМодуль = Ложь;
	Для Каждого Переменная Из ОбъявлениеМетода.Переменные Цикл
		Если НРег(Переменная.Имя) = "модуль" Тогда
			ЕстьПеременнаяМодуль = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ОбъявлениеМетода.Операторы.Количество() <=1 Или Не ЕстьПеременнаяМодуль Тогда
		Возврат;
	КонецЕсли;

	ТекстВставки="
	|Если Модуль=Неопределено Тогда
	|	" + ПрефиксПеременныхИПроцедур + "ИмяВнешнейОбработки = Имя;" + ТекстЗаменыИменВнешнихОбработок + "
	|	Попытка
	|		Модуль="+ПрефиксПеременныхИПроцедур+"ОбщийМодульПоИмени(" + ПрефиксПеременныхИПроцедур + "ИмяВнешнейОбработки);
	|	Исключение
	|		Модуль = Неопределено;
	|	КонецПопытки;
	|КонецЕсли;
	|
	|";
	Вставка(ТекстВставки, ОбъявлениеМетода.Операторы[ОбъявлениеМетода.Операторы.Количество()-1].Начало.Позиция);
КонецПроцедуры

#КонецОбласти // РеализацияПодписок

Процедура Ошибка(Текст, Начало, Конец = Неопределено, ЕстьЗамена = Ложь)
	Ошибка = ТаблицаОшибок.Добавить();
	Ошибка.Источник = "ПереопределитьМетодОбщийМодуль";
	Ошибка.Текст = Текст;
	Ошибка.ПозицияНачала = Начало.Позиция;
	Ошибка.НомерСтрокиНачала = Начало.НомерСтроки;
	Ошибка.НомерКолонкиНачала = Начало.НомерКолонки;
	Если Конец = Неопределено Или Конец = Начало Тогда
		Ошибка.ПозицияКонца = Начало.Позиция + Начало.Длина;
		Ошибка.НомерСтрокиКонца = Начало.НомерСтроки;
		Ошибка.НомерКолонкиКонца = Начало.НомерКолонки + Начало.Длина;
	Иначе
		Ошибка.ПозицияКонца = Конец.Позиция + Конец.Длина;
		Ошибка.НомерСтрокиКонца = Конец.НомерСтроки;
		Ошибка.НомерКолонкиКонца = Конец.НомерКолонки + Конец.Длина;
	КонецЕсли;
	Ошибка.ЕстьЗамена = ЕстьЗамена;
КонецПроцедуры

Процедура Замена(Текст, Начало, Конец = Неопределено)
	НоваяЗамена = ТаблицаЗамен.Добавить();
	НоваяЗамена.Источник = "ПереопределитьМетодОбщийМодуль";
	НоваяЗамена.Текст = Текст;
	НоваяЗамена.Позиция = Начало.Позиция;
	Если Конец = Неопределено Тогда
		НоваяЗамена.Длина = Начало.Длина;
	Иначе
		НоваяЗамена.Длина = Конец.Позиция + Конец.Длина - Начало.Позиция;
	КонецЕсли;
КонецПроцедуры

Процедура Вставка(Текст, Позиция)
	НоваяЗамена = ТаблицаЗамен.Добавить();
	НоваяЗамена.Источник = "ПереопределитьМетодОбщийМодуль";
	НоваяЗамена.Текст = Текст;
	НоваяЗамена.Позиция = Позиция;
	НоваяЗамена.Длина = 0;
КонецПроцедуры