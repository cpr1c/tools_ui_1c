// Форма ожидания входа пользователя после запуска клиента 1С под ним с временным паролем.
// Раз в секунду проверяет, появился ли у пользователя новый сеанс, и показывает, когда будет восстановлен пароль.
// Закрывается при появлении сеанса (результат Истина), по истечении времени ожидания или по команде (результат Ложь).
// Исходный пароль восстанавливает обработчик оповещения о закрытии формы.

#Область ОписаниеПеременных

&НаКлиенте
Перем ВремяНачалаОжидания;

&НаКлиенте
Перем ВремяОкончанияОжидания;

&НаКлиенте
Перем ОжиданиеЗавершено;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Параметры.Пользователь) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Пользователь = Параметры.Пользователь;
	ВремяОжидания = Параметры.ВремяОжидания;
	Если ТипЗнч(Параметры.НомераСеансовДоЗапуска) = Тип("Массив") Тогда
		НомераСеансовДоЗапуска.ЗагрузитьЗначения(Параметры.НомераСеансовДоЗапуска);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОжиданиеЗавершено = Ложь;
	ВремяНачалаОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВремяОкончанияОжидания = ВремяНачалаОжидания + ВремяОжидания * 1000;
	ОбновитьСостояние();
	ПодключитьОбработчикОжидания("ПроверитьВходПользователя", 1);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Не ОжиданиеЗавершено Тогда
		Отказ = Истина;
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru = 'Исходный пароль пользователя ""%1"" еще не восстановлен.'"), Пользователь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ПроверитьВходПользователя");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВосстановитьПарольСейчас(Команда)

	ЗавершитьОжидание(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьВходПользователя()

	Если УИ_ОбщегоНазначенияВызовСервера.ЕстьНовыйСеансПользователя(Пользователь,
		НомераСеансовДоЗапуска.ВыгрузитьЗначения()) Тогда
		ЗавершитьОжидание(Истина);
	ИначеЕсли ТекущаяУниверсальнаяДатаВМиллисекундах() >= ВремяОкончанияОжидания Тогда
		ЗавершитьОжидание(Ложь);
	Иначе
		ОбновитьСостояние();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОжидание(ВходВыполнен)

	ОтключитьОбработчикОжидания("ПроверитьВходПользователя");
	ОжиданиеЗавершено = Истина;
	Закрыть(ВходВыполнен);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояние()

	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДлительностьОжидания = ВремяОкончанияОжидания - ВремяНачалаОжидания;
	Если ДлительностьОжидания > 0 Тогда
		Прогресс = Мин(100, Окр((ТекущееВремя - ВремяНачалаОжидания) * 100 / ДлительностьОжидания));
	Иначе
		Прогресс = 100;
	КонецЕсли;
	ОсталосьСекунд = Макс(0, Окр((ВремяОкончанияОжидания - ТекущееВремя) / 1000));
	ТекстСостояния = СтрШаблон(НСтр("ru = 'Ожидается вход пользователя ""%1"".'"), Пользователь);
	Элементы.Прогресс.Заголовок = СтрШаблон(НСтр("ru = 'Пароль восстановится через %1 сек.'"), ОсталосьСекунд);

КонецПроцедуры

#КонецОбласти
