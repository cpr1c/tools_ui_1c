// Генератор паролей. Начальные настройки берутся из политики паролей, переданной параметром
// ИмяПолитикиПаролей, а если она не задана - из параметров информационной базы.
// Команда «Выбрать» закрывает форму и возвращает сгенерированный пароль.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = УИ_Пользователи.НастройкиГенерацииПароля(Параметры.ИмяПолитикиПаролей);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сгенерировать(Команда)

	Попытка
		Пароль = НовыйПароль(ДлинаПароля, ВерхнийРегистр, НижнийРегистр, Цифры, Символы);
	Исключение
		ПоказатьПредупреждение( , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)

	Если ПустаяСтрока(Пароль) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Сначала сгенерируйте пароль.'"));
		Возврат;
	КонецЕсли;
	Закрыть(Пароль);

КонецПроцедуры

&НаКлиенте
Процедура КопироватьПароль(Команда)

	Если ПустаяСтрока(Пароль) Тогда
		Возврат;
	КонецЕсли;
	УИ_БуферОбменаКлиент.НачатьКопированиеСтрокиВБуфер(Пароль,
		Новый ОписаниеОповещения("КопироватьПарольЗавершение", ЭтотОбъект));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Завершение копирования пароля в буфер обмена.
//
// Параметры:
//  Результат - Булево, Неопределено - результат копирования; Неопределено, если не удалось подключить компоненту.
//  ДополнительныеПараметры - Неопределено - не используется.
&НаКлиенте
Процедура КопироватьПарольЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Истина Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Пароль скопирован в буфер обмена'"));
	Иначе
		ПоказатьПредупреждение( , НСтр("ru = 'Не удалось скопировать пароль в буфер обмена.'"));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйПароль(Знач Длина, Знач ПрописныеБуквы, Знач СтрочныеБуквы, Знач ЦифрыПароля, Знач СпецСимволы)

	Возврат УИ_Пользователи.СгенерироватьПароль(Длина, ПрописныеБуквы, СтрочныеБуквы, ЦифрыПароля, СпецСимволы);

КонецФункции

#КонецОбласти
