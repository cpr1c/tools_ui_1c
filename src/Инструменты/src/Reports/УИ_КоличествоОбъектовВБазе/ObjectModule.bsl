// см. ОМ.ВариантыОтчетовСлужебныйКлиентСервер
Функция РежимВариантаОтчета(КлючВарианта) 
	
	Возврат ТипЗнч(КлючВарианта) = Тип("Строка")
		И Не ПустаяСтрока(КлючВарианта);
	
