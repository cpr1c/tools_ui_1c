	РежимыРаботыВыгрузкиОбъекта = РежимыРаботыВыгрузкиОбъекта();
	ОткрытьФормуВыгрузкиОбъекта(РежимыРаботыВыгрузкиОбъекта.ВыгрузкаНабораЗаписей);
