Процедура ЗагрузитьНастройкиОбработки()
	ДанныеНастройки = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаХранилищаНастройки(), "Настройки");
	Если ТипЗнч(ДанныеНастройки) = Тип("Структура") Тогда
		НастройкиОбработки = СформироватьСтруктуруНастроек();
		ЗаполнитьЗначенияСвойств(НастройкиОбработки, ДанныеНастройки);
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОбработки);
	КонецЕсли;
