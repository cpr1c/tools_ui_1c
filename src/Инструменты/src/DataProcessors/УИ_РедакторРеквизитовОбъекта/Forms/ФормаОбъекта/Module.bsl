Функция ТипыДанныхРеквизитов()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Число", Тип("Число"));
	Результат.Вставить("Строка", Тип("Строка"));
	Результат.Вставить("Дата", Тип("Дата"));
	Результат.Вставить("Булево", Тип("Булево"));
	Результат.Вставить("ХранилищеЗначения", Тип("ХранилищеЗначения"));
	Результат.Вставить("УникальныйИдентификатор", Тип("УникальныйИдентификатор"));
	Результат.Вставить("ДвоичныеДанные", Тип("ДвоичныеДанные"));
	
	Возврат Результат;
	
КонецФункции

