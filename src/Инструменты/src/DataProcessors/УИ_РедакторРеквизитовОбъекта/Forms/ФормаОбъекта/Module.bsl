	Иначе
		ТекстВопроса = НСтр("ru = 'Объект будет записан в базу. Продолжить?'");
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения(НСтр("ru = 'ЗаписатьОбъектДалее'"), ЭтотОбъект),
