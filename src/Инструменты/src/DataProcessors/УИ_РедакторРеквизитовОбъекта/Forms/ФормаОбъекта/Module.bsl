&НаКлиенте
Процедура ОткрытьОбъект(Команда)
	
	Имя = ПутьКДаннымТекущегоЭлемента();
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат;
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(ТекущийЭлемент) = Тип("ПолеФормы") Тогда
		Значение = ЭтотОбъект[Имя];
	ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		ТекДанные = ТекущийЭлемент.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			Если ТекущийЭлемент.Имя = "РеквизитыОбъекта" Тогда
				Значение = ТекДанные.Значение;
			Иначе
				Значение = ТекДанные[Имя];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Значение) Тогда
		Если ТипЗнч(Значение) = ТипХранилищаЗначений Тогда
			УИ_ОбщегоНазначенияКлиент.РедактироватьХранилищеЗначения(ЭтотОбъект, Значение);
		Иначе
			УИ_ОбщегоНазначенияКлиент.РедактироватьОбъект(Значение, АдресОбщихРеквизитов);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

