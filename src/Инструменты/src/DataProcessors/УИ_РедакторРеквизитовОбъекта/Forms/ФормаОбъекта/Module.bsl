
#Область ОписаниеПеременных

&НаКлиенте
Перем ТипХранилищаЗначений;

&НаКлиенте
Перем ТипUUID;

&НаКлиенте
Перем ПоследнийUUID;

&НаКлиенте
Перем ОбработкаВыбораФормы;

&НаКлиенте
Перем ЭтоЗакрытиеОбработки; //Булево

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресОбщихРеквизитов = Параметры.АдресОбщихРеквизитов;
	Если ПустаяСтрока(АдресОбщихРеквизитов) Тогда
		УИ_ОбщегоНазначения.ДанныеПоОбщимРеквизитам(АдресОбщихРеквизитов);
	КонецЕсли;
	
	ВсеПеречисления = УИ_ОбщегоНазначения.ОписаниеТипаПеречислениеСсылка().Типы();
	ВсеСсылки = УИ_ОбщегоНазначения.ОписаниеТипаВсеСсылки();
	Элементы.мОбъектСсылка.ДоступныеТипы = Новый ОписаниеТипов(ВсеСсылки, , ВсеПеречисления);
	мОбъектСсылка = Параметры.мОбъектСсылка;
	
	ОграничениеНаСписокЗависимых = 10000;
	ПрефиксДляНовыхЭлементов = "__XXX__";
	ПриЗаполненииОбрабатыватьТолькоВыделенныеСтроки = Истина;
	
	НастройкиОбработки = СформироватьСтруктуруНастроек();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОбработки);
	ЗагрузитьНастройкиОбработки();
	
	КонфигурацияДопускаетДопДвижения = (Метаданные.Документы.Найти("РегистраторРасчетов") <> Неопределено);
	
	Если Не ЕстьПраваАдминистратора() Тогда
		Элементы.Форма_УдалитьОбъект.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	ЗаполнитьДанныеОбъектаСсылки();
	
	УИ_РаботаСФормами.ФормаПриСозданииНаСервереСоздатьРеквизитыПараметровЗаписи(ЭтотОбъект,
		Элементы.ГруппаПараметрыЗаписи);
	УИ_ОбщегоНазначения.ФормаИнструментаПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);

	ДобавитьКомандуОчисткиТаблицы(Элементы._НаборЗаписей, "_НаборЗаписей");	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТипХранилищаЗначений = Тип("ХранилищеЗначения");
	ТипUUID = Тип("УникальныйИдентификатор");
	ЭтоЗакрытиеОбработки = Ложь;
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)

	ИмяКлюча = "мОбъектСсылка";

	ЗначениеИзНастройки = Настройки[ИмяКлюча];
	Если ЗначениеИзНастройки <> Неопределено Тогда
		НовоеОписаниеТипов = НовоеОписаниеТипов(ТипЗнч(ЗначениеИзНастройки));
		Элементы[ИмяКлюча].ОграничениеТипа = НовоеОписаниеТипов;
		ЭтотОбъект[ИмяКлюча] = НовоеОписаниеТипов.ПривестиЗначение(ЗначениеИзНастройки);
	Иначе
		Элементы[ИмяКлюча].ОграничениеТипа = Новый ОписаниеТипов;
		ЭтотОбъект[ИмяКлюча] = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	Если мОбъектСсылка <> Неопределено Тогда
		ЗаполнитьДанныеОбъектаСсылки();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ОбработкаВыбораФормы <> Неопределено Тогда
		Элементы[ОбработкаВыбораФормы.Таблица].ТекущиеДанные[ОбработкаВыбораФормы.Поле] = ВыбранноеЗначение;
		ОбработкаВыбораФормы = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		Отказ = Истина;
	ИначеЕсли Модифицированность И Не ЭтоЗакрытиеОбработки Тогда
		Отказ = Истина;
		ЭтоЗакрытиеОбработки = Истина;

		ТекстВопроса  = "ru = 'Объект был изменен. 
						|Закрытие приведет к потере выполненных изменений.
						|Записать объект перед закрытием?'";
		ОповещениеОЗавершенииВопроса = Новый ОписаниеОповещения("ПередЗакрытиемЗавершениеВопросаОЗаписиОбъекта",
			ЭтотОбъект);

		ПоказатьВопрос(ОповещениеОЗавершенииВопроса,
					   ТекстВопроса,
					   РежимДиалогаВопрос.ДаНетОтмена,
					   10,
					   КодВозвратаДиалога.Нет);
	Иначе
		// SonarQube не пропускает обработку, если нет Иначе
		ЭтоЗакрытиеОбработки = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектСсылкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДоступныеНаборыТипов = УИ_ОбщегоНазначенияКлиентСервер.ДоступныеНаборыТиповДляРедактирования();

	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияНачалоВыбораЗначения(ЭтотОбъект,
																										  Элемент,
																										  "мОбъектСсылка");
	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;
	ПараметрыОбработчика.Значение = мОбъектСсылка;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ЭтотОбъект;
	ПараметрыОбработчика.НаборТипов = ДоступныеНаборыТипов.Ссылки;
	ПараметрыОбработчика.ТекущееОписаниеТиповЗначения = Элемент.ДоступныеТипы;
	ПараметрыОбработчика.ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбъектСсылкаНачалоВыбораЗавершение",
		ЭтотОбъект);
	ПараметрыОбработчика.ИспользоватьДинамическийСписокДляВыбораСсылочногоЗначения = _ИспользоватьНеСтандартнуюФормуДляВыбора;
	ПараметрыОбработчика.ПараметрыФормы.Вставить("ВыборГруппИЭлементов",
		УИ_ОбщегоНазначенияКлиентСервер.ИспользованиеГруппИЭлементов(Элементы.мОбъектСсылка.ВыборГруппИЭлементов));

	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикНачалоВыбораЗначения(ПараметрыОбработчика, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСсылкаПриИзменении(Элемент)
	ПриИзмененииОбъектаСсылки();
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСсылкаОчистка(Элемент, СтандартнаяОбработка)
	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияОчистка(ЭтотОбъект,
																							 Элемент,
																							 "мОбъектСсылка");
	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ЭтотОбъект;

	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикОчистка(ПараметрыОбработчика, СтандартнаяОбработка);
	ПриИзмененииОбъектаСсылки();
КонецПроцедуры

&НаКлиенте
Процедура _GUIDПриИзменении(Элемент)
	_ДатаСозданияОбъекта = ДатаСозданияГУИД(_UUID);
КонецПроцедуры

&НаКлиенте
Процедура _URLПриИзменении(Элемент)
	Если ЗначениеЗаполнено(_URL) Тогда
		ЗаполнитьОбъектСсылкаПоURL();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура _ИмяНабораЗаписейПриИзменении(Элемент)
	ОбновитьНаборЗаписейНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура _СкрыватьПустыеТабличныеЧастиПриИзменении(Элемент)
	ИзменитьВидимостьТабличныхЧастейОбъекта();
КонецПроцедуры

&НаКлиенте
Процедура _ЗначениеДляЗаполненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияНачалоВыбораЗначения(ЭтотОбъект,
																											   Элемент,
																											   "_ЗначениеДляЗаполнения");
																											   
	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;																											   
	ПараметрыОбработчика.Значение = _ЗначениеДляЗаполнения;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ЭтотОбъект;
	ПараметрыОбработчика.ИспользоватьДинамическийСписокДляВыбораСсылочногоЗначения = _ИспользоватьНеСтандартнуюФормуДляВыбора;
	ПараметрыОбработчика.ПараметрыФормы.Вставить("ВыборГруппИЭлементов",
		УИ_ОбщегоНазначенияКлиентСервер.ИспользованиеГруппИЭлементов(Элементы._ЗначениеДляЗаполнения.ВыборГруппИЭлементов));
	
	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикНачалоВыбораЗначения(ПараметрыОбработчика, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура _ЗначениеДляЗаполненияОчистка(Элемент, СтандартнаяОбработка)
	ПараметрыОбработкиСобытия = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияОчистка(ЭтотОбъект,
																								  Элемент,
																								  "_ЗначениеДляЗаполнения");

	ПараметрыОбработкиСобытия.ДоступенКонтейнер = Ложь;																											   
	ПараметрыОбработкиСобытия.СтруктураХраненияЗначения = ЭтотОбъект;

	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикОчистка(ПараметрыОбработкиСобытия, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыОбъекта

&НаКлиенте
Процедура РеквизитыОбъектаЗначениеПриИзменении(Элемент)
	Значение = Элементы.РеквизитыОбъекта.ТекущиеДанные.Значение;

	Если Элементы.РеквизитыОбъекта.ТекущиеДанные.Имя = "ТипЗначения" И Значение <> Неопределено Тогда
		ВидОбъекта = ОпределитьВидОбъекта(мОбъектСсылка);
		Если ВидОбъекта = "ПланВидовХарактеристик" Тогда
			Элементы.РеквизитыОбъекта.ТекущиеДанные.Значение = НовоеОписаниеТипов(ТипЗнч(Значение));
		КонецЕсли;
	КонецЕсли;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОбъектаЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.РеквизитыОбъекта.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ЭтоРеквизитИмяПредопределенныхДанных(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияНачалоВыбораЗначения(ЭтотОбъект,
																										  Элемент,
																										  "Значение");

	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ТекущиеДанные;
	ПараметрыОбработчика.Значение = ТекущиеДанные.Значение;
	ПараметрыОбработчика.ТекущееОписаниеТиповЗначения = ТекущиеДанные.ТипЗначения;
	ПараметрыОбработчика.ИспользоватьДинамическийСписокДляВыбораСсылочногоЗначения = _ИспользоватьНеСтандартнуюФормуДляВыбора;
	ПараметрыОбработчика.ОграничениеВыбораЗначенияОписанияТипов = ТекущиеДанные.ОграничениеВыбораЗначенияОписанияТипов;
	ПараметрыОбработчика.ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ТекущиеДанные.ВыборГруппИЭлементов);
	
	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикНачалоВыбораЗначения(ПараметрыОбработчика, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОбъектаЗначениеОчистка(Элемент, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.РеквизитыОбъекта.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияОчистка(ЭтотОбъект,
																							 Элемент,
																							 "Значение");

	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ТекущиеДанные;
	ПараметрыОбработчика.ТекущееОписаниеТиповЗначения = ТекущиеДанные.ТипЗначения;

	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикОчистка(ПараметрыОбработчика, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОбъектаПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.РеквизитыОбъекта.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Колонка = Элементы.РеквизитыОбъектаЗначение;
	Если ЭтоРеквизитИмяПредопределенныхДанных(ТекущиеДанные) Тогда
		Колонка.РежимВыбораИзСписка = Истина;
		Колонка.СписокВыбора.ЗагрузитьЗначения(ИменаПредопределенныхДанных.ВыгрузитьЗначения());
	Иначе
		Колонка.РежимВыбораИзСписка = Ложь;
		Колонка.СписокВыбора.Очистить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТабличнаяЧасть

&НаКлиенте
Процедура Подключаемый_ТабличнаяЧастьПриИзменении(Элемент)
	ОбновитьНомераСтрокТабличнойЧасти(Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТабличнаяЧастьПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьЗаголовокСтраницыТабличнойЧасти(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТабличнаяЧастьПослеУдаления(Элемент)
	ОбновитьЗаголовокСтраницыТабличнойЧасти(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТабличнаяЧастьРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТаблицаФормыЭлемента = Элемент.Родитель;

	ТекущиеДанные = ТаблицаФормыЭлемента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяКолонки = Сред(Элемент.Имя, СтрДлина(ТаблицаФормыЭлемента.Имя) + 1);
	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияНачалоВыбораЗначения(ЭтотОбъект,
																										  Элемент,
																										  ИмяКолонки);

	ВыборГруппИЭлементов = УИ_ОбщегоНазначенияКлиентСервер.ИспользованиеГруппИЭлементов(Элемент.ВыборГруппИЭлементов);
	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ТекущиеДанные;
	ПараметрыОбработчика.Значение = ТекущиеДанные[ИмяКолонки];
	ПараметрыОбработчика.ТекущееОписаниеТиповЗначения = Элемент.ДоступныеТипы;
	ПараметрыОбработчика.ИспользоватьДинамическийСписокДляВыбораСсылочногоЗначения = _ИспользоватьНеСтандартнуюФормуДляВыбора;
	ПараметрыОбработчика.ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ВыборГруппИЭлементов);

	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикНачалоВыбораЗначения(ПараметрыОбработчика, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТабличнаяЧастьРеквизитОчистка(Элемент, СтандартнаяОбработка)
	ТаблицаФормыЭлемента = Элемент.Родитель;

	ТекущиеДанные = ТаблицаФормыЭлемента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяКолонки = Сред(Элемент.Имя, СтрДлина(ТаблицаФормыЭлемента.Имя) + 1);

	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияОчистка(ЭтотОбъект,
																							 Элемент,
																							 ИмяКолонки);

	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ТекущиеДанные;
	ПараметрыОбработчика.ТекущееОписаниеТиповЗначения = Элемент.ДоступныеТипы;

	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикОчистка(ПараметрыОбработчика, СтандартнаяОбработка);
КонецПроцедуры

