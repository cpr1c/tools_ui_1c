&НаКлиенте
Процедура _ПрименитьНастройки(Команда)
	ИмяНабораЗаписей = _ИмяНабораЗаписей;
	ПерезаполнитьДанныеОбъекта(Истина);
	Если Не ПустаяСтрока(ИмяНабораЗаписей) Тогда
		_ИмяНабораЗаписей = ИмяНабораЗаписей;
		ОбновитьНаборЗаписейНаСервере();
	КонецЕсли;

	НастройкиОбработки = СформироватьСтруктуруНастроек();
	ЗаполнитьЗначенияСвойств(НастройкиОбработки, ЭтотОбъект);
	СохранитьНастройкиОбработки(НастройкиОбработки);
КонецПроцедуры

&НаКлиенте
Процедура _ПоказатьСвойстваОбъектаМД(Команда)

	ТекДанные = Элементы._ДеревоСвойств.ТекущиеДанные;

	Если ТекДанные = Неопределено Или ПустаяСтрока(ТекДанные.ТипСтрокой) Или СтрНайти(ТекДанные.ТипСтрокой, ".") = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивТипов = вПолучитьМассивТиповМД(ТекДанные.ТипСтрокой);
	Если МассивТипов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ФормаНавигатора = ПолучитьФормуНавигатораПоКонфигурации(Истина);
	Если ФормаНавигатора = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Операция не доступна, необходимо открыть ""Навигатор по метаданным""'");
		УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	Если МассивТипов.Количество() = 1 Тогда
		вПоказатьСвойстваОбъектаМД(Новый Структура("Значение", МассивТипов[0]), ФормаНавигатора);
	Иначе
		СписокТипов = Новый СписокЗначений;
		СписокТипов.ЗагрузитьЗначения(МассивТипов);
		СписокТипов.СортироватьПоЗначению();
		Оповещение = Новый ОписаниеОповещения("вПоказатьСвойстваОбъектаМД", ЭтотОбъект, ФормаНавигатора);
		СписокТипов.ПоказатьВыборЭлемента(Оповещение, "Выбор типа");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОчиститьТаблицу(Команда)
	
	Префикс = ПрефиксКомандыОчиститьТаблицу();
	ИмяНаФорме = Сред(Команда.Имя, СтрДлина(Префикс) + 1);
	НайденныеТабличныеЧасти = ТабличныеЧастиОбъекта.НайтиСтроки(Новый Структура("ИмяНаФорме", ИмяНаФорме));
	Если НайденныеТабличныеЧасти.Количество() > 0 Тогда
		ТабличнаяЧасть = НайденныеТабличныеЧасти[0];
		ОчиститьТабличнуюЧастьОбъекта(ТабличнаяЧасть.ИмяНаФорме);
		ОбновитьЗаголовокСтраницыТабличнойЧасти(Элементы[ТабличнаяЧасть.ИмяНаФорме]);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перед закрытием завершение вопроса о записи объекта.
// 
// Параметры:
//  Результат - КодВозвратаДиалога
//  ДополнительныеПараметры - Неопределено
&НаКлиенте
Процедура ПередЗакрытиемЗавершениеВопросаОЗаписиОбъекта(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		ЭтоЗакрытиеОбработки = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаписатьОбъектДалее(Результат, ДополнительныеПараметры);

	КонецЕсли;
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомандуОчисткиТаблицы(Таблица, ПутьКДанным)
	ИмяКоманды = СтрШаблон("%1%2", ПрефиксКомандыОчиститьТаблицу(), ПутьКДанным);
	Если Команды.Найти(ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяКоманда = Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = "Подключаемый_ОчиститьТаблицу";
	НоваяКоманда.Заголовок = "Очистить таблицу";
	НоваяКоманда.ИзменяетСохраняемыеДанные = Истина;

	Кнопка = Элементы.Добавить("ОчиститьТаблицу_" + ПутьКДанным, Тип("КнопкаФормы"), Таблица.КоманднаяПанель);
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	Кнопка.ИмяКоманды = ИмяКоманды;
КонецПроцедуры

