&НаСервере
Процедура НайтиОбъектПоUUIDСервер()
	
	Если ПустаяСтрока(_UUID) Тогда
		Возврат;
	КонецЕсли;
	
	мОбъектСсылка = Неопределено;
	ТипОбъектаРедактирования = "";

	Если УИ_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(_UUID) Тогда
		УИД = Новый УникальныйИдентификатор(_UUID);
		Если Не ЗначениеЗаполнено(УИД) Тогда
			Возврат;
		КонецЕсли;
	Иначе
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Неправильное значение UUID'"));
		Возврат;
	КонецЕсли;

	МенеджерыОбъектов = Новый Массив;
	МенеджерыОбъектов.Добавить(Справочники);
	МенеджерыОбъектов.Добавить(Документы);
	МенеджерыОбъектов.Добавить(ПланыВидовРасчета);
	МенеджерыОбъектов.Добавить(ПланыВидовХарактеристик);
	МенеджерыОбъектов.Добавить(ПланыСчетов);
	МенеджерыОбъектов.Добавить(БизнесПроцессы);
	МенеджерыОбъектов.Добавить(Задачи);
	
	Для Каждого МенеджерОбъектов Из МенеджерыОбъектов Цикл
		Для Каждого Менеджер Из МенеджерОбъектов Цикл
			СсылкаНаОбъект = Менеджер.ПолучитьСсылку(УИД);
			Если УИ_ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
				мОбъектСсылка = СсылкаНаОбъект;
				ЗаполнитьДанныеОбъектаСсылки();
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НайтиОбъектПоТипу_UUIDСервер()
	Если Не ПустаяСтрока(ТипОбъектаРедактирования) И Не ПустаяСтрока(_UUID) Тогда
		Если Не УИ_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(_UUID) Тогда
			УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Неправильное значение UUID'"));
			Возврат;
		КонецЕсли;

		ИмяТипа = СтрЗаменить(ТипОбъектаРедактирования, ".", "Ссылка.");
		Попытка
			мОбъектСсылка = XMLЗначение(Тип(ИмяТипа), _UUID);
		Исключение
			УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить объект по типу'"));
			Возврат;
		КонецПопытки;
		ЗаполнитьДанныеОбъектаСсылки();
	КонецЕсли;
КонецПроцедуры

// Возвращает заголовок страницы табличной части.
// 
// Параметры:
//  ИмяТабличнойЧасти - Строка - Имя табличной части
//  ДанныеТабличнойЧасти - ДанныеФормыКоллекция, ТаблицаЗначений - Данные табличной части
// 
// Возвращаемое значение:
//  Строка - новый заголовок страницы
&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокСтраницыТабличнойЧасти(ИмяТабличнойЧасти, ДанныеТабличнойЧасти)
	КоличествоСтрок = ДанныеТабличнойЧасти.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат ИмяТабличнойЧасти;
	Иначе
		Возврат СтрШаблон("%1 (%2)", ИмяТабличнойЧасти, КоличествоСтрок);
	КонецЕсли;			
КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовокСтраницыТабличнойЧасти(ЭлементТабличнойЧасти)
	
	НайденныеТабличныеЧасти = ТабличныеЧастиОбъекта.НайтиСтроки(Новый Структура("ИмяНаФорме", ЭлементТабличнойЧасти.Имя));
	Если НайденныеТабличныеЧасти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабличнаяЧасть = НайденныеТабличныеЧасти[0];
	ДанныеТабличнойЧасти = ЭтотОбъект[ТабличнаяЧасть.ИмяНаФорме];
	ИмяСтраницы = ПрефиксСтраницы() + ТабличнаяЧасть.ИмяНаФорме;
	Элементы[ИмяСтраницы].Заголовок = ЗаголовокСтраницыТабличнойЧасти(ТабличнаяЧасть.Имя, ДанныеТабличнойЧасти);

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокСтраницыТабличнойЧастиНаСервере(Знач ТабличнаяЧасть)
	
	ДанныеТабличнойЧасти = ЭтотОбъект[ТабличнаяЧасть.ИмяНаФорме];
	ИмяСтраницы = ПрефиксСтраницы() + ТабличнаяЧасть.ИмяНаФорме;
	Элементы[ИмяСтраницы].Заголовок = ЗаголовокСтраницыТабличнойЧасти(ТабличнаяЧасть.Имя, ДанныеТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНомераСтрокТабличнойЧасти(Знач ИмяЭлемента)

	ТаблицаФормы = Элементы[ИмяЭлемента];
	ТабличнаяЧасть = ЭтотОбъект[ТаблицаФормы.ПутьКДанным];
	НомерСтроки = 1;
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		Строка.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЭтоРеквизитИмяПредопределенныхДанных(ТекущиеДанные)
	
	Возврат (ТекущиеДанные.Имя = "ИмяПредопределенныхДанных" И ТекущиеДанные.Категория = 0);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоРеквизитТолькоДляЧтения(Реквизит)
	
	РеквизитыДляЧтения = Новый Массив;
	РеквизитыДляЧтения.Добавить("Ссылка");
	РеквизитыДляЧтения.Добавить("Предопределенный");
	РеквизитыДляЧтения.Добавить("ДатаОбмена");
	РеквизитыДляЧтения.Добавить("ЭтоГруппа");
	
	Возврат (ТипЗнч(Реквизит) = Тип("ОписаниеСтандартногоРеквизита")
			И РеквизитыДляЧтения.Найти(Реквизит.Имя) <> Неопределено);
	
КонецФункции

&НаКлиенте
Функция ПолучитьФормуНавигатораПоКонфигурации(ОткрытьФорму = Ложь)

	ФормаНавигатора = Неопределено;
	Для Каждого ОткрытоеОкно Из ПолучитьОкна() Цикл
		Для Каждого Элем Из ОткрытоеОкно.Содержимое Цикл
			Если ТипЗнч(Элем) = УИ_ОбщегоНазначенияКлиентСервер.ТипУправляемойФормы() Тогда
				Если СтрЗаканчиваетсяНа(Элем.ИмяФормы, ".УИ_НавигаторПоМетаданным.Форма.Форма") Тогда
					ФормаНавигатора = Элем;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Если ФормаНавигатора <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ОткрытьФорму И ФормаНавигатора <> Неопределено Тогда
		Если Не ФормаНавигатора.Открыта() Тогда
			Попытка
				ФормаНавигатора.Открыть();
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;
		Возврат ФормаНавигатора;
	ИначеЕсли ОткрытьФорму И ФормаНавигатора = Неопределено Тогда
		УИ_ОбщегоНазначенияКлиент.ОткрытьНавигаторПоКонфигурации();
		ФормаНавигатора = ПолучитьФормуНавигатораПоКонфигурации(ОткрытьФорму);
		Возврат ФормаНавигатора;
	Иначе
		Возврат ФормаНавигатора;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ПутьКДаннымТекущегоЭлемента()

	Если ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		ТекПоле = ТекущийЭлемент.ТекущийЭлемент;
		Если ТипЗнч(ТекПоле) = Тип("ПолеФормы") Тогда
			Значение = ТекПоле.ПутьКДанным;
			Поз = СтрНайти(Значение, ".");
			Если Поз <> 0 Тогда
				Значение = Сред(Значение, Поз + 1);
				Если СтрНайти(Значение, ".") = 0 Тогда
					Возврат Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ПолеФормы") Тогда
		Возврат ТекущийЭлемент.ПутьКДанным;
	КонецЕсли;

	Возврат "";
	
КонецФункции

&НаСервере
Функция ЗаписатьОбъектВБазу(Знач КакНовый = Ложь, Знач СтрокаUUID = Неопределено)
	
	Если КакНовый Тогда
		Если Не УИ_ОбщегоНазначения.СсылкаСуществует(мОбъектСсылка) Тогда
			ОбъектМД = мОбъектСсылка.Метаданные();
			ОбъектДляЗаписи = СоздатьНовыйОбъект(ОбъектМД);
			Если ОбъектДляЗаписи = Неопределено Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось создать новый объект типа %1.'"),
										   ОбъектМД.ПолноеИмя());
				УИ_ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
		Иначе
			ОбъектДляЗаписи = мОбъектСсылка.Скопировать();
		КонецЕсли;

		Если СтрокаUUID <> Неопределено Тогда
			Если Не УстановитьСсылкуДляОбъекта(ОбъектДляЗаписи, СтрокаUUID) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ОбъектДляЗаписи = мОбъектСсылка.ПолучитьОбъект();
	КонецЕсли;

	Если ОбъектДляЗаписи = Неопределено Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить объект для записи (битая ссылка)!'"));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектМД = ОбъектДляЗаписи.Метаданные();
		
		ПараметрыОтбора = Новый Структура("Использование, ТолькоПросмотр", Истина, Ложь);
		СписокРеквизитовОбъекта = РеквизитыОбъекта.НайтиСтроки(ПараметрыОтбора);
		Для Каждого Реквизит Из СписокРеквизитовОбъекта Цикл
			ОбъектДляЗаписи[Реквизит.Имя] = Реквизит.Значение;
		КонецЦикла;

		Для Каждого ТабличнаяЧасть Из ТабличныеЧастиОбъекта Цикл
			Если Не ТабличнаяЧасть.Использование Тогда
				Продолжить;
			КонецЕсли;
			ТабличнаяЧастьОбъекта = ОбъектДляЗаписи[ТабличнаяЧасть.Имя];
			ТаблицаЗагрузки = РеквизитФормыВЗначение(ТабличнаяЧасть.ИмяНаФорме);
			ТабличнаяЧастьОбъекта.Загрузить(ТаблицаЗагрузки);
		КонецЦикла;

		ПараметрыЗаписи = УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект);
		Если УИ_ОбщегоНазначения.ЗаписатьОбъектВБазу(ОбъектДляЗаписи, ПараметрыЗаписи) Тогда
			мОбъектСсылка = ОбъектДляЗаписи.Ссылка;
			ЗаполнитьДанныеОбъектаСсылки();
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция СоздатьНовыйОбъект(ОбъектМетаданных)
	
	ИмяОбъекта = ОбъектМетаданных.Имя;
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		ЭтоИерархияГруппИЭлементов = ЭтоИерархияГруппИЭлементов(ОбъектМетаданных);

		ЭтоГруппа = Ложь;
		Если ЭтоИерархияГруппИЭлементов Тогда
			ПараметрыПоиска = Новый Структура("Категория, Имя", 0, "ЭтоГруппа");
			НайденныеРеквизиты = РеквизитыОбъекта.НайтиСтроки(ПараметрыПоиска);
			Для Каждого Реквизит Из НайденныеРеквизиты Цикл
				ЭтоГруппа = Реквизит.Значение;
			КонецЦикла;
		КонецЕсли;

		Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Менеджер = Справочники;
		Иначе
			Менеджер = ПланыВидовХарактеристик;
		КонецЕсли;

		НовыйОбъект = ?(ЭтоГруппа, Менеджер[ИмяОбъекта].СоздатьГруппу(), Менеджер[ИмяОбъекта].СоздатьЭлемент());

	ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = ПланыОбмена[ИмяОбъекта].СоздатьУзел();

	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = Документы[ИмяОбъекта].СоздатьДокумент();

	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = ПланыСчетов[ИмяОбъекта].СоздатьСчет();

	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = ПланыВидовРасчета[ИмяОбъекта].СоздатьВидРасчета();

	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = БизнесПроцессы[ИмяОбъекта].СоздатьБизнесПроцесс();

	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = Задачи[ИмяОбъекта].СоздатьЗадачу();

	Иначе
		НовыйОбъект = Неопределено;
	КонецЕсли;

	Возврат НовыйОбъект;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьИмяТипаПоЗначению(Знач Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Неопределено") Тогда
		ИмяТипа = "Неопределено";
	Иначе
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных <> Неопределено Тогда
			ИмяТипа = ОбъектМетаданных.ПолноеИмя();
		Иначе
			ИмяТипа = Строка(ТипЗначения);
		КонецЕсли;
	КонецЕсли;
	Возврат ИмяТипа;
	
КонецФункции

&НаСервере
Функция УдалитьОбъектНаСервере(Знач Ссылка)
	Попытка
		ОбъектДляУдаления = Ссылка.ПолучитьОбъект();
		Если ОбъектДляУдаления = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Если УИ_ОбщегоНазначения.ЗаписатьОбъектВБазу(ОбъектДляУдаления,
													 УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект),
													 "НепосредственноеУдаление") Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ШаблонОшибки = НСтр("ru = 'Ошибка при удалении объекта: 
							|%1'");
		ТекстОшибки = СтрШаблон(ШаблонОшибки, КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПровестиДокументПродолжение(РезультатВопроса, ДопПараметры = Неопределено) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьДокумент(мОбъектСсылка, Истина) Тогда
			ЗаполнитьДанныеОбъектаСсылки();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПроведениеПродолжение(РезультатВопроса, ДопПараметры = Неопределено) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьДокумент(мОбъектСсылка, Ложь) Тогда
			ЗаполнитьДанныеОбъектаСсылки();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаписатьДокумент(Знач Ссылка, Знач Проводить = Истина)
	Режим = ?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.ОтменаПроведения);
	ДокОбъект = Ссылка.ПолучитьОбъект();
	Возврат УИ_ОбщегоНазначения.ЗаписатьОбъектВБазу(ДокОбъект,
													УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект),
													,
													Режим);
КонецФункции

&НаСервере
Процедура ЗаписатьНаборЗаписейНаСервере()
	Если Не ПустаяСтрока(_ИмяНабораЗаписей) И ЗначениеЗаполнено(мОбъектСсылка) Тогда
		Менеджер = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(_ИмяНабораЗаписей);
		Если Менеджер <> Неопределено Тогда
			Набор = Менеджер.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(мОбъектСсылка);
			ПараметрыЗаписи = УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект);

			Если ПараметрыЗаписи.ЗаписьВРежимеЗагрузки Тогда
				Набор.ОбменДанными.Загрузка = Истина;
			КонецЕсли;

			Попытка
				РезультатТаблица = РеквизитФормыВЗначение("_НаборЗаписей");
				РезультатТаблица.ЗаполнитьЗначения(мОбъектСсылка, "Регистратор");
				Набор.Загрузить(РезультатТаблица);
				Набор.Записать(Истина);
				ОбновитьНаборЗаписейНаСервере();
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция вОписаниеТиповДляUUID(ОписаниеТипов)
	Если ОписаниеТипов.Типы().Количество() = 1 Тогда
		НовоеОписаниеТипов = Новый ОписаниеТипов(ОписаниеТипов, "Строка");
	Иначе
		НовоеОписаниеТипов = ОписаниеТипов;
	КонецЕсли;

	Возврат НовоеОписаниеТипов;
КонецФункции

&НаСервере
Процедура ПересчитатьИтогиПоКолонкам(Знач ИмяТабличнойЧасти)
	ТипЧисло = Тип("Число");
	РезультатТаблица = РеквизитФормыВЗначение(ИмяТабличнойЧасти);

	Если РезультатТаблица = Неопределено Тогда
		РезультатТаблица = Новый ТаблицаЗначений;
	КонецЕсли;

	Если ИмяТабличнойЧасти = "_НаборЗаписей" Тогда
		ИмяТабличнойЧасти = "_НаборЗаписей_";
		Для Каждого Колонка Из РезультатТаблица.Колонки Цикл
			Если Колонка.Имя <> "НомерСтроки" 
				И УИ_ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(Колонка.ТипЗначения, ТипЧисло) Тогда
				ЭФ = Элементы.Найти(ИмяТабличнойЧасти + Колонка.Имя);
				Если ЭФ <> Неопределено Тогда
					ЭФ.ТекстПодвала = Строка(РезультатТаблица.Итог(Колонка.Имя));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИмяБезПрефикса = Прав(ИмяТабличнойЧасти, СтрДлина(ИмяТабличнойЧасти) - СтрДлина(ПрефиксДляНовыхЭлементов));
		ПараметрыПоиска = Новый Структура("ИмяТабличнойЧасти", ИмяБезПрефикса);
		РеквизитыТабличнойЧасти = РеквизитыТабличныхЧастейОбъекта.НайтиСтроки(ПараметрыПоиска);
		Для Каждого Реквизит Из РеквизитыТабличнойЧасти Цикл
			Если Реквизит.ИспользоватьИтоги Тогда
				ЭФ = Элементы.Найти(Реквизит.ИмяНаФорме);
				Если ЭФ <> Неопределено Тогда
					ЭФ.ТекстПодвала = Строка(РезультатТаблица.Итог(Реквизит.Имя));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

