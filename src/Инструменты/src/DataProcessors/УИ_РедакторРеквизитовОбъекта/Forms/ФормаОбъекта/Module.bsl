&НаКлиенте
Процедура ВыборУдаленногоОбъектаЗавершение(Строка, ДополнительныеПараметры = Неопределено) Экспорт
	Если ЗначениеЗаполнено(Строка) Тогда
		Результат = СсылкаНаУдаленныйОбъект(Строка);
		Если Не Результат.Отказ Тогда
			мОбъектСсылка = Результат.Ссылка;
			ПриИзмененииОбъектаСсылки()
		ИначеЕсли ЗначениеЗаполнено(Результат.ПричинаОтказа) Тогда
			УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПричинаОтказа);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкаНаУдаленныйОбъект(Знач СтрокаУдаленногоОбъекта)

	Результат = Новый Структура("Отказ, ПричинаОтказа, Ссылка",
		Истина, НСтр("ru = 'Неправильный формат строки!'"), Неопределено);

	// Пример строки "<Объект не найден> (769:b1390050568b35ac11e6e46fdd2c3861)"
	СтрокаУдаленногоОбъекта = Сред(СтрокаУдаленногоОбъекта, СтрНайти(СтрокаУдаленногоОбъекта, "(") + 1);
	СтрокаУдаленногоОбъекта = СтрЗаменить(СтрокаУдаленногоОбъекта, ")", "");
	СтрокаУдаленногоОбъекта = СокрЛП(СтрокаУдаленногоОбъекта);

	ПозицияРазделителя = СтрНайти(СтрокаУдаленногоОбъекта, ":");

	ТипСсылкиСтрокой = Лев(СтрокаУдаленногоОбъекта, ПозицияРазделителя - 1);
	СтрокаUUID = Сред(СтрокаУдаленногоОбъекта, ПозицияРазделителя + 1);

	Попытка
		UUIDСтрокой = СтрШаблон("%1-%2-%3-%4-%5",
								Сред(СтрокаUUID, 25, 8),
								Сред(СтрокаUUID, 21, 4),
								Сред(СтрокаUUID, 17, 4),
								Сред(СтрокаUUID, 1, 4),
								Сред(СтрокаUUID, 5, 12));
		UUID = Новый УникальныйИдентификатор(UUIDСтрокой);

		РазделыМетаданных = Новый Массив();
		РазделыМетаданных.Добавить("Справочник");
		РазделыМетаданных.Добавить("Документ");
		РазделыМетаданных.Добавить("БизнесПроцесс");
		РазделыМетаданных.Добавить("Задача");
		РазделыМетаданных.Добавить("ПланСчетов");
		РазделыМетаданных.Добавить("ПланОбмена");
		РазделыМетаданных.Добавить("ПланВидовХарактеристик");
		РазделыМетаданных.Добавить("ПланВидовРасчета");

		Для Каждого РазделМетаданных Из РазделыМетаданных Цикл
			Для Каждого ОбъектМетаданных Из Метаданные[РазделМетаданных] Цикл
				ИмяМенеджера = СтрШаблон("%1.%2", РазделМетаданных, ОбъектМетаданных.Имя);
				МенеджерОбъекта = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяМенеджера);
				ПредставлениеСсылки = ЗначениеВСтрокуВнутр(МенеджерОбъекта.ПустаяСсылка());
				Поз1 = СтрНайти(ПредставлениеСсылки, ",", НаправлениеПоиска.СКонца);
				Поз2 = СтрНайти(ПредставлениеСсылки, ":");

				Если Сред(ПредставлениеСсылки, Поз1 + 1, Поз2 - Поз1 - 1) = ТипСсылкиСтрокой Тогда
					Результат.Ссылка = МенеджерОбъекта.ПолучитьСсылку(UUID);
					Результат.Отказ = Ложь;
					Возврат Результат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Результат.ПричинаОтказа = СтрШаблон("%1
											|%2",
											Результат.ПричинаОтказа,
											КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДатаСозданияГУИД(Знач ГУИДСтрокой)

	ПустаяДата = Дата(1, 1, 1);
	ПустойГУИД = Строка(УИ_ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	Если ГУИДСтрокой = ПустойГУИД
		Или Не УИ_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ГУИДСтрокой) Тогда
		Возврат ПустаяДата;
	КонецЕсли;
	
	Возврат УИ_ОбщегоНазначения.ДатаСозданияГУИД(ГУИДСтрокой);	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьОбъектСсылкаПоURL()
	
	ЗначениеОбъектаСсылка = УИ_ОбщегоНазначения.СсылкаНаОбъектПоНавигационнойСсылке(_URL);
	
	Если мОбъектСсылка <> ЗначениеОбъектаСсылка Тогда
		мОбъектСсылка = ЗначениеОбъектаСсылка;
		ЗаполнитьДанныеОбъектаСсылки();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОбъектаСсылки()
	
	Элементы.мОбъектСсылка.ОграничениеТипа = НовоеОписаниеТипов(ТипЗнч(мОбъектСсылка));
	НадоСоздаватьРеквизиты = (ТипЗнч(мОбъектСсылка) <> ТипЗнч(ОбъектСсылкаПредыдущий));
	
	Если НадоСоздаватьРеквизиты Тогда
		ЗаполнитьДеревоМетаданныхОбъекта();
		ОчиститьЗависимыеОбъекты();
	КонецЕсли;
	
	Если КонфигурацияДопускаетДопДвижения И НадоСоздаватьРеквизиты И мОбъектСсылка <> Неопределено Тогда
		РезультатПроверки = ОпределитьДополнительныеРегистрыДокумента(мОбъектСсылка);
		Элементы._ОткрытьРедакторДвиженийДоп.Видимость = РезультатПроверки.ЕстьДанные;
	КонецЕсли;
	
	ПерезаполнитьДанныеОбъекта(НадоСоздаватьРеквизиты);
	ОбъектСсылкаПредыдущий = мОбъектСсылка;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НовоеОписаниеТипов(Знач ТипЗначения)
	
	ТипВМассиве = УИ_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗначения);
	Возврат Новый ОписаниеТипов(ТипВМассиве);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоМетаданныхОбъекта()
	
	_ДеревоСвойств.ПолучитьЭлементы().Очистить();
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(мОбъектСсылка));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если УИ_ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхСправочника(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхДокумента(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаСчетов(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланОбмена(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаОбмена(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланВидовХарактеристик(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаВидовХарактеристик(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланВидовРасчета(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаВидовРасчета(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоБизнесПроцесс(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхБизнесПроцесса(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоЗадача(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхЗадачи(ОбъектМетаданных);
	КонецЕсли;
	
КонецПроцедуры

