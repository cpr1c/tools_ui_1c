&НаСервере
Процедура ЗаполнитьДеревоМетаданныхОбъекта()
	
	_ДеревоСвойств.ПолучитьЭлементы().Очистить();
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(мОбъектСсылка));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если УИ_ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхСправочника(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхДокумента(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаСчетов(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланОбмена(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаОбмена(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланВидовХарактеристик(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаВидовХарактеристик(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоПланВидовРасчета(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхПланаВидовРасчета(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоБизнесПроцесс(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхБизнесПроцесса(ОбъектМетаданных);
	ИначеЕсли УИ_ОбщегоНазначения.ЭтоЗадача(ОбъектМетаданных) Тогда
		ЗаполнитьДеревоМетаданныхЗадачи(ОбъектМетаданных);
	КонецЕсли;
	
КонецПроцедуры

