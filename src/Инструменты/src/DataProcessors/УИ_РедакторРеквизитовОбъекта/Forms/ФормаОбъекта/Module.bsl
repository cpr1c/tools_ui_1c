&НаСервере
Процедура вЗаполнитьВводитсяНаОсновании(ОбъектМД, УзелДЗ)
	вЗаполнитьСвойствоКоллекцияОбъекта(ОбъектМД, УзелДЗ, "ВводитсяНаОсновании");
КонецПроцедуры

&НаСервере
Процедура вЗаполнитьГруппуСвойствОбъекта(ОбъектМД, УзелДЗ, ИмяГруппы, Сортировать = Истина, ВыводитьКоличество = Ложь,
	ПроверитьНаВедущее = Ложь)
	Если ОбъектМД[ИмяГруппы].Количество() <> 0 Или ИмяГруппы = "Реквизиты" Тогда

		Таблица = вСформироватьТаблицуСвойств();
		Для Каждого Элем Из ОбъектМД[ИмяГруппы] Цикл
			Стр = Таблица.Добавить();
			Стр.Имя = Элем.Имя;
			Стр.Индексирование = вПолучитьСвойстовоИндексирование(Элем);
			Если ПроверитьНаВедущее И ПустаяСтрока(Стр.Индексирование) Тогда
				Если Элем.Ведущее Тогда
					Стр.Индексирование = "Ведущее";
				КонецЕсли;
			КонецЕсли;
			Стр.Синоним = Элем.Представление();
			Стр.Комментарий = Элем.Комментарий;
			Стр.ТипСтрокой = ПредставлениеОписанияТипа(Элем.Тип);
			Стр.Расширение = (Элем.РасширениеКонфигурации() <> Неопределено);
			Стр.ИзмененРасширениями = Элем.ЕстьИзмененияРасширениямиКонфигурации();
		КонецЦикла;

		Если ИмяГруппы = "Реквизиты" Тогда
			ДанныеПоОбщимРеквизитам = УИ_ОбщегоНазначения.ДанныеПоОбщимРеквизитам(АдресОбщихРеквизитов);
			ОбщиеРеквизиты = ДанныеПоОбщимРеквизитам.НайтиСтроки(Новый Структура("Объект", ОбъектМД.ПолноеИмя()));
			Для Каждого Элем Из ОбщиеРеквизиты Цикл
				НС = Таблица.Добавить();
				НС.Имя = Элем.Имя;
				НС.Синоним = Элем.Представление;
				НС.ТипСтрокой = ПредставлениеОписанияТипа(Элем.Тип);
				НС.ОбщийРеквизит = Истина;
				НС.Комментарий = Элем.Комментарий;
				НС.Индексирование = Элем.Индексирование;
			КонецЦикла;

			Если Таблица.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;

		Если Сортировать Тогда
			Таблица.Сортировать("Имя");
		КонецЕсли;

		РазделДЗ = УзелДЗ.ПолучитьЭлементы().Добавить();
		РазделДЗ.ВидУзла = 2;
		РазделДЗ.Имя = ИмяГруппы;
		Если ВыводитьКоличество Тогда
			РазделДЗ.Имя = РазделДЗ.Имя + " (" + Таблица.Количество() + ")";
		КонецЕсли;

		Для Каждого Стр Из Таблица Цикл
			ЗаполнитьЗначенияСвойств(РазделДЗ.ПолучитьЭлементы().Добавить(), Стр);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура вЗаполнитьРеквизитыОбъекта(ОбъектМД, УзелДЗ)
	вЗаполнитьГруппуСвойствОбъекта(ОбъектМД, УзелДЗ, "Реквизиты", Истина, Истина);
КонецПроцедуры

&НаКлиенте
Функция вПолучитьМассивТиповМД(Знач ТипСтрокой)
	ПростыеТипы = "/Булево/Дата/ДатаВремя/Строка/Число/ХранилищеЗначения/УникальныйИдентификатор/";
	Результат = Новый Массив;

	Для Каждого Элем Из СтрРазделить(ТипСтрокой, ",", Ложь) Цикл
		Если СтрНайти(ПростыеТипы, Элем) = 0 Тогда
			Если СтрНайти(Элем, "Строка(") = 0 И СтрНайти(Элем, "Число(") = 0 Тогда
				Результат.Добавить(Элем);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура вПоказатьСвойстваОбъектаМД(ВыбранныйЭлемент, ФормаНавигатора) Экспорт
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ПолноеИмя = ВыбранныйЭлемент.Значение;

		Попытка
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Операция", "ПоказатьСвойстваОбъектаМД");
			ПараметрыОткрытия.Вставить("Источник", "СДРОбъектУпр");
			ПараметрыОткрытия.Вставить("Параметры", Новый Структура("ПолноеИмя", ПолноеИмя));

			Результат = ФормаНавигатора.вОбработатьВнешнийВызов(ПараметрыОткрытия);
			Если Результат.Отказ Тогда
				УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПричинаОтказа);
			КонецЕсли;
		Исключение
			ТекстОшибки = НСтр("ru = '""Навигатор по метаданным"" не поддерживает внешние вызовы'");
			УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

