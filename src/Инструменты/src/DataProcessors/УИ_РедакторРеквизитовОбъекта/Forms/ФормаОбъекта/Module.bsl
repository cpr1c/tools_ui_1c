&НаКлиенте
Процедура ВставитьСсылкуНаОбъектЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СсылкаНаОбъектБазы = УИ_ОбщегоНазначения.СсылкаНаОбъектПоНавигационнойСсылке(Результат);
	Если СсылкаНаОбъектБазы <> Неопределено Тогда
		Если ДополнительныеПараметры.ДоступныеТипы.Типы().Количество() > 0 Тогда
			Если Не ДополнительныеПараметры.ДоступныеТипы.СодержитТип(ТипЗнч(СсылкаНаОбъектБазы)) Тогда
				ПредупреждениеБезОповещения(НСтр("ru = 'Неправильное значение для подстановки!'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДополнительныеПараметры.Таблица) Тогда
			ТекДанные = Элементы[ДополнительныеПараметры.Таблица].ТекущиеДанные;
			Если ТекДанные <> Неопределено Тогда
				ТекДанные[ДополнительныеПараметры.Имя] = СсылкаНаОбъектБазы;
			КонецЕсли;
		Иначе
			ЭтотОбъект[ДополнительныеПараметры.Имя] = СсылкаНаОбъектБазы;
			Если ДополнительныеПараметры.Имя = "мОбъектСсылка" Тогда
				КлючУникальности = мОбъектСсылка;
				ЗаполнитьДанныеОбъектаСсылки();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

