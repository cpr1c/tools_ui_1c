&НаКлиенте
Процедура _РазвернутьВсеУзлы(Команда)
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаМетаданные Тогда
		Для Каждого Элемент Из _ДеревоСвойств.ПолучитьЭлементы() Цикл
			Элементы._ДеревоСвойств.Развернуть(Элемент.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСсылкиНаОбъект Тогда
		Для Каждого Элемент Из _ЗависимыеОбъекты.ПолучитьЭлементы() Цикл
			Элементы._ЗависимыеОбъекты.Развернуть(Элемент.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура _СвернутьВсеУзлы(Команда)
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаМетаданные Тогда
		Для Каждого УзелДерева Из _ДеревоСвойств.ПолучитьЭлементы() Цикл
			Для Каждого Элемент Из УзелДерева.ПолучитьЭлементы() Цикл
				Элементы._ДеревоСвойств.Свернуть(Элемент.ПолучитьИдентификатор());
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСсылкиНаОбъект Тогда
		Для Каждого УзелДерева Из _ЗависимыеОбъекты.ПолучитьЭлементы() Цикл
			Для Каждого Элемент Из УзелДерева.ПолучитьЭлементы() Цикл
				Элементы._ЗависимыеОбъекты.Свернуть(Элемент.ПолучитьИдентификатор());
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

