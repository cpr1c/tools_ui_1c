Процедура ЗаполнитьПоОбразцуЗавершение(РезультатЗакрытия, ДопПарам = Неопределено) Экспорт
	Если РезультатЗакрытия <> Неопределено Тогда
		ПредыдущаяСсылка = мОбъектСсылка;
		мОбъектСсылка = РезультатЗакрытия;

		ИнформацияОПредопределенныхДанных = ИнформацияОПредопределенныхДанных();

		Попытка
			ЗаполнитьДанныеОбъектаСсылки();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;

		Если ИнформацияОПредопределенныхДанных.ЕстьДанные Тогда
			СтруктураПоиска = Новый Структура("Категория, Имя", 0, "ИмяПредопределенныхДанных");
			НайденныеСтроки = РеквизитыОбъекта.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Значение = ИнформацияОПредопределенныхДанных.Значение;
			КонецЕсли;
		КонецЕсли;

		мОбъектСсылка = ПредыдущаяСсылка;
		_UUID = мОбъектСсылка.УникальныйИдентификатор();
		_URL  = ПолучитьНавигационнуюСсылкуОбъекта(мОбъектСсылка);
		_ДатаСозданияОбъекта = ДатаСозданияГУИД(_UUID);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьСсылкуДляОбъекта(ОбъектЗаполнения, Знач UUIDСтрокой)

	Если УИ_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(UUIDСтрокой) Тогда
		УИД = Новый УникальныйИдентификатор(UUIDСтрокой);
		Если Не ЗначениеЗаполнено(УИД) Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Неправильное значение UUID'"));
		Возврат Ложь;
	КонецЕсли;

	ОбъектМетаданных = ОбъектЗаполнения.Метаданные();
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Попытка
		МенеджерОбъекта = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = '%1 - данный тип не обрабатывается!'"), ПолноеИмя);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;

	Попытка
		НоваяСсылка = МенеджерОбъекта.ПолучитьСсылку(УИД);
		ОбъектЗаполнения.УстановитьСсылкуНового(НоваяСсылка);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось установить ссылку для нового объекта!
									 |%1'"), ПредставлениеОшибки);
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПроверитьИмяПредопределенныхДанных()
	
	НайденныеСтроки = РеквизитыОбъекта.НайтиСтроки(Новый Структура("Категория, Имя", 0, "ИмяПредопределенныхДанных"));
	Если НайденныеСтроки.Количество() <> 0 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
		НайденнаяСтрока.Значение = СокрЛП(НайденнаяСтрока.Значение);

		Если Не ПустаяСтрока(НайденнаяСтрока.Значение) Тогда
			ПроверочнаяСтруктура = Новый Структура;
			Попытка
				ПроверочнаяСтруктура.Вставить(НайденнаяСтрока.Значение, 1);
			Исключение
				Возврат Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ИнформацияОПредопределенныхДанных()
	
	Результат = Новый Структура("ЕстьДанные, ЕстьИзменения, НекорректноеИмя", Ложь, Ложь, Ложь);
	Результат.Вставить("Значение");

	НайденныеСтроки = РеквизитыОбъекта.НайтиСтроки(Новый Структура("Категория, Имя", 0, "ИмяПредопределенныхДанных"));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат.ЕстьДанные = Истина;
		Если Не ПроверитьИмяПредопределенныхДанных() Тогда
			Результат.НекорректноеИмя = Истина;
		КонецЕсли;

		Результат.Значение = НайденныеСтроки[0].Значение;
		Если НайденныеСтроки[0].Значение <> _ИмяПредопределенныхДанных Тогда
			Результат.ЕстьИзменения = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

