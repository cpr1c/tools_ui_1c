&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтруктуруНастроек()
	Настройка = Новый Структура;
	Настройка.Вставить("ПоказыватьИтогиПоЧисловымКолонкам", Ложь);
	Настройка.Вставить("ПоказыватьИтогиПоЧисловымКолонкамРД", Ложь);
	Настройка.Вставить("ИспользоватьЖирныйШрифтДляИтогов", Истина);
	Настройка.Вставить("ПоказыватьНомерСтрокиТЧ", Истина);
	Настройка.Вставить("СкрыватьПустыеТабличныеЧасти", Ложь);
	Настройка.Вставить("ОсобыйРежимРаботыСНаборомЗаписейРБ", Истина);
	Возврат Настройка;
КонецФункции

