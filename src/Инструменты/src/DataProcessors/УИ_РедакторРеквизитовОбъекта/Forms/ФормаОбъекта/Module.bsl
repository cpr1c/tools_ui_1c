&НаСервереБезКонтекста
Функция ОпределитьДополнительныеРегистрыДокумента(Знач СсылкаНаДокумент)

	ДополнительныеРегистры = Новый Соответствие;
	Результат = Новый Структура;
	Результат.Вставить("ЕстьДанные", Ложь);
	Результат.Вставить("ДополнительныеРегистры", ДополнительныеРегистры);

	Если СсылкаНаДокумент = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	МетаданныеРегистратораРасчетов = Метаданные.Документы.Найти("РегистраторРасчетов");
	Если МетаданныеРегистратораРасчетов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	Если Не УИ_ОбщегоНазначения.ЭтоДокумент(МетаданныеДокумента)
		 Или МетаданныеДокумента = МетаданныеРегистратораРасчетов Тогда
		Возврат Результат;
	КонецЕсли;

	ТипДокумента = ТипЗнч(СсылкаНаДокумент);
	Для Каждого МетаданныеРегистра Из МетаданныеРегистратораРасчетов.Движения Цикл
		РеквизитДокументРегистратор = МетаданныеРегистра.Реквизиты.Найти("ДокументРегистратор");
		Если РеквизитДокументРегистратор <> Неопределено Тогда
			Если РеквизитДокументРегистратор.Тип.СодержитТип(ТипДокумента) Тогда
				ДополнительныеРегистры[МетаданныеРегистра.ПолноеИмя()] = МетаданныеРегистра.Представление();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Результат.ЕстьДанные = (ДополнительныеРегистры.Количество() > 0);

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПодготовитьТабличныеЧастиОбъекта(МассивКСозданию, МассивКУдалению, ТабличныеЧастиПредыдущие, ТипыДанныхРеквизитов)

	ТабличныеЧастиОбъекта.Очистить();
	РеквизитыТабличныхЧастейОбъекта.Очистить();
	Если ОбъектСсылкаПредыдущий <> Неопределено Тогда
		Для Каждого ИмяНаФорме Из ТабличныеЧастиПредыдущие Цикл
			МассивКУдалению.Добавить(ИмяНаФорме);
		КонецЦикла;
	КонецЕсли;

	Если мОбъектСсылка <> Неопределено Тогда
		ОбъектМетаданных = мОбъектСсылка.Метаданные();
		ВидыТабличныхЧастейОбъекта = ВидыТабличныхЧастейОбъекта(ОбъектМетаданных);
		Для Каждого ВидТабличнойЧасти Из ВидыТабличныхЧастейОбъекта Цикл
			Для Каждого ТабличнаяЧасть Из ВидТабличнойЧасти Цикл
				
				ЭтоСтандартнаяТабличнаяЧасть = (ТипЗнч(ТабличнаяЧасть) = Тип("ОписаниеСтандартнойТабличнойЧасти"));
				НоваяТабличнаяЧасть = ТабличныеЧастиОбъекта.Добавить();
				НоваяТабличнаяЧасть.Имя = ТабличнаяЧасть.Имя;
				НоваяТабличнаяЧасть.ИмяНаФорме = ПрефиксДляНовыхЭлементов + ТабличнаяЧасть.Имя;
				НоваяТабличнаяЧасть.Представление = ТабличнаяЧасть.Представление();
				НоваяТабличнаяЧасть.Категория = ?(ЭтоСтандартнаяТабличнаяЧасть, 0, 1);
				
				НовыйРеквизит = УИ_РаботаСФормами.ОписаниеРеквизитаФормы();
				НовыйРеквизит.Имя = НоваяТабличнаяЧасть.ИмяНаФорме;
				НовыйРеквизит.Заголовок = НоваяТабличнаяЧасть.Представление;
				НовыйРеквизит.Тип = Новый ОписаниеТипов("ТаблицаЗначений");
				НовыйРеквизит.СохраняемыеДанные = Истина;
				
				УИ_РаботаСФормами.ДобавитьРеквизитФормы(МассивКСозданию, НовыйРеквизит);
				
				ВидыРеквизитовТабличнойЧасти = ВидыРеквизитовТабличнойЧасти(ТабличнаяЧасть);
				Для Каждого ВидРеквизита Из ВидыРеквизитовТабличнойЧасти Цикл
					Для Каждого Реквизит Из ВидРеквизита Цикл
						НоваяСтрока = ДобавитьРеквизитТабличнойЧастиОбъекта(НоваяТабличнаяЧасть, Реквизит);
						НовыйРеквизит = УИ_РаботаСФормами.ОписаниеРеквизитаФормы();
						НовыйРеквизит.Имя = НоваяСтрока.Имя;
						НовыйРеквизит.Заголовок = НоваяСтрока.Представление;
						НовыйРеквизит.ПутьКДанным = НоваяТабличнаяЧасть.ИмяНаФорме;
						Если НоваяСтрока.Тип.СодержитТип(ТипыДанныхРеквизитов.ХранилищеЗначения) Тогда
							НовыйРеквизит.Тип = Новый ОписаниеТипов;
						Иначе
							НовыйРеквизит.Тип = НоваяСтрока.Тип;
						КонецЕсли;
						УИ_РаботаСФормами.ДобавитьРеквизитФормы(МассивКСозданию, НовыйРеквизит);
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		ТабличныеЧастиОбъекта.Сортировать("Категория, Представление");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДобавитьРеквизитТабличнойЧастиОбъекта(ТабличнаяЧасть, Реквизит)
	НоваяСтрока = РеквизитыТабличныхЧастейОбъекта.Добавить();
	НоваяСтрока.Имя = Реквизит.Имя;
	НоваяСтрока.ИмяНаФорме = ТабличнаяЧасть.ИмяНаФорме + Реквизит.Имя;
	НоваяСтрока.ИмяТабличнойЧасти = ТабличнаяЧасть.Имя;
	НоваяСтрока.Категория = ?(ТипЗнч(Реквизит) = Тип("ОписаниеСтандартногоРеквизита"), 0, 1);
	НоваяСтрока.Представление = Реквизит.Представление();
	НоваяСтрока.Тип = Реквизит.Тип;

	ЭтоНомерСтроки = (НоваяСтрока.Категория = 0 И НоваяСтрока.Имя = "НомерСтроки");
	ЭтоПредопределенный = (НоваяСтрока.Категория = 0 И НоваяСтрока.Имя = "Предопределенный");
	ЭтоТипЧисло = УИ_ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(Реквизит.Тип, Тип("Число"));
	НоваяСтрока.ИспользоватьИтоги =  Не ЭтоНомерСтроки И ЭтоТипЧисло;
	НоваяСтрока.ТолькоПросмотр = ЭтоНомерСтроки Или ЭтоПредопределенный;
	Если НоваяСтрока.Категория <> 0 Тогда
		НоваяСтрока.ВыборГруппИЭлементов = Реквизит.ВыборГруппИЭлементов;
	КонецЕсли;
	
	Возврат НоваяСтрока;
КонецФункции

// Возвращает табличные части объект метаданных.
// 
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданныхПланСчетов, ОбъектМетаданныхПланВидовХарактеристик, ОбъектМетаданныхПланВидовРасчета, ОбъектМетаданныхСправочник, ОбъектМетаданныхЗадача, ОбъектМетаданныхПланОбмена, ОбъектМетаданныхБизнесПроцесс, ОбъектМетаданныхДокумент - Объект метаданных
// 
// Возвращаемое значение:
//  Массив из КоллекцияОбъектовМетаданных, ОписанияСтандартныхТабличныхЧастей - Виды табличных частей объекта
&НаСервереБезКонтекста
Функция ВидыТабличныхЧастейОбъекта(ОбъектМетаданных)
	
	Результат = Новый Массив;
	Если ЕстьТабличныеЧасти(ОбъектМетаданных) Тогда
		Результат.Добавить(ОбъектМетаданных.ТабличныеЧасти);
	КонецЕсли;
	Если ЕстьСтандартныеТабличныеЧасти(ОбъектМетаданных) Тогда
		Результат.Добавить(ОбъектМетаданных.СтандартныеТабличныеЧасти);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Возвращает реквизиты табличной части объект метаданных.
// 
// Параметры:
//  ТабличнаяЧасть - КоллекцияОбъектовМетаданных, ОписанияСтандартныхТабличныхЧастей - Табличная часть
// 
// Возвращаемое значение:
//  Массив из КоллекцияОбъектовМетаданных, ОписанияСтандартныхРеквизитов - Виды табличных частей объекта
&НаСервереБезКонтекста
Функция ВидыРеквизитовТабличнойЧасти(ТабличнаяЧасть)
	ЭтоСтандартнаяТабличнаяЧасть = (ТипЗнч(ТабличнаяЧасть) = Тип("ОписаниеСтандартнойТабличнойЧасти"));
	Результат = Новый Массив;
	Результат.Добавить(ТабличнаяЧасть.СтандартныеРеквизиты);
	Если Не ЭтоСтандартнаяТабличнаяЧасть Тогда
		Результат.Добавить(ТабличнаяЧасть.Реквизиты);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГруппыИЭлементыПоИспользованию(ОписаниеИспользования)

	Если ОписаниеИспользования = ИспользованиеГруппИЭлементов.Группы Тогда
		Результат = ГруппыИЭлементы.Группы;
	ИначеЕсли ОписаниеИспользования = ИспользованиеГруппИЭлементов.ГруппыИЭлементы Тогда
		Результат = ГруппыИЭлементы.ГруппыИЭлементы;
	ИначеЕсли ОписаниеИспользования = ИспользованиеГруппИЭлементов.Элементы Тогда
		Результат = ГруппыИЭлементы.Элементы;
	Иначе
		Результат = ГруппыИЭлементы.Авто;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПодготовитьСтраницуДвижений(ПересоздатьРеквизиты)
	
	_ИмяНабораЗаписей = "";
	ВидимостьРазделаДвижения = Ложь;
	ОбновитьНаборЗаписейНаСервере();

	Если мОбъектСсылка <> Неопределено Тогда
		ОбъектМетаданных = мОбъектСсылка.Метаданные();

		Если УИ_ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных) Тогда
			Если ОбъектМетаданных.Движения.Количество() > 0 Тогда
				ВидимостьРазделаДвижения = Истина;
				Если ПересоздатьРеквизиты Тогда
					_ПроведениеРазрешено = (ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить);

					СписокНабораЗаписей = Элементы._ИмяНабораЗаписей.СписокВыбора;
					СписокНабораЗаписей.Очистить();
					КэшИменРегистров = Новый Соответствие;
					Для Каждого ОбъектРегистрМД Из ОбъектМетаданных.Движения Цикл
						ПолноеИмяРегистра = ОбъектРегистрМД.ПолноеИмя();
						Если КэшИменРегистров[ПолноеИмяРегистра] = Неопределено Тогда
								// Защита от кривых конфигураций
							КэшИменРегистров[ПолноеИмяРегистра] = 1;
							СписокНабораЗаписей.Добавить(ПолноеИмяРегистра, ОбъектРегистрМД.Представление());
						КонецЕсли;
					КонецЦикла;
					СписокНабораЗаписей.СортироватьПоЗначению();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Элементы.СтраницаДвиженияДокумента.Видимость = ВидимостьРазделаДвижения;

КонецПроцедуры

