Процедура ЗаполнитьИменаПредопределенныхДанных(ОбъектМетаданных)
	
	ЭтоПланСчетов = УИ_ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных);
	ЭтоПланВидовРасчета = УИ_ОбщегоНазначения.ЭтоПланВидовРасчета(ОбъектМетаданных);
	ЭтоПланВидовХарактеристик = УИ_ОбщегоНазначения.ЭтоПланВидовХарактеристик(ОбъектМетаданных);
	ЭтоСправочник = УИ_ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных);
	Если ЭтоПланСчетов Или ЭтоПланВидовРасчета Или ЭтоПланВидовХарактеристик Или ЭтоСправочник Тогда
		ЗначенияПредопределенных = Новый Массив(ОбъектМетаданных.ПолучитьИменаПредопределенных());
		ИменаПредопределенныхДанных.ЗагрузитьЗначения(ЗначенияПредопределенных);
	Иначе
		ИменаПредопределенныхДанных.Очистить();
	КонецЕсли;
	
