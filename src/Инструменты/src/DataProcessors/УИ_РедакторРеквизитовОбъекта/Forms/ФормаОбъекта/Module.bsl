	УзелДЗ = _ДеревоСвойств.ПолучитьЭлементы().Добавить();
	УзелДЗ.ВидУзла = 1;
	УзелДЗ.Имя = ОбъектМетаданных.Имя;
	УзелДЗ.Синоним = ОбъектМетаданных.Представление();
	УзелДЗ.Комментарий = ОбъектМетаданных.Комментарий;
	УзелДЗ.ТипСтрокой = ОбъектМетаданных.ПолноеИмя();
	УзелДЗ.Расширение = (ОбъектМетаданных.РасширениеКонфигурации() <> Неопределено);
	УзелДЗ.ИзмененРасширениями = ОбъектМетаданных.ЕстьИзмененияРасширениямиКонфигурации();
	
	ПереченьСвойств = "ИспользоватьСтандартныеКоманды, ДлинаКода, ДлинаНаименования, ДопустимаяДлинаКода, РежимУправленияБлокировкойДанных";
	вЗаполнитьСвойстваОбъекта(ОбъектМетаданных, УзелДЗ, ПереченьСвойств);
	вЗаполнитьСтандартныеРеквизитыОбъекта(ОбъектМетаданных, УзелДЗ);
	вЗаполнитьРеквизитыОбъекта(ОбъектМетаданных, УзелДЗ);
	вЗаполнитьТабличныеЧастиОбъекта(ОбъектМетаданных, УзелДЗ);
	вЗаполнитьВводитсяНаОсновании(ОбъектМетаданных, УзелДЗ);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьЗависимыеОбъекты()
	Элементы.ДекорацияСсылкиНаОбъект.Заголовок = "Ссылки на объекты конфигурации";
	_ЗависимыеОбъекты.ПолучитьЭлементы().Очистить();
	_ГдеНайдено = "";
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьДополнительныеРегистрыДокумента(Знач СсылкаНаДокумент)
	
	ДополнительныеРегистры = Новый Соответствие;
	Результат = Новый Структура;
	Результат.Вставить("ЕстьДанные", Ложь);
	Результат.Вставить("ДополнительныеРегистры", ДополнительныеРегистры);
	
	МетаданныеРегистратораРасчетов = Метаданные.Документы.Найти("РегистраторРасчетов");
	Если МетаданныеРегистратораРасчетов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	Если Не УИ_ОбщегоНазначения.ЭтоДокумент(МетаданныеДокумента)
		Или МетаданныеДокумента = МетаданныеРегистратораРасчетов Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(СсылкаНаДокумент);
	Для каждого МетаданныеРегистра из МетаданныеРегистратораРасчетов.Движения Цикл
		РеквизитДокументРегистратор = МетаданныеРегистра.Реквизиты.Найти("ДокументРегистратор");
		Если РеквизитДокументРегистратор <> Неопределено Тогда
			Если РеквизитДокументРегистратор.Тип.СодержитТип(ТипДокумента) Тогда
				ДополнительныеРегистры[МетаданныеРегистра.ПолноеИмя()] = МетаданныеРегистра.Представление();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат.ЕстьДанные = (ДополнительныеРегистры.Количество() > 0);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПодготовитьТабличныеЧастиОбъекта(МассивКСозданию, МассивКУдалению, ТипыДанныхРеквизитов)

	Если ОбъектСсылкаПредыдущий <> Неопределено Тогда
		ОбъектМетаданныхПредыдущий = ОбъектСсылкаПредыдущий.Метаданные();
		ВидыТабличныхЧастейОбъекта = ВидыТабличныхЧастейОбъекта(ОбъектМетаданныхПредыдущий);
		Для Каждого ВидТабличнойЧасти Из ВидыТабличныхЧастейОбъекта Цикл
			Для Каждого ТабличнаяЧасть Из ВидТабличнойЧасти Цикл
				ИмяТаб = ПрефиксДляНовыхЭлементов + ТабличнаяЧасть.Имя;
				МассивКУдалению.Добавить(ИмяТаб);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если мОбъектСсылка <> Неопределено Тогда
		ОбъектМетаданных = мОбъектСсылка.Метаданные();
		ВидыТабличныхЧастейОбъекта = ВидыТабличныхЧастейОбъекта(ОбъектМетаданных);
		Для Каждого ВидТабличнойЧасти Из ВидыТабличныхЧастейОбъекта Цикл
			Для Каждого ТабличнаяЧасть Из ВидТабличнойЧасти Цикл
				ИмяТаблицы = ПрефиксДляНовыхЭлементов + ТабличнаяЧасть.Имя;
				НовыйРеквизит = УИ_РаботаСФормами.ОписаниеРеквизитаФормы();
				НовыйРеквизит.Имя = ИмяТаблицы;
				НовыйРеквизит.Заголовок = ТабличнаяЧасть.Представление();
				НовыйРеквизит.Тип = Новый ОписаниеТипов("ТаблицаЗначений");
				УИ_РаботаСФормами.ДобавитьРеквизитФормы(МассивКСозданию, НовыйРеквизит);
				
				Для Каждого Реквизит Из ТабличнаяЧасть.СтандартныеРеквизиты Цикл
					НовыйРеквизит = УИ_РаботаСФормами.ОписаниеРеквизитаФормы();
					НовыйРеквизит.Имя = Реквизит.Имя;
					НовыйРеквизит.Заголовок = Реквизит.Представление();
					НовыйРеквизит.ПутьКДанным = ИмяТаблицы;
					НовыйРеквизит.Тип = Реквизит.Тип;
					УИ_РаботаСФормами.ДобавитьРеквизитФормы(МассивКСозданию, НовыйРеквизит);
				КонецЦикла;
	
				Если ТипЗнч(ТабличнаяЧасть) = Тип("ОбъектМетаданных") Тогда
					Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
						НовыйРеквизит = УИ_РаботаСФормами.ОписаниеРеквизитаФормы();
						НовыйРеквизит.Имя = Реквизит.Имя;
						НовыйРеквизит.Заголовок = Реквизит.Представление();
						НовыйРеквизит.ПутьКДанным = ИмяТаблицы;
						НовыйРеквизит.Тип = Реквизит.Тип;
						УИ_РаботаСФормами.ДобавитьРеквизитФормы(МассивКСозданию, НовыйРеквизит);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Возвращает табличные части объект метаданных.
// 
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданныхПланСчетов, ОбъектМетаданныхПланВидовХарактеристик, ОбъектМетаданныхПланВидовРасчета, ОбъектМетаданныхСправочник, ОбъектМетаданныхЗадача, ОбъектМетаданныхПланОбмена, ОбъектМетаданныхБизнесПроцесс, ОбъектМетаданныхДокумент - Объект метаданных
// 
// Возвращаемое значение:
//  Массив из КоллекцияОбъектовМетаданных, ОписанияСтандартныхТабличныхЧастей - Виды табличных частей объекта
&НаСервереБезКонтекста
Функция ВидыТабличныхЧастейОбъекта(ОбъектМетаданных)
	
	Результат = Новый Массив;
	Если ЕстьТабличныеЧасти(ОбъектМетаданных) Тогда
		Результат.Добавить(ОбъектМетаданных.ТабличныеЧасти);
	КонецЕсли;
	Если ЕстьСтандартныеТабличныеЧасти(ОбъектМетаданных) Тогда
		Результат.Добавить(ОбъектМетаданных.СтандартныеТабличныеЧасти);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Возвращает табличные части объект метаданных.
// 
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданныхПланСчетов, ОбъектМетаданныхПланВидовХарактеристик, ОбъектМетаданныхПланВидовРасчета, ОбъектМетаданныхСправочник, ОбъектМетаданныхЗадача, ОбъектМетаданныхПланОбмена, ОбъектМетаданныхБизнесПроцесс, ОбъектМетаданныхДокумент - Объект метаданных
// 
// Возвращаемое значение:
//  Массив из КоллекцияОбъектовМетаданных, ОписанияСтандартныхТабличныхЧастей - Виды табличных частей объекта
&НаСервереБезКонтекста
Функция ТабличныеЧастиОбъекта(ОбъектМетаданных)
	
	Результат = Новый Массив;
	Если ЕстьТабличныеЧасти(ОбъектМетаданных) Тогда
		Результат.Добавить(ОбъектМетаданных.ТабличныеЧасти);
	КонецЕсли;
	Если ЕстьСтандартныеТабличныеЧасти(ОбъектМетаданных) Тогда
		Результат.Добавить(ОбъектМетаданных.СтандартныеТабличныеЧасти);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции


&НаСервере
Процедура ПодготовитьСтраницуДвижений()
	
	_ИмяНабораЗаписей = "";
	ВидимостьРазделаДвижения = Ложь;
	ОбновитьНаборЗаписейНаСервере();

	Если мОбъектСсылка <> Неопределено Тогда
		ОбъектМетаданных = мОбъектСсылка.Метаданные();

		Если УИ_ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных) Тогда
			Если ОбъектМетаданных.Движения.Количество() > 0 Тогда
				ВидимостьРазделаДвижения = Истина;
				_ПроведениеРазрешено = (ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить);

				СписокНабораЗаписей = Элементы._ИмяНабораЗаписей.СписокВыбора;
				СписокНабораЗаписей.Очистить();
				КэшИменРегистров = Новый Соответствие;
				Для Каждого ОбъектРегистрМД Из ОбъектМетаданных.Движения Цикл
					ПолноеИмяРегистра = ОбъектРегистрМД.ПолноеИмя();
					Если КэшИменРегистров[ПолноеИмяРегистра] = Неопределено Тогда
							//!!! защита от кривых конфигураций
						КэшИменРегистров[ПолноеИмяРегистра] = 1;
						СписокНабораЗаписей.Добавить(ПолноеИмяРегистра, ОбъектРегистрМД.Представление());
					КонецЕсли;
				КонецЦикла;
				СписокНабораЗаписей.СортироватьПоЗначению();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Элементы.СтраницаДвиженияДокумента.Видимость = ВидимостьРазделаДвижения;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПрефиксСтраницы()
	Возврат "Страница";
КонецФункции

&НаСервере
Процедура ЗаполнитьИменаПредопределенныхДанных(ОбъектМетаданных)
	
	ЭтоПланСчетов = УИ_ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных);
	ЭтоПланВидовРасчета = УИ_ОбщегоНазначения.ЭтоПланВидовРасчета(ОбъектМетаданных);
	ЭтоПланВидовХарактеристик = УИ_ОбщегоНазначения.ЭтоПланВидовХарактеристик(ОбъектМетаданных);
	ЭтоСправочник = УИ_ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных);
	Если ЭтоПланСчетов Или ЭтоПланВидовРасчета Или ЭтоПланВидовХарактеристик Или ЭтоСправочник Тогда
		ЗначенияПредопределенных = Новый Массив(ОбъектМетаданных.ПолучитьИменаПредопределенных());
		ИменаПредопределенныхДанных.ЗагрузитьЗначения(ЗначенияПредопределенных);
	Иначе
		ИменаПредопределенныхДанных.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьЭлементыТабличныхЧастейОбъекта(ТипыДанныхРеквизитов)
	
	ПрефиксСтраницы = ПрефиксСтраницы();
	Если ОбъектСсылкаПредыдущий <> Неопределено Тогда
		ОбъектМетаданныхПредыдущий = ОбъектСсылкаПредыдущий.Метаданные();
		ВидыТабличныхЧастейОбъекта = ВидыТабличныхЧастейОбъекта(ОбъектМетаданныхПредыдущий);
		Для Каждого ВидТабличнойЧасти Из ВидыТабличныхЧастейОбъекта Цикл
			Для Каждого ТабличнаяЧасть Из ВидТабличнойЧасти Цикл
				ИмяСтраницы = ПрефиксСтраницы + ПрефиксДляНовыхЭлементов + ТабличнаяЧасть.Имя;
				Элементы.Удалить(Элементы.Найти(ИмяСтраницы));
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если мОбъектСсылка <> Неопределено Тогда
		ОбъектМетаданных = мОбъектСсылка.Метаданные();
		ВидыТабличныхЧастейОбъекта = ВидыТабличныхЧастейОбъекта(ОбъектМетаданных);
		_СписокТабличныхЧастей = Новый СписокЗначений;
		СписокТабличныхЧастей = Новый СписокЗначений;
		Для Каждого ВидТабличнойЧасти Из ВидыТабличныхЧастейОбъекта Цикл
			Для Каждого ТабличнаяЧасть Из ВидТабличнойЧасти Цикл
				СписокТабличныхЧастей.Добавить(ТабличнаяЧасть, ТабличнаяЧасть.Представление());
				_СписокТабличныхЧастей.Добавить(ТабличнаяЧасть.Имя);
			КонецЦикла;
		КонецЦикла;
		СписокТабличныхЧастей.СортироватьПоПредставлению();
		
		ИмяРеквизитаНомерСтроки = "НомерСтроки";
		ИмяРеквизитаПредопределенный = "Предопределенный";
		ШаблонПутиКРеквизиту = "%1.%2";
		Для Каждого Элемент Из СписокТабличныхЧастей Цикл
			ТабличнаяЧасть = Элемент.Значение;
			ИмяТаблицы = ПрефиксДляНовыхЭлементов + ТабличнаяЧасть.Имя;
			ИмяСтраницы = ПрефиксСтраницы + ИмяТаблицы;

			ОписаниеСтраницы = УИ_РаботаСФормами.НовыйОписаниеГруппыФормы();
			ОписаниеСтраницы.Имя = ИмяСтраницы;
			ОписаниеСтраницы.Родитель = Элементы.СтраницыТабличныхЧастейОбъекта;
			ОписаниеСтраницы.ОтображатьЗаголовок = Истина;
			ОписаниеСтраницы.Вид = ВидГруппыФормы.Страница;
			ОписаниеСтраницы.Заголовок = ТабличнаяЧасть.Имя;
			НоваяСтраница = УИ_РаботаСФормами.СоздатьГруппуПоОписанию(ЭтотОбъект, ОписаниеСтраницы);

			ШаблонОформленияЭФ = Элементы.ДекорацияРеквизитыОбъекта;
			ЭФ = Элементы.Добавить(СтрШаблон("Надпись_%1", ИмяТаблицы), Тип("ДекорацияФормы"), НоваяСтраница);
			ЭФ.Вид = ВидДекорацииФормы.Надпись;
			ЭФ.ЦветТекста = ШаблонОформленияЭФ.ЦветТекста;
			ЭФ.Шрифт = ШаблонОформленияЭФ.Шрифт;
			ЭФ.АвтоМаксимальнаяШирина = Ложь;
			ЭФ.РастягиватьПоГоризонтали = Истина;
			ЭФ.Заголовок = СтрШаблон("%1: %2", ТабличнаяЧасть.Имя, Элемент.Представление);

			НоваяТаблица = Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), НоваяСтраница);
			НоваяТаблица.ПутьКДанным = ИмяТаблицы;
			НоваяТаблица.Подвал = ПоказыватьИтогиПоЧисловымКолонкам;

			Для Каждого Реквизит Из ТабличнаяЧасть.СтандартныеРеквизиты Цикл
				НоваяКолонка = Элементы.Добавить(ИмяТаблицы + Реквизит.Имя, Тип("ПолеФормы"), НоваяТаблица);
				НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
				НоваяКолонка.ПутьКДанным = СтрШаблон(ШаблонПутиКРеквизиту, ИмяТаблицы, Реквизит.Имя);
				НоваяКолонка.КнопкаОчистки = Истина;
				НоваяКолонка.КнопкаВыбора = Истина;
				Если Не Реквизит.Тип.СодержитТип(ТипыДанныхРеквизитов.ХранилищеЗначения) Тогда
					НоваяКолонка.ДоступныеТипы = Реквизит.Тип;
				КонецЕсли;
				НоваяКолонка.УстановитьДействие("НачалоВыбора", "Подключаемый_ТабличнаяЧастьРеквизитНачалоВыбора");
				НоваяКолонка.УстановитьДействие("Очистка", "Подключаемый_ТабличнаяЧастьРеквизитОчистка");
				ЗаполнениеПодвалаЧисловойКолонки(ИмяТаблицы, НоваяКолонка, Реквизит);
			КонецЦикла;
			
			КолонкаНомерСтроки = Элементы[ИмяТаблицы + ИмяРеквизитаНомерСтроки];
			КолонкаНомерСтроки.АвтоМаксимальнаяШирина = Ложь;
			КолонкаНомерСтроки.МаксимальнаяШирина = 5;
			КолонкаНомерСтроки.Заголовок = НСтр("ru = 'N'");
			КолонкаНомерСтроки.ТолькоПросмотр = Истина;
			Если НоваяТаблица.ПодчиненныеЭлементы.Количество() > 0
				И НоваяТаблица.ПодчиненныеЭлементы[0] <> КолонкаНомерСтроки Тогда
				Элементы.Переместить(КолонкаНомерСтроки, НоваяТаблица, НоваяТаблица.ПодчиненныеЭлементы[0]);
			КонецЕсли;
			КолонкаПредопределенный = Элементы.Найти(ИмяРеквизитаПредопределенный);
			Если КолонкаПредопределенный <> Неопределено Тогда
				КолонкаПредопределенный.ТолькоПросмотр = Истина;
			КонецЕсли;

			Если ТипЗнч(ТабличнаяЧасть) = Тип("ОбъектМетаданных") Тогда
				Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
					НоваяКолонка = Элементы.Добавить(ИмяТаблицы + Реквизит.Имя, Тип("ПолеФормы"), НоваяТаблица);
					НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
					НоваяКолонка.ПутьКДанным = СтрШаблон(ШаблонПутиКРеквизиту, ИмяТаблицы, Реквизит.Имя);
					НоваяКолонка.КнопкаОчистки = Истина;
					НоваяКолонка.КнопкаВыбора = Истина;
					Если Не Реквизит.Тип.СодержитТип(ТипыДанныхРеквизитов.ХранилищеЗначения) Тогда
						НоваяКолонка.ДоступныеТипы = Реквизит.Тип;
					КонецЕсли;
					НоваяКолонка.УстановитьДействие("НачалоВыбора", "Подключаемый_ТабличнаяЧастьРеквизитНачалоВыбора");
					НоваяКолонка.УстановитьДействие("Очистка", "Подключаемый_ТабличнаяЧастьРеквизитОчистка");
					ЗаполнениеПодвалаЧисловойКолонки(ИмяТаблицы, НоваяКолонка, Реквизит);
				КонецЦикла;
			КонецЕсли;

			НоваяТаблица.УстановитьДействие("ПриОкончанииРедактирования",
											"Подключаемый_ТабличнаяЧастьПриОкончанииРедактирования");
			НоваяТаблица.УстановитьДействие("ПослеУдаления", "Подключаемый_ТабличнаяЧастьПослеУдаления");
			//@skip-check bsl-legacy-check-string-literal
			НоваяТаблица.УстановитьДействие("ПриИзменении", "Подключаемый_ТабличнаяЧастьПриИзменении");
			
			// Заполнение контекстного меню
			ГруппаКнопок = Элементы.Добавить(СтрШаблон("Группа_%1", ИмяТаблицы), Тип("ГруппаФормы"),
				НоваяТаблица.КонтекстноеМеню);
			ГруппаКнопок.Вид = ВидГруппыФормы.ГруппаКнопок;

			Кнопка = Элементы.Добавить(СтрШаблон("_ОткрытьСпецФормуВыбора_%1", ИмяТаблицы), Тип("КнопкаФормы"),
				ГруппаКнопок);
			Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			Кнопка.ИмяКоманды = "_ОткрытьСпецФормуВыбора";

			Кнопка = Элементы.Добавить(СтрШаблон("_ВставитьСсылкуНаОбъект_%1", ИмяТаблицы), Тип("КнопкаФормы"),
				ГруппаКнопок);
			Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			Кнопка.ИмяКоманды = "_ВставитьСсылкуНаОбъект";

			Кнопка = Элементы.Добавить(СтрШаблон("_ВставитьУникальныйИдентификатор_%1", ИмяТаблицы), Тип("КнопкаФормы"),
				ГруппаКнопок);
			Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			Кнопка.ИмяКоманды = "_ВставитьУникальныйИдентификатор";

			Кнопка = Элементы.Добавить(СтрШаблон("ОткрытьОбъект_%1", ИмяТаблицы), Тип("КнопкаФормы"), ГруппаКнопок);
			Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			Кнопка.ИмяКоманды = "ОткрытьОбъект";
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеПодвалаЧисловойКолонки(ИмяТаблицы, КолонкаТаблицы, РеквизитТаблицы)
	
	ЭтоНомерСтроки = (ТипЗнч(РеквизитТаблицы) = Тип("ОписаниеСтандартногоРеквизита") И РеквизитТаблицы.Имя = "НомерСтроки");
	Если ПоказыватьИтогиПоЧисловымКолонкам Тогда
		ЕстьЧисловыеКолонки = Ложь;
		Если Не ЭтоНомерСтроки
				И УИ_ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(РеквизитТаблицы.Тип, Тип("Число")) Тогда
			ЕстьЧисловыеКолонки = Истина;
			КолонкаТаблицы.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
			КолонкаТаблицы.ЦветТекстаПодвала = ЦветаСтиля.ЦветФонаВыделенияПоля;
			Если ИспользоватьЖирныйШрифтДляИтогов Тогда
				КолонкаТаблицы.ШрифтПодвала = Новый Шрифт(КолонкаТаблицы.Шрифт, , , Истина);
			КонецЕсли;
		КонецЕсли;
		Если ЕстьЧисловыеКолонки Тогда
			ИмяКнопки = СтрШаблон("_%1_ПересчитатьИтогиПоКолонкам", ИмяТаблицы);
			Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
				НоваяКнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[ИмяТаблицы].КоманднаяПанель);
				НоваяКнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
				НоваяКнопка.ИмяКоманды = "_ПересчитатьИтогиПоКолонкам";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНавигационнуюСсылкуОбъекта(Ссылка)
	// На некоторых платформах возникает ошибка при получении НавСсылки определенных объектов (на пример, счета БУ)
	Попытка
		Возврат ПолучитьНавигационнуюСсылку(Ссылка);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоИерархияГруппИЭлементов(ОбъектМетаданных)
	
	Результат = Ложь;
	Если УИ_ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоПланВидовХарактеристик(ОбъектМетаданных) Тогда
		Результат = (ОбъектМетаданных.Иерархический
			И ОбъектМетаданных.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов); 
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеОбъекта(ПересоздатьРеквизиты)

	ВидОбъекта = УИ_ОбщегоНазначения.ВидОбъектаПоСсылке(мОбъектСсылка);
	ОбъектМетаданных = мОбъектСсылка.Метаданные();
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	ТипОбъектаРедактирования = ПолноеИмя;
	
	_UUID = мОбъектСсылка.УникальныйИдентификатор();
	_URL  = ПолучитьНавигационнуюСсылкуОбъекта(мОбъектСсылка);
	_ДатаСозданияОбъекта = ДатаСозданияГУИД(_UUID);
	
	Если ПересоздатьРеквизиты Тогда
		ЗаполнитьИменаПредопределенныхДанных(ОбъектМетаданных);	
	КонецЕсли;
	ТипыДанныхРеквизитов = ТипыДанныхРеквизитов();
	ЗаполнитьРеквизитыОбъекта(ОбъектМетаданных, ПолноеИмя, ТипыДанныхРеквизитов);	
	ЗаполнитьТабличныеЧастиОбъекта(ОбъектМетаданных, ВидОбъекта, ТипыДанныхРеквизитов);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеЗначенияРеквизитаОбъекта()
	
	Описание = Новый Структура();
	Описание.Вставить("Имя", "");
	Описание.Вставить("Категория", 1);
	Описание.Вставить("Тип", Новый ОписаниеТипов());
	Описание.Вставить("Значение", Неопределено);
	Описание.Вставить("Представление", "");
	Описание.Вставить("Использование", Истина);
	Описание.Вставить("ТолькоПросмотр", Ложь);
	Возврат Описание;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИспользоватьРеквизит(ЭтоИерархияГруппИЭлементов, ЭтоГруппа, Реквизит)
	
	Результат = Истина;
	Если ЭтоИерархияГруппИЭлементов Тогда
		ИспользованиеРеквизита = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита;
		Если ЭтоГруппа И Реквизит.Использование = ИспользованиеРеквизита.ДляЭлемента
			Или Не ЭтоГруппа И Реквизит.Использование = ИспользованиеРеквизита.ДляГруппы Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИспользоватьТабличнуюЧасть(ЭтоИерархияГруппИЭлементов, ЭтоГруппа, ТабличнаяЧасть)
	
	Результат = Истина;
	Если ЭтоИерархияГруппИЭлементов Тогда
		ИспользованиеРеквизита = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита;
		Если ЭтоГруппа И ТабличнаяЧасть.Использование = ИспользованиеРеквизита.ДляЭлемента
			Или Не ЭтоГруппа И ТабличнаяЧасть.Использование = ИспользованиеРеквизита.ДляГруппы Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Добавить значение реквизита объекта.
// 
// Параметры:
//  ОписаниеЗначенияРеквизита - Структура - Описание значения реквизита:
// * Имя - Строка - имя реквизита
// * Категория - Число - категория реквизита, 0 - стандартный реквизит, 1 - реквизит
// * Тип - ОписаниеТипов - описание типа для текущего реквизита
// * Значение - Произвольный - значение реквизита
// * Представление - Строка - представление реквизита
// * Использование - Булево - использование реквизита
// * ТолькоПросмотр - Булево - будет ли возможность редактировать значение реквизита
// 
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - Добавить значение реквизита объекта
&НаСервере
Функция ДобавитьЗначениеРеквизитаОбъекта(ОписаниеЗначенияРеквизита)
	
	НоваяСтрока = РеквизитыОбъекта.Добавить();
	НоваяСтрока.Имя = ОписаниеЗначенияРеквизита.Имя;
	НоваяСтрока.Представление = ?(ПустаяСтрока(ОписаниеЗначенияРеквизита.Представление),
		ОписаниеЗначенияРеквизита.Имя, ОписаниеЗначенияРеквизита.Представление);
	НоваяСтрока.Категория = ОписаниеЗначенияРеквизита.Категория;
	
	НоваяСтрока.ТипЗначения = ОписаниеЗначенияРеквизита.Тип;
	ТипыДанныхРеквизитов = ТипыДанныхРеквизитов();
	НоваяСтрока.ТипСтрокой = ПредставлениеОписанияТипа(НоваяСтрока.ТипЗначения, ТипыДанныхРеквизитов);
	НоваяСтрока.ТолькоПросмотр = ОписаниеЗначенияРеквизита.ТолькоПросмотр;
	НоваяСтрока.Использование = ОписаниеЗначенияРеквизита.Использование;
	НоваяСтрока.Значение = ОписаниеЗначенияРеквизита.Значение;
	Возврат НоваяСтрока;

КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыОбъекта(ОбъектМетаданных, ПолноеИмя, ТипыДанныхРеквизитов)
	
	ЭтоПланСчетов = УИ_ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных);
	ЭтоЗадача = УИ_ОбщегоНазначения.ЭтоЗадача(ОбъектМетаданных);
	
	СписокРеквизитов = Новый Структура();
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		СписокРеквизитов.Вставить(Реквизит.Имя);
	КонецЦикла;
	ДанныеПоОбщимРеквизитам = УИ_ОбщегоНазначения.ДанныеПоОбщимРеквизитам(АдресОбщихРеквизитов);
	ОбщиеРеквизиты = ДанныеПоОбщимРеквизитам.НайтиСтроки(Новый Структура("Объект", ПолноеИмя));
	Для Каждого Реквизит Из ОбщиеРеквизиты Цикл
		СписокРеквизитов.Вставить(Реквизит.Имя);
	КонецЦикла;
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		СписокРеквизитов.Вставить(Реквизит.Имя);
	КонецЦикла;
	Если ЭтоПланСчетов Тогда
		Для Каждого Реквизит Из ОбъектМетаданных.ПризнакиУчета Цикл
			СписокРеквизитов.Вставить(Реквизит.Имя);
		КонецЦикла;
	КонецЕсли;
	Если ЭтоЗадача Тогда
		Для Каждого Реквизит Из ОбъектМетаданных.РеквизитыАдресации Цикл
			СписокРеквизитов.Вставить(Реквизит.Имя);
		КонецЦикла;
	КонецЕсли;
	ЗначенияРеквизитов = УИ_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(мОбъектСсылка, СписокРеквизитов);
	
	ЕстьИмяПредопределенныхДанных = Ложь;
	ЕстьЭтоГруппа = Ложь;
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		ОписаниеРеквизита = ОписаниеЗначенияРеквизитаОбъекта();
		ОписаниеРеквизита.Имя = Реквизит.Имя;
		ОписаниеРеквизита.Тип = Реквизит.Тип;
		ОписаниеРеквизита.Представление = Реквизит.Представление();
		ОписаниеРеквизита.Значение = ЗначенияРеквизитов[Реквизит.Имя];
		ОписаниеРеквизита.Категория = 0;
		ОписаниеРеквизита.ТолькоПросмотр = ЭтоРеквизитТолькоДляЧтения(Реквизит);
		ДобавитьЗначениеРеквизитаОбъекта(ОписаниеРеквизита);
		Если Реквизит.Имя = "ИмяПредопределенныхДанных" Тогда
			ЕстьИмяПредопределенныхДанных = Истина;
		КонецЕсли;
		Если Реквизит.Имя = "ЭтоГруппа" Тогда
			ЕстьЭтоГруппа = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьИмяПредопределенныхДанных Тогда
		ЗначенияРеквизитов.Свойство("ИмяПредопределенныхДанных", _ИмяПредопределенныхДанных);
	Иначе
		_ИмяПредопределенныхДанных = "";		
	КонецЕсли;
	Если ЕстьЭтоГруппа Тогда
		ЭтоГруппа = ЗначенияРеквизитов.ЭтоГруппа;
	иначе
		ЭтоГруппа = Ложь;
	КонецЕсли;
		
	Для Каждого Реквизит Из ОбщиеРеквизиты Цикл
		ОписаниеРеквизита = ОписаниеЗначенияРеквизитаОбъекта();
		ОписаниеРеквизита.Имя = Реквизит.Имя;
		ОписаниеРеквизита.Тип = Реквизит.Тип;
		ОписаниеРеквизита.Представление = Реквизит.Представление;
		ОписаниеРеквизита.Значение = ЗначенияРеквизитов[Реквизит.Имя];
		ДобавитьЗначениеРеквизитаОбъекта(ОписаниеРеквизита);
	КонецЦикла;
	
	ЭтоИерархияГруппИЭлементов = ЭтоИерархияГруппИЭлементов(ОбъектМетаданных);
	Для каждого Реквизит из ОбъектМетаданных.Реквизиты Цикл
		ОписаниеРеквизита = ОписаниеЗначенияРеквизитаОбъекта();
		ОписаниеРеквизита.Имя = Реквизит.Имя;
		ОписаниеРеквизита.Тип = Реквизит.Тип;
		ОписаниеРеквизита.Представление = Реквизит.Представление();
		ОписаниеРеквизита.Значение = ЗначенияРеквизитов[Реквизит.Имя];
		ОписаниеРеквизита.Использование = ИспользоватьРеквизит(ЭтоИерархияГруппИЭлементов, ЭтоГруппа, Реквизит);
		ДобавитьЗначениеРеквизитаОбъекта(ОписаниеРеквизита);
	КонецЦикла;
	
	Если ЭтоПланСчетов Тогда
		Для каждого Реквизит из ОбъектМетаданных.ПризнакиУчета Цикл
			ОписаниеРеквизита = ОписаниеЗначенияРеквизитаОбъекта();
			ОписаниеРеквизита.Имя = Реквизит.Имя;
			ОписаниеРеквизита.Тип = Реквизит.Тип;
			ОписаниеРеквизита.Представление = Реквизит.Представление();
			ОписаниеРеквизита.Значение = ЗначенияРеквизитов[Реквизит.Имя];
			ДобавитьЗначениеРеквизитаОбъекта(ОписаниеРеквизита);
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтоЗадача Тогда
		Для каждого Реквизит из ОбъектМетаданных.РеквизитыАдресации Цикл
			ОписаниеРеквизита = ОписаниеЗначенияРеквизитаОбъекта();
			ОписаниеРеквизита.Имя = Реквизит.Имя;
			ОписаниеРеквизита.Тип = Реквизит.Тип;
			ОписаниеРеквизита.Представление = Реквизит.Представление();
			ОписаниеРеквизита.Значение = ЗначенияРеквизитов[Реквизит.Имя];
			ДобавитьЗначениеРеквизитаОбъекта(ОписаниеРеквизита);
		КонецЦикла;
	КонецЕсли;
	
	РеквизитыОбъекта.Сортировать("Категория, Имя");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныеЧастиОбъекта(ОбъектМетаданных, ВидОбъекта, ТипыДанныхРеквизитов)
	
	ТабличныеЧасти = Новый Массив;
	ВидыТабличныхЧастейОбъекта = ВидыТабличныхЧастейОбъекта(ОбъектМетаданных);
	Для Каждого ВидТабличныхЧастей Из ВидыТабличныхЧастейОбъекта Цикл
		Для Каждого ТабличнаяЧасть Из ВидТабличныхЧастей Цикл
			ТабличныеЧасти.Добавить(ТабличнаяЧасть);
		КонецЦикла;
	КонецЦикла;
	Если ТабличныеЧасти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонЗапроса =
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	&ПолноеИмяТаблицы КАК ТаблицаОбъекта
		|ГДЕ
		|	ТаблицаОбъекта.Ссылка = &Ссылка";

	ТекстыЗапроса = Новый Массив;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		ПолноеИмяТаблицы = СтрШаблон("%1.%2.%3", ВидОбъекта, ОбъектМетаданных.Имя, ТабличнаяЧасть.Имя);
		ТекстыЗапроса.Добавить(СтрЗаменить(ШаблонЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы));
	КонецЦикла;
	Запрос = Новый Запрос(СтрСоединить(ТекстыЗапроса, УИ_ОбщегоНазначения.РазделительПакетаЗапросов()));
	Запрос.УстановитьПараметр("Ссылка", мОбъектСсылка);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	НомерПакета = 0;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		ИмяТаблицы = ПрефиксДляНовыхЭлементов + ТабличнаяЧасть.Имя;
		ТаблицаРезультата = РезультатЗапроса[НомерПакета].Выгрузить();
		ЗначениеВРеквизитФормы(ТаблицаРезультата, ИмяТаблицы);
		Если ПоказыватьИтогиПоЧисловымКолонкам Тогда
			вПересчитатьИтогиПоКолонкам(ИмяТаблицы);
		КонецЕсли;
		ОбновитьЗаголовокСтраницыТабличнойЧастиНаСервере(ИмяТаблицы);
		НомерПакета = НомерПакета + 1;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьДанныеОбъекта(ПересоздатьРеквизиты)
	
	РеквизитыОбъекта.Очистить();
	ТипыДанныхРеквизитов = ТипыДанныхРеквизитов();
	Если ПересоздатьРеквизиты Тогда
		МассивКСозданию = Новый Массив;
		МассивКУдалению = Новый Массив;
		
		ПодготовитьТабличныеЧастиОбъекта(МассивКСозданию, МассивКУдалению, ТипыДанныхРеквизитов);
		ПодготовитьСтраницуДвижений();
		ИзменитьРеквизиты(МассивКСозданию, МассивКУдалению);
		ПодготовитьЭлементыТабличныхЧастейОбъекта(ТипыДанныхРеквизитов);
	КонецЕсли;
	
	Если мОбъектСсылка <> Неопределено Тогда
		ЗаполнитьДанныеОбъекта(ПересоздатьРеквизиты);
	Иначе
		ТипОбъектаРедактирования = "";
	КонецЕсли;
	
	УстановитьВидимостьТабличныхЧастейОбъекта();
	УстановитьВидимостьНомераСтрокиТабличныхЧастейОбъекта();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаборЗаписейНаСервере()

	_НаборЗаписей.Очистить();
	НадоИзменитьРеквизиты = (_ИмяНабораЗаписей <> _ИмяНабораЗаписейПредыдущий);

	ИмяКомандыПересчета = "__НаборЗаписей__ПересчитатьИтогиПоКолонкам";

	МассивКСозданию = Новый Массив;
	МассивКУдалению = Новый Массив;

	Если НадоИзменитьРеквизиты Тогда
		ТабРезультат = РеквизитФормыВЗначение("_НаборЗаписей");
		Для Каждого Колонка Из ТабРезультат.Колонки Цикл
			МассивКУдалению.Добавить("_НаборЗаписей." + Колонка.Имя);
			Элем = Элементы.Найти("_НаборЗаписей_" + Колонка.Имя);
			Если Элем <> Неопределено Тогда
				Элементы.Удалить(Элем);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Не ПустаяСтрока(_ИмяНабораЗаписей) Тогда
		Менеджер = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(_ИмяНабораЗаписей);
		Если Менеджер = Неопределено Тогда
			Если НадоИзменитьРеквизиты Тогда
				ИзменитьРеквизиты(МассивКСозданию, МассивКУдалению);
			КонецЕсли;
			Возврат;
		КонецЕсли;

		Набор = Менеджер.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(мОбъектСсылка);
		Набор.Прочитать();

		ТабРезультат = Набор.Выгрузить();

		Если ОсобыйРежимРаботыСНаборомЗаписейРБ Тогда
			вНастроитьТаблицуНабораЗаписей(Набор, ТабРезультат);
		КонецЕсли;

		Попытка
			Если НадоИзменитьРеквизиты Тогда
				ТипХЗ = Тип("ХранилищеЗначения");
				ТипТТ = Тип("Тип");
				ТипМВ = Тип("МоментВремени");
				ТипUUID = Тип("УникальныйИдентификатор");

				СтрукСпецКолонки = Новый Структура("Регистратор, МоментВремени");

				Для Каждого Колонка Из ТабРезультат.Колонки Цикл
					Если Колонка.ТипЗначения.СодержитТип(ТипХЗ) Тогда
						ТипЗначенияРеквизита = Новый ОписаниеТипов;
					ИначеЕсли Колонка.ТипЗначения.СодержитТип(ТипТТ) Тогда
						ТипЗначенияРеквизита = Новый ОписаниеТипов;
					ИначеЕсли Колонка.ТипЗначения.СодержитТип(ТипМВ) Тогда
						ТипЗначенияРеквизита = Новый ОписаниеТипов;
					ИначеЕсли Колонка.ТипЗначения.СодержитТип(ТипUUID) Тогда
						ТипЗначенияРеквизита = вОписаниеТиповДляUUID(Колонка.ТипЗначения);
					Иначе
						ТипЗначенияРеквизита = Колонка.ТипЗначения;
					КонецЕсли;
					МассивКСозданию.Добавить(Новый РеквизитФормы(Колонка.Имя, ТипЗначенияРеквизита, "_НаборЗаписей",
						Колонка.Заголовок, Ложь));
				КонецЦикла;

				ИзменитьРеквизиты(МассивКСозданию, МассивКУдалению);
			КонецЕсли;

			ЗначениеВРеквизитФормы(ТабРезультат, "_НаборЗаписей");

			Если НадоИзменитьРеквизиты Тогда

				Для Каждого Колонка Из ТабРезультат.Колонки Цикл
					Если СтрукСпецКолонки.Свойство(Колонка.Имя) Тогда
						Продолжить;
					КонецЕсли;

					Элем = Элементы.Добавить("_НаборЗаписей_" + Колонка.Имя, Тип("ПолеФормы"), Элементы._НаборЗаписей);
					Элем.ПутьКДанным="_НаборЗаписей." + Колонка.Имя;
					Элем.Вид=ВидПоляФормы.ПолеВвода;
					Элем.ДоступныеТипы=Колонка.ТипЗначения;
					Элем.КнопкаОчистки = Истина;

					Если Колонка.ТипЗначения.СодержитТип(ТипХЗ) Тогда // версия 033
						Элем.ТолькоПросмотр = Истина;
					Иначе
						Элем.ВыборГруппИЭлементов = ГруппыИЭлементы.ГруппыИЭлементы;
					КонецЕсли;
				КонецЦикла;

			КонецЕсли;

			ТипЧисло = Тип("Число");
			ЕстьЧисловыеКолонки = Ложь;

			Если ПоказыватьИтогиПоЧисловымКолонкам Тогда
				Для Каждого пКолонка Из ТабРезультат.Колонки Цикл
					Если пКолонка.Имя <> "НомерСтроки" И пКолонка.ТипЗначения.СодержитТип(ТипЧисло) Тогда
						ЕстьЧисловыеКолонки = Истина;
						ЭФ = Элементы.Найти("_НаборЗаписей_" + пКолонка.Имя);
						Если ЭФ <> Неопределено Тогда
							Если НадоИзменитьРеквизиты Тогда
								ЭФ.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
								ЭФ.ЦветТекстаПодвала = ЦветаСтиля.ЦветФонаВыделенияПоля;
								Если ИспользоватьЖирныйШрифтДляИтогов Тогда
									ЭФ.ШрифтПодвала = Новый Шрифт(ЭФ.Шрифт, , , Истина);
								КонецЕсли;
							КонецЕсли;
							ЭФ.ТекстПодвала = Строка(ТабРезультат.Итог(пКолонка.Имя));
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;

				КнопкаПересчета = Элементы.Найти(ИмяКомандыПересчета);
				Если ЕстьЧисловыеКолонки Тогда
					Если КнопкаПересчета = Неопределено Тогда
						ЭФ = Элементы.Добавить(ИмяКомандыПересчета,
											   Тип("КнопкаФормы"),
											   Элементы._НаборЗаписей.КоманднаяПанель);
						ЭФ.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
						ЭФ.ИмяКоманды = "_ПересчитатьИтогиПоКолонкам";
					КонецЕсли;
				ИначеЕсли КнопкаПересчета <> Неопределено Тогда
					Элементы.Удалить(КнопкаПересчета);
				КонецЕсли;
			КонецЕсли;

			Элементы._НаборЗаписей.Подвал = ПоказыватьИтогиПоЧисловымКолонкам И ЕстьЧисловыеКолонки;

		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;

	ИначеЕсли НадоИзменитьРеквизиты Тогда
		ИзменитьРеквизиты(МассивКСозданию, МассивКУдалению);
		КомандаПересчета = Элементы.Найти(ИмяКомандыПересчета);
		Если КомандаПересчета <> Неопределено Тогда
			Элементы.Удалить(КомандаПересчета);
		КонецЕсли;
	КонецЕсли;

	_ИмяНабораЗаписейПредыдущий = _ИмяНабораЗаписей;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьСтандартныеТабличныеЧасти(ОбъектМетаданных)
	
	Возврат (УИ_ОбщегоНазначения.ЭтоПланВидовРасчета(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных));
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьТабличныеЧасти(ОбъектМетаданных)
	
	Возврат (УИ_ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоПланВидовРасчета(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоПланВидовХарактеристик(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоПланОбмена(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоЗадача(ОбъектМетаданных)
		Или УИ_ОбщегоНазначения.ЭтоБизнесПроцесс(ОбъектМетаданных));
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеОписанияТипа(ОписаниеТипов, Знач ТипыДанныхРеквизитов = Неопределено)
	
	Результат = "";
	Если ОписаниеТипов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыДанныхРеквизитов = ?(ТипыДанныхРеквизитов = Неопределено, ТипыДанныхРеквизитов(), ТипыДанныхРеквизитов);
	ПредставленияТипов = Новый Массив;
	Типы = ОписаниеТипов.Типы();
	Для каждого Тип из Типы Цикл
		ИмяТипа = ПредставлениеТипа(ТипыДанныхРеквизитов, ОписаниеТипов, Тип);
		Если Не ПустаяСтрока(ИмяТипа) Тогда
			ПредставленияТипов.Добавить(ИмяТипа);
		КонецЕсли;
	КонецЦикла;
	Результат = СтрСоединить(ПредставленияТипов, ", ");
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеТипа(ТипыДанныхРеквизитов, ОписаниеТипов, Тип)
	
	ИмяТипа = "";
	Если Тип = ТипыДанныхРеквизитов.Число Тогда
		ИмяТипа = "Число";
		КвалификаторыЧисла = ОписаниеТипов.КвалификаторыЧисла;
		ОписаниеЧисла = Новый Массив;
		Если ЗначениеЗаполнено(КвалификаторыЧисла.Разрядность) Тогда
			ОписаниеЧисла.Добавить(СтрШаблон("%1.%2",
				КвалификаторыЧисла.Разрядность, КвалификаторыЧисла.РазрядностьДробнойЧасти));
		КонецЕсли;
		Если КвалификаторыЧисла.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный Тогда
			ОписаниеЧисла.Добавить("+");
		КонецЕсли;
		Если ЗначениеЗаполнено(ОписаниеЧисла) Тогда
		    ИмяТипа = СтрШаблон("%1(%2)", ИмяТипа, СтрСоединить(ОписаниеЧисла, ", "));
		КонецЕсли;
	ИначеЕсли Тип = ТипыДанныхРеквизитов.Строка Тогда
		ИмяТипа = "Строка";
		КвалификаторыСтроки = ОписаниеТипов.КвалификаторыСтроки;
		Если КвалификаторыСтроки.Длина <> 0 Тогда
			ПредставлениеДлины = ?(КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Переменная, "П", "Ф");
			ИмяТипа = СтрШаблон("%1(%2%3)", ИмяТипа, ПредставлениеДлины, КвалификаторыСтроки.Длина);
		КонецЕсли;
	ИначеЕсли Тип = ТипыДанныхРеквизитов.Дата Тогда
		КвалификаторыДаты = ОписаниеТипов.КвалификаторыДаты;
		Если КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Время Тогда
			ИмяТипа = "Время";
		ИначеЕсли КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Дата Тогда
			ИмяТипа = "Дата";
		Иначе
			ИмяТипа = "ДатаВремя";
		КонецЕсли;
	ИначеЕсли Тип = ТипыДанныхРеквизитов.Булево Тогда
		ИмяТипа = "Булево";
	ИначеЕсли Тип = ТипыДанныхРеквизитов.ДвоичныеДанные Тогда
		ИмяТипа = "ДвоичныеДанные";
	ИначеЕсли Тип = ТипыДанныхРеквизитов.ХранилищеЗначения Тогда
		ИмяТипа = "ХранилищеЗначения";
	ИначеЕсли Тип = ТипыДанныхРеквизитов.УникальныйИдентификатор Тогда
		ИмяТипа = "УникальныйИдентификатор";
	Иначе
		ОбъектМД = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМД <> Неопределено Тогда
			ИмяТипа = ОбъектМД.ПолноеИмя();
		Иначе
			ИмяТипа = Строка(Тип);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИмяТипа;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТипыДанныхРеквизитов()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Число", Тип("Число"));
	Результат.Вставить("Строка", Тип("Строка"));
	Результат.Вставить("Дата", Тип("Дата"));
	Результат.Вставить("Булево", Тип("Булево"));
	Результат.Вставить("ХранилищеЗначения", Тип("ХранилищеЗначения"));
	Результат.Вставить("УникальныйИдентификатор", Тип("УникальныйИдентификатор"));
	Результат.Вставить("ДвоичныеДанные", Тип("ДвоичныеДанные"));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ИзменитьВидимостьТабличныхЧастейОбъекта()
	НастройкиОбработки = СформироватьСтруктуруНастроек();
	ЗаполнитьЗначенияСвойств(НастройкиОбработки, ЭтотОбъект);
	СохранитьНастройкиОбработки(НастройкиОбработки);
	УстановитьВидимостьТабличныхЧастейОбъекта();
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьТабличныхЧастейОбъекта()
	Для каждого ЗначениеСписка из _СписокТабличныхЧастей Цикл
		ИмяТабличныйЧасти = ЗначениеСписка.Значение;
		
		ИмяСПрефиксов = ПрефиксДляНовыхЭлементов + ИмяТабличныйЧасти;
		ИмяСтраницы = ПрефиксСтраницы() + ИмяСПрефиксов;
		
		СтраницаТаблицы = Элементы.Найти(ИмяСтраницы);
		Если СтраницаТаблицы <> Неопределено Тогда
			Если СкрыватьПустыеТабличныеЧасти Тогда
				ДанныеТаблицы = ЭтотОбъект[ИмяСПрефиксов];
				ЕстьДанные = (ДанныеТаблицы.Количество() > 0);
				СтраницаТаблицы.Видимость = ЕстьДанные;
			Иначе
				СтраницаТаблицы.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНомераСтрокиТабличныхЧастейОбъекта()
	
	Для каждого ЗначениеСписка из _СписокТабличныхЧастей Цикл
		ИмяТабличныйЧасти = ЗначениеСписка.Значение;
		
		ИмяСПрефиксов = ПрефиксДляНовыхЭлементов + ИмяТабличныйЧасти;
		ИмяКолонкиНомерСтроки = СтрШаблон("%1НомерСтроки", ИмяСПрефиксов);
		
		Колонка = Элементы.Найти(ИмяКолонкиНомерСтроки);
		Если Колонка <> Неопределено Тогда
			Колонка.Видимость = ПоказыватьНомерСтрокиТЧ;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция вПолучитьПолноеИмяМД(Знач Ссылка)
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка.Метаданные().ПолноеИмя();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоОбразцуЗавершение(РезультатЗакрытия, ДопПарам = Неопределено) Экспорт
	Если РезультатЗакрытия <> Неопределено Тогда
		ПредыдущаяСсылка = мОбъектСсылка;
		мОбъектСсылка = РезультатЗакрытия;

		ИнформацияОПредопределенныхДанных = ИнформацияОПредопределенныхДанных();

		Попытка
			ЗаполнитьДанныеОбъектаСсылки();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;

		Если ИнформацияОПредопределенныхДанных.ЕстьДанные Тогда
			СтруктураПоиска = Новый Структура("Категория, Имя", 0, "ИмяПредопределенныхДанных");
			НайденныеСтроки = РеквизитыОбъекта.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Значение = ИнформацияОПредопределенныхДанных.Значение;
			КонецЕсли;
		КонецЕсли;

		мОбъектСсылка = ПредыдущаяСсылка;
		_UUID = мОбъектСсылка.УникальныйИдентификатор();
		_URL  = ПолучитьНавигационнуюСсылкуОбъекта(мОбъектСсылка);
		_ДатаСозданияОбъекта = ДатаСозданияГУИД(_UUID);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьСсылкуДляОбъекта(ОбъектЗаполнения, Знач UUIDСтрокой)

	Если УИ_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(UUIDСтрокой) Тогда
		УИД = Новый УникальныйИдентификатор(UUIDСтрокой);
		Если Не ЗначениеЗаполнено(УИД) Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Неправильное значение UUID'"));
		Возврат Ложь;
	КонецЕсли;

	ОбъектМетаданных = ОбъектЗаполнения.Метаданные();
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Попытка
		МенеджерОбъекта = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = '%1 - данный тип не обрабатывается!'"), ПолноеИмя);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;

	Попытка
		НоваяСсылка = МенеджерОбъекта.ПолучитьСсылку(УИД);
		ОбъектЗаполнения.УстановитьСсылкуНового(НоваяСсылка);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось установить ссылку для нового объекта!
									 |%1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПроверитьИмяПредопределенныхДанных()
	
	НайденныеСтроки = РеквизитыОбъекта.НайтиСтроки(Новый Структура("Категория, Имя", 0, "ИмяПредопределенныхДанных"));
	Если НайденныеСтроки.Количество() <> 0 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
		НайденнаяСтрока.Значение = СокрЛП(НайденнаяСтрока.Значение);

		Если Не ПустаяСтрока(НайденнаяСтрока.Значение) Тогда
			ПроверочнаяСтруктура = Новый Структура;
			Попытка
				ПроверочнаяСтруктура.Вставить(НайденнаяСтрока.Значение, 1);
			Исключение
				Возврат Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ИнформацияОПредопределенныхДанных()
	
	Результат = Новый Структура("ЕстьДанные, ЕстьИзменения, НекорректноеИмя", Ложь, Ложь, Ложь);
	Результат.Вставить("Значение");

	НайденныеСтроки = РеквизитыОбъекта.НайтиСтроки(Новый Структура("Категория, Имя", 0, "ИмяПредопределенныхДанных"));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат.ЕстьДанные = Истина;
		Если Не ПроверитьИмяПредопределенныхДанных() Тогда
			Результат.НекорректноеИмя = Истина;
		КонецЕсли;

		Результат.Значение = НайденныеСтроки[0].Значение;
		Если НайденныеСтроки[0].Значение <> _ИмяПредопределенныхДанных Тогда
			Результат.ЕстьИзменения = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьОбъектДалее(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьОбъектВБазу(Ложь) Тогда
			ОтобразитьИзменениеДанных(мОбъектСсылка, ВидИзмененияДанных.Изменение);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОбъектКакНовыйДалее(РезультатВопроса, ДопПараметры = Неопределено) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьОбъектВБазу(Истина, ДопПараметры) Тогда
			ОтобразитьИзменениеДанных(мОбъектСсылка, ВидИзмененияДанных.Добавление);
			Если ДопПараметры <> Неопределено Тогда
				ОтобразитьИзменениеДанных(мОбъектСсылка, ВидИзмененияДанных.Изменение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбъектДалее(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОписаниеТипаОбъекта = НовоеОписаниеТипов(ТипЗнч(мОбъектСсылка));
		Если УдалитьОбъектНаСервере(мОбъектСсылка) Тогда
			ОтобразитьИзменениеДанных(мОбъектСсылка, ВидИзмененияДанных.Удаление);
			мОбъектСсылка = ОписаниеТипаОбъекта.ПривестиЗначение();
			ЗаполнитьДанныеОбъектаСсылки();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНаборЗаписейПродолжение(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаписатьНаборЗаписейНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредупреждениеБезОповещения(ТекстСообщения)
	ПоказатьПредупреждение( , ТекстСообщения);
КонецПроцедуры

&НаСервере
Процедура НайтиОбъектПоUUIDСервер()
	
	Если ПустаяСтрока(_UUID) Тогда
		Возврат;
	КонецЕсли;
	
	мОбъектСсылка = Неопределено;
	ТипОбъектаРедактирования = "";

	Если УИ_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(_UUID) Тогда
		УИД = Новый УникальныйИдентификатор(_UUID);
		Если Не ЗначениеЗаполнено(УИД) Тогда
			Возврат;
		КонецЕсли;
	Иначе
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Неправильное значение UUID'"));
		Возврат;
	КонецЕсли;

	МенеджерыОбъектов = Новый Массив;
	МенеджерыОбъектов.Добавить(Справочники);
	МенеджерыОбъектов.Добавить(Документы);
	МенеджерыОбъектов.Добавить(ПланыВидовРасчета);
	МенеджерыОбъектов.Добавить(ПланыВидовХарактеристик);
	МенеджерыОбъектов.Добавить(ПланыСчетов);
	МенеджерыОбъектов.Добавить(БизнесПроцессы);
	МенеджерыОбъектов.Добавить(Задачи);
	
	Для Каждого МенеджерОбъектов Из МенеджерыОбъектов Цикл
		Для Каждого Менеджер Из МенеджерОбъектов Цикл
			СсылкаНаОбъект = Менеджер.ПолучитьСсылку(УИД);
			Если УИ_ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
				мОбъектСсылка = СсылкаНаОбъект;
				ЗаполнитьДанныеОбъектаСсылки();
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НайтиОбъектПоТипу_UUIDСервер()
	Если Не ПустаяСтрока(ТипОбъектаРедактирования) И Не ПустаяСтрока(_UUID) Тогда
		Если Не УИ_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(_UUID) Тогда
			УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Неправильное значение UUID'"));
			Возврат;
		КонецЕсли;

		ИмяТипа = СтрЗаменить(ТипОбъектаРедактирования, ".", "Ссылка.");
		Попытка
			мОбъектСсылка = XMLЗначение(Тип(ИмяТипа), _UUID);
		Исключение
			УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить объект по типу'"));
			Возврат;
		КонецПопытки;
		ЗаполнитьДанныеОбъектаСсылки();
	КонецЕсли;
КонецПроцедуры

// Возвращает заголовок страницы табличной части.
// 
// Параметры:
//  ИмяТабличнойЧасти - Строка - Имя табличной части
//  ДанныеТабличнойЧасти - ДанныеФормыКоллекция, ТаблицаЗначений - Данные табличной части
// 
// Возвращаемое значение:
//  Строка - новый заголовок страницы
&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокСтраницыТабличнойЧасти(ИмяТабличнойЧасти, ДанныеТабличнойЧасти)
	КоличествоСтрок = ДанныеТабличнойЧасти.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат ИмяТабличнойЧасти;
	Иначе
		Возврат СтрШаблон("%1 (%2)", ИмяТабличнойЧасти, КоличествоСтрок);
	КонецЕсли;			
КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовокСтраницыТабличнойЧасти(ЭлементТабличнойЧасти)
	
	ИмяСПрефиксом = ЭлементТабличнойЧасти.Имя;
	Если Не СтрНачинаетсяС(ИмяСПрефиксом, ПрефиксДляНовыхЭлементов) Тогда
		Возврат;
	КонецЕсли;

	ИмяТабличнойЧасти = Сред(ИмяСПрефиксом, СтрДлина(ПрефиксДляНовыхЭлементов) + 1);
	ИмяСтраницы = ПрефиксСтраницы() + ИмяСПрефиксом;
	Элементы[ИмяСтраницы].Заголовок = ЗаголовокСтраницыТабличнойЧасти(ИмяТабличнойЧасти, ЭтотОбъект[ИмяСПрефиксом]);

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокСтраницыТабличнойЧастиНаСервере(ИмяТабличнойЧасти)
	
	Если Не СтрНачинаетсяС(ИмяТабличнойЧасти, ПрефиксДляНовыхЭлементов) Тогда
		Возврат;
	КонецЕсли;

	ИмяТабличнойЧастиБезПрефикса = Сред(ИмяТабличнойЧасти, СтрДлина(ПрефиксДляНовыхЭлементов) + 1);
	ИмяСтраницы = ПрефиксСтраницы() + ИмяТабличнойЧасти;
	Элементы[ИмяСтраницы].Заголовок = ЗаголовокСтраницыТабличнойЧасти(ИмяТабличнойЧастиБезПрефикса, ЭтотОбъект[ИмяТабличнойЧасти]);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНомераСтрокТабличнойЧасти()

	ТабличнаяЧасть = ЭтотОбъект[ТекущийЭлемент.ПутьКДанным];
	НомерСтроки = 1;
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		Строка.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЭтоРеквизитИмяПредопределенныхДанных(ТекущиеДанные)
	
	Возврат (ТекущиеДанные.Имя = "ИмяПредопределенныхДанных" И ТекущиеДанные.Категория = 0);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоРеквизитТолькоДляЧтения(Реквизит)
	
	РеквизитыДляЧтения = Новый Массив;
	РеквизитыДляЧтения.Добавить("Ссылка");
	РеквизитыДляЧтения.Добавить("Предопределенный");
	РеквизитыДляЧтения.Добавить("ДатаОбмена");
	РеквизитыДляЧтения.Добавить("ЭтоГруппа");
	
	Возврат (ТипЗнч(Реквизит) = Тип("ОписаниеСтандартногоРеквизита")
			И РеквизитыДляЧтения.Найти(Реквизит.Имя) <> Неопределено);
	
КонецФункции

&НаКлиенте
Функция ПолучитьФормуНавигатораПоКонфигурации(ОткрытьФорму = ложь)
	
	ФормаНавигатора = Неопределено;
	Для каждого пОкно из ПолучитьОкна() Цикл
		Для каждого Элем из пОкно.Содержимое Цикл
			Если ТипЗнч(Элем) = УИ_ОбщегоНазначенияКлиентСервер.ТипУправляемойФормы() Тогда
				Если СтрЗаканчиваетсяНа(Элем.ИмяФормы, ".УИ_НавигаторПоКонфигурации.Форма.Форма") Тогда
					ФормаНавигатора = Элем;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ФормаНавигатора <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОткрытьФорму и ФормаНавигатора <> Неопределено Тогда
		Если не ФормаНавигатора.Открыта() Тогда
			Попытка
				ФормаНавигатора.Открыть();
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;
		Возврат ФормаНавигатора;
	ИначеЕсли ОткрытьФорму и ФормаНавигатора = Неопределено Тогда
		УИ_ОбщегоНазначенияКлиент.ОткрытьНавигаторПоКонфигурации();
		ФормаНавигатора = ПолучитьФормуНавигатораПоКонфигурации(ОткрытьФорму);
		Возврат ФормаНавигатора;
	Иначе
		Возврат ФормаНавигатора;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПутьКДаннымТекущегоЭлемента()

	Если ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		ТекПоле = ТекущийЭлемент.ТекущийЭлемент;
		Если ТипЗнч(ТекПоле) = Тип("ПолеФормы") Тогда
			Значение = ТекПоле.ПутьКДанным;
			Поз = СтрНайти(Значение, ".");
			Если Поз <> 0 Тогда
				Значение = Сред(Значение, Поз + 1);
				Если СтрНайти(Значение, ".") = 0 Тогда
					Возврат Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ПолеФормы") Тогда
		Возврат ТекущийЭлемент.ПутьКДанным;
	КонецЕсли;

	Возврат "";
	
КонецФункции

&НаСервере
Функция ЗаписатьОбъектВБазу(Знач КакНовый = Ложь, Знач СтрокаUUID = Неопределено)
	
	Если КакНовый Тогда
		Если Не УИ_ОбщегоНазначения.СсылкаСуществует(мОбъектСсылка) Тогда
			ОбъектМД = мОбъектСсылка.Метаданные();
			ОбъектДляЗаписи = СоздатьНовыйОбъект(ОбъектМД);
			Если ОбъектДляЗаписи = Неопределено Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось создать новый объект типа %1.'"),
										   ОбъектМД.ПолноеИмя());
				УИ_ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
		Иначе
			ОбъектДляЗаписи = мОбъектСсылка.Скопировать();
		КонецЕсли;

		Если СтрокаUUID <> Неопределено Тогда
			Если Не УстановитьСсылкуДляОбъекта(ОбъектДляЗаписи, СтрокаUUID) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ОбъектДляЗаписи = мОбъектСсылка.ПолучитьОбъект();
	КонецЕсли;

	Если ОбъектДляЗаписи = Неопределено Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить объект для записи (битая ссылка)!'"));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОбъектМД = ОбъектДляЗаписи.Метаданные();
		ЭтоИерархияГруппИЭлементов = ЭтоИерархияГруппИЭлементов(ОбъектМД);
		ЭтоГруппа = ?(ЭтоИерархияГруппИЭлементов, ОбъектДляЗаписи.ЭтоГруппа, Ложь);
		
		ПараметрыОтбора = Новый Структура("Использование, ТолькоПросмотр", Истина, Ложь);
		СписокРеквизитовОбъекта = РеквизитыОбъекта.НайтиСтроки(ПараметрыОтбора);
		Для Каждого Реквизит Из СписокРеквизитовОбъекта Цикл
			ОбъектДляЗаписи[Реквизит.Имя] = Реквизит.Значение;
		КонецЦикла;

		ИспользованиеРеквизита = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита;
		ВидыТабличныхЧастейОбъекта = ВидыТабличныхЧастейОбъекта(ОбъектМД);
		Для Каждого ВидТабличныхЧастей Из ВидыТабличныхЧастейОбъекта Цикл
			Для Каждого ТабличнаяЧасть Из ВидТабличныхЧастей Цикл
				Если ТипЗнч(ТабличнаяЧасть) = Тип("ОбъектМетаданных") И ЭтоИерархияГруппИЭлементов 
					И ((ЭтоГруппа И ТабличнаяЧасть.Использование = ИспользованиеРеквизита.ДляЭлемента)
						Или (Не ЭтоГруппа И ТабличнаяЧасть.Использование = ИспользованиеРеквизита.ДляГруппы)) Тогда
					Продолжить;
				КонецЕсли;
				ТабличнаяЧастьОбъекта = ОбъектДляЗаписи[ТабличнаяЧасть.Имя];
				ИмяТаблицы = ПрефиксДляНовыхЭлементов + ТабличнаяЧасть.Имя;
				ТаблицаЗагрузки = РеквизитФормыВЗначение(ИмяТаблицы);
				ТабличнаяЧастьОбъекта.Загрузить(ТаблицаЗагрузки);
			КонецЦикла;
		КонецЦикла;

		ПараметрыЗаписи = УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект);
		Если УИ_ОбщегоНазначения.ЗаписатьОбъектВБазу(ОбъектДляЗаписи, ПараметрыЗаписи) Тогда
			мОбъектСсылка = ОбъектДляЗаписи.Ссылка;
			ЗаполнитьДанныеОбъектаСсылки();
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция СоздатьНовыйОбъект(ОбъектМетаданных)
	
	ИмяОбъекта = ОбъектМетаданных.Имя;
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		ЭтоИерархияГруппИЭлементов = ЭтоИерархияГруппИЭлементов(ОбъектМетаданных);

		ЭтоГруппа = Ложь;
		Если ЭтоИерархияГруппИЭлементов Тогда
			ПараметрыПоиска = Новый Структура("Категория, Имя", 0, "ЭтоГруппа");
			НайденныеРеквизиты = РеквизитыОбъекта.НайтиСтроки(ПараметрыПоиска);
			Для Каждого Реквизит Из НайденныеРеквизиты Цикл
				ЭтоГруппа = Реквизит.Значение;
			КонецЦикла;
		КонецЕсли;

		Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Менеджер = Справочники;
		Иначе
			Менеджер = ПланыВидовХарактеристик;
		КонецЕсли;

		НовыйОбъект = ?(ЭтоГруппа, Менеджер[ИмяОбъекта].СоздатьГруппу(), Менеджер[ИмяОбъекта].СоздатьЭлемент());

	ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = ПланыОбмена[ИмяОбъекта].СоздатьУзел();

	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = Документы[ИмяОбъекта].СоздатьДокумент();

	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = ПланыСчетов[ИмяОбъекта].СоздатьСчет();

	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = ПланыВидовРасчета[ИмяОбъекта].СоздатьВидРасчета();

	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = БизнесПроцессы[ИмяОбъекта].СоздатьБизнесПроцесс();

	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		НовыйОбъект = Задачи[ИмяОбъекта].СоздатьЗадачу();

	Иначе
		НовыйОбъект = Неопределено;
	КонецЕсли;

	Возврат НовыйОбъект;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьИмяТипаПоЗначению(Знач Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Неопределено") Тогда
		ИмяТипа = "Неопределено";
	Иначе
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных <> Неопределено Тогда
			ИмяТипа = ОбъектМетаданных.ПолноеИмя();
		Иначе
			ИмяТипа = Строка(ТипЗначения);
		КонецЕсли;
	КонецЕсли;
	Возврат ИмяТипа;
	
КонецФункции

&НаСервере
Функция УдалитьОбъектНаСервере(Знач Ссылка)
	Попытка
		ОбъектДляУдаления = Ссылка.ПолучитьОбъект();
		Если ОбъектДляУдаления = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Если УИ_ОбщегоНазначения.ЗаписатьОбъектВБазу(ОбъектДляУдаления,
													 УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект),
													 "НепосредственноеУдаление") Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ШаблонОшибки = НСтр("ru = 'Ошибка при удалении объекта: 
							|%1'");
		ТекстОшибки = СтрШаблон(ШаблонОшибки, КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПровестиДокументПродолжение(РезультатВопроса, ДопПараметры = Неопределено) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьДокумент(мОбъектСсылка, Истина) Тогда
			ЗаполнитьДанныеОбъектаСсылки();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПроведениеПродолжение(РезультатВопроса, ДопПараметры = Неопределено) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьДокумент(мОбъектСсылка, Ложь) Тогда
			ЗаполнитьДанныеОбъектаСсылки();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаписатьДокумент(Ссылка, Проводить = Истина)
	Режим = ?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.ОтменаПроведения);
	ДокОбъект = Ссылка.ПолучитьОбъект();
	Возврат УИ_ОбщегоНазначения.ЗаписатьОбъектВБазу(ДокОбъект,
													УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект),
													,
													Режим);
КонецФункции

&НаСервере
Процедура ЗаписатьНаборЗаписейНаСервере()
	Если Не ПустаяСтрока(_ИмяНабораЗаписей) И ЗначениеЗаполнено(мОбъектСсылка) Тогда
		Менеджер = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(_ИмяНабораЗаписей);
		Если Менеджер <> Неопределено Тогда
			Набор = Менеджер.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(мОбъектСсылка);
			ПараметрыЗаписи=УИ_ОбщегоНазначенияКлиентСервер.ПараметрыЗаписиФормы(ЭтотОбъект);

			Если ПараметрыЗаписи.ЗаписьВРежимеЗагрузки Тогда
				Набор.ОбменДанными.Загрузка = Истина;
			КонецЕсли;

			Попытка
				ТабРезультат = РеквизитФормыВЗначение("_НаборЗаписей");
				ТабРезультат.ЗаполнитьЗначения(мОбъектСсылка, "Регистратор");
				Набор.Загрузить(ТабРезультат);
				Набор.Записать(Истина);
				ОбновитьНаборЗаписейНаСервере();
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция вОписаниеТиповДляUUID(ОписаниеТипов)
	Если ОписаниеТипов.Типы().Количество() = 1 Тогда
		пНовоеОписаниеТипов = новый ОписаниеТипов(ОписаниеТипов, "Строка");
	Иначе
		пНовоеОписаниеТипов = ОписаниеТипов;
	КонецЕсли;
	
	Возврат пНовоеОписаниеТипов;
КонецФункции

#КонецОбласти

&НаСервере
Функция вПолучитьСвойстваТабличногоПоля(Знач ИмяЭФ)
	пРезультат = новый Структура("Отказ, Таблица, Поле", истина, "", "");
	
	ЭФ = Элементы[ИмяЭФ];
	
	Если ТипЗнч(ЭФ) = Тип("ТаблицаФормы") Тогда
		пРезультат.Вставить("Таблица", ЭФ.ПутьКДанным);
		
		ТекПоле = ЭФ.ТекущийЭлемент;
		Если ТипЗнч(ТекПоле) = Тип("ПолеФормы") Тогда
			Значение = ТекПоле.ПутьКДанным;
			Поз = Найти(Значение, ".");
			Если Поз <> 0 Тогда
				Значение = Сред(Значение, Поз+1);
				пРезультат.Вставить("Поле", Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	пРезультат.Отказ = (ПустаяСтрока(пРезультат.Таблица) или ПустаяСтрока(пРезультат.Поле));
	
	Возврат пРезультат;
КонецФункции

&НаСервереБезКонтекста
Процедура вНастроитьТаблицуНабораЗаписей(пНаборЗаписей, пТабРезультат)
	Если пТабРезультат = Неопределено Тогда
		пТабРезультат = новый ТаблицаЗначений;
	КонецЕсли;
	
	пОбъектМД = пНаборЗаписей.Метаданные();
	Если Метаданные.РегистрыБухгалтерии.Содержит(пОбъектМД) Тогда
		пКолонкиДляОбработки = "";
		Для каждого Элем из пОбъектМД.Измерения Цикл
			Если Элем.ПризнакУчета <> Неопределено Тогда
				пСуффиксы = новый Массив;
				Если Элем.Балансовый или не пОбъектМД.Корреспонденция Тогда
					пСуффиксы.Добавить("");
				Иначе
					пСуффиксы.Добавить("Дт");
					пСуффиксы.Добавить("Кт");
				КонецЕсли;
				
				Для каждого пСуфф из пСуффиксы Цикл
					пИмяКолонки = Элем.Имя + пСуфф;
					пСтараяКолонка = пТабРезультат.Колонки.Найти(пИмяКолонки);
					Если пСтараяКолонка <> Неопределено Тогда
						пКолонкиДляОбработки = пКолонкиДляОбработки + "," + пИмяКолонки;
						пТипЗначения = новый ОписаниеТипов(пСтараяКолонка.ТипЗначения, "NULL");
						пНоваяКолонка = пТабРезультат.Колонки.Вставить(пТабРезультат.Колонки.Индекс(пСтараяКолонка), , пТипЗначения, пСтараяКолонка.Заголовок, пСтараяКолонка.Ширина);
						пТабРезультат.Колонки.Удалить(пСтараяКолонка);
						пНоваяКолонка.Имя = пИмяКолонки;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если не ПустаяСтрока(пКолонкиДляОбработки) Тогда
			пКолонкиДляОбработки = Сред(пКолонкиДляОбработки, 2);
			
			Сч = -1;
			Для каждого Стр из пНаборЗаписей Цикл
				Сч = Сч + 1;
				ЗаполнитьЗначенияСвойств(пТабРезультат[Сч], Стр, пКолонкиДляОбработки);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция вСформироватьОтчетПоДвижениям(Знач ДокСсылка, Знач СписокРегистров, Знач пКонфигурацияДопускаетДопДвижения)
	пЧислоТаблицВЗапросе = 200;

	Если пКонфигурацияДопускаетДопДвижения Тогда
		пСтрук = ОпределитьДополнительныеРегистрыДокумента(ДокСсылка);
		Если пСтрук.ЕстьДанные Тогда
			Для Каждого Элем Из пСтрук.ДополнительныеРегистры Цикл
				СписокРегистров.Добавить("+" + Элем.Ключ, Элем.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ДокСсылка);

	ТекстНачалаЗапроса = "ВЫБРАТЬ 0 КАК Инд, 100000000 КАК ПолеА ГДЕ ложь";

	пМассивЗапросов = Новый Массив;
	пМассивЗапросов.Добавить(ТекстНачалаЗапроса);

	ТабРезультат = Неопределено;
	Инд = -1;
	Сч = 0;

	Для Каждого Элем Из СписокРегистров Цикл
		Инд = Инд + 1;
		Сч = Сч + 1;

		Если Сч > пЧислоТаблицВЗапросе Тогда
			Сч = 1;

			Запрос.Текст = СтрСоединить(пМассивЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
			ТабДанные = Запрос.Выполнить().Выгрузить();

			Если ТабРезультат = Неопределено Тогда
				ТабРезультат = ТабДанные;
			Иначе
				Для Каждого Стр Из ТабДанные Цикл
					ЗаполнитьЗначенияСвойств(ТабРезультат.Добавить(), Стр);
				КонецЦикла;
			КонецЕсли;

			пМассивЗапросов.Очистить();
			пМассивЗапросов.Добавить(ТекстНачалаЗапроса);
		КонецЕсли;

		Если Лев(Элем.Значение, 1) = "+" Тогда
			пМассивЗапросов.Добавить("ВЫБРАТЬ "
									 + Инд
									 + ", КОЛИЧЕСТВО(*) ИЗ "
									 + Сред(Элем.Значение, 2)
									 + " КАК т ГДЕ т.ДокументРегистратор = &Регистратор ИМЕЮЩИЕ КОЛИЧЕСТВО(*) > 0");
		Иначе
			пМассивЗапросов.Добавить("ВЫБРАТЬ "
									 + Инд
									 + ", КОЛИЧЕСТВО(*) ИЗ "
									 + Элем.Значение
									 + " КАК т ГДЕ т.Регистратор = &Регистратор ИМЕЮЩИЕ КОЛИЧЕСТВО(*) > 0");
		КонецЕсли;
	КонецЦикла;

	Запрос.Текст = СтрСоединить(пМассивЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	ТабДанные = Запрос.Выполнить().Выгрузить();

	Если ТабРезультат = Неопределено Тогда
		ТабРезультат = ТабДанные;
	Иначе
		Для Каждого Стр Из ТабДанные Цикл
			ЗаполнитьЗначенияСвойств(ТабРезультат.Добавить(), Стр);
		КонецЦикла;
	КонецЕсли;

	Линия1 = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);

	ТДок = Новый ТабличныйДокумент;

	ТДок.Область( , 1, , 1).ШиринаКолонки = 2;
	ТДок.Область( , 2, , 2).ШиринаКолонки = 50;
	ТДок.Область( , 3, , 3).ШиринаКолонки = 50;
	ТДок.Область( , 4, , 4).ШиринаКолонки = 12;

	ТДок.Область(2, 2).Текст = Строка(ДокСсылка);
	ТДок.Область(2, 2, 2, 3).Обвести( , , , Линия1);

	ТДок.Область(4, 2).Текст = "Имя регистра";
	ТДок.Область(4, 3).Текст = "Представление";
	ТДок.Область(4, 4).Текст = "Число записей";
	ТДок.Область(4, 2, 4, 4).ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
	ТДок.Область(4, 2, 4, 4).Обвести(Линия1, Линия1, Линия1, Линия1);

	НПП = 4;
	Для Каждого Стр Из ТабРезультат Цикл
		НПП = НПП + 1;
		пИмяРегистра = СписокРегистров[Стр.Инд].Значение;
		пЭтоДопДвижение = пКонфигурацияДопускаетДопДвижения И (Лев(пИмяРегистра, 1) = "+");

		ТДок.Область(НПП, 2).Текст = ?(пЭтоДопДвижение, Сред(пИмяРегистра, 2), пИмяРегистра);
		ТДок.Область(НПП, 3).Текст = СписокРегистров[Стр.Инд].Представление;
		ТДок.Область(НПП, 4).Текст = Стр.ПолеА;

		Если пЭтоДопДвижение Тогда
			ТДок.Область(НПП, 2, НПП, 4).ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;
	КонецЦикла;

	ТДок.Область(4, 2, НПП, 4).Обвести(Линия1, Линия1, Линия1, Линия1);

	Возврат ТДок;
КонецФункции

&НаСервереБезКонтекста
Функция вОписаниеТиповСтрока(ДлинаСтроки, ПеременнаяДлина = истина)
