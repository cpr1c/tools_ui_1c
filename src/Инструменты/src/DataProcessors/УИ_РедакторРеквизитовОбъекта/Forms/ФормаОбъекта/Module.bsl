Процедура УстановитьВидимостьТабличныхЧастейОбъекта()
	ПрефиксСтраницы = ПрефиксСтраницы();
	Для Каждого ТабличнаяЧасть Из ТабличныеЧастиОбъекта Цикл
		ИмяСтраницы = ПрефиксСтраницы + ТабличнаяЧасть.ИмяНаФорме;
		СтраницаТаблицы = Элементы.Найти(ИмяСтраницы);
		Если СтраницаТаблицы <> Неопределено Тогда
			Если СкрыватьПустыеТабличныеЧасти Тогда
				ДанныеТаблицы = ЭтотОбъект[ТабличнаяЧасть.ИмяНаФорме];
				ЕстьДанные = (ДанныеТаблицы.Количество() > 0);
				СтраницаТаблицы.Видимость = ТабличнаяЧасть.Использование И ЕстьДанные;
			Иначе
				СтраницаТаблицы.Видимость = ТабличнаяЧасть.Использование;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
