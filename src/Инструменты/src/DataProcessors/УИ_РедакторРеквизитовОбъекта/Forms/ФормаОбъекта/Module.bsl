КонецПроцедуры

// Проверка, что описание типов содержит ссылочный тип.
// 
// Параметры:
//  ОписаниеТипов - ОписаниеТипов - Описание типов
// 
// Возвращаемое значение:
//  Булево - описание типов содержит ссылочный тип
&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеТиповСодержитСсылочныйТип(Знач ОписаниеТипов)

	ПримитивныеТипы = Новый Массив;
	ПримитивныеТипы.Добавить(Тип("Дата"));
	ПримитивныеТипы.Добавить(Тип("Число"));
	ПримитивныеТипы.Добавить(Тип("Булево"));
	ПримитивныеТипы.Добавить(Тип("Строка"));
	ПримитивныеТипы.Добавить(Тип("ХранилищеЗначения"));
	ПримитивныеТипы.Добавить(Тип("УникальныйИдентификатор"));

	ЕстьСсылочныйТип = Истина;
	ДоступныеТипы = ОписаниеТипов.Типы();
	Если ДоступныеТипы.Количество() > 0 Тогда
		ЕстьСсылочныйТип = Ложь;
		Для Каждого Элем Из ДоступныеТипы Цикл
			Если ПримитивныеТипы.Найти(Элем) = Неопределено Тогда
				ЕстьСсылочныйТип = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ЕстьСсылочныйТип;

КонецФункции

// Проверка описание типов поддерживает вставку уникального идентификатора.
// 
// Параметры:
//  ОписаниеТипов - ОписаниеТипов - Описание типов
// 
// Возвращаемое значение:
//  Булево - описание типов поддерживает вставку уникального идентификатора
&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеТиповПоддерживаетВставкуУникальногоИдентификатора(Знач ОписаниеТипов)
	
	Результат = ОписаниеТипов.Типы().Количество() = 0
		Или ОписаниеТипов.СодержитТип(Тип("Строка"))
		Или ОписаниеТипов.СодержитТип(Тип("УникальныйИдентификатор"));
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСвойстваТабличногоПоля(Знач ИмяЭлементаФормы)
	Результат = Новый Структура("Отказ, Таблица, Поле", Истина, "", "");
	ЭлементФормы = Элементы[ИмяЭлементаФормы];

	Если ТипЗнч(ЭлементФормы) = Тип("ТаблицаФормы") Тогда
		Результат.Вставить("Таблица", ЭлементФормы.ПутьКДанным);

		ТекПоле = ЭлементФормы.ТекущийЭлемент;
		Если ТипЗнч(ТекПоле) = Тип("ПолеФормы") Тогда
			Значение = ТекПоле.ПутьКДанным;
			Позиция = СтрНайти(Значение, ".");
			Если Позиция <> 0 Тогда
				Значение = Сред(Значение, Позиция + 1);
				Результат.Вставить("Поле", Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Результат.Отказ = (ПустаяСтрока(Результат.Таблица) Или ПустаяСтрока(Результат.Поле));

	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура НастроитьТаблицуНабораЗаписей(Знач НаборЗаписей, ТаблицаРезультата)
	Если ТаблицаРезультата = Неопределено Тогда
		ТаблицаРезультата = Новый ТаблицаЗначений;
	КонецЕсли;

	ОбъектМетаданных = НаборЗаписей.Метаданные();
	Если Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных) Тогда
		КолонкиДляОбработки = "";
		Для Каждого Измерение Из ОбъектМетаданных.Измерения Цикл
			Если Измерение.ПризнакУчета <> Неопределено Тогда
				Суффиксы = Новый Массив;
				Если Измерение.Балансовый Или Не ОбъектМетаданных.Корреспонденция Тогда
					Суффиксы.Добавить("");
				Иначе
					Суффиксы.Добавить("Дт");
					Суффиксы.Добавить("Кт");
				КонецЕсли;

				Для Каждого Суффикс Из Суффиксы Цикл
					ИмяКолонки = Измерение.Имя + Суффикс;
					СтараяКолонка = ТаблицаРезультата.Колонки.Найти(ИмяКолонки);
					Если СтараяКолонка <> Неопределено Тогда
						КолонкиДляОбработки = КолонкиДляОбработки + "," + ИмяКолонки;
						ТипЗначения = Новый ОписаниеТипов(СтараяКолонка.ТипЗначения, "NULL");
						НоваяКолонка = ТаблицаРезультата.Колонки.Вставить(ТаблицаРезультата.Колонки.Индекс(СтараяКолонка),
																		   ,
																		   ТипЗначения,
																		   СтараяКолонка.Заголовок,
																		   СтараяКолонка.Ширина);
						ТаблицаРезультата.Колонки.Удалить(СтараяКолонка);
						НоваяКолонка.Имя = ИмяКолонки;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Если Не ПустаяСтрока(КолонкиДляОбработки) Тогда
			КолонкиДляОбработки = Сред(КолонкиДляОбработки, 2);
			НомерСтроки = 0;
			Для Каждого Стр Из НаборЗаписей Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаРезультата[НомерСтроки], Стр, КолонкиДляОбработки);
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьОтчетПоДвижениям(Знач ДокСсылка, Знач СписокРегистров, Знач КонфигурацияДопускаетДопДвижения)
	
	ЧислоТаблицВЗапросе = 200;
	Если КонфигурацияДопускаетДопДвижения Тогда
		РезультатПроверки = ОпределитьДополнительныеРегистрыДокумента(ДокСсылка);
		Если РезультатПроверки.ЕстьДанные Тогда
			Для Каждого Элемент Из РезультатПроверки.ДополнительныеРегистры Цикл
				СписокРегистров.Добавить("+" + Элемент.Ключ, Элемент.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ДокСсылка);

	ТекстНачалаЗапроса = 
		"ВЫБРАТЬ
		|	0 КАК Инд,
		|	100000000 КАК ПолеА
		|ГДЕ
		|	ЛОЖЬ";
	МассивЗапросов = Новый Массив;
	МассивЗапросов.Добавить(ТекстНачалаЗапроса);

	ТабРезультат = Неопределено;
	Идентификатор = 0;
	НомерТаблицы = 0;

	Для Каждого Элемент Из СписокРегистров Цикл
		НомерТаблицы = НомерТаблицы + 1;

		Если НомерТаблицы > ЧислоТаблицВЗапросе Тогда
			НомерТаблицы = 1;

			Запрос.Текст = СтрСоединить(МассивЗапросов, УИ_ОбщегоНазначения.ТекстОбъединитьВсе());
			ТабДанные = Запрос.Выполнить().Выгрузить();

			Если ТабРезультат = Неопределено Тогда
				ТабРезультат = ТабДанные;
			Иначе
				Для Каждого Стр Из ТабДанные Цикл
					ЗаполнитьЗначенияСвойств(ТабРезультат.Добавить(), Стр);
				КонецЦикла;
			КонецЕсли;

			МассивЗапросов.Очистить();
			МассивЗапросов.Добавить(ТекстНачалаЗапроса);
		КонецЕсли;

		Если Лев(Элемент.Значение, 1) = "+" Тогда
			МассивЗапросов.Добавить("ВЫБРАТЬ "
									 + Идентификатор
									 + ", КОЛИЧЕСТВО(*) ИЗ "
									 + Сред(Элемент.Значение, 2)
									 + " КАК т ГДЕ т.ДокументРегистратор = &Регистратор ИМЕЮЩИЕ КОЛИЧЕСТВО(*) > 0");
		Иначе
			МассивЗапросов.Добавить("ВЫБРАТЬ "
									 + Идентификатор
									 + ", КОЛИЧЕСТВО(*) ИЗ "
									 + Элемент.Значение
									 + " КАК т ГДЕ т.Регистратор = &Регистратор ИМЕЮЩИЕ КОЛИЧЕСТВО(*) > 0");
		КонецЕсли;
		Идентификатор = Идентификатор + 1;
	КонецЦикла;

	Запрос.Текст = СтрСоединить(МассивЗапросов, УИ_ОбщегоНазначения.ТекстОбъединитьВсе());
	ТабДанные = Запрос.Выполнить().Выгрузить();

	Если ТабРезультат = Неопределено Тогда
		ТабРезультат = ТабДанные;
	Иначе
		Для Каждого Стр Из ТабДанные Цикл
			ЗаполнитьЗначенияСвойств(ТабРезультат.Добавить(), Стр);
		КонецЦикла;
	КонецЕсли;

	Линия1 = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);

	ТабличныйДокумент = Новый ТабличныйДокумент;

	ТабличныйДокумент.Область( , 1, , 1).ШиринаКолонки = 2;
	ТабличныйДокумент.Область( , 2, , 2).ШиринаКолонки = 50;
	ТабличныйДокумент.Область( , 3, , 3).ШиринаКолонки = 50;
	ТабличныйДокумент.Область( , 4, , 4).ШиринаКолонки = 12;

	ТабличныйДокумент.Область(2, 2).Текст = Строка(ДокСсылка);
	ТабличныйДокумент.Область(2, 2, 2, 3).Обвести( , , , Линия1);

	ТабличныйДокумент.Область(4, 2).Текст = "Имя регистра";
	ТабличныйДокумент.Область(4, 3).Текст = "Представление";
	ТабличныйДокумент.Область(4, 4).Текст = "Число записей";
	ТабличныйДокумент.Область(4, 2, 4, 4).ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
	ТабличныйДокумент.Область(4, 2, 4, 4).Обвести(Линия1, Линия1, Линия1, Линия1);

	ПорядковыйНомер = 4;
	Для Каждого Стр Из ТабРезультат Цикл
		ПорядковыйНомер = ПорядковыйНомер + 1;
		ИмяРегистра = СписокРегистров[Стр.Инд].Значение;
		ЭтоДопДвижение = КонфигурацияДопускаетДопДвижения И (Лев(ИмяРегистра, 1) = "+");

		ТабличныйДокумент.Область(ПорядковыйНомер, 2).Текст = ?(ЭтоДопДвижение, Сред(ИмяРегистра, 2), ИмяРегистра);
		ТабличныйДокумент.Область(ПорядковыйНомер, 3).Текст = СписокРегистров[Стр.Инд].Представление;
		ТабличныйДокумент.Область(ПорядковыйНомер, 4).Текст = Стр.ПолеА;

		Если ЭтоДопДвижение Тогда
			ТабличныйДокумент.Область(ПорядковыйНомер, 2, ПорядковыйНомер, 4).ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;
	КонецЦикла;

	ТабличныйДокумент.Область(4, 2, ПорядковыйНомер, 4).Обвести(Линия1, Линия1, Линия1, Линия1);

	Возврат ТабличныйДокумент;
	
КонецФункции

&НаКлиенте
Процедура вОбработатьКомандуЗагрузкиДанныхXML(РезультатЗакрытия = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	Если ТипЗнч(РезультатЗакрытия) = Тип("Структура") Тогда
		Если РезультатЗакрытия.ЗагружатьДанныеБезИспользованияФайла Тогда
			СтрокаXML = РезультатЗакрытия.ДанныеXML;
			Если Не ПустаяСтрока(СтрокаXML) Тогда
				РезультатЗакрытия.ДанныеXML = "";
				вЗагрузитьДанныеXML(РезультатЗакрытия, СтрокаXML);
			КонецЕсли;

			Возврат;
		КонецЕсли;

		ПутьКФайлуXML = РезультатЗакрытия.ПутьКФайлуXML;
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("Параметры", РезультатЗакрытия);
		Оповещение = Новый ОписаниеОповещения("вПослеОкончанияЧтенияФайла", ЭтотОбъект, ПараметрыОповещения);
		НачатьСозданиеДвоичныхДанныхИзФайла(Оповещение, ПутьКФайлуXML);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура вПослеОкончанияЧтенияФайла(ДвоичныеДанные, ДополнительныеПараметры) Экспорт
	Если ДвоичныеДанные <> Неопределено И ДвоичныеДанные.Размер() <> 0 Тогда
		вЗагрузитьДанныеXML(ДополнительныеПараметры.Параметры, ДвоичныеДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РежимыРаботыВыгрузкиОбъекта()
	
	Режимы = Новый Структура();
	Режимы.Вставить("ВыгрузкаОбъекта", 1);
	Режимы.Вставить("ВыгрузкаОбъектаСДвижениями", 2);
	Режимы.Вставить("ВыгрузкаОбъектаТолькоДвижения", 3);
	Режимы.Вставить("ВыгрузкаНабораЗаписей", 4);
	Возврат Режимы;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВыгрузкиОбъекта(РежимРаботы)
	Если Не ЗначениеЗаполнено(мОбъектСсылка) Тогда
		ПредупреждениеБезОповещения(НСтр("ru = 'Не задан документ для выгрузки'"));
		Возврат;
	КонецЕсли;

	РежимыРаботыВыгрузкиОбъекта = РежимыРаботыВыгрузкиОбъекта();
	ПараметрыОткрытия = Новый Структура("_Режим, _ИмяФайла", РежимРаботы, "ДанныеXML");
	Если РежимРаботы = РежимыРаботыВыгрузкиОбъекта.ВыгрузкаОбъекта Тогда
		ПараметрыОткрытия._ИмяФайла = "Объект";
	ИначеЕсли РежимРаботы = РежимыРаботыВыгрузкиОбъекта.ВыгрузкаОбъектаСДвижениями Тогда
		ПараметрыОткрытия._ИмяФайла = "Объект (с движениями)";
	ИначеЕсли РежимРаботы = РежимыРаботыВыгрузкиОбъекта.ВыгрузкаОбъектаТолькоДвижения Тогда
		ПараметрыОткрытия._ИмяФайла = "Объект (движения)";
	ИначеЕсли РежимРаботы = РежимыРаботыВыгрузкиОбъекта.ВыгрузкаНабораЗаписей Тогда
		ПараметрыОткрытия._ИмяФайла = _ИмяНабораЗаписей;
	Иначе
		ТекстОшибки = НСтр("ru = 'Указан неизвестный режим работы выгрузки объекта'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ВыгрузитьОбъектВФайл", ЭтотОбъект);
	ОткрытьФорму("Обработка.УИ_РедакторРеквизитовОбъекта.Форма.ФормаВыгрузкаОбъектаXML",
				 ПараметрыОткрытия, , , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОбъектВФайл(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(РезультатЗакрытия) = Тип("Структура") Тогда
		Режим = РезультатЗакрытия.Режим;
		СтрокаXML = СформироватьВыгрузкуXML(мОбъектСсылка,
											 Режим,
											 _ИмяНабораЗаписей,
											 Не РезультатЗакрытия.ВыгружатьДанныеБезИспользованияФайла);
		Если СтрокаXML <> Неопределено Тогда
			Если РезультатЗакрытия.ВыгружатьДанныеБезИспользованияФайла Тогда
				ТДок = Новый ТекстовыйДокумент;
				ТДок.УстановитьТекст(СтрокаXML);
				ТДок.Показать("ДанныеXML");
			Иначе
				ИмяФайла = РезультатЗакрытия.ПутьКФайлуXML;
				СтрокаXML.НачатьЗапись(Новый ОписаниеОповещения("ПослеОкончанияЗаписиФайла", ЭтотОбъект), ИмяФайла);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОкончанияЗаписиФайла(ДополнительныеПараметры) Экспорт
	ПредупреждениеБезОповещения(НСтр("ru = 'Данные выгружены в файл'"));
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьВыгрузкуXML(Знач СсылкаНаОбъект, Знач РежимРаботы, Знач ИмяНабораЗаписей = "",
	Знач ИспользоватьДвоичныеДанные = Истина)

	ЗаписьXML = Новый ЗаписьXML;

	Если ИспользоватьДвоичныеДанные Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
	Иначе
		ЗаписьXML.УстановитьСтроку("UTF-8");
	КонецЕсли;

	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("_1CV8DtUD", "http://www.1c.ru/V8/1CV8DtUD/");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("V8Exch", "http://www.1c.ru/V8/1CV8DtUD/");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("core", "http://v8.1c.ru/data");

	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8", "http://v8.1c.ru/8.1/data/enterprise/current-config");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");

	ЗаписьXML.ЗаписатьНачалоЭлемента("V8Exch:Data");
	Если РежимРаботы = 4 Тогда
		Менеджер = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяНабораЗаписей);
		Если Менеджер <> Неопределено Тогда
			Набор = Менеджер.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(СсылкаНаОбъект);
			Набор.Прочитать();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Набор);
		КонецЕсли;
	Иначе
		Попытка
			Объект = СсылкаНаОбъект.ПолучитьОбъект();
		Исключение
			УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Выгрузка данных не выполнена!'"));
			ЗаписьXML.Закрыть();
			Если ИспользоватьДвоичныеДанные Тогда
				УдалитьФайлы(ИмяФайла);
			КонецЕсли;
			Возврат Неопределено;
		КонецПопытки;
		Если РежимРаботы = 1 Или РежимРаботы = 2 Тогда
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Объект, НазначениеТипаXML.Явное);
		КонецЕсли;
		Если РежимРаботы = 2 Или РежимРаботы = 3 Тогда
			ОбъектМетаданных = Объект.Метаданные();
			Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
				КэшИмен = Новый Соответствие;
				Для Каждого Движение Из Объект.Движения Цикл
					ПолноеИмя = Движение.Метаданные().ПолноеИмя();
					Если КэшИмен[ПолноеИмя] = Неопределено Тогда
						// Защита от кривых конфигураций
						КэшИмен[ПолноеИмя] = 1;
						Движение.Прочитать();
						СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Движение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента(); // V8Exc:Data
	ЗаписьXML.ЗаписатьКонецЭлемента(); // V8Exc:_1CV8DtUD

	СтрокаXML = ЗаписьXML.Закрыть();

	Если ИспользоватьДвоичныеДанные Тогда
		СтрокаXML = Новый ДвоичныеДанные(ИмяФайла);
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;

	Возврат СтрокаXML;

КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьПроцедуруВКонтекстеОбъекта(ОбъектКонтекта, ПроцедураПередЗаписью)
	Попытка
		УИ_ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПроцедураПередЗаписью);
	Исключение
		УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Важное);
		ВызватьИсключение НСтр("ru = 'Ошибка при выполнение процедуры перед записью!'");
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура вЗагрузитьДанныеXML(Знач ПараметрыВыполнения, Знач СтрокаXML)

	ИспользоватьДвоичныеДанные = (ТипЗнч(СтрокаXML) = Тип("ДвоичныеДанные"));
	ЧтениеXML = Новый ЧтениеXML;

	Если ИспользоватьДвоичныеДанные Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		СтрокаXML.Записать(ИмяФайла);
		ЧтениеXML.ОткрытьФайл(ИмяФайла, , , "UTF-8");
	Иначе
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
	КонецЕсли;

	УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Загрузка данных стартовала'"));

	ОшибкаФормата = Ложь;
	ТекстНеверныйФормат = НСтр("ru = 'Неверный формат файла выгрузки'");

	Попытка
		// Проверка формата
		Если ОшибкаФормата
			 Или Не ЧтениеXML.Прочитать()
			 Или ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
			 Или ЧтениеXML.ЛокальноеИмя <> "_1CV8DtUD"
			 Или ЧтениеXML.URIПространстваИмен <> "http://www.1c.ru/V8/1CV8DtUD/" Тогда

			ОшибкаФормата = Истина;
		КонецЕсли;

		Если ОшибкаФормата
			 Или Не ЧтениеXML.Прочитать()
			 Или ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
			 Или ЧтениеXML.ЛокальноеИмя <> "Data" Тогда

			ОшибкаФормата = Истина;
		КонецЕсли;

		Если ОшибкаФормата Или Не ЧтениеXML.Прочитать() Тогда

			ОшибкаФормата = Истина;
		КонецЕсли;

	Исключение
		ОшибкаФормата = Истина;
	КонецПопытки;

	Если ОшибкаФормата Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстНеверныйФормат, СтатусСообщения.Важное);
		ЧтениеXML.Закрыть();

		Если ИспользоватьДвоичныеДанные Тогда
			УдалитьФайлы(ИмяФайла);
		КонецЕсли;

		Возврат;
	КонецЕсли;
	
	// параметры загрузки
	ЗагружатьВТранзакции = ПараметрыВыполнения.ЗагружатьВТранзакции;
	ЗагружатьВРежимеОбменДанными = ПараметрыВыполнения.ЗагружатьВРежимеОбменДанными;
	ПродолжатьЗагрузкуПриОшибке = ПараметрыВыполнения.ПродолжатьЗагрузкуПриОшибке;
	ИспользоватьДополнительныеСвойстваПриЗаписи = ПараметрыВыполнения.ИспользоватьДополнительныеСвойстваПриЗаписи;
	ИспользоватьПроцедуруПередЗаписью = ПараметрыВыполнения.ИспользоватьПроцедуруПередЗаписью;
	ДополнительныеСвойства = ПараметрыВыполнения.ДополнительныеСвойства;
	ПроцедураПередЗаписью = ПараметрыВыполнения.ПроцедураПередЗаписью;

	ПродолжатьЗагрузкуПриОшибке = ПродолжатьЗагрузкуПриОшибке И Не ЗагружатьВТранзакции;
	ИспользоватьДополнительныеСвойстваПриЗаписи = ИспользоватьДополнительныеСвойстваПриЗаписи
												   И ДополнительныеСвойства.Количество() <> 0;
	ИспользоватьПроцедуруПередЗаписью = ИспользоватьПроцедуруПередЗаписью И Не ПустаяСтрока(ПроцедураПередЗаписью);
	
	// чтение данных
	Если ЗагружатьВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;

	Пока СериализаторXDTO.ВозможностьЧтенияXML(ЧтениеXML) Цикл
		Попытка
			ОбъектЗаписи = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
			ОбъектЗаписи.ОбменДанными.Загрузка = ЗагружатьВРежимеОбменДанными;

			Если ИспользоватьДополнительныеСвойстваПриЗаписи Тогда
				Для Каждого Элем Из ДополнительныеСвойства Цикл
					ОбъектЗаписи.ДополнительныеСвойства.Вставить(Элем.Ключ, Элем.Значение);
				КонецЦикла;
			КонецЕсли;

			Если ИспользоватьПроцедуруПередЗаписью Тогда
				ВыполнитьПроцедуруВКонтекстеОбъекта(ОбъектЗаписи, ПроцедураПередЗаписью);
			КонецЕсли;

			ОбъектЗаписи.Записать();
		Исключение
			УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Если Не ПродолжатьЗагрузкуПриОшибке Тогда
				ОшибкаФормата = Истина;
				Прервать;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Если ОшибкаФормата Тогда
		Если ЗагружатьВТранзакции Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		ЧтениеXML.Закрыть();
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Загрузка данных прервана'"), СтатусСообщения.Важное);

		Если ИспользоватьДвоичныеДанные Тогда
			УдалитьФайлы(ИмяФайла);
		КонецЕсли;

		Возврат;
	Иначе
		Если ЗагружатьВТранзакции Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	// проверка формата
	Если ОшибкаФормата Или ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Или ЧтениеXML.ЛокальноеИмя <> "Data" Тогда

		ОшибкаФормата = Истина;
	КонецЕсли;

	Если ОшибкаФормата
		 Или Не ЧтениеXML.Прочитать()
		 Или ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента
		 Или ЧтениеXML.ЛокальноеИмя <> "_1CV8DtUD"
		 Или ЧтениеXML.URIПространстваИмен <> "http://www.1c.ru/V8/1CV8DtUD/" Тогда

		ОшибкаФормата = Истина;
	КонецЕсли;

	Если ОшибкаФормата Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстНеверныйФормат, СтатусСообщения.Важное);
		ЧтениеXML.Закрыть();
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Загрузка данных завершена'"));

		Если ИспользоватьДвоичныеДанные Тогда
			УдалитьФайлы(ИмяФайла);
		КонецЕсли;

		Возврат;
	КонецЕсли;

	ЧтениеXML.Закрыть();

	Если ИспользоватьДвоичныеДанные Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;

	УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Загрузка данных завершена'"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьВидОбъекта(Знач СсылкаНаОбъект)
	Если СсылкаНаОбъект = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат УИ_ОбщегоНазначения.ВидОбъектаПоСсылке(СсылкаНаОбъект);
	КонецЕсли;
КонецФункции

&НаСервере
Процедура вЗаполнитьЗависимыеОбъекты()

	ОчиститьЗависимыеОбъекты();

	_КоличествоЗависимых = 0;
	пОбщееКоличество = 0;

	пОбъектМД = Метаданные.НайтиПоПолномуИмени(ТипОбъектаРедактирования);
	Если пОбъектМД = Неопределено Тогда
		Возврат;
	КонецЕсли;

	пКорневойУзел = _ЗависимыеОбъекты.ПолучитьЭлементы().Добавить();
	пКорневойУзел.ВидУзла = 1;
	пКорневойУзел.Имя = пОбъектМД.Имя;
	пКорневойУзел.Представление = пОбъектМД.Представление();
	пКорневойУзел.ПолноеИмя = ТипОбъектаРедактирования;

	Поз = СтрНайти(ТипОбъектаРедактирования, ".");
	пТипДляПоиска = Тип(Лев(ТипОбъектаРедактирования, Поз - 1) + "Ссылка" + Сред(ТипОбъектаРедактирования, Поз));

	пНадоСмотретьПланСчетов = (Лев(ТипОбъектаРедактирования, Поз - 1) = "ПланСчетов");
	пНадоСмотретьПланВидовРасчета = (Лев(ТипОбъектаРедактирования, Поз - 1) = "ПланВидовРасчета");

	пНадоСмотретьВладельцев = (Лев(ТипОбъектаРедактирования, Поз - 1) = "Справочник");
	пНадоСмотретьРегистраторов = (Лев(ТипОбъектаРедактирования, Поз - 1) = "Документ");
	пНадоСмотретьВидыСубконтоПС = (Лев(ТипОбъектаРедактирования, Поз - 1) = "ПланВидовХарактеристик");
	пНадоСмотретьРодителя = (Лев(ТипОбъектаРедактирования, Поз - 1) = "Справочник") Или (Лев(ТипОбъектаРедактирования,
																							 Поз - 1)
																						 = "ПланВидовХарактеристик");

	Если пНадоСмотретьРодителя И Не пОбъектМД.Иерархический Тогда
		пНадоСмотретьРодителя = Ложь;
	КонецЕсли;

	ДанныеПоОбщимРеквизитам = УИ_ОбщегоНазначения.ДанныеПоОбщимРеквизитам(АдресОбщихРеквизитов);
	пТабТипы = ДанныеПоОбщимРеквизитам.Скопировать( , "Тип");
	пТабТипы.Свернуть("Тип");
	пМассивОТ = Новый Массив;
	Для Каждого Стр Из пТабТипы Цикл
		Если Стр.Тип.СодержитТип(пТипДляПоиска) Тогда
			пМассивОТ.Добавить(Стр.Тип);
		КонецЕсли;
	КонецЦикла;

	пНадоСмотретьОбщиеРеквизиты = (пМассивОТ.Количество() <> 0);
	Если пНадоСмотретьОбщиеРеквизиты Тогда
		пТабОбщиеРеквизитыХХХ = Неопределено;
		Для Каждого Элем Из пМассивОТ Цикл
			Если пТабОбщиеРеквизитыХХХ = Неопределено Тогда
				пТабОбщиеРеквизитыХХХ = ДанныеПоОбщимРеквизитам.Скопировать(Новый Структура("Тип", Элем));
			Иначе
				Для Каждого Стр Из ДанныеПоОбщимРеквизитам.НайтиСтроки(Новый Структура("Тип", Элем)) Цикл
					ЗаполнитьЗначенияСвойств(пТабОбщиеРеквизитыХХХ.Добавить(), Стр);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		пТабОбщиеРеквизитыХХХ.Индексы.Добавить("Объект");
		ДанныеПоОбщимРеквизитам = Неопределено;
	КонецЕсли;

	пТабРезультат = Новый ТаблицаЗначений;
	пТабРезультат.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	пТабРезультат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	пТабРезультат.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	пТабРезультат.Колонки.Добавить("ГдеНайдено", Новый ОписаниеТипов("Строка"));
	
	// ---
	пСтрукРазделы = Новый Структура("ПараметрыСеанса, ОпределяемыеТипы, Константы");

	пСоотв = Новый Соответствие;

	Для Каждого пЭлем Из пСтрукРазделы Цикл
		пТабРезультат.Очистить();

		пРазделМД = Метаданные[пЭлем.Ключ];

		Для Каждого ОбъектМД Из пРазделМД Цикл
			пПолноеИмя = ОбъектМД.ПолноеИмя();
			пГдеНайдено = "";
			пСчетчик = 0;

			Если ОбъектМД.Тип.Типы().Найти(пТипДляПоиска) <> Неопределено Тогда
				пПуть = "Объект.Тип";
				Если пСчетчик = 0 Тогда
					пГдеНайдено = пПуть;
				Иначе
					пГдеНайдено = пГдеНайдено + "," + пПуть;
				КонецЕсли;
				пСчетчик = пСчетчик + 1;

				пСоотв[пПолноеИмя] = 1;
			КонецЕсли;

			Если пСоотв[пПолноеИмя] <> Неопределено Тогда
				НС = пТабРезультат.Добавить();
				НС.Имя = ОбъектМД.Имя;
				НС.Представление = ОбъектМД.Представление();
				НС.ПолноеИмя = пПолноеИмя;
				НС.ГдеНайдено = пГдеНайдено;
			КонецЕсли;
		КонецЦикла;

		пКоличество = пТабРезультат.Количество();
		Если пКоличество <> 0 Тогда
			пОбщееКоличество = пОбщееКоличество + пКоличество;

			пТабРезультат.Сортировать("Имя");

			пУзелРаздела = пКорневойУзел.ПолучитьЭлементы().Добавить();
			пУзелРаздела.Имя = пЭлем.Ключ + " (" + пКоличество + ")";
			пУзелРаздела.ВидУзла = 2;
			пКоллекцияЭлементов = пУзелРаздела.ПолучитьЭлементы();

			Для Каждого Стр Из пТабРезультат Цикл
				ЗаполнитьЗначенияСвойств(пКоллекцияЭлементов.Добавить(), Стр);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// ---
	пСтрукРазделы = Новый Структура("ПланыОбмена, Справочники, Документы, ПланыВидовРасчета, ПланыВидовХарактеристик, ПланыСчетов,
									|РегистрыСведений, РегистрыНакопления, РегистрыБухгалтерии, РегистрыРасчета,
									|БизнесПроцессы, Задачи");

	пСтрукОбласти = Новый Структура("Измерения, Ресурсы, Реквизиты");

	пСоотв = Новый Соответствие;

	Для Каждого пЭлем Из пСтрукРазделы Цикл
		пТабРезультат.Очистить();

		пРазделМД = Метаданные[пЭлем.Ключ];

		пЭтоПланСчетов = (пЭлем.Ключ = "ПланыСчетов");
		пЭтоПланОбмена = (пЭлем.Ключ = "ПланыОбмена");
		пЭтоСправочник = (пЭлем.Ключ = "Справочники");
		пЭтоРегистр = (СтрНайти(пЭлем.Ключ, "Регистры") = 1);

		Для Каждого ОбъектМД Из пРазделМД Цикл
			пПолноеИмя = ОбъектМД.ПолноеИмя();
			пГдеНайдено = "";
			пСчетчик = 0;

			Если пЭтоРегистр Тогда
				Если пНадоСмотретьРегистраторов И пОбъектМД.Движения.Содержит(ОбъектМД) Тогда
					Если пСчетчик = 0 Тогда
						пГдеНайдено = "Объект.Реквизиты.Регистратор";
					Иначе
						пГдеНайдено = пГдеНайдено + ",Объект.Реквизиты.Регистратор";
					КонецЕсли;
					пСчетчик = пСчетчик + 1;

					пСоотв[пПолноеИмя] = 1;
				КонецЕсли;

				Если пНадоСмотретьПланСчетов И СтрНайти(пПолноеИмя, "РегистрБухгалтерии") = 1 Тогда
					Если ОбъектМД.ПланСчетов = пОбъектМД Тогда
						Если пСчетчик = 0 Тогда
							пГдеНайдено = "Объект.Реквизиты.Счет";
						Иначе
							пГдеНайдено = пГдеНайдено + ",Объект.Реквизиты.Счет";
						КонецЕсли;
						пСчетчик = пСчетчик + 1;

						пСоотв[пПолноеИмя] = 1;
					КонецЕсли;
				КонецЕсли;

				Если пНадоСмотретьПланВидовРасчета И СтрНайти(пПолноеИмя, "РегистрРасчета") = 1 Тогда
					Если ОбъектМД.ПланВидовРасчета = пОбъектМД Тогда
						Если пСчетчик = 0 Тогда
							пГдеНайдено = "Объект.Реквизиты.ВидРасчета";
						Иначе
							пГдеНайдено = пГдеНайдено + ",Объект.Реквизиты.ВидРасчета";
						КонецЕсли;
						пСчетчик = пСчетчик + 1;

						пСоотв[пПолноеИмя] = 1;
					КонецЕсли;
				КонецЕсли;

				Для Каждого пОбласть Из пСтрукОбласти Цикл
					Для Каждого пРеквизит Из ОбъектМД[пОбласть.Ключ] Цикл
						Если пРеквизит.Тип.Типы().Найти(пТипДляПоиска) <> Неопределено Тогда
							пПуть = "Объект." + пОбласть.Ключ + "." + пРеквизит.Имя;
							Если пСчетчик = 0 Тогда
								пГдеНайдено = пПуть;
							Иначе
								пГдеНайдено = пГдеНайдено + "," + пПуть;
							КонецЕсли;
							пСчетчик = пСчетчик + 1;

							пСоотв[пПолноеИмя] = 1;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;

			Иначе // для не регистров

				Если пНадоСмотретьВладельцев И пЭтоСправочник Тогда
					Если ОбъектМД.Владельцы.Содержит(пОбъектМД) Тогда
						Если пСчетчик = 0 Тогда
							пГдеНайдено = "Объект.Реквизиты.Владелец";
						Иначе
							пГдеНайдено = пГдеНайдено + ",Объект.Реквизиты.Владелец";
						КонецЕсли;
						пСчетчик = пСчетчик + 1;

						пСоотв[пПолноеИмя] = 1;
					КонецЕсли;
				КонецЕсли;

				Если пНадоСмотретьРодителя И пПолноеИмя = ТипОбъектаРедактирования Тогда
					Если пСчетчик = 0 Тогда
						пГдеНайдено = "Объект.Реквизиты.Родитель";
					Иначе
						пГдеНайдено = пГдеНайдено + ",Объект.Реквизиты.Родитель";
					КонецЕсли;
					пСчетчик = пСчетчик + 1;

					пСоотв[пПолноеИмя] = 1;
				КонецЕсли;

				Для Каждого пРеквизит Из ОбъектМД.Реквизиты Цикл
					Если пРеквизит.Тип.Типы().Найти(пТипДляПоиска) <> Неопределено Тогда
						Если пСчетчик = 0 Тогда
							пГдеНайдено = "Объект.Реквизиты." + пРеквизит.Имя;
						Иначе
							пГдеНайдено = пГдеНайдено + ",Объект.Реквизиты." + пРеквизит.Имя;
						КонецЕсли;
						пСчетчик = пСчетчик + 1;

						пСоотв[пПолноеИмя] = 1;
					КонецЕсли;
				КонецЦикла;

				Для Каждого пТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
					Для Каждого пРеквизит Из пТабличнаяЧасть.Реквизиты Цикл
						Если пРеквизит.Тип.Типы().Найти(пТипДляПоиска) <> Неопределено Тогда
							Если пСчетчик = 0 Тогда
								пГдеНайдено = "Объект." + пТабличнаяЧасть.Имя + ".Реквизиты." + пРеквизит.Имя;
							Иначе
								пГдеНайдено = пГдеНайдено
											  + ",Объект."
											  + пТабличнаяЧасть.Имя
											  + ".Реквизиты."
											  + пРеквизит.Имя;
							КонецЕсли;
							пСчетчик = пСчетчик + 1;

							пСоотв[пПолноеИмя] = 1;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;

				Если пЭтоПланОбмена Тогда
					Если ОбъектМД.Состав.Содержит(пОбъектМД) Тогда
						Если пСчетчик = 0 Тогда
							пГдеНайдено = "Объект.Состав";
						Иначе
							пГдеНайдено = пГдеНайдено + ",Объект.Состав";
						КонецЕсли;
						пСчетчик = пСчетчик + 1;

						пСоотв[пПолноеИмя] = 1;
					КонецЕсли;
				КонецЕсли;

				Если пЭтоПланСчетов И пНадоСмотретьВидыСубконтоПС Тогда
					Если ОбъектМД.ВидыСубконто = пОбъектМД Тогда
						Если пСчетчик = 0 Тогда
							пГдеНайдено = "Объект.ВидыСубконто";
						Иначе
							пГдеНайдено = пГдеНайдено + ",Объект.ВидыСубконто";
						КонецЕсли;
						пСчетчик = пСчетчик + 1;

						пСоотв[пПолноеИмя] = 1;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			Если пНадоСмотретьОбщиеРеквизиты Тогда
				Для Каждого Стр Из пТабОбщиеРеквизитыХХХ.НайтиСтроки(Новый Структура("Объект", пПолноеИмя)) Цикл
					Если пСчетчик = 0 Тогда
						пГдеНайдено = "Объект.Реквизиты." + Стр.Имя;
					Иначе
						пГдеНайдено = пГдеНайдено + ",Объект.Реквизиты." + Стр.Имя;
					КонецЕсли;
					пСчетчик = пСчетчик + 1;

					пСоотв[пПолноеИмя] = 1;
				КонецЦикла;
			КонецЕсли;

			Если пСоотв[пПолноеИмя] <> Неопределено Тогда
				НС = пТабРезультат.Добавить();
				НС.Имя = ОбъектМД.Имя;
				НС.Представление = ОбъектМД.Представление();
				НС.ПолноеИмя = пПолноеИмя;
				НС.ГдеНайдено = пГдеНайдено;
			КонецЕсли;
		КонецЦикла;

		пКоличество = пТабРезультат.Количество();
		Если пКоличество <> 0 Тогда
			пОбщееКоличество = пОбщееКоличество + пКоличество;

			пТабРезультат.Сортировать("Имя");

			пУзелРаздела = пКорневойУзел.ПолучитьЭлементы().Добавить();
			пУзелРаздела.Имя = пЭлем.Ключ + " (" + пКоличество + ")";
			пУзелРаздела.ВидУзла = 2;
			пКоллекцияЭлементов = пУзелРаздела.ПолучитьЭлементы();

			Для Каждого Стр Из пТабРезультат Цикл
				ЗаполнитьЗначенияСвойств(пКоллекцияЭлементов.Добавить(), Стр);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	_КоличествоЗависимых = пОбщееКоличество;

	Если _КоличествоЗависимых > 0 Тогда
		Элементы.ДекорацияСсылкиНаОбъект.Заголовок = "Ссылки на объекты конфигурации (" + _КоличествоЗависимых + ")";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаАктивизацииСтрокиЗависимых()
	ТекущиеДанные = Элементы._ЗависимыеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		_ГдеНайдено = СтрЗаменить(ТекущиеДанные.ГдеНайдено, ",", Символы.ПС);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСпискаЗависимых()
	
	ТекущиеДанные = Элементы._ЗависимыеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.ВидУзла = 0 Тогда
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("мОбъектСсылка", мОбъектСсылка);
		ПараметрыФормы.Вставить("АдресаХранилищ", _АдресаХранилищ);
		ПараметрыФормы.Вставить("ПолноеИмя", ТекущиеДанные.ПолноеИмя);
		ПараметрыФормы.Вставить("ГдеНайдено", ТекущиеДанные.ГдеНайдено);
		ПараметрыФормы.Вставить("ОграничениеНаСписокЗависимых", ОграничениеНаСписокЗависимых);
		ПараметрыФормы.Вставить("АдресОбщихРеквизитов", АдресОбщихРеквизитов);
		ОткрытьФорму("Обработка.УИ_РедакторРеквизитовОбъекта.Форма.ФормаСпискаЗависимых", ПараметрыФормы, , Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция вСформироватьТаблицуСвойств()
	ТипСтрока = Новый ОписаниеТипов("Строка");

	ТабРезультат = Новый ТаблицаЗначений;
	ТабРезультат.Колонки.Добавить("Имя", ТипСтрока);
	ТабРезультат.Колонки.Добавить("Индексирование", ТипСтрока);
	ТабРезультат.Колонки.Добавить("Синоним", ТипСтрока);
	ТабРезультат.Колонки.Добавить("Комментарий", ТипСтрока);
	ТабРезультат.Колонки.Добавить("ТипСтрокой", ТипСтрока);
	ТабРезультат.Колонки.Добавить("ОбщийРеквизит", Новый ОписаниеТипов("Булево"));
	ТабРезультат.Колонки.Добавить("Расширение", Новый ОписаниеТипов("Булево"));
	ТабРезультат.Колонки.Добавить("ИзмененРасширениями", Новый ОписаниеТипов("Булево"));

	Возврат ТабРезультат;
КонецФункции

&НаСервереБезКонтекста
Функция вПолучитьСвойстовоИндексирование(Знач ОбъектМД)
	Структура = Новый Структура("Индексирование");
	СвойствоИндексирование = Метаданные.СвойстваОбъектов.Индексирование;

	ЗаполнитьЗначенияСвойств(Структура, ОбъектМД);
	Если Структура.Индексирование = Неопределено Тогда
		Значение = "";
	ИначеЕсли Структура.Индексирование = СвойствоИндексирование.НеИндексировать Тогда
		Значение = "";
	Иначе
		Значение = Структура.Индексирование;
	КонецЕсли;

	Возврат Значение;
КонецФункции

&НаСервере
Процедура вЗаполнитьСпецСвойствоОбъекта(ОбъектМД, УзелДЗ, ИмяСвойства)
	Если ОбъектМД[ИмяСвойства].Количество() <> 0 Тогда
		РазделДЗ = УзелДЗ.ПолучитьЭлементы().Добавить();
		РазделДЗ.Имя = ИмяСвойства;
		Для Каждого Элем Из ОбъектМД[ИмяСвойства] Цикл
			СтрДЗ = РазделДЗ.ПолучитьЭлементы().Добавить();
			СтрДЗ.Имя = Элем.Имя;
			СтрДЗ.Синоним = Элем.Представление();
			СтрДЗ.Комментарий = Элем.Комментарий;
			СтрДЗ.ТипСтрокой = Элем.ПолноеИмя();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура вЗаполнитьСвойстваОбъекта(ОбъектМД, УзелДЗ, ПереченьСвойств)

	РазделДЗ = УзелДЗ.ПолучитьЭлементы().Добавить();
	РазделДЗ.ВидУзла = 2;
	РазделДЗ.Имя = "Свойства";

	ТипОбъектМД = Тип("ОбъектМетаданных");
	ТипОписаниеТипов = Тип("ОписаниеТипов");

	пРасширениеКонфигурации = ОбъектМД.РасширениеКонфигурации();
	Если пРасширениеКонфигурации <> Неопределено Тогда
		СтрДЗ = РазделДЗ.ПолучитьЭлементы().Добавить();
		СтрДЗ.Имя = "РасширениеКонфигурации";
		СтрДЗ.Синоним = пРасширениеКонфигурации.Имя;
		СтрДЗ.ТипСтрокой = "РасширениеКонфигурации";
		СтрДЗ.Комментарий = пРасширениеКонфигурации.Синоним;
	КонецЕсли;

	Струк = Новый Структура(ПереченьСвойств);
	ЗаполнитьЗначенияСвойств(Струк, ОбъектМД);
	Для Каждого Элем Из Струк Цикл
		СтрДЗ = РазделДЗ.ПолучитьЭлементы().Добавить();
		СтрДЗ.Имя = Элем.Ключ;
		СтрДЗ.Синоним = Элем.Значение;
		Если Элем.Значение <> Неопределено Тогда
			пТипЗнч = ТипЗнч(Элем.Значение);
			Если пТипЗнч = ТипОбъектМД Тогда
				СтрДЗ.ТипСтрокой = Элем.Значение.ПолноеИмя();
			ИначеЕсли пТипЗнч = ТипОписаниеТипов Тогда
				СтрДЗ.ТипСтрокой = ПредставлениеОписанияТипа(Элем.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура вЗаполнитьСтандартныеРеквизитыОбъекта(ОбъектМД, УзелДЗ)
	Если ОбъектМД.СтандартныеРеквизиты.Количество() <> 0 Тогда
		РазделДЗ = УзелДЗ.ПолучитьЭлементы().Добавить();
		РазделДЗ.ВидУзла = 2;
		РазделДЗ.Имя = "СтандартныеРеквизиты";
		Для Каждого Элем Из ОбъектМД.СтандартныеРеквизиты Цикл
			СтрДЗ = РазделДЗ.ПолучитьЭлементы().Добавить();
			СтрДЗ.Имя = Элем.Имя;
			СтрДЗ.Синоним = Элем.Представление();
			СтрДЗ.Комментарий = Элем.Комментарий;
			//СтрДЗ.ТипСтрокой = Элем.ПолноеИмя();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура вЗаполнитьТабличныеЧастиОбъекта(ОбъектМД, УзелДЗ)
	Список = Новый СписокЗначений;
	Для Каждого Элем Из ОбъектМД.ТабличныеЧасти Цикл
		Список.Добавить(Элем.Имя);
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Для Каждого ЭлемХ Из Список Цикл
		Элем = ОбъектМД.ТабличныеЧасти[ЭлемХ.Значение];
		РазделДЗ = УзелДЗ.ПолучитьЭлементы().Добавить();
		РазделДЗ.ВидУзла = 2;
		РазделДЗ.Имя = "ТЧ." + Элем.Имя;
		РазделДЗ.Расширение = (Элем.РасширениеКонфигурации() <> Неопределено);
		РазделДЗ.ИзмененРасширениями = Элем.ЕстьИзмененияРасширениямиКонфигурации();

		Таблица = вСформироватьТаблицуСвойств();
		Для Каждого ЭлемТЧ Из Элем.Реквизиты Цикл
			Стр = Таблица.Добавить();
			Стр.Имя = ЭлемТЧ.Имя;
			Стр.Индексирование = вПолучитьСвойстовоИндексирование(ЭлемТЧ);
			Стр.Синоним = ЭлемТЧ.Представление();
			Стр.Комментарий = ЭлемТЧ.Комментарий;
			Стр.ТипСтрокой = ПредставлениеОписанияТипа(ЭлемТЧ.Тип);
			Стр.Расширение = (Элем.РасширениеКонфигурации() <> Неопределено);
			Стр.ИзмененРасширениями = Элем.ЕстьИзмененияРасширениямиКонфигурации();
		КонецЦикла;
		Таблица.Сортировать("Имя");

		Для Каждого Стр Из Таблица Цикл
			СтрДЗ = РазделДЗ.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(СтрДЗ, Стр);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура вЗаполнитьСвойствоКоллекцияОбъекта(ОбъектМД, УзелДЗ, ИмяКоллекции, Сортировать = Истина,
	ПолеСортировки = "Имя", ЗаполнятьИндексирование = Ложь)
	Если ОбъектМД[ИмяКоллекции].Количество() <> 0 Тогда
		Таблица = вСформироватьТаблицуСвойств();
		Для Каждого Элем Из ОбъектМД[ИмяКоллекции] Цикл
			Стр = Таблица.Добавить();
			Стр.Имя = Элем.Имя;
			Если ЗаполнятьИндексирование Тогда
				Стр.Индексирование = вПолучитьСвойстовоИндексирование(Элем);
			КонецЕсли;
			Стр.Синоним = Элем.Представление();
			Стр.Комментарий = Элем.Комментарий;
			Стр.ТипСтрокой = Элем.ПолноеИмя();
			Стр.Расширение = (Элем.РасширениеКонфигурации() <> Неопределено);
			Стр.ИзмененРасширениями = Элем.ЕстьИзмененияРасширениямиКонфигурации();
		КонецЦикла;

		Если Сортировать Тогда
			Таблица.Сортировать(ПолеСортировки);
		КонецЕсли;

		РазделДЗ = УзелДЗ.ПолучитьЭлементы().Добавить();
		РазделДЗ.ВидУзла = 2;
		РазделДЗ.Имя = ИмяКоллекции + " (" + Таблица.Количество() + ")";
		Для Каждого Элем Из Таблица Цикл
			СтрДЗ = РазделДЗ.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(СтрДЗ, Элем);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура вЗаполнитьВладельцевОбъекта(ОбъектМД, УзелДЗ)
	вЗаполнитьСвойствоКоллекцияОбъекта(ОбъектМД, УзелДЗ, "Владельцы");
