&НаКлиенте
Процедура _ВставитьСсылкуНаОбъект(Команда)
	
	ДоступныеТипы = Новый ОписаниеТипов;
	Если ТекущийЭлемент.ТолькоПросмотр Или Не ТекущийЭлемент.Доступность Тогда
		Возврат;
	КонецЕсли;

	ЕстьСсылочныйТип = Ложь;

	Если ТипЗнч(ТекущийЭлемент) = Тип("ПолеФормы") Тогда
		ПолеФормы = ТекущийЭлемент;
	ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		ПолеФормы = ТекущийЭлемент.ТекущийЭлемент;
		Если ПолеФормы.ТолькоПросмотр Или Не ПолеФормы.Доступность Тогда
			Возврат;
		КонецЕсли;

		ТекДанные = ТекущийЭлемент.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Если ТекущийЭлемент.Имя = "РеквизитыОбъекта" И Не ТекДанные.ТолькоПросмотр Тогда
			ЕстьСсылочныйТип = ОписаниеТиповСодержитСсылочныйТип(ТекДанные.ТипЗначения);
			Если Не ЕстьСсылочныйТип Тогда
				Возврат;
			КонецЕсли;
			ДоступныеТипы = ТекДанные.ТипЗначения;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;

	Если Не ЕстьСсылочныйТип Тогда
		ЕстьСсылочныйТип = ОписаниеТиповСодержитСсылочныйТип(ПолеФормы.ДоступныеТипы);
		ДоступныеТипы = ПолеФормы.ДоступныеТипы;
	КонецЕсли;
	
	Если ЕстьСсылочныйТип Тогда
		Имя = ПутьКДаннымТекущегоЭлемента();
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Возврат;
		КонецЕсли;
		ДополнительныеПараметры = Новый Структура("Таблица");
		ДополнительныеПараметры.Вставить("Имя", Имя);
		Если ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
			ДополнительныеПараметры.Таблица = ТекущийЭлемент.Имя;
		КонецЕсли;
		ДополнительныеПараметры.Вставить("ДоступныеТипы", ДоступныеТипы);

		Оповещение = Новый ОписаниеОповещения("ВставитьСсылкуНаОбъектПродолжение", ЭтотОбъект, ДополнительныеПараметры);
		УИ_БуферОбменаКлиент.НачатьПолучениеСтрокиИзБуфера(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура _ВставитьСсылкуИзБуфераОбмена(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ВставитьСсылкуИзБуфераОбменаПродолжение", ЭтотОбъект);
	УИ_БуферОбменаКлиент.НачатьПолучениеСтрокиИзБуфера(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура _ВставитьУникальныйИдентификатор(Команда)
	
	Если ТекущийЭлемент.ТолькоПросмотр Или Не ТекущийЭлемент.Доступность Тогда
		Возврат;
	КонецЕсли;

	МожноВставить = Ложь;
	Если ТипЗнч(ТекущийЭлемент) = Тип("ПолеФормы") Тогда
		ПолеФормы = ТекущийЭлемент;
	ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		ПолеФормы = ТекущийЭлемент.ТекущийЭлемент;
		Если ПолеФормы.ТолькоПросмотр Или Не ПолеФормы.Доступность Тогда
			Возврат;
		КонецЕсли;
		ТекДанные = ТекущийЭлемент.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ТекущийЭлемент.Имя = "РеквизитыОбъекта" И Не ТекДанные.ТолькоПросмотр Тогда
			МожноВставить = ОписаниеТиповПоддерживаетВставкуУникальногоИдентификатора(ТекДанные.ТипЗначения);
			Если Не МожноВставить Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;

	Если Не МожноВставить Тогда
		МожноВставить = ОписаниеТиповПоддерживаетВставкуУникальногоИдентификатора(ПолеФормы.ДоступныеТипы);		
	КонецЕсли;
	
	Если МожноВставить Тогда
		Имя = ПутьКДаннымТекущегоЭлемента();
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Возврат;
		КонецЕсли;
		ДополнительныеПараметры = Новый Структура("Таблица");
		ДополнительныеПараметры.Вставить("Имя", Имя);
		Если ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
			ДополнительныеПараметры.Таблица = ТекущийЭлемент.Имя;
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ВставитьУникальныйИдентификаторПродолжение", ЭтотОбъект,
			ДополнительныеПараметры);
		УИ_БуферОбменаКлиент.НачатьПолучениеСтрокиИзБуфера(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура _ЗаполнитьДанныеТекущейКолонки(Команда)

	ТекСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если ТекСтраница.Имя = "СтраницаРеквизитыОбъекта"
		 Или ТекСтраница.Имя = "СтраницаНастройки"
		 Или ТекСтраница.Имя = "СтраницаСсылкиНаОбъект" Тогда
		Возврат;
	КонецЕсли;

	Если ТекСтраница.Имя = "СтраницаТабличныеЧастиОбъекта" Тогда
		ТекСтраница = Элементы.СтраницыТабличныхЧастейОбъекта.ТекущаяСтраница;
	КонецЕсли;

	ПрефиксСтраницы = ПрефиксСтраницы();
	КоличествоСимволов = СтрДлина(ТекСтраница.Имя) - СтрДлина(ПрефиксСтраницы);
	ТекущаяТаблица = ТекСтраница.ПодчиненныеЭлементы.Найти(Прав(ТекСтраница.Имя, КоличествоСимволов));

	Если ТипЗнч(ТекущаяТаблица) = Тип("ТаблицаФормы") Тогда
		Если ТекущаяТаблица.ТолькоПросмотр Или Не ТекущаяТаблица.Доступность Тогда
			Возврат;
		КонецЕсли;
		СтрукДанные = ПолучитьСвойстваТабличногоПоля(ТекущаяТаблица.Имя);
		Если Не СтрукДанные.Отказ Тогда
			ТаблицаФормы = ЭтотОбъект[СтрукДанные.Таблица];
			ИмяПоля = СтрукДанные.Поле;
			ПолеФормы = ТекущаяТаблица.ТекущийЭлемент;
			Если ТекущаяТаблица.ТекущийЭлемент.ТолькоПросмотр Или Не ТекущаяТаблица.ТекущийЭлемент.Доступность Тогда
				Возврат;
			КонецЕсли;

			Если ТипЗнч(ТаблицаФормы) = Тип("ДанныеФормыКоллекция") И ТаблицаФормы.Количество() <> 0 Тогда

				НовоеЗначение = ПолеФормы.ДоступныеТипы.ПривестиЗначение(_ЗначениеДляЗаполнения);
				Если ПриЗаполненииОбрабатыватьТолькоВыделенныеСтроки Тогда
					Для Каждого Элем Из ТекущаяТаблица.ВыделенныеСтроки Цикл
						Стр = ТаблицаФормы.НайтиПоИдентификатору(Элем);
						Стр[ИмяПоля] = НовоеЗначение;
					КонецЦикла;
				Иначе
					Для Каждого Стр Из ТаблицаФормы Цикл
						Стр[ИмяПоля] = НовоеЗначение;
					КонецЦикла;
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура _ВыгрузитьНаборЗаписей(Команда)
	Если Не ЗначениеЗаполнено(мОбъектСсылка) Тогда
		ПредупреждениеБезОповещения(НСтр("ru = 'Не задан объект для выгрузки движений'"));
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(_ИмяНабораЗаписей) Тогда
