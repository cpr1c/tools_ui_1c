&НаСервере
Процедура вЗаполнитьМетаданные()
	_ДеревоСвойств.ПолучитьЭлементы().Очистить();
	
	пОбъектМД = Метаданные.НайтиПоТипу(ТипЗнч(мОбъектСсылка));
	Если пОбъектМД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	пПолноеИмя = пОбъектМД.ПолноеИмя();
	
	Если Найти(пПолноеИмя, "Справочник.") = 1 Тогда
		вЗаполнитьСвойстваСправочника(пПолноеИмя);
	ИначеЕсли Найти(пПолноеИмя, "Документ.") = 1 Тогда
		вЗаполнитьСвойстваДокумента(пПолноеИмя);
	ИначеЕсли Найти(пПолноеИмя, "ПланСчетов.") = 1 Тогда
		вЗаполнитьСвойстваПланаСчетов(пПолноеИмя);
	ИначеЕсли Найти(пПолноеИмя, "ПланОбмена.") = 1 Тогда
		вЗаполнитьСвойстваПланаОбмена(пПолноеИмя);
	ИначеЕсли Найти(пПолноеИмя, "ПланВидовХарактеристик.") = 1 Тогда
		вЗаполнитьСвойстваПВХ(пПолноеИмя);
	ИначеЕсли Найти(пПолноеИмя, "ПланВидовРасчета.") = 1 Тогда
		вЗаполнитьСвойстваПВР(пПолноеИмя);
	ИначеЕсли Найти(пПолноеИмя, "БизнесПроцесс.") = 1 Тогда
		вЗаполнитьСвойстваБизнесПроцесса(пПолноеИмя);
	ИначеЕсли Найти(пПолноеИмя, "Задача.") = 1 Тогда
		вЗаполнитьСвойстваЗадачи(пПолноеИмя);
	КонецЕсли;
КонецПроцедуры

