		ПоказатьПредупреждение(,"Не задан объект для выгрузки движений", 20);
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(_ИмяНабораЗаписей) Тогда
		ПоказатьПредупреждение(,"Не задан набор записей для выгрузки", 20);
		Возврат;
	КонецЕсли;
	
	вВыгрузитьОбъект(4);
КонецПроцедуры

