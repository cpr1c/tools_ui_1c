&НаКлиенте
Функция вСтрРазделить(Знач пСтрока, Знач пРазделитель, Знач пВключатьПустые = ложь)
	пМассив = СтрРазделить(пСтрока, пРазделитель, пВключатьПустые);
	пРезультат = новый Массив;
	
	Для каждого Элем из пМассив Цикл
		пРезультат.Добавить(СокрЛП(Элем));
	КонецЦикла;
	
	Возврат пРезультат;
КонецФункции

&НаКлиенте
Функция вПолучитьМассивТиповМД(Знач пТипСтрокой)
	ПростыеТипы = "/Булево/Дата/ДатаВремя/Строка/Число/ХранилищеЗначения/УникальныйИдентификатор/";
	Результат = новый Массив;
	
	Для каждого Элем из вСтрРазделить(пТипСтрокой, ",", ложь) Цикл
		Если СтрНайти(ПростыеТипы, Элем) = 0 Тогда
			Если СтрНайти(Элем, "Строка(") = 0 и СтрНайти(Элем, "Число(") = 0 Тогда
				Результат.Добавить(Элем);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция вПолучитьФормуСДРНавигаторУпр(пОткрыть = ложь)
	пФормаНавигатора = Неопределено;
	
	Для каждого пОкно из ПолучитьОкна() Цикл
		Для каждого Элем из пОкно.Содержимое Цикл
			Если ТипЗнч(Элем) = Тип("ФормаКлиентскогоПриложения") Тогда
				Если СтрЗаканчиваетсяНа(Элем.ИмяФормы, ".СДРНавигаторУпр.Форма.Форма") Тогда
					пФормаНавигатора = ПолучитьФорму(Элем.ИмяФормы);
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если пФормаНавигатора <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если пОткрыть и пФормаНавигатора <> Неопределено Тогда
		Если не пФормаНавигатора.Открыта() Тогда
			Попытка
				пФормаНавигатора.Открыть();
			Исключение
				Возврат Неопределено
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат пФормаНавигатора;
КонецФункции

&НаКлиенте
Процедура _ПоказатьСвойстваОбъектаМД(Команда)
	
	ТекДанные = Элементы._ДеревоСвойств.ТекущиеДанные;
	
	Если ТекДанные = Неопределено или ПустаяСтрока(ТекДанные.ТипСтрокой) или СтрНайти(ТекДанные.ТипСтрокой, ".") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	пМассивТипов = вПолучитьМассивТиповМД(ТекДанные.ТипСтрокой);
	Если пМассивТипов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	пФормаНавигатора = вПолучитьФормуСДРНавигаторУпр(истина);
	Если пФормаНавигатора = Неопределено Тогда
		вСообщить("Операция не доступна, необходимо открыть СДРНавигаторУпр");
		Возврат;
	КонецЕсли;
	
	
	Если пМассивТипов.Количество() = 1 Тогда
		вПоказатьСвойстваОбъектаМД(новый Структура("Значение", пМассивТипов[0]), пФормаНавигатора);
	Иначе
		пСписок = новый СписокЗначений;
		пСписок.ЗагрузитьЗначения(пМассивТипов);
		пСписок.СортироватьПоЗначению();
		пОповещение = новый ОписаниеОповещения("вПоказатьСвойстваОбъектаМД", ЭтаФорма, пФормаНавигатора);
		пСписок.ПоказатьВыборЭлемента(пОповещение, "Выбор типа"); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура вПоказатьСвойстваОбъектаМД(ВыбранныйЭлемент, пФормаНавигатора) Экспорт
	Если ВыбранныйЭлемент <> Неопределено Тогда
		пПолноеИмя = ВыбранныйЭлемент.Значение;
		
		Попытка
			пСтрук = новый Структура;
			пСтрук.Вставить("Операция", "ПоказатьСвойстваОбъектаМД");
			пСтрук.Вставить("Источник", "СДРОбъектУпр");
			пСтрук.Вставить("Параметры", новый Структура("ПолноеИмя", пПолноеИмя));
			
			пРезультат = пФормаНавигатора.вОбработатьВнешнийВызов(пСтрук);
			Если пРезультат.Отказ Тогда
				вСообщить(пРезультат.ПричинаОтказа);
			КонецЕсли;
		Исключение
			пОписаниеОшибки = ОписаниеОшибки();
			вСообщить("СДРНавигаторУпр не поддерживает внешние вызовы (старая версия)");
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

