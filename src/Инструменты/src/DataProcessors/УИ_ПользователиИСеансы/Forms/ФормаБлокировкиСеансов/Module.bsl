// Форма блокировки сеансов информационной базы. Пока блокировка установлена и действует, новые сеансы
// не начинаются без кода разрешения; уже работающие сеансы блокировка не завершает.
// Открывается со страницы "Сеансы" основной формы обработки, нужно право "Администрирование".

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не УИ_ПользователиИСеансы.ЕстьПравоАдминистрированияПользователей() Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для блокировки сеансов нужно право ""Администрирование"".'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ПрочитатьБлокировку();

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(Начало) И ЗначениеЗаполнено(Конец) И Конец <= Начало Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Конец блокировки должен быть позже ее начала.'"), , "Конец", ,
			Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьБлокировку() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьБлокировку();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает блокировку сеансов и показывает оповещение о результате.
//
// Возвращаемое значение:
//  Булево - Истина, если блокировка записана
&НаКлиенте
Функция ЗаписатьБлокировку()

	Если Не ЗаписатьБлокировкуНаСервере() Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстОповещения = ?(Установлена, НСтр("ru = 'Блокировка сеансов установлена'"), НСтр("ru = 'Блокировка сеансов снята'"));
	ПоказатьОповещениеПользователя(ТекстОповещения);
	Возврат Истина;

КонецФункции

// Проверяет заполнение и записывает блокировку сеансов. Об ошибке записи выводит сообщение.
//
// Возвращаемое значение:
//  Булево - Истина, если блокировка записана
&НаСервере
Функция ЗаписатьБлокировкуНаСервере()

	Если Не ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;

	ДанныеБлокировки = УИ_ПользователиИСеансы.НовыеДанныеБлокировкиСеансов();
	ЗаполнитьЗначенияСвойств(ДанныеБлокировки, ЭтотОбъект);
	Попытка
		УИ_ПользователиИСеансы.УстановитьБлокировкуСеансовПоДанным(ДанныеБлокировки);
	Исключение
		ПодробностиОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Блокировка сеансов не записана: %1'"), ПодробностиОшибки);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	ПрочитатьБлокировку();
	Возврат Истина;

КонецФункции

&НаСервере
Процедура ПрочитатьБлокировку()

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, УИ_ПользователиИСеансы.ДанныеБлокировкиСеансов());
	Модифицированность = Ложь;

КонецПроцедуры

#КонецОбласти
