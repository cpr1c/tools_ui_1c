// Форма пользователя информационной базы работает как форма элемента справочника:
// - параметр ИмяПользователя - открывается существующий пользователь;
// - параметр ЗначениеКопирования (имя пользователя) - создается новый пользователь по образцу существующего;
// - параметр ЗначенияЗаполнения (структура, см. УИ_ПользователиИСеансы.НовыеДанныеПользователяИБ)
//   или отсутствие параметров - создается новый пользователь.
// После записи оповещает об изменении пользователя, см. УИ_ПользователиИСеансы.ИмяСобытияЗаписиПользователяИБ.

#Область ОписаниеПеременных

&НаКлиенте
Перем ЗакрытиеПодтверждено; // Истина, если пользователь отказался сохранять изменения и форму можно закрыть

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЕстьПравоАдминистрирования = УИ_ПользователиИСеансы.ЕстьПравоАдминистрированияПользователей();
	Если Не ЕстьПравоАдминистрирования И Не ОткрытаСвояКарточка() Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстНедостаточноПрав());
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗаполнитьСпискиВыбора();
	СкрытьНедоступныеСвойства();

	Если ЗначениеЗаполнено(Параметры.ИмяПользователя) Тогда
		ПользовательИБ = НайтиПользователяПоИмени(Параметры.ИмяПользователя);
		ДанныеПолучены = (ПользовательИБ <> Неопределено И ПрочитатьПользователя(ПользовательИБ));
	Иначе
		ДанныеПолучены = ЗаполнитьНовогоПользователя();
	КонецЕсли;
	Если Не ДанныеПолучены Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЕстьПравоАдминистрирования Тогда
		ОграничитьРедактированиеСвоейКарточки();
	КонецЕсли;
	УстановитьДоступностьЭлементов(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не Модифицированность Или ЗакрытиеПодтверждено Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Изменения пользователя информационной базы не записаны.'");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ВведенНовыйПароль(ЭтотОбъект) И Не Элементы.ПоказатьПароль.Пометка И Пароль <> ПодтверждениеПароля Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Пароль и подтверждение пароля не совпадают.'"), ,
			"ПодтверждениеПароля", , Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АутентификацияСтандартнаяПриИзменении(Элемент)

	УстановитьДоступностьЭлементов(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)

	Если ВведенНовыйПароль(ЭтотОбъект) Тогда
		СброситьПарольПриЗаписи = Ложь;
		Если Элементы.ПоказатьПароль.Пометка Тогда
			ПодтверждениеПароля = Пароль;
		КонецЕсли;
	Иначе
		ПодтверждениеПароля = "";
	КонецЕсли;
	ОбновитьПодсказкуПароля(ЭтотОбъект);
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	ПроверитьПодтверждениеПароля();

КонецПроцедуры

&НаКлиенте
Процедура ПарольОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Пароль = "";
	ПодтверждениеПароля = "";
	СброситьПарольПриЗаписи = Истина;
	Модифицированность = Истина;
	ОбновитьПодсказкуПароля(ЭтотОбъект);
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	ПроверитьПодтверждениеПароля();

КонецПроцедуры

&НаКлиенте
Процедура ПарольИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	Элементы.ПодтверждениеПароля.Доступность = ДоступноПодтверждениеПароля(ЭтотОбъект, Текст);
	ПроверитьПодтверждениеПароля(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПароляПриИзменении(Элемент)

	ПроверитьПодтверждениеПароля();

КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПароляИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	ПроверитьПодтверждениеПароля(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура АутентификацияОСПриИзменении(Элемент)

	УстановитьДоступностьЭлементов(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьПользователя(Истина);

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьПользователя(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Перечитать(Команда)

	Если Не Модифицированность Тогда
		ПеречитатьНаСервере();
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПеречитатьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Данные изменены. Перечитать данные?'"), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура Скопировать(Команда)

	Если Не Модифицированность И ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
		ОткрытьКопиюПользователя();
		Возврат;
	КонецЕсли;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Записать и скопировать'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	Оповещение = Новый ОписаниеОповещения("СкопироватьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Для копирования необходимо выполнить запись данных'"), Кнопки, ,
		КодВозвратаДиалога.ОК);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользователя(Команда)

	ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить пользователя информационной базы ""%1""? Удаление нельзя отменить.'"), Имя);
	Оповещение = Новый ОписаниеОповещения("УдалитьПользователяЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПароль(Команда)

	Кнопка = Элементы.ПоказатьПароль;
	Кнопка.Пометка = Не Кнопка.Пометка;
	Элементы.Пароль.РежимПароля = Не Кнопка.Пометка;
	Если Кнопка.Пометка Тогда
		ПодтверждениеПароля = Пароль;
	КонецЕсли;
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	ПроверитьПодтверждениеПароля();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПароль(Команда)

	Если ВведенНовыйПароль(ЭтотОбъект) Тогда
		ПоказатьПредупреждение( , ТекстПроверкиВведенногоПароля());
	Иначе
		ПоказатьПредупреждение( , ТекстПроверкиУстановленногоПароля());
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СгенерироватьПароль(Команда)

	ПараметрыФормы = Новый Структура("ИмяПолитикиПаролей", ИмяПолитикиПаролей);
	ОткрытьФорму("ОбщаяФорма.УИ_ГенераторПаролей", ПараметрыФормы, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("СгенерироватьПарольЗавершение", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ТолькоВыбранныеРоли(Команда)

	Кнопка = Элементы.РолиПользователяТолькоВыбранныеРоли;
	Кнопка.Пометка = Не Кнопка.Пометка;
	Если Кнопка.Пометка Тогда
		Элементы.РолиПользователя.ОтборСтрок = Новый ФиксированнаяСтруктура("Пометка", Истина);
	Иначе
		Элементы.РолиПользователя.ОтборСтрок = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенныеРоли(Команда)

	УстановитьПометкуВыделенныхРолей(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВыделенныхРолей(Команда)

	УстановитьПометкуВыделенныхРолей(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьПользователя(Истина);
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ЗакрытиеПодтверждено = Истина;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПеречитатьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СкопироватьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.ОК И ЗаписатьПользователя(Ложь) Тогда
		ОткрытьКопиюПользователя();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользователяЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Или Не УдалитьПользователяНаСервере() Тогда
		Возврат;
	КонецЕсли;

	Оповестить(ИмяСобытияЗаписиПользователя, ИдентификаторПользователя, ЭтотОбъект);
	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

// Завершение выбора пароля в генераторе паролей: подставляет пароль и его подтверждение.
//
// Параметры:
//  Результат - Строка, Неопределено - выбранный пароль; Неопределено, если генератор закрыт без выбора.
//  ДополнительныеПараметры - Неопределено - не используется.
&НаКлиенте
Процедура СгенерироватьПарольЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Строка") Или ПустаяСтрока(Результат) Тогда
		Возврат;
	КонецЕсли;

	Пароль = Результат;
	ПодтверждениеПароля = Результат;
	СброситьПарольПриЗаписи = Ложь;
	Модифицированность = Истина;
	ОбновитьПодсказкуПароля(ЭтотОбъект);
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	ПроверитьПодтверждениеПароля();

КонецПроцедуры

// Открывает форму нового пользователя, заполненную копированием записанного пользователя.
&НаКлиенте
Процедура ОткрытьКопиюПользователя()

	ПараметрыФормы = Новый Структура("ЗначениеКопирования", Имя);
	ОткрытьФорму("Обработка.УИ_ПользователиИСеансы.Форма.ФормаПользователя", ПараметрыФормы, ВладелецФормы,
		Новый УникальныйИдентификатор);

КонецПроцедуры

// Записывает пользователя и оповещает о записи.
//
// Параметры:
//  ЗакрытьПослеЗаписи - Булево - закрыть форму после успешной записи
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь записан
&НаКлиенте
Функция ЗаписатьПользователя(ЗакрытьПослеЗаписи)

	Если Не ЗаписатьПользователяНаСервере() Тогда
		Возврат Ложь;
	КонецЕсли;

	Оповестить(ИмяСобытияЗаписиПользователя, ИдентификаторПользователя, ЭтотОбъект);
	Если ЗакрытьПослеЗаписи Тогда
		Закрыть();
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаСервере
Процедура ПеречитатьНаСервере()

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ИдентификаторПользователя);
	Если ПользовательИБ = Неопределено Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Пользователь информационной базы не найден, возможно, он удален.'"));
		Возврат;
	КонецЕсли;

	Если Не ПрочитатьПользователя(ПользовательИБ) Тогда
		Возврат;
	КонецЕсли;
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Функция ЗаписатьПользователяНаСервере()

	Если Не ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВведенНовыйПароль(ЭтотОбъект) Тогда
		НовыйПароль = Пароль;
	Иначе
		НовыйПароль = ?(СброситьПарольПриЗаписи, "", Неопределено);
	КонецЕсли;
	Попытка
		ИдентификаторПользователя = УИ_ПользователиИСеансы.ЗаписатьПользователяИБ(ИдентификаторПользователя,
			ДанныеПользователя(), НовыйПароль);
	Исключение
		УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	ПрочитатьПользователя(ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ИдентификаторПользователя));
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	Модифицированность = Ложь;
	Возврат Истина;

КонецФункции

&НаСервере
Функция УдалитьПользователяНаСервере()

	Попытка
		УИ_ПользователиИСеансы.УдалитьПользователяИБ(ИдентификаторПользователя);
	Исключение
		УИ_ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

&НаСервере
Функция НайтиПользователяПоИмени(ИмяПользователя)

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательИБ = Неопределено Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Пользователь информационной базы ""%1"" не найден.'"), ИмяПользователя);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	Возврат ПользовательИБ;

КонецФункции

&НаСервере
Функция ОткрытаСвояКарточка()

	Возврат ЗначениеЗаполнено(Параметры.ИмяПользователя)
		И УИ_ПользователиИСеансы.ЭтоТекущийПользователь(Параметры.ИмяПользователя);

КонецФункции

// Оставляет для редактирования только сведения, которые пользователь без права "Администрирование"
// может изменить о себе: полное имя, язык и пароль, если пароль ему не запрещено изменять.
&НаСервере
Процедура ОграничитьРедактированиеСвоейКарточки()

	РедактируемыеПоля = Новый Массив;
	РедактируемыеПоля.Добавить("ПолноеИмя");
	РедактируемыеПоля.Добавить("Язык");
	Если Не ЗапрещеноИзменятьПароль Тогда
		РедактируемыеПоля.Добавить("Пароль");
		РедактируемыеПоля.Добавить("ПодтверждениеПароля");
	КонецЕсли;

	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") И РедактируемыеПоля.Найти(ЭлементФормы.Имя) = Неопределено Тогда
			ЭлементФормы.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЦикла;

	Элементы.РолиПользователя.ТолькоПросмотр = Истина;
	Элементы.РолиПользователяГруппаОтметкаРолей.Видимость = Ложь;
	Элементы.ПроверитьПароль.Видимость = Ложь;
	Элементы.СгенерироватьПароль.Видимость = Ложь;
	Элементы.ФормаСкопировать.Видимость = Ложь;
	Элементы.ФормаУдалитьПользователя.Видимость = Ложь;

КонецПроцедуры

// Заполняет форму для создания пользователя: копированием существующего пользователя
// или значениями, которые платформа задает новому пользователю, затем - значениями заполнения.
//
// Возвращаемое значение:
//  Булево - Ложь, если копируемый пользователь не найден
&НаСервере
Функция ЗаполнитьНовогоПользователя()

	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		КопируемыйПользователь = НайтиПользователяПоИмени(Параметры.ЗначениеКопирования);
		Если КопируемыйПользователь = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Данные = УИ_ПользователиИСеансы.ДанныеКопированияПользователяИБ(КопируемыйПользователь);
	Иначе
		Данные = УИ_ПользователиИСеансы.ДанныеСоздаваемогоПользователяИБ();
	КонецЕсли;

	Если ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура")
		Или ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("ФиксированнаяСтруктура") Тогда
		ЗаполнитьЗначенияСвойств(Данные, Параметры.ЗначенияЗаполнения);
	КонецЕсли;

	ЗагрузитьДанныеПользователя(Данные);
	ИдентификаторПользователя = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Идентификатор = "";
	СброситьПоляПароля(Ложь);
	Заголовок = НСтр("ru = 'Пользователь информационной базы (создание)'");
	Возврат Истина;

КонецФункции

// Читает сведения пользователя в форму.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - найденный пользователь
//
// Возвращаемое значение:
//  Булево - Ложь, если сведения пользователя прочитать нельзя: о причине выводится сообщение
&НаСервере
Функция ПрочитатьПользователя(ПользовательИБ)

	Сведения = УИ_ПользователиИСеансы.СведенияПользователяИБДляФормы(ПользовательИБ);
	Если Сведения = Неопределено Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстНедостаточноПрав());
		Возврат Ложь;
	КонецЕсли;

	ЗагрузитьДанныеПользователя(Сведения.Данные);
	ИдентификаторПользователя = Сведения.Идентификатор;
	Идентификатор = Строка(ИдентификаторПользователя);
	СброситьПоляПароля(Сведения.ПарольУстановлен);
	Заголовок = СтрШаблон(НСтр("ru = '%1 (Пользователь информационной базы)'"), Сведения.Имя);
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстНедостаточноПрав()

	Возврат НСтр("ru = 'Недостаточно прав для работы с пользователями информационной базы.'") + " "
		+ НСтр("ru = 'Без права ""Администрирование"" можно открыть только свою карточку.'");

КонецФункции

// Сбрасывает поля пароля после чтения пользователя: пароль пользователя не читается, а записывается,
// только если ввели новый или очистили поле кнопкой очистки.
//
// Параметры:
//  ПарольУстановленУПользователя - Булево - у пользователя установлен пароль
&НаСервере
Процедура СброситьПоляПароля(ПарольУстановленУПользователя)

	ПарольУстановлен = ПарольУстановленУПользователя;
	Пароль = "";
	ПодтверждениеПароля = "";
	СброситьПарольПриЗаписи = Ложь;
	ОбновитьПодсказкуПароля(ЭтотОбъект);
	Элементы.НадписьПарольНеСовпадает.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Функция ТекстПроверкиВведенногоПароля()

	Проверка = УИ_ПользователиИСеансы.ПроверитьПарольПоПолитике(Пароль, ИмяПолитикиПаролей, ИдентификаторПользователя);
	Если Проверка.Нарушения.Количество() = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Пароль соответствует требованиям: %1.'"), Проверка.Требования);
	КонецЕсли;

	ТекстНесоответствия = СтрШаблон(НСтр("ru = 'Пароль не соответствует требованиям: %1.'"), Проверка.Требования);
	Возврат ТекстНесоответствия + Символы.ПС + СтрСоединить(Проверка.Нарушения, Символы.ПС);

КонецФункции

&НаСервере
Функция ТекстПроверкиУстановленногоПароля()

	Текст = НСтр("ru = 'Введите пароль, чтобы проверить его.'") + Символы.ПС
		+ НСтр("ru = 'Установленный пароль проверить нельзя: в информационной базе хранится только его хеш.'");
	Если Не ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
		Возврат Текст;
	КонецЕсли;

	Отметка = УИ_ПользователиИСеансы.ПарольОтмеченНесоответствующимТребованиям(ИдентификаторПользователя);
	Если Отметка = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Если Отметка Тогда
		Текст = Текст + Символы.ПС
			+ НСтр("ru = 'При входе пользователя платформа отметила установленный пароль как не соответствующий требованиям.'");
	Иначе
		Текст = Текст + Символы.ПС
			+ НСтр("ru = 'Отметки о несоответствии установленного пароля требованиям нет: платформа проверяет его при входе пользователя.'");
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеПользователя(Данные)

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Данные);

	ВыбранныеРоли = Новый Соответствие;
	Для Каждого ИмяРоли Из Данные.Роли Цикл
		ВыбранныеРоли.Вставить(ИмяРоли, Истина);
	КонецЦикла;

	КартинкаРоли = БиблиотекаКартинок.УИ_МетаданныеРоль;
	РолиПользователя.Очистить();
	Для Каждого Роль Из Метаданные.Роли Цикл
		СтрокаРоли = РолиПользователя.Добавить();
		СтрокаРоли.Картинка = КартинкаРоли;
		СтрокаРоли.Имя = Роль.Имя;
		СтрокаРоли.Синоним = Роль.Представление();
		СтрокаРоли.Пометка = (ВыбранныеРоли[Роль.Имя] = Истина);
		СтрокаРоли.ДобавленаРасширением = (Роль.РасширениеКонфигурации() <> Неопределено);
	КонецЦикла;
	РолиПользователя.Сортировать("Имя");

	ДобавитьНенайденнуюПолитикуПаролей();

КонецПроцедуры

// Возвращает данные пользователя из реквизитов формы.
//
// Возвращаемое значение:
//  см. УИ_ПользователиИСеансы.НовыеДанныеПользователяИБ
&НаСервере
Функция ДанныеПользователя()

	Данные = УИ_ПользователиИСеансы.НовыеДанныеПользователяИБ();
	ЗаполнитьЗначенияСвойств(Данные, ЭтотОбъект);
	Для Каждого СтрокаРоли Из РолиПользователя.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Данные.Роли.Добавить(СтрокаРоли.Имя);
	КонецЦикла;
	Возврат Данные;

КонецФункции

&НаСервере
Процедура ЗаполнитьСпискиВыбора()

	ИмяСобытияЗаписиПользователя = УИ_ПользователиИСеансы.ИмяСобытияЗаписиПользователяИБ();

	СписокВыбора = Элементы.РежимЗапуска.СписокВыбора;
	СписокВыбора.Добавить("Авто", НСтр("ru = 'Авто'"));
	СписокВыбора.Добавить("ОбычноеПриложение", НСтр("ru = 'Обычное приложение'"));
	СписокВыбора.Добавить("УправляемоеПриложение", НСтр("ru = 'Управляемое приложение'"));

	СписокВыбора = Элементы.Язык.СписокВыбора;
	СписокВыбора.Добавить("", НСтр("ru = '<Не задан>'"));
	Для Каждого ЯзыкКонфигурации Из Метаданные.Языки Цикл
		СписокВыбора.Добавить(ЯзыкКонфигурации.Имя, ЯзыкКонфигурации.Представление());
	КонецЦикла;

	СписокВыбора = Элементы.ОсновнойИнтерфейс.СписокВыбора;
	СписокВыбора.Добавить("", НСтр("ru = '<Не задан>'"));
	Для Каждого ИнтерфейсКонфигурации Из Метаданные.Интерфейсы Цикл
		СписокВыбора.Добавить(ИнтерфейсКонфигурации.Имя, ИнтерфейсКонфигурации.Представление());
	КонецЦикла;

	СписокВыбора = Элементы.ИмяПолитикиПаролей.СписокВыбора;
	СписокВыбора.Добавить("", НСтр("ru = '<Параметры информационной базы>'"));
	Для Каждого ИмяПолитики Из УИ_ПользователиИСеансы.ИменаПолитикПаролей() Цикл
		СписокВыбора.Добавить(ИмяПолитики);
	КонецЦикла;

КонецПроцедуры

// Добавляет в список выбора политику паролей пользователя, которой нет среди политик информационной базы.
// Платформа не проверяет имя политики при записи пользователя, а для пользователя с именем несуществующей
// политики действуют параметры информационной базы. Без права "Администрирование" список политик
// не читается, поэтому политика пользователя добавляется без пометки.
&НаСервере
Процедура ДобавитьНенайденнуюПолитикуПаролей()

	СписокВыбора = Элементы.ИмяПолитикиПаролей.СписокВыбора;
	Если ПустаяСтрока(ИмяПолитикиПаролей) Или СписокВыбора.НайтиПоЗначению(ИмяПолитикиПаролей) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если УИ_ПользователиИСеансы.ЕстьПравоАдминистрированияПользователей() Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 (политика не найдена, действуют параметры информационной базы)'"),
			ИмяПолитикиПаролей);
	Иначе
		Представление = ИмяПолитикиПаролей;
	КонецЕсли;
	СписокВыбора.Добавить(ИмяПолитикиПаролей, Представление);

КонецПроцедуры

// Скрывает поля свойств, которых нет в текущей версии платформы, проверку пароля, если в ней нет
// политик паролей, и основной интерфейс, если в конфигурации нет интерфейсов обычного приложения.
&НаСервере
Процедура СкрытьНедоступныеСвойства()

	ДоступныеСвойства = УИ_ПользователиИСеансы.ДоступныеСвойстваПользователяИБ();
	Для Каждого КлючИЗначение Из ДоступныеСвойства Цикл
		Элементы[КлючИЗначение.Ключ].Видимость = КлючИЗначение.Значение;
	КонецЦикла;
	Элементы.ПроверитьПароль.Видимость = ДоступныеСвойства.ИмяПолитикиПаролей;
	Элементы.ОсновнойИнтерфейс.Видимость = (Метаданные.Интерфейсы.Количество() > 0);

КонецПроцедуры

// Показывает в пустом поле пароля, что станет с паролем при записи.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма пользователя
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПодсказкуПароля(Форма)

	Если Форма.СброситьПарольПриЗаписи Тогда
		Подсказка = НСтр("ru = 'Пароль будет очищен при записи'");
	ИначеЕсли Форма.ПарольУстановлен Тогда
		Подсказка = НСтр("ru = 'Пароль установлен'");
	Иначе
		Подсказка = НСтр("ru = 'Пароль пустой'");
	КонецЕсли;
	Форма.Элементы.Пароль.ПодсказкаВвода = Подсказка;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементов(Форма)

	Элементы = Форма.Элементы;
	Элементы.ГруппаСвойстваСтандартнойАутентификации.Доступность = Форма.АутентификацияСтандартная;
	Элементы.ПодтверждениеПароля.Доступность = ДоступноПодтверждениеПароля(Форма, Форма.Пароль);
	Элементы.ПользовательОС.Доступность = Форма.АутентификацияОС;
	Элементы.ФормаПеречитать.Доступность = ЗначениеЗаполнено(Форма.ИдентификаторПользователя);
	Элементы.ФормаУдалитьПользователя.Доступность = ЗначениеЗаполнено(Форма.ИдентификаторПользователя);

КонецПроцедуры

// Возвращает признак доступности подтверждения пароля: подтверждение нужно, когда пароль введен
// и не показан открытым текстом кнопкой "Показать".
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма пользователя
//  ТекстПароля - Строка - введенный пароль
//
// Возвращаемое значение:
//  Булево - Истина, если подтверждение пароля доступно
&НаКлиентеНаСервереБезКонтекста
Функция ДоступноПодтверждениеПароля(Форма, ТекстПароля)

	Возврат ТекстПароля <> "" И Не Форма.Элементы.ПоказатьПароль.Пометка;

КонецФункции

// Показывает надпись о несовпадении пароля и подтверждения. Значение редактируемого поля
// еще не попало в реквизит формы, поэтому для него берется текст редактирования.
//
// Параметры:
//  ПолеПароля - ПолеФормы, Неопределено - редактируемое поле пароля или подтверждения
&НаКлиенте
Процедура ПроверитьПодтверждениеПароля(ПолеПароля = Неопределено)

	ЗначениеПароля = Пароль;
	ЗначениеПодтверждения = ПодтверждениеПароля;
	Если ПолеПароля = Элементы.Пароль Тогда
		ЗначениеПароля = ПолеПароля.ТекстРедактирования;
	КонецЕсли;
	Если ПолеПароля = Элементы.ПодтверждениеПароля Тогда
		ЗначениеПодтверждения = ПолеПароля.ТекстРедактирования;
	КонецЕсли;

	ПарольНеСовпадает = (ЗначениеПароля <> ЗначениеПодтверждения);
	Элементы.НадписьПарольНеСовпадает.Видимость = ПарольНеСовпадает И Не Элементы.ПоказатьПароль.Пометка;

КонецПроцедуры

// Возвращает признак того, что в форме введен новый пароль пользователя: пустое поле пароля
// означает, что пароль не меняется. Пароль из одних пробелов тоже считается введенным,
// поэтому поле сравнивается с пустой строкой, а не проверяется функцией ПустаяСтрока.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма пользователя
//
// Возвращаемое значение:
//  Булево - Истина, если пароль введен
&НаКлиентеНаСервереБезКонтекста
Функция ВведенНовыйПароль(Форма)

	Возврат Форма.Пароль <> "";

КонецФункции

&НаКлиенте
Процедура УстановитьПометкуВыделенныхРолей(Пометка)

	Для Каждого ИдентификаторСтроки Из Элементы.РолиПользователя.ВыделенныеСтроки Цикл
		СтрокаРоли = РолиПользователя.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаРоли <> Неопределено И СтрокаРоли.Пометка <> Пометка Тогда
			СтрокаРоли.Пометка = Пометка;
			Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Инициализация

ЗакрытиеПодтверждено = Ложь;

#КонецОбласти
