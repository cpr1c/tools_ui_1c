// Основная форма обработки: список пользователей информационной базы.
// Пользователи создаются, копируются и изменяются в форме ФормаПользователя.
// Без права "Администрирование" в списке только текущий пользователь, его карточка открывается из списка.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяСобытияЗаписиПользователя = УИ_ПользователиИСеансы.ИмяСобытияЗаписиПользователяИБ();
	ПредставленияРолей = ПредставленияРолейКонфигурации();
	ПаузаПередВосстановлениемПароля = 20;
	СкрытьНедоступныеСвойства();
	СкрытьКомандыАдминистрирования();
	УстановитьОформлениеТекущегоПользователя();
	ЗаполнитьПользователей();
	УстановитьВидимостьРолей(ЭтотОбъект);

	УИ_ОбщегоНазначения.ФормаИнструментаПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	УстановитьВидимостьРолей(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = ИмяСобытияЗаписиПользователя И Источник <> ЭтотОбъект
		И ТипЗнч(Параметр) = Тип("УникальныйИдентификатор") Тогда
		ОбновитьСтрокуПользователя(Параметр);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПользователиИБ

&НаКлиенте
Процедура ПользователиИБВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПриАктивизацииСтроки(Элемент)

	Если ПоказыватьРоли Тогда
		ПодключитьОбработчикОжидания("ОбработчикОжиданияАктивизацииСтрокиПользователиИБ", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;
	Если Не Копирование Тогда
		ОткрытьФормуПользователя(Новый Структура, Новый УникальныйИдентификатор);
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьФормуПользователя(Новый Структура("ЗначениеКопирования", ТекущиеДанные.Имя),
			Новый УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПередНачаломИзменения(Элемент, Отказ)

	Отказ = Истина;
	ОткрытьТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПередУдалением(Элемент, Отказ)

	Отказ = Истина;

	Идентификаторы = Новый Массив;
	ИменаПользователей = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элемент.ВыделенныеСтроки Цикл
		СтрокаПользователя = ПользователиИБ.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаПользователя <> Неопределено Тогда
			Идентификаторы.Добавить(СтрокаПользователя.Идентификатор);
			ИменаПользователей.Добавить(СтрокаПользователя.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Идентификаторы.Количество() = 1 Тогда
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить пользователя информационной базы ""%1""? Удаление нельзя отменить.'"),
			ИменаПользователей[0]);
	Иначе
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Удалить выделенных пользователей информационной базы (%1)? Удаление нельзя отменить.'"),
			Идентификаторы.Количество());
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПользователиИБПередУдалениемЗавершение", ЭтотОбъект, Идентификаторы);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	ИдентификаторСтроки = ОбновитьСписокНаСервере(?(ТекущиеДанные = Неопределено, Неопределено,
		ТекущиеДанные.Идентификатор));
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.ПользователиИБ.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура Роли(Команда)

	ПоказыватьРоли = Не ПоказыватьРоли;
	УстановитьВидимостьРолей(ЭтотОбъект);
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТонкийКлиент(Команда)

	ЗапуститьПодПользователем(4);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТолстыйКлиентУправляемоеПриложение(Команда)

	ЗапуститьПодПользователем(3);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТолстыйКлиентОбычноеПриложение(Команда)

	ЗапуститьПодПользователем(2);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбщуюКомандуИнструментов(Команда)

	УИ_ОбщегоНазначенияКлиент.Подключаемый_ВыполнитьОбщуюКомандуИнструментов(ЭтотОбъект, Команда);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПользователиИБПередУдалениемЗавершение(Ответ, Идентификаторы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Идентификатор Из УдалитьПользователейНаСервере(Идентификаторы) Цикл
		Оповестить(ИмяСобытияЗаписиПользователя, Идентификатор, ЭтотОбъект);
	КонецЦикла;
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

// Запускает сеанс под пользователем текущей строки, см. УИ_ОбщегоНазначенияКлиент.ЗапуститьСеанс1С.
//
// Параметры:
//  ТипКлиента - Число - код режима запуска: 2 - толстый клиент, обычное приложение;
//               3 - толстый клиент, управляемое приложение; 4 - тонкий клиент
&НаКлиенте
Процедура ЗапуститьПодПользователем(ТипКлиента)

	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УИ_ОбщегоНазначенияКлиент.ЗапуститьСеанс1С(ТипКлиента, ТекущиеДанные.Имя, Истина, ПаузаПередВосстановлениемПароля);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущегоПользователя()

	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьФормуПользователя(Новый Структура("ИмяПользователя", ТекущиеДанные.Имя));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияАктивизацииСтрокиПользователиИБ()

	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

// Заполняет таблицу ролей ролями пользователя текущей строки списка.
// Роли берутся из строки списка, представления ролей - из ПредставленияРолей, без вызова сервера.
&НаКлиенте
Процедура ЗаполнитьРолиТекущегоПользователя()

	РолиПользователя.Очистить();
	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	Если Не ПоказыватьРоли Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КартинкаРоли = БиблиотекаКартинок.УИ_МетаданныеРоль;
	Для Каждого ИмяРоли Из СтрРазделить(ТекущиеДанные.ИменаРолей, ", ", Ложь) Цикл
		СтрокаРоли = РолиПользователя.Добавить();
		СтрокаРоли.Картинка = КартинкаРоли;
		СтрокаРоли.Имя = ИмяРоли;
		ПредставлениеРоли = ПредставленияРолей.Получить(ИмяРоли);
		СтрокаРоли.Представление = ?(ПредставлениеРоли = Неопределено, ИмяРоли, ПредставлениеРоли);
	КонецЦикла;

КонецПроцедуры

// Открывает форму пользователя, подчиненную списку.
//
// Параметры:
//  ПараметрыФормы - Структура - параметры формы пользователя
//  Уникальность - УникальныйИдентификатор, Неопределено - ключ уникальности формы: новый идентификатор
//                 открывает отдельную форму для каждого создаваемого пользователя
&НаКлиенте
Процедура ОткрытьФормуПользователя(ПараметрыФормы, Уникальность = Неопределено)

	ОткрытьФорму("Обработка.УИ_ПользователиИСеансы.Форма.ФормаПользователя", ПараметрыФормы, Элементы.ПользователиИБ,
		Уникальность);

КонецПроцедуры

// Перечитывает строку пользователя после записи или удаления пользователя.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор пользователя
&НаКлиенте
Процедура ОбновитьСтрокуПользователя(Идентификатор)

	ИдентификаторСтроки = ОбновитьСтрокуПользователяНаСервере(Идентификатор);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.ПользователиИБ.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

// Перечитывает список пользователей.
//
// Параметры:
//  ИдентификаторПользователяТекущейСтроки - УникальныйИдентификатор, Неопределено - пользователь,
//                                           на строку которого нужно вернуться после обновления
//
// Возвращаемое значение:
//  Число, Неопределено - идентификатор строки пользователя; Неопределено, если пользователя нет в списке
&НаСервере
Функция ОбновитьСписокНаСервере(ИдентификаторПользователяТекущейСтроки)

	ЗаполнитьПользователей();
	Возврат ИдентификаторСтрокиПользователя(ИдентификаторПользователяТекущейСтроки);

КонецФункции

// Добавляет, обновляет или удаляет строку пользователя по данным информационной базы.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор пользователя
//
// Возвращаемое значение:
//  Число, Неопределено - идентификатор строки пользователя; Неопределено, если пользователь не найден
&НаСервере
Функция ОбновитьСтрокуПользователяНаСервере(Идентификатор)

	Данные = УИ_ПользователиИСеансы.ДанныеПользователяИБДляСписка(Идентификатор);
	СтрокиПользователя = ПользователиИБ.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
	Если Данные = Неопределено Тогда
		Для Каждого СтрокаПользователя Из СтрокиПользователя Цикл
			ПользователиИБ.Удалить(СтрокаПользователя);
		КонецЦикла;
		ОбновитьЗаголовокСтраницы();
		Возврат Неопределено;
	КонецЕсли;

	Если СтрокиПользователя.Количество() = 0 Тогда
		СтрокаПользователя = ПользователиИБ.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПользователя, Данные);
		ПользователиИБ.Сортировать("Имя");
		ОбновитьЗаголовокСтраницы();
	Иначе
		СтрокаПользователя = СтрокиПользователя[0];
		ЗаполнитьЗначенияСвойств(СтрокаПользователя, Данные);
	КонецЕсли;
	Возврат СтрокаПользователя.ПолучитьИдентификатор();

КонецФункции

// Удаляет пользователей информационной базы. Об ошибках удаления выводятся сообщения.
//
// Параметры:
//  Идентификаторы - Массив из УникальныйИдентификатор - удаляемые пользователи
//
// Возвращаемое значение:
//  Массив из УникальныйИдентификатор - удаленные пользователи
&НаСервере
Функция УдалитьПользователейНаСервере(Идентификаторы)

	Удаленные = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокиПользователя = ПользователиИБ.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
		ИмяУдаляемогоПользователя = ?(СтрокиПользователя.Количество() = 0, "", СтрокиПользователя[0].Имя);
		Попытка
			УИ_ПользователиИСеансы.УдалитьПользователяИБ(Идентификатор);
			Удаленные.Добавить(Идентификатор);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Пользователь ""%1"" не удален: %2'"), ИмяУдаляемогоПользователя,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			УИ_ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		ОбновитьСтрокуПользователяНаСервере(Идентификатор);
	КонецЦикла;
	Возврат Удаленные;

КонецФункции

&НаСервере
Процедура ЗаполнитьПользователей()

	ПользователиИБ.Очистить();
	Для Каждого Данные Из УИ_ПользователиИСеансы.ДанныеПользователейИБДляСписка() Цикл
		ЗаполнитьЗначенияСвойств(ПользователиИБ.Добавить(), Данные);
	КонецЦикла;
	ПользователиИБ.Сортировать("Имя");
	ОбновитьЗаголовокСтраницы();

КонецПроцедуры

// Возвращает представления всех ролей, включая роли расширений, для таблицы ролей пользователя.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - имя роли
//   * Значение - Строка - представление роли
&НаСервереБезКонтекста
Функция ПредставленияРолейКонфигурации()

	Представления = Новый Соответствие;
	Для Каждого Роль Из Метаданные.Роли Цикл
		Представления.Вставить(Роль.Имя, Роль.Представление());
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Представления);

КонецФункции

&НаСервере
Функция ИдентификаторСтрокиПользователя(Идентификатор)

	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокиПользователя = ПользователиИБ.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
	Возврат ?(СтрокиПользователя.Количество() = 0, Неопределено, СтрокиПользователя[0].ПолучитьИдентификатор());

КонецФункции

&НаСервере
Процедура ОбновитьЗаголовокСтраницы()

	Элементы.СтраницаПользователи.Заголовок = СтрШаблон(НСтр("ru = 'Пользователи (%1)'"), ПользователиИБ.Количество());

КонецПроцедуры

// Выделяет жирным шрифтом строку пользователя, под которым выполнен вход в программу.
&НаСервере
Процедура УстановитьОформлениеТекущегоПользователя()

	//@skip-check new-font
	ЖирныйШрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина);
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ЖирныйШрифт);

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПользователиИБ.ЭтоТекущийПользователь");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПользователиИБ.Имя);

КонецПроцедуры

// Скрывает колонки свойств, которых нет в текущей версии платформы, и основной интерфейс,
// если в конфигурации нет интерфейсов обычного приложения.
&НаСервере
Процедура СкрытьНедоступныеСвойства()

	Для Каждого КлючИЗначение Из УИ_ПользователиИСеансы.ДоступныеСвойстваПользователяИБ() Цикл
		Элементы["ПользователиИБ" + КлючИЗначение.Ключ].Видимость = КлючИЗначение.Значение;
	КонецЦикла;
	Элементы.ПользователиИБОсновнойИнтерфейс.Видимость = (Метаданные.Интерфейсы.Количество() > 0);

КонецПроцедуры

// Без права "Администрирование" в списке только текущий пользователь, см. УИ_ПользователиИСеансы.ДанныеПользователейИБДляСписка.
// Скрывает команды, которым нужно это право: создание, копирование и удаление пользователей, запуск под пользователем.
// Свою карточку пользователь открывает из списка.
&НаСервере
Процедура СкрытьКомандыАдминистрирования()

	Если УИ_ПользователиИСеансы.ЕстьПравоАдминистрированияПользователей() Тогда
		Возврат;
	КонецЕсли;
	Элементы.ПользователиИБ.ИзменятьСоставСтрок = Ложь;
	Элементы.ГруппаНастройкиСписка.Видимость = Ложь;
	Элементы.ПользователиИБГруппаЗапускПодПользователем.Видимость = Ложь;
	Элементы.ПользователиИБКонтекстноеМенюГруппаЗапускПодПользователем.Видимость = Ложь;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРолей(Форма)

	Форма.Элементы.РолиПользователя.Видимость = Форма.ПоказыватьРоли;
	Форма.Элементы.ПользователиИБРоли.Пометка = Форма.ПоказыватьРоли;

КонецПроцедуры

#КонецОбласти
