// Основная форма обработки: пользователи информационной базы, сеансы и соединения.
// Пользователи создаются, копируются и изменяются в форме ФормаПользователя.
// Без права "Администрирование" в списке только текущий пользователь, его карточка открывается из списка,
// страница сеансов скрыта.
// Сеансы завершаются через COM-соединитель на клиенте под Windows, а если он недоступен (веб-клиент, Linux, macOS,
// соединитель не зарегистрирован) - через сервер администрирования кластера (RAS) утилитой rac на сервере.
// На странице сеансов также устанавливается блокировка сеансов (форма ФормаБлокировкиСеансов)
// и включается монопольный режим текущего сеанса.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяСобытияЗаписиПользователя = УИ_ПользователиИСеансы.ИмяСобытияЗаписиПользователяИБ();
	ПредставленияРолей = ПредставленияРолейКонфигурации();
	ПаузаПередВосстановлениемПароля = 20;
	СкрытьНедоступныеСвойства();
	СкрытьКомандыАдминистрирования();
	УстановитьОформлениеТекущихСтрок();
	ЗаполнитьПользователей();
	Если УИ_ПользователиИСеансы.ЕстьПравоАдминистрированияПользователей() Тогда
		НастроитьЗавершениеСеансов();
		ЗаполнитьСеансыИСоединения();
	КонецЕсли;
	УстановитьВидимостьРолей(ЭтотОбъект);
	УстановитьВидимостьСоединений(ЭтотОбъект);

	УИ_ОбщегоНазначения.ФормаИнструментаПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	УстановитьВидимостьРолей(ЭтотОбъект);
	УстановитьВидимостьСоединений(ЭтотОбъект);
	Если СпособПодключенияККластеру <> СпособПодключенияCOM() И СпособПодключенияККластеру <> СпособПодключенияRAS() Тогда
		СпособПодключенияККластеру = СпособПодключенияАвтоматически();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = ИмяСобытияЗаписиПользователя И Источник <> ЭтотОбъект
		И ТипЗнч(Параметр) = Тип("УникальныйИдентификатор") Тогда
		ОбновитьСтрокуПользователя(Параметр);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПользователиИБ

&НаКлиенте
Процедура ПользователиИБВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПриАктивизацииСтроки(Элемент)

	Если ПоказыватьРоли Тогда
		ИнтервалОжидания = 0.1;
		ПодключитьОбработчикОжидания("ОбработчикОжиданияАктивизацииСтрокиПользователиИБ", ИнтервалОжидания, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;
	Если Не Копирование Тогда
		ОткрытьФормуПользователя(Новый Структура, Новый УникальныйИдентификатор);
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьФормуПользователя(Новый Структура("ЗначениеКопирования", ТекущиеДанные.Имя),
			Новый УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПередНачаломИзменения(Элемент, Отказ)

	Отказ = Истина;
	ОткрытьТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ПользователиИБПередУдалением(Элемент, Отказ)

	Отказ = Истина;

	Идентификаторы = Новый Массив;
	ИменаПользователей = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элемент.ВыделенныеСтроки Цикл
		СтрокаПользователя = ПользователиИБ.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаПользователя <> Неопределено Тогда
			Идентификаторы.Добавить(СтрокаПользователя.Идентификатор);
			ИменаПользователей.Добавить(СтрокаПользователя.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Идентификаторы.Количество() = 1 Тогда
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить пользователя информационной базы ""%1""? Удаление нельзя отменить.'"),
			ИменаПользователей[0]);
	Иначе
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Удалить выделенных пользователей информационной базы (%1)? Удаление нельзя отменить.'"),
			Идентификаторы.Количество());
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПользователиИБПередУдалениемЗавершение", ЭтотОбъект, Идентификаторы);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСеансы

&НаКлиенте
Процедура СеансыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьПользователяСтроки(Элемент.ТекущиеДанные);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоединения

&НаКлиенте
Процедура СоединенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьПользователяСтроки(Элемент.ТекущиеДанные);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСеансы Тогда
		ОбновитьСеансыИСоединения();
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	ИдентификаторСтроки = ОбновитьСписокНаСервере(?(ТекущиеДанные = Неопределено, Неопределено,
		ТекущиеДанные.Идентификатор));
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.ПользователиИБ.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура Роли(Команда)

	ПоказыватьРоли = Не ПоказыватьРоли;
	УстановитьВидимостьРолей(ЭтотОбъект);
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТонкийКлиент(Команда)

	ТипКлиентаТонкийКлиент = 4;
	ЗапуститьПодПользователем(ТипКлиентаТонкийКлиент);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТолстыйКлиентУправляемоеПриложение(Команда)

	ТипКлиентаТолстыйУправляемое = 3;
	ЗапуститьПодПользователем(ТипКлиентаТолстыйУправляемое);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТолстыйКлиентОбычноеПриложение(Команда)

	ТипКлиентаТолстыйОбычное = 2;
	ЗапуститьПодПользователем(ТипКлиентаТолстыйОбычное);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСеансы(Команда)

	НомераСеансов = Новый Массив;
	ВыделенТекущийСеанс = Ложь;
	Для Каждого ИдентификаторСтроки Из Элементы.Сеансы.ВыделенныеСтроки Цикл
		СтрокаСеанса = Сеансы.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаСеанса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаСеанса.ТекущийСеанс Тогда
			ВыделенТекущийСеанс = Истина;
		Иначе
			НомераСеансов.Добавить(СтрокаСеанса.НомерСеанса);
		КонецЕсли;
	КонецЦикла;

	Если НомераСеансов.Количество() = 0 Тогда
		Если ВыделенТекущийСеанс Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Текущий сеанс завершить нельзя. Чтобы выйти из программы, закройте ее главное окно.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Попытка
		ПодключениеККластеру = НовоеПодключениеККластеру();
	Исключение
		ПоказатьОшибкуЗавершенияСеансов(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ТекстВопроса = СтрШаблон(НСтр("ru = 'Завершить выделенные сеансы (%1)? Несохраненные данные в них будут потеряны.'"),
		НомераСеансов.Количество());
	ПараметрыЗавершения = Новый Структура("НомераСеансов, ПодключениеККластеру", НомераСеансов, ПодключениеККластеру);
	Оповещение = Новый ОписаниеОповещения("ЗавершитьСеансыЗавершение", ЭтотОбъект, ПараметрыЗавершения);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПользователяСеанса(Команда)

	Если ТекущийЭлемент = Элементы.Соединения Тогда
		ОткрытьПользователяСтроки(Элементы.Соединения.ТекущиеДанные);
	Иначе
		ОткрытьПользователяСтроки(Элементы.Сеансы.ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСоединения(Команда)

	ПоказыватьСоединения = Не ПоказыватьСоединения;
	УстановитьВидимостьСоединений(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьБлокировкуСеансов(Команда)

	Оповещение = Новый ОписаниеОповещения("ОткрытьБлокировкуСеансовЗавершение", ЭтотОбъект);
	ОткрытьФорму("Обработка.УИ_ПользователиИСеансы.Форма.ФормаБлокировкиСеансов", , ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьМонопольныйРежим(Команда)

	Включить = Не Элементы.СеансыМонопольныйРежим.Пометка;
	Попытка
		Элементы.СеансыМонопольныйРежим.Пометка = УстановитьМонопольныйРежимНаСервере(Включить);
	Исключение
		ПодробностиОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Включить Тогда
			ТекстПредупреждения = СтрШаблон(НСтр("ru = 'Монопольный режим не включен.
				|Его можно включить, только когда с информационной базой не работают другие сеансы: завершите их
				|или установите блокировку сеансов и дождитесь, пока они завершатся.
				|Техническая информация: %1'"), ПодробностиОшибки);
		Иначе
			ТекстПредупреждения = СтрШаблон(НСтр("ru = 'Монопольный режим не выключен.
				|Техническая информация: %1'"), ПодробностиОшибки);
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбщуюКомандуИнструментов(Команда)

	УИ_ОбщегоНазначенияКлиент.Подключаемый_ВыполнитьОбщуюКомандуИнструментов(ЭтотОбъект, Команда);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПользователиИБПередУдалениемЗавершение(Ответ, Идентификаторы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Идентификатор Из УдалитьПользователейНаСервере(Идентификаторы) Цикл
		Оповестить(ИмяСобытияЗаписиПользователя, Идентификатор, ЭтотОбъект);
	КонецЦикла;
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

// Запускает сеанс под пользователем текущей строки, см. УИ_ОбщегоНазначенияКлиент.ЗапуститьСеанс1С.
//
// Параметры:
//  ТипКлиента - Число - код режима запуска: 2 - толстый клиент, обычное приложение;
//               3 - толстый клиент, управляемое приложение; 4 - тонкий клиент
&НаКлиенте
Процедура ЗапуститьПодПользователем(ТипКлиента)

	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УИ_ОбщегоНазначенияКлиент.ЗапуститьСеанс1С(ТипКлиента, ТекущиеДанные.Имя, Истина, ПаузаПередВосстановлениемПароля,
		ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущегоПользователя()

	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьФормуПользователя(Новый Структура("ИмяПользователя", ТекущиеДанные.Имя));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияАктивизацииСтрокиПользователиИБ()

	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

// Заполняет таблицу ролей ролями пользователя текущей строки списка.
// Роли берутся из строки списка, представления ролей - из ПредставленияРолей, без вызова сервера.
&НаКлиенте
Процедура ЗаполнитьРолиТекущегоПользователя()

	РолиПользователя.Очистить();
	ТекущиеДанные = Элементы.ПользователиИБ.ТекущиеДанные;
	Если Не ПоказыватьРоли Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КартинкаРоли = БиблиотекаКартинок.УИ_МетаданныеРоль;
	Для Каждого ИмяРоли Из СтрРазделить(ТекущиеДанные.ИменаРолей, ", ", Ложь) Цикл
		СтрокаРоли = РолиПользователя.Добавить();
		СтрокаРоли.Картинка = КартинкаРоли;
		СтрокаРоли.Имя = ИмяРоли;
		ПредставлениеРоли = ПредставленияРолей.Получить(ИмяРоли);
		СтрокаРоли.Представление = ?(ПредставлениеРоли = Неопределено, ИмяРоли, ПредставлениеРоли);
	КонецЦикла;

КонецПроцедуры

// Открывает форму пользователя, подчиненную списку.
//
// Параметры:
//  ПараметрыФормы - Структура - параметры формы пользователя
//  Уникальность - УникальныйИдентификатор, Неопределено - ключ уникальности формы: новый идентификатор
//                 открывает отдельную форму для каждого создаваемого пользователя
&НаКлиенте
Процедура ОткрытьФормуПользователя(ПараметрыФормы, Уникальность = Неопределено)

	ОткрытьФорму("Обработка.УИ_ПользователиИСеансы.Форма.ФормаПользователя", ПараметрыФормы, Элементы.ПользователиИБ,
		Уникальность);

КонецПроцедуры

// Открывает карточку пользователя строки сеанса или соединения.
//
// Параметры:
//  ДанныеСтроки - ДанныеФормыЭлементКоллекции, Неопределено - строка таблицы сеансов или соединений
&НаКлиенте
Процедура ОткрытьПользователяСтроки(ДанныеСтроки)

	Если ДанныеСтроки = Неопределено Или ПустаяСтрока(ДанныеСтроки.Пользователь) Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФормуПользователя(Новый Структура("ИмяПользователя", ДанныеСтроки.Пользователь));

КонецПроцедуры

// Перечитывает строку пользователя после записи или удаления пользователя.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор пользователя
&НаКлиенте
Процедура ОбновитьСтрокуПользователя(Идентификатор)

	ИдентификаторСтроки = ОбновитьСтрокуПользователяНаСервере(Идентификатор);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.ПользователиИБ.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
	ЗаполнитьРолиТекущегоПользователя();

КонецПроцедуры

// Перечитывает список пользователей.
//
// Параметры:
//  ИдентификаторПользователяТекущейСтроки - УникальныйИдентификатор, Неопределено - пользователь,
//                                           на строку которого нужно вернуться после обновления
//
// Возвращаемое значение:
//  Число, Неопределено - идентификатор строки пользователя; Неопределено, если пользователя нет в списке
&НаСервере
Функция ОбновитьСписокНаСервере(Знач ИдентификаторПользователяТекущейСтроки)

	ЗаполнитьПользователей();
	Возврат ИдентификаторСтрокиПользователя(ИдентификаторПользователяТекущейСтроки);

КонецФункции

// Добавляет, обновляет или удаляет строку пользователя по данным информационной базы.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор пользователя
//
// Возвращаемое значение:
//  Число, Неопределено - идентификатор строки пользователя; Неопределено, если пользователь не найден
&НаСервере
Функция ОбновитьСтрокуПользователяНаСервере(Знач Идентификатор)

	Данные = УИ_ПользователиИСеансы.ДанныеПользователяИБДляСписка(Идентификатор);
	СтрокиПользователя = ПользователиИБ.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
	Если Данные = Неопределено Тогда
		Для Каждого СтрокаПользователя Из СтрокиПользователя Цикл
			ПользователиИБ.Удалить(СтрокаПользователя);
		КонецЦикла;
		ОбновитьЗаголовокСтраницы();
		Возврат Неопределено;
	КонецЕсли;

	Если СтрокиПользователя.Количество() = 0 Тогда
		СтрокаПользователя = ПользователиИБ.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПользователя, Данные);
		ПользователиИБ.Сортировать("Имя");
		ОбновитьЗаголовокСтраницы();
	Иначе
		СтрокаПользователя = СтрокиПользователя[0];
		ЗаполнитьЗначенияСвойств(СтрокаПользователя, Данные);
	КонецЕсли;
	Возврат СтрокаПользователя.ПолучитьИдентификатор();

КонецФункции

// Удаляет пользователей информационной базы. Об ошибках удаления выводятся сообщения.
//
// Параметры:
//  Идентификаторы - Массив из УникальныйИдентификатор - удаляемые пользователи
//
// Возвращаемое значение:
//  Массив из УникальныйИдентификатор - удаленные пользователи
&НаСервере
Функция УдалитьПользователейНаСервере(Знач Идентификаторы)

	Удаленные = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокиПользователя = ПользователиИБ.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
		ИмяУдаляемогоПользователя = ?(СтрокиПользователя.Количество() = 0, "", СтрокиПользователя[0].Имя);
		Попытка
			УИ_ПользователиИСеансы.УдалитьПользователяИБ(Идентификатор);
			Удаленные.Добавить(Идентификатор);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Пользователь ""%1"" не удален: %2'"), ИмяУдаляемогоПользователя,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			УИ_ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		ОбновитьСтрокуПользователяНаСервере(Идентификатор);
	КонецЦикла;
	Возврат Удаленные;

КонецФункции

&НаСервере
Процедура ЗаполнитьПользователей()

	ПользователиИБ.Очистить();
	Для Каждого Данные Из УИ_ПользователиИСеансы.ДанныеПользователейИБДляСписка() Цикл
		ЗаполнитьЗначенияСвойств(ПользователиИБ.Добавить(), Данные);
	КонецЦикла;
	ПользователиИБ.Сортировать("Имя");
	ОбновитьЗаголовокСтраницы();

КонецПроцедуры

// Возвращает представления всех ролей, включая роли расширений, для таблицы ролей пользователя.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - имя роли
//   * Значение - Строка - представление роли
&НаСервереБезКонтекста
Функция ПредставленияРолейКонфигурации()

	Представления = Новый Соответствие;
	Для Каждого Роль Из Метаданные.Роли Цикл
		Представления.Вставить(Роль.Имя, Роль.Представление());
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Представления);

КонецФункции

&НаСервере
Функция ИдентификаторСтрокиПользователя(Идентификатор)

	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокиПользователя = ПользователиИБ.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
	Возврат ?(СтрокиПользователя.Количество() = 0, Неопределено, СтрокиПользователя[0].ПолучитьИдентификатор());

КонецФункции

&НаСервере
Процедура ОбновитьЗаголовокСтраницы()

	Элементы.СтраницаПользователи.Заголовок = СтрШаблон(НСтр("ru = 'Пользователи (%1)'"), ПользователиИБ.Количество());

КонецПроцедуры

// Выделяет жирным шрифтом строки пользователя, сеанса и соединения, в которых работает текущий сеанс.
&НаСервере
Процедура УстановитьОформлениеТекущихСтрок()

	// BSLLS:StyleElementConstructors-off
	//@skip-check new-font
	ЖирныйШрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина);
	// BSLLS:StyleElementConstructors-on
	ДобавитьОформлениеСтрокТаблицы(Элементы.ПользователиИБ, "ЭтоТекущийПользователь", ЖирныйШрифт);
	ДобавитьОформлениеСтрокТаблицы(Элементы.Сеансы, "ТекущийСеанс", ЖирныйШрифт);
	ДобавитьОформлениеСтрокТаблицы(Элементы.Соединения, "ТекущееСоединение", ЖирныйШрифт);

КонецПроцедуры

// Добавляет условное оформление строк таблицы, у которых колонка-признак равна Истина.
//
// Параметры:
//  Таблица - ТаблицаФормы - оформляемая таблица
//  ИмяКолонкиПризнака - Строка - имя колонки с признаком
//  ШрифтСтрок - Шрифт - шрифт оформляемых строк
&НаСервере
Процедура ДобавитьОформлениеСтрокТаблицы(Таблица, ИмяКолонкиПризнака, ШрифтСтрок)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтСтрок);

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Таблица.ПутьКДанным + "." + ИмяКолонкиПризнака);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Таблица.Имя);

КонецПроцедуры

// Скрывает колонки свойств, которых нет в текущей версии платформы, и основной интерфейс,
// если в конфигурации нет интерфейсов обычного приложения.
&НаСервере
Процедура СкрытьНедоступныеСвойства()

	Для Каждого КлючИЗначение Из УИ_ПользователиИСеансы.ДоступныеСвойстваПользователяИБ() Цикл
		Элементы["ПользователиИБ" + КлючИЗначение.Ключ].Видимость = КлючИЗначение.Значение;
	КонецЦикла;
	Элементы.ПользователиИБОсновнойИнтерфейс.Видимость = (Метаданные.Интерфейсы.Количество() > 0);

КонецПроцедуры

// Без права "Администрирование" в списке только текущий пользователь, см. УИ_ПользователиИСеансы.ДанныеПользователейИБДляСписка.
// Скрывает команды, которым нужно это право: создание, копирование и удаление пользователей, запуск под пользователем,
// и страницу сеансов. Свою карточку пользователь открывает из списка.
&НаСервере
Процедура СкрытьКомандыАдминистрирования()

	Если УИ_ПользователиИСеансы.ЕстьПравоАдминистрированияПользователей() Тогда
		Возврат;
	КонецЕсли;
	Элементы.ПользователиИБ.ИзменятьСоставСтрок = Ложь;
	Элементы.ГруппаНастройкиСписка.Видимость = Ложь;
	Элементы.ПользователиИБГруппаЗапускПодПользователем.Видимость = Ложь;
	Элементы.ПользователиИБКонтекстноеМенюГруппаЗапускПодПользователем.Видимость = Ложь;
	Элементы.СтраницаСеансы.Видимость = Ложь;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРолей(Форма)

	Форма.Элементы.РолиПользователя.Видимость = Форма.ПоказыватьРоли;
	Форма.Элементы.ПользователиИБРоли.Пометка = Форма.ПоказыватьРоли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСоединений(Форма)

	Форма.Элементы.Соединения.Видимость = Форма.ПоказыватьСоединения;
	Форма.Элементы.СеансыСоединения.Пометка = Форма.ПоказыватьСоединения;

КонецПроцедуры

// Читает параметры подключения к кластеру серверов и заполняет список способов подключения.
// В файловой базе кластера нет, поэтому скрывает команды завершения сеансов и настройки подключения к кластеру.
&НаСервере
Процедура НастроитьЗавершениеСеансов()

	ПараметрыКластера = УИ_ПользователиИСеансы.ПараметрыПодключенияККластеру();
	ЕстьКластер = Не ПараметрыКластера.ЭтоФайловаяБаза;
	Элементы.ГруппаПодключениеККластеру.Видимость = ЕстьКластер;
	Элементы.СеансыЗавершитьСеансы.Видимость = ЕстьКластер;
	Элементы.СеансыКонтекстноеМенюЗавершитьСеансы.Видимость = ЕстьКластер;

	СпособыПодключения = Элементы.СпособПодключенияККластеру.СписокВыбора;
	СпособыПодключения.Добавить(СпособПодключенияАвтоматически(), НСтр("ru = 'Автоматически: COM, если доступен, иначе RAS'"));
	СпособыПодключения.Добавить(СпособПодключенияCOM(), НСтр("ru = 'COM-соединитель на этом компьютере'"));
	СпособыПодключения.Добавить(СпособПодключенияRAS(), НСтр("ru = 'Сервер администрирования (RAS) через rac на сервере'"));
	СпособПодключенияККластеру = СпособПодключенияАвтоматически();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСеансыИСоединения()

	Сеансы.Очистить();
	Для Каждого Данные Из УИ_ПользователиИСеансы.ДанныеСеансовИБ() Цикл
		ЗаполнитьЗначенияСвойств(Сеансы.Добавить(), Данные);
	КонецЦикла;
	Сеансы.Сортировать("НачалоСеанса");

	Соединения.Очистить();
	Для Каждого Данные Из УИ_ПользователиИСеансы.ДанныеСоединенийИБ() Цикл
		ЗаполнитьЗначенияСвойств(Соединения.Добавить(), Данные);
	КонецЦикла;
	Соединения.Сортировать("НачалоСоединения");

	Элементы.СтраницаСеансы.Заголовок = СтрШаблон(НСтр("ru = 'Сеансы (%1)'"), Сеансы.Количество());
	Элементы.Соединения.Заголовок = СтрШаблон(НСтр("ru = 'Соединения (%1)'"), Соединения.Количество());

	ДанныеБлокировки = УИ_ПользователиИСеансы.ДанныеБлокировкиСеансов();
	Элементы.СеансыБлокировкаСеансов.Пометка = ДанныеБлокировки.Установлена;
	Элементы.СеансыМонопольныйРежим.Пометка = МонопольныйРежим();

КонецПроцедуры

// Перечитывает сеансы и соединения и возвращает курсор на те же сеанс и соединение, если они остались.
&НаКлиенте
Процедура ОбновитьСеансыИСоединения()

	ДанныеСеанса = Элементы.Сеансы.ТекущиеДанные;
	ДанныеСоединения = Элементы.Соединения.ТекущиеДанные;
	ТекущиеСтроки = ОбновитьСеансыИСоединенияНаСервере(?(ДанныеСеанса = Неопределено, 0, ДанныеСеанса.НомерСеанса),
		?(ДанныеСоединения = Неопределено, 0, ДанныеСоединения.НомерСоединения));
	Если ТекущиеСтроки.Сеанс <> Неопределено Тогда
		Элементы.Сеансы.ТекущаяСтрока = ТекущиеСтроки.Сеанс;
	КонецЕсли;
	Если ТекущиеСтроки.Соединение <> Неопределено Тогда
		Элементы.Соединения.ТекущаяСтрока = ТекущиеСтроки.Соединение;
	КонецЕсли;

КонецПроцедуры

// Перечитывает сеансы и соединения.
//
// Параметры:
//  НомерСеансаТекущейСтроки - Число - сеанс, на строку которого нужно вернуться после обновления
//  НомерСоединенияТекущейСтроки - Число - соединение, на строку которого нужно вернуться после обновления
//
// Возвращаемое значение:
//  Структура:
//   * Сеанс - Число, Неопределено - идентификатор строки сеанса; Неопределено, если сеанса больше нет
//   * Соединение - Число, Неопределено - идентификатор строки соединения; Неопределено, если соединения больше нет
&НаСервере
Функция ОбновитьСеансыИСоединенияНаСервере(Знач НомерСеансаТекущейСтроки, Знач НомерСоединенияТекущейСтроки)

	ЗаполнитьСеансыИСоединения();
	СтрокиСеанса = Сеансы.НайтиСтроки(Новый Структура("НомерСеанса", НомерСеансаТекущейСтроки));
	СтрокиСоединения = Соединения.НайтиСтроки(Новый Структура("НомерСоединения", НомерСоединенияТекущейСтроки));
	ИдентификаторСтрокиСеанса = ?(СтрокиСеанса.Количество() = 0, Неопределено, СтрокиСеанса[0].ПолучитьИдентификатор());
	ИдентификаторСтрокиСоединения = ?(СтрокиСоединения.Количество() = 0, Неопределено,
		СтрокиСоединения[0].ПолучитьИдентификатор());
	Возврат Новый Структура("Сеанс, Соединение", ИдентификаторСтрокиСеанса, ИдентификаторСтрокиСоединения);

КонецФункции

// Обновляет сеансы, соединения и пометки блокировки сеансов и монопольного режима после закрытия формы блокировки.
//
// Параметры:
//  Результат - Неопределено - результат закрытия формы блокировки сеансов
//  ДополнительныеПараметры - Неопределено - не используются
&НаКлиенте
Процедура ОткрытьБлокировкуСеансовЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ОбновитьСеансыИСоединения();

КонецПроцедуры

// Включает или выключает монопольный режим текущего сеанса,
// см. УИ_ПользователиИСеансы.УстановитьМонопольныйРежимСеанса.
//
// Параметры:
//  Включить - Булево - Истина, чтобы включить монопольный режим
//
// Возвращаемое значение:
//  Булево - Истина, если после изменения монопольный режим включен
&НаСервереБезКонтекста
Функция УстановитьМонопольныйРежимНаСервере(Знач Включить)

	Возврат УИ_ПользователиИСеансы.УстановитьМонопольныйРежимСеанса(Включить);

КонецФункции

&НаКлиенте
Процедура ЗавершитьСеансыЗавершение(Ответ, ПараметрыЗавершения) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КоличествоЗавершенных = 0;
	Попытка
		КоличествоЗавершенных = ЗавершитьСеансыЧерезКластер(ПараметрыЗавершения.ПодключениеККластеру,
			ПараметрыЗавершения.НомераСеансов);
	Исключение
		ПоказатьОшибкуЗавершенияСеансов(ИнформацияОбОшибке());
	КонецПопытки;

	ОбновитьСеансыИСоединения();
	Если КоличествоЗавершенных > 0 Тогда
		ТекстОповещения = СтрШаблон(НСтр("ru = 'Завершено сеансов: %1 (через %2)'"), КоличествоЗавершенных,
			ПараметрыЗавершения.ПодключениеККластеру.Способ);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сеансы завершены'"), , ТекстОповещения);
	КонецЕсли;

КонецПроцедуры

// Показывает, почему сеансы не завершены: предупреждением и сообщением, из которого можно скопировать
// команду регистрации COM-соединителя.
//
// Параметры:
//  ИнформацияОбОшибкеВызова - ИнформацияОбОшибке - ошибка подключения к кластеру или завершения сеансов
&НаКлиенте
Процедура ПоказатьОшибкуЗавершенияСеансов(ИнформацияОбОшибкеВызова)

	ПодробностиОшибки = ОписаниеОшибкиСПричинами(ИнформацияОбОшибкеВызова);
	ТекстОшибки = СтрШаблон(НСтр("ru = 'Сеансы не завершены.
		|%1'"), ПодробностиОшибки);
	УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	ПоказатьПредупреждение(, ТекстОшибки);

КонецПроцедуры

// Подключается к кластеру серверов информационной базы и находит в нем информационную базу. Вызывается до вопроса
// о завершении сеансов, чтобы ошибки подключения пользователь увидел сразу.
// Способ подключения берется из реквизита СпособПодключенияККластеру:
//  - автоматически - COM-соединитель на клиенте под Windows, а если он на этом клиенте недоступен (веб-клиент, Linux,
//    macOS, соединитель не зарегистрирован) - сервер администрирования (RAS) через rac на сервере. Если COM-соединитель
//    работает, но подключиться к кластеру через него не удалось, RAS не пробуется;
//  - COM - только COM-соединитель;
//  - RAS - только сервер администрирования.
// При ошибке вызывает исключение с описанием, что случилось и что проверить.
//
// Возвращаемое значение:
//  см. ОписаниеПодключенияККластеру
&НаКлиенте
Функция НовоеПодключениеККластеру()

	ПричинаНедоступностиCOM = "";
	Если СпособПодключенияККластеру <> СпособПодключенияRAS() Тогда
		ПодключениеCOM = СоединениеСАгентомСервера();
		СоединениеСАгентом = ПодключениеCOM.СоединениеСАгентом;
		ПричинаНедоступностиCOM = ПодключениеCOM.ПричинаНедоступностиCOM;
		Если СоединениеСАгентом <> Неопределено Тогда
			Кластер = КластерСерверов(СоединениеСАгентом);
			ИнформационнаяБаза = ИнформационнаяБазаКластера(СоединениеСАгентом, Кластер);
			Возврат ОписаниеПодключенияККластеру(СпособПодключенияCOM(), СоединениеСАгентом, Кластер, ИнформационнаяБаза);
		КонецЕсли;
		Если СпособПодключенияККластеру = СпособПодключенияCOM() Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'В настройках подключения к кластеру выбран COM-соединитель,
				|но на этом компьютере он недоступен.
				|%1
				|
				|Чтобы завершать сеансы через сервер администрирования (RAS), выберите в группе
				|""Подключение к кластеру серверов"" способ ""Автоматически"" или ""Сервер администрирования (RAS)"".'"),
				ПричинаНедоступностиCOM);
		КонецЕсли;
	КонецЕсли;

	Попытка
		ПодключениеRAS = ПодключениеККластеруЧерезRASНаСервере(ПараметрыКластера, ИмяАдминистратораКластера,
			ПарольАдминистратораКластера);
	Исключение
		ОписаниеОшибкиRAS = ОписаниеОшибкиСПричинами(ИнформацияОбОшибке());
		Если СпособПодключенияККластеру = СпособПодключенияRAS() Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось подключиться к кластеру через сервер администрирования (RAS),
				|выбранный в настройках подключения к кластеру.
				|%1'"), ОписаниеОшибкиRAS);
		КонецЕсли;
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось подключиться к кластеру серверов ни одним из двух способов,
			|достаточно настроить любой из них. Способ можно выбрать и явно в группе ""Подключение к кластеру серверов"".
			|
			|Способ 1. COM-соединитель 1С:Предприятия на этом компьютере.
			|%1
			|
			|Способ 2. Сервер администрирования кластера (RAS) через утилиту rac на сервере 1С:Предприятия.
			|%2'"), ПричинаНедоступностиCOM, ОписаниеОшибкиRAS);
	КонецПопытки;
	Способ = СпособПодключенияRAS();
	Возврат ОписаниеПодключенияККластеру(Способ, Неопределено, ПодключениеRAS.Кластер, ПодключениеRAS.ИнформационнаяБаза);

КонецФункции

// Возвращает описание подключения к кластеру серверов, см. НовоеПодключениеККластеру.
//
// Параметры:
//  Способ - Строка - "COM" или "RAS"
//  СоединениеСАгентом - COMОбъект, Неопределено - соединение с агентом сервера для способа COM, Неопределено для RAS
//  Кластер - COMОбъект, Строка - кластер серверов для COM, идентификатор кластера для RAS
//  ИнформационнаяБаза - COMОбъект, Строка - описание информационной базы для COM, ее идентификатор для RAS
//
// Возвращаемое значение:
//  Структура:
//   * Способ - Строка - "COM" или "RAS"
//   * СоединениеСАгентом - COMОбъект, Неопределено - соединение с агентом сервера для COM, Неопределено для RAS
//   * Кластер - COMОбъект, Строка - кластер серверов для COM, идентификатор кластера для RAS
//   * ИнформационнаяБаза - COMОбъект, Строка - описание информационной базы для COM, ее идентификатор для RAS
&НаКлиенте
Функция ОписаниеПодключенияККластеру(Способ, СоединениеСАгентом, Кластер, ИнформационнаяБаза)

	Подключение = Новый Структура;
	Подключение.Вставить("Способ", Способ);
	Подключение.Вставить("СоединениеСАгентом", СоединениеСАгентом);
	Подключение.Вставить("Кластер", Кластер);
	Подключение.Вставить("ИнформационнаяБаза", ИнформационнаяБаза);
	Возврат Подключение;

КонецФункции

// Способ подключения к кластеру "Автоматически": COM-соединитель, а если он недоступен - сервер администрирования.
//
// Возвращаемое значение:
//  Строка - значение реквизита СпособПодключенияККластеру
&НаКлиентеНаСервереБезКонтекста
Функция СпособПодключенияАвтоматически()

	Возврат "Авто";

КонецФункции

// Способ подключения к кластеру через COM-соединитель на клиенте.
//
// Возвращаемое значение:
//  Строка - значение реквизита СпособПодключенияККластеру и свойства Способ описания подключения
&НаКлиентеНаСервереБезКонтекста
Функция СпособПодключенияCOM()

	Возврат "COM";

КонецФункции

// Способ подключения к кластеру через сервер администрирования (RAS) утилитой rac на сервере.
//
// Возвращаемое значение:
//  Строка - значение реквизита СпособПодключенияККластеру и свойства Способ описания подключения
&НаКлиентеНаСервереБезКонтекста
Функция СпособПодключенияRAS()

	Возврат "RAS";

КонецФункции

// Завершает сеансы информационной базы через подключение к кластеру серверов, см. НовоеПодключениеККластеру.
// Сеансы ищутся только среди сеансов этой информационной базы: номера сеансов уникальны в пределах базы.
// Ошибки отдельных сеансов и уже завершенные сеансы выводятся сообщениями.
//
// Параметры:
//  ПодключениеККластеру - см. НовоеПодключениеККластеру
//  НомераСеансов - Массив из Число - номера завершаемых сеансов
//
// Возвращаемое значение:
//  Число - количество завершенных сеансов
&НаКлиенте
Функция ЗавершитьСеансыЧерезКластер(ПодключениеККластеру, НомераСеансов)

	Если ПодключениеККластеру.Способ = СпособПодключенияRAS() Тогда
		ПодключениеRAS = Новый Структура("Кластер, ИнформационнаяБаза", ПодключениеККластеру.Кластер,
			ПодключениеККластеру.ИнформационнаяБаза);
		РезультатRAS = ЗавершитьСеансыЧерезRASНаСервере(ПараметрыКластера, ПодключениеRAS, НомераСеансов,
			ИмяАдминистратораКластера, ПарольАдминистратораКластера);
		Для Каждого ТекстСообщения Из РезультатRAS.Ошибки Цикл
			УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
		СообщитьОНенайденныхСеансах(РезультатRAS.НенайденныеСеансы);
		Возврат РезультатRAS.КоличествоЗавершенных;
	КонецЕсли;

	СоединениеСАгентом = ПодключениеККластеру.СоединениеСАгентом;
	Кластер = ПодключениеККластеру.Кластер;

	КоличествоЗавершенных = 0;
	НенайденныеСеансы = Новый Массив;
	Для Каждого НомерСеанса Из НомераСеансов Цикл
		НенайденныеСеансы.Добавить(НомерСеанса);
	КонецЦикла;
	СеансыБазы = СоединениеСАгентом.GetInfoBaseSessions(Кластер, ПодключениеККластеру.ИнформационнаяБаза).Выгрузить();
	Для Каждого Сеанс Из СеансыБазы Цикл
		ИндексСеанса = НенайденныеСеансы.Найти(Сеанс.SessionID);
		Если ИндексСеанса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НенайденныеСеансы.Удалить(ИндексСеанса);
		Попытка
			СоединениеСАгентом.TerminateSession(Кластер, Сеанс);
			КоличествоЗавершенных = КоличествоЗавершенных + 1;
		Исключение
			ПодробностиОшибки = ОписаниеОшибкиСПричинами(ИнформацияОбОшибке());
			НомерСеансаСтрокой = Формат(Сеанс.SessionID, "ЧГ=0");
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Сеанс %1 не завершен: кластер серверов отказал в завершении.
				|Техническая информация: %2'"), НомерСеансаСтрокой, ПодробностиОшибки);
			УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЦикла;
	СообщитьОНенайденныхСеансах(НенайденныеСеансы);
	Возврат КоличествоЗавершенных;

КонецФункции

// Сообщает о сеансах, которых не оказалось в кластере к моменту завершения.
//
// Параметры:
//  НенайденныеСеансы - Массив из Число - номера сеансов
&НаКлиенте
Процедура СообщитьОНенайденныхСеансах(НенайденныеСеансы)

	Для Каждого НомерСеанса Из НенайденныеСеансы Цикл
		НомерСеансаСтрокой = Формат(НомерСеанса, "ЧГ=0");
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Сеанс %1 не найден в кластере: вероятно, он уже завершился сам.'"),
			НомерСеансаСтрокой);
		УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;

КонецПроцедуры

// Подключается к кластеру через сервер администрирования (RAS),
// см. УИ_ПользователиИСеансы.ПодключениеККластеруЧерезRAS.
//
// Параметры:
//  ПараметрыПодключения - см. УИ_ПользователиИСеансы.ПараметрыПодключенияККластеру
//  ИмяАдминистратора - Строка
//  ПарольАдминистратора - Строка
//
// Возвращаемое значение:
//  см. УИ_ПользователиИСеансы.ПодключениеККластеруЧерезRAS
&НаСервереБезКонтекста
Функция ПодключениеККластеруЧерезRASНаСервере(Знач ПараметрыПодключения, Знач ИмяАдминистратора,
	Знач ПарольАдминистратора)

	Возврат УИ_ПользователиИСеансы.ПодключениеККластеруЧерезRAS(ПараметрыПодключения, ИмяАдминистратора,
		ПарольАдминистратора);

КонецФункции

// Завершает сеансы через сервер администрирования (RAS), см. УИ_ПользователиИСеансы.ЗавершитьСеансыЧерезRAS.
//
// Параметры:
//  ПараметрыПодключения - см. УИ_ПользователиИСеансы.ПараметрыПодключенияККластеру
//  ПодключениеRAS - см. УИ_ПользователиИСеансы.ПодключениеККластеруЧерезRAS
//  НомераСеансов - Массив из Число
//  ИмяАдминистратора - Строка
//  ПарольАдминистратора - Строка
//
// Возвращаемое значение:
//  см. УИ_ПользователиИСеансы.ЗавершитьСеансыЧерезRAS
&НаСервереБезКонтекста
Функция ЗавершитьСеансыЧерезRASНаСервере(Знач ПараметрыПодключения, Знач ПодключениеRAS, Знач НомераСеансов,
	Знач ИмяАдминистратора, Знач ПарольАдминистратора)

	Возврат УИ_ПользователиИСеансы.ЗавершитьСеансыЧерезRAS(ПараметрыПодключения, ПодключениеRAS, НомераСеансов,
		ИмяАдминистратора, ПарольАдминистратора);

КонецФункции

// Подключается к агенту сервера через COM-соединитель версии сервера.
// Если COM-соединитель на этом клиенте недоступен (веб-клиент, Linux, macOS, соединитель не зарегистрирован или
// зарегистрирован не полностью), возвращает причину недоступности. Если соединитель работает,
// но агент недоступен, вызывает исключение с описанием, что проверить.
//
// Возвращаемое значение:
//  см. РезультатПодключенияCOM
&НаКлиенте
Функция СоединениеСАгентомСервера()

	Если УИ_ОбщегоНазначенияКлиент.ЭтоВебКлиент() Или Не УИ_ОбщегоНазначенияКлиентСервер.ЭтоWindows() Тогда
		Причина = НСтр("ru = 'COM-объекты недоступны в веб-клиенте и в клиентах под Linux и macOS.'");
		Возврат РезультатПодключенияCOM(Неопределено, Причина);
	КонецЕсли;

	ИмяСоединителя = ПараметрыКластера.ИмяCOMСоединителя;
	Попытка
		COMСоединитель = НовыйCOMСоединитель(ИмяСоединителя);
	Исключение
		ПодробностиОшибки = ОписаниеОшибкиСПричинами(ИнформацияОбОшибке());
		КомандаРегистрации = КомандаРегистрацииCOMСоединителя();
		Причина = СтрШаблон(НСтр("ru = 'COM-соединитель %1 не зарегистрирован на этом компьютере.
			|Соединитель (comcntr.dll) устанавливается вместе с платформой, но в Windows регистрируется отдельно,
			|его версия должна совпадать с версией сервера %2 по первым двум числам.
			|Что сделать: запустите командную строку от имени администратора Windows и выполните команду
			|%3
			|Техническая информация: %4'"), ИмяСоединителя, ПараметрыКластера.ВерсияСервера, КомандаРегистрации,
			ПодробностиОшибки);
		Возврат РезультатПодключенияCOM(Неопределено, Причина);
	КонецПопытки;

	ПортАгента = Формат(ПараметрыКластера.ПортАгентаСервера, "ЧГ=0");
	АдресАгента = СтрШаблон("tcp://%1:%2", ПараметрыКластера.АдресАгентаСервера, ПортАгента);
	Попытка
		СоединениеСАгентом = COMСоединитель.ConnectAgent(АдресАгента);
		Возврат РезультатПодключенияCOM(СоединениеСАгентом, "");
	Исключение
		ПодробностиОшибки = ОписаниеОшибкиСПричинами(ИнформацияОбОшибке());
	КонецПопытки;

	Если ЭтоОшибкаРегистрацииБиблиотекиТипов(ПодробностиОшибки) Тогда
		КомандаРегистрации = КомандаРегистрацииCOMСоединителя();
		Причина = СтрШаблон(НСтр("ru = 'COM-соединитель %1 зарегистрирован на этом компьютере не полностью.
			|В Windows есть класс соединителя, но нет его библиотеки типов, поэтому платформа не может вызвать
			|методы соединителя и сообщает ""Метод объекта не обнаружен"".
			|Что сделать: запустите командную строку от имени администратора Windows и перерегистрируйте соединитель командой
			|%2
			|Если ошибка останется, перезапустите клиент 1С:Предприятия.
			|Техническая информация: %3'"), ИмяСоединителя, КомандаРегистрации, ПодробностиОшибки);
		Возврат РезультатПодключенияCOM(Неопределено, Причина);
	КонецЕсли;
	ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось подключиться к агенту сервера 1С:Предприятия %1.
		|Адрес сервера взят из строки соединения информационной базы, порт агента на единицу меньше порта кластера.
		|Что проверить: служба агента сервера запущена и слушает этот порт (параметр -port в командной строке службы),
		|а сетевой доступ к порту с этого компьютера не закрыт.
		|Техническая информация: %2'"), АдресАгента, ПодробностиОшибки);

КонецФункции

// Возвращает результат подключения к агенту сервера через COM-соединитель, см. СоединениеСАгентомСервера.
//
// Параметры:
//  СоединениеСАгентом - COMОбъект, Неопределено - соединение с агентом сервера; Неопределено, если COM-соединитель
//                       на этом клиенте недоступен
//  ПричинаНедоступностиCOM - Строка - почему COM-соединитель недоступен и как это исправить
//
// Возвращаемое значение:
//  Структура:
//   * СоединениеСАгентом - COMОбъект, Неопределено - соединение с агентом сервера; Неопределено, если COM-соединитель
//                          на этом клиенте недоступен
//   * ПричинаНедоступностиCOM - Строка - почему COM-соединитель недоступен и как это исправить
&НаКлиенте
Функция РезультатПодключенияCOM(СоединениеСАгентом, ПричинаНедоступностиCOM)

	Возврат Новый Структура("СоединениеСАгентом, ПричинаНедоступностиCOM", СоединениеСАгентом, ПричинаНедоступностиCOM);

КонецФункции

// Создает COM-соединитель. В веб-клиенте COM-объекты недоступны.
//
// Параметры:
//  ИмяСоединителя - Строка - имя COM-соединителя, например "V83.COMConnector"
//
// Возвращаемое значение:
//  COMОбъект - COM-соединитель
&НаКлиенте
Функция НовыйCOMСоединитель(ИмяСоединителя)

	#Если ВебКлиент Тогда
	ВызватьИсключение НСтр("ru = 'COM-соединитель недоступен в веб-клиенте.'");
	#Иначе
	// BSLLS:UsingObjectNotAvailableUnix-off
	Возврат Новый COMОбъект(ИмяСоединителя);
	// BSLLS:UsingObjectNotAvailableUnix-on
	#КонецЕсли

КонецФункции

// Возвращает признак того, что у COM-соединителя не зарегистрирована библиотека типов: класс в Windows есть,
// объект создается, но его методы не вызываются. Платформа сообщает об этом "Метод объекта не обнаружен (ConnectAgent)",
// Windows - "Library not registered" (код 0x8002801D).
//
// Параметры:
//  ПодробностиОшибки - Строка - описание ошибки с причинами
//
// Возвращаемое значение:
//  Булево - Истина, если это ошибка регистрации библиотеки типов
&НаКлиенте
Функция ЭтоОшибкаРегистрацииБиблиотекиТипов(ПодробностиОшибки)

	ТекстОшибки = НРег(ПодробностиОшибки);
	Возврат СтрНайти(ТекстОшибки, "метод объекта не обнаружен") > 0
		Или СтрНайти(ТекстОшибки, "method not found") > 0
		Или СтрНайти(ТекстОшибки, "library not registered") > 0
		Или СтрНайти(ТекстОшибки, "библиотека не зарегистрирована") > 0
		Или СтрНайти(ТекстОшибки, "8002801d") > 0;

КонецФункции

// Возвращает команду регистрации COM-соединителя для текста ошибки. Путь к comcntr.dll подставляется из каталога
// программы клиента, если версия клиента совпадает с версией сервера по первым двум числам, иначе указывается версия сервера.
//
// Возвращаемое значение:
//  Строка - команда regsvr32
&НаКлиенте
Функция КомандаРегистрацииCOMСоединителя()

	ИнформацияОСистеме = Новый СистемнаяИнформация;
	НомераВерсии = СтрРазделить(ИнформацияОСистеме.ВерсияПриложения, ".");
	ИмяСоединителяКлиента = СтрШаблон("V%1%2.COMConnector", НомераВерсии[0], НомераВерсии[1]);
	КаталогПлатформы = КаталогПрограммыКлиента();
	Если ИмяСоединителяКлиента <> ПараметрыКластера.ИмяCOMСоединителя Или ПустаяСтрока(КаталогПлатформы) Тогда
		КаталогПлатформы = СтрШаблон(НСтр("ru = '<каталог bin платформы %1>'"), ПараметрыКластера.ВерсияСервера);
	КонецЕсли;
	ПутьКБиблиотеке = УИ_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогПлатформы, "comcntr.dll");
	Возврат СтрШаблон("regsvr32 ""%1""", ПутьКБиблиотеке);

КонецФункции

// Возвращает каталог программы клиента.
//
// Возвращаемое значение:
//  Строка - каталог программы клиента; в веб-клиенте - пустая строка
&НаКлиенте
Функция КаталогПрограммыКлиента()

	#Если ВебКлиент Тогда
	Возврат "";
	#Иначе
	Возврат КаталогПрограммы();
	#КонецЕсли

КонецФункции

// Находит кластер информационной базы по порту и выполняет в нем аутентификацию администратора кластера.
// Если кластер не найден или войти не удалось, вызывает исключение с описанием, что проверить.
//
// Параметры:
//  СоединениеСАгентом - COMОбъект - соединение с агентом сервера
//
// Возвращаемое значение:
//  COMОбъект - кластер серверов
&НаКлиенте
Функция КластерСерверов(СоединениеСАгентом)

	ПортКластера = Формат(ПараметрыКластера.ПортКластера, "ЧГ=0");
	АдресКластера = СтрШаблон("%1:%2", ПараметрыКластера.АдресАгентаСервера, ПортКластера);
	Попытка
		Кластеры = СоединениеСАгентом.GetClusters().Выгрузить();
	Исключение
		ПодробностиОшибки = ОписаниеОшибкиСПричинами(ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Агент сервера %1 не выдал список кластеров.
			|Техническая информация: %2'"), ПараметрыКластера.АдресАгентаСервера, ПодробностиОшибки);
	КонецПопытки;

	Для Каждого Кластер Из Кластеры Цикл
		Если Кластер.MainPort <> ПараметрыКластера.ПортКластера Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			СоединениеСАгентом.Authenticate(Кластер, ИмяАдминистратораКластера,
				?(ПустаяСтрока(ИмяАдминистратораКластера), "", ПарольАдминистратораКластера));
		Исключение
			ПодробностиОшибки = ОписаниеОшибкиСПричинами(ИнформацияОбОшибке());
			Если ПустаяСтрока(ИмяАдминистратораКластера) Тогда
				ОписаниеВхода = НСтр("ru = 'без имени администратора'");
			Иначе
				ОписаниеВхода = СтрШаблон(НСтр("ru = 'под администратором ""%1""'"), ИмяАдминистратораКластера);
			КонецЕсли;
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось войти в кластер серверов %1 %2.
				|Если в кластере заданы администраторы, укажите на странице ""Сеансы"" имя и пароль одного из них.
				|Если администраторов кластера нет, оставьте эти поля пустыми.
				|Техническая информация: %3'"), АдресКластера, ОписаниеВхода, ПодробностиОшибки);
		КонецПопытки;
		Возврат Кластер;
	КонецЦикла;
	ВызватьИсключение СтрШаблон(НСтр("ru = 'У агента сервера %1 нет кластера с портом %2.
		|Порт кластера взят из параметра Srvr строки соединения информационной базы; если порт там не указан,
		|используется порт по умолчанию 1541.'"), ПараметрыКластера.АдресАгентаСервера, ПортКластера);

КонецФункции

// Находит информационную базу в кластере серверов по имени из строки соединения.
// Если базы нет, вызывает исключение с описанием, что проверить.
//
// Параметры:
//  СоединениеСАгентом - COMОбъект - соединение с агентом сервера
//  Кластер - COMОбъект - кластер серверов
//
// Возвращаемое значение:
//  COMОбъект - краткое описание информационной базы в кластере
&НаКлиенте
Функция ИнформационнаяБазаКластера(СоединениеСАгентом, Кластер)

	ИмяБазы = НРег(ПараметрыКластера.ИмяИнформационнойБазы);
	ПортКластера = Формат(ПараметрыКластера.ПортКластера, "ЧГ=0");
	Попытка
		БазыКластера = СоединениеСАгентом.GetInfoBases(Кластер).Выгрузить();
	Исключение
		ПодробностиОшибки = ОписаниеОшибкиСПричинами(ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Кластер серверов %1:%2 не выдал список информационных баз.
			|Техническая информация: %3'"), ПараметрыКластера.АдресАгентаСервера, ПортКластера, ПодробностиОшибки);
	КонецПопытки;

	Для Каждого ОписаниеБазы Из БазыКластера Цикл
		Если НРег(ОписаниеБазы.Name) = ИмяБазы Тогда
			Возврат ОписаниеБазы;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон(НСтр("ru = 'В кластере серверов %1:%2 нет информационной базы ""%3"".
		|Имя базы взято из параметра Ref строки соединения информационной базы. Проверьте, что база
		|зарегистрирована в этом кластере под тем же именем.'"), ПараметрыКластера.АдресАгентаСервера, ПортКластера,
		ПараметрыКластера.ИмяИнформационнойБазы);

КонецФункции

// Возвращает описание ошибки вместе с описаниями причин: у ошибок COM-соединения подробности в причинах.
//
// Параметры:
//  ИнформацияОбОшибкеВызова - ИнформацияОбОшибке - ошибка
//
// Возвращаемое значение:
//  Строка - описания ошибки и ее причин, каждое с новой строки
&НаКлиенте
Функция ОписаниеОшибкиСПричинами(ИнформацияОбОшибкеВызова)

	Описания = Новый Массив;
	ТекущаяОшибка = ИнформацияОбОшибкеВызова;
	Пока ТекущаяОшибка <> Неопределено Цикл
		Описания.Добавить(ТекущаяОшибка.Описание);
		ТекущаяОшибка = ТекущаяОшибка.Причина;
	КонецЦикла;
	Возврат СтрСоединить(Описания, Символы.ПС);

КонецФункции

#КонецОбласти
