#Область ОписаниеПеременных

&НаСервере
Перем ОбработкаОбъект; // ВнешняяОбработка.КонструкторПредставленийЗарплатаКадры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Заполняет текст запроса и код программного интерфейса по переданным параметрам формы
// и управляет доступностью страницы кода программного интерфейса.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак использования стандартной обработки инициализации формы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекстЗапросаПредставления.УстановитьТекст(Параметры.ТекстЗапросаПредставления);	
	ОбновитьИсполняемыйТекстЗапроса = Истина;
	
	Если ЗначениеЗаполнено(Параметры.КодПрограммногоИнтерфейса) Тогда
		КодПрограммногоИнтерфейса.УстановитьТекст(Параметры.КодПрограммногоИнтерфейса);
	Иначе
		Элементы.СтраницаКодПрограммногоИнтерфейса.Доступность = Ложь;
		Элементы.СтраницаКодПрограммногоИнтерфейса.Подсказка = НСтр("ru = 'Код программного интерфейса недоступен для данного представления'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Обрабатывает переключение на страницу исполняемого текста запроса:
// при необходимости обновляет исполняемый текст запроса на основании
// текста представления и выводит сообщение об ошибке при неудаче.
//
// Параметры:
//  Элемент         - ГруппаФормы - элемент управления, вызвавший событие (страницы).
//  ТекущаяСтраница - ГруппаФормы - страница, на которую выполняется переключение.
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаТекстЗапросаИсполняемый
		И ОбновитьИсполняемыйТекстЗапроса Тогда
		
		ТекстЗапроса = ТекстЗапросаПредставления.ПолучитьТекст();
		Если СтрНайти(ТекстЗапроса, "|") > 0 Тогда
			ТекстЗапроса = ТекстЗапросаИзСтрокКода(ТекстЗапроса);	
		КонецЕсли;
		
		Попытка
			ТекстЗапросаИсполняемый.УстановитьТекст(ИсполняемыйТекстЗапросаПредставления(ТекстЗапроса));
		Исключение
			ТекстЗапросаИсполняемый.УстановитьТекст(
				НСтр("ru = 'Произошла ошибка при формировании текста запроса. Возможно, в представлении допущена ошибка:'")
				+ Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						
		КонецПопытки;
		
		ОбновитьИсполняемыйТекстЗапроса = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает признак необходимости обновления исполняемого текста запроса при изменении текста запроса представления.
//
// Параметры:
//   Элемент - ПолеФормы - элемент формы, в котором произошло изменение
&НаКлиенте
Процедура ТекстЗапросаПредставленияПриИзменении(Элемент)
	ОбновитьИсполняемыйТекстЗапроса = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Помещает в буфер обмена текст активной страницы: исполняемый запрос, запрос представления
// или код программного интерфейса.
//
// Параметры:
//  Команда - КомандаФормы - не используется
&НаКлиенте
Асинх Процедура СкопироватьВБуферОбмена(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТекстЗапросаИсполняемый Тогда
		ДанныеДляПомещенияВБуфер = ТекстЗапросаИсполняемый.ПолучитьТекст();
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТекстЗапросаПредставления Тогда
		ДанныеДляПомещенияВБуфер = ТекстЗапросаПредставления.ПолучитьТекст();
	Иначе
		ДанныеДляПомещенияВБуфер = КодПрограммногоИнтерфейса.ПолучитьТекст();	
	КонецЕсли;
	
	ЭлементБуфераОбмена = Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ДанныеДляПомещенияВБуфер);
	Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ЭлементБуфераОбмена);
	
КонецПроцедуры

// Преобразует текст запроса текущей страницы формы в формат, пригодный для вставки в код, 
// и обновляет содержимое соответствующего текстового документа.
//
// Параметры:
//   Команда - КомандаФормы - команда формы, инициировавшая обработку
&НаКлиенте
Процедура ПреобразоватьДляВставкиВКод(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТекстЗапросаИсполняемый Тогда
		ТекстовыйДокумент = ТекстЗапросаИсполняемый;
	Иначе
		ТекстовыйДокумент = ТекстЗапросаПредставления;	
	КонецЕсли;
	
	ТекстЗапроса = ТекстовыйДокумент.ПолучитьТекст();
	
	Если СтрНайти(ТекстЗапроса, "|") > 0 Тогда
		ТекстЗапроса = ТекстЗапросаИзСтрокКода(ТекстЗапроса);	
	Иначе
		ТекстЗапроса = ТекстЗапросаДляВставкиВКод(ТекстЗапроса);
	КонецЕсли;
	
	ТекстовыйДокумент.УстановитьТекст(ТекстЗапроса);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Преобразует текст запроса представления в исполняемый текст, заменяя обращения к представлениям виртуальных таблиц.
//
// Параметры:
//   ТекстЗапросаПредставления - Строка - исходный текст запроса представления
//
// Возвращаемое значение:
//   Строка - исполняемый текст запроса с подставленными запросами к виртуальным таблицам
&НаСервере
Функция ИсполняемыйТекстЗапросаПредставления(Знач ТекстЗапросаПредставления)
	
	Если ПустаяСтрока(ТекстЗапросаПредставления) Тогда
		Возврат "";
	КонецЕсли;
	
	ОбработкаОбъект = ОбработкаОбъект();
	МодульОбщегоНазначения = ОбработкаОбъект.МодульОбщегоНазначения();
	МодульЗарплатаКадрыОбщиеНаборыДанных = МодульОбщегоНазначения.ОбщийМодуль("ЗарплатаКадрыОбщиеНаборыДанных");
	МодульЗарплатаКадрыОбщиеНаборыДанных.ЗаменитьЗапросыКПредставлениямВиртуальныхТаблиц(ТекстЗапросаПредставления);
	
	Возврат ТекстЗапросаПредставления;
		
КонецФункции

// Формирует текст запроса, подготовленный для вставки в код 1С в виде многострочного строкового литерала.
//
// Параметры:
//  ТекстЗапроса - Строка - исходный текст запроса
//
// Возвращаемое значение:
//  Строка - текст запроса, обрамлённый кавычками, с экранированными символами """ и символом переноса строки в начале каждой последующей строки
&НаСервереБезКонтекста
Функция ТекстЗапросаДляВставкиВКод(Знач ТекстЗапроса)
	
	ТекстЗапроса = СокрЛП(ТекстЗапроса);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", """""");
	ТекстЗапроса = """" + ТекстЗапроса + """";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ПС, Символы.ПС + "|");
	Возврат ТекстЗапроса;
	
КонецФункции

// Преобразует текст запроса, заданный в виде строк кода, в текст на языке запросов 1С.
//
// Параметры:
//   ТекстЗапроса - Строка - строки кода запроса
//
// Возвращаемое значение:
//   Строка - текст запроса на языке запросов
&НаСервере
Функция ТекстЗапросаИзСтрокКода(Знач ТекстЗапроса)
	
	Возврат ОбработкаОбъект().ТекстЗапросаИзСтрокКода(ТекстЗапроса);
	
КонецФункции

// Объект текущей обработки
// 
// Возвращаемое значение:
//  ВнешняяОбработка.КонструкторПредставленийЗарплатаКадры - Обработка объект
//
&НаСервере
Функция ОбработкаОбъект()
	
	Если ОбработкаОбъект = Неопределено Тогда
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат ОбработкаОбъект;
	
КонецФункции

#КонецОбласти
