#Область ОписаниеПеременных

&НаСервере
Перем ОбработкаОбъект; // ВнешняяОбработка.КонструкторПредставленийЗарплатаКадры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Формирует форму на сервере.
// Обрабатывает пакетный режим запуска, инициализирует описания представлений, списки выбора
// вида сравнения и источника данных, а также устанавливает условное оформление.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Обработка = ОбработкаОбъект();
	ПолноеИмяОбработки = Обработка.Метаданные().ПолноеИмя();
	
	ПараметрыЗапуска = ПараметрыЗапуска();
	Если ПараметрыЗапуска.ПакетныйРежим Тогда

		// В пакетном режиме форма не открывается: выполняется только выгрузка описаний представлений в JSON.
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		
		Если Не ЗначениеЗаполнено(ПараметрыЗапуска.КаталогВыгрузки) Тогда
			ВызватьИсключение НСтр("ru = 'Не указан каталог выгрузки'");
		КонецЕсли;
		
		ОписанияПредставлений = Обработка.ОписанияПредставленийПоКонфигурации();
		
		Обработка.ВыгрузитьПредставленияВJSON(ОписанияПредставлений, ПараметрыЗапуска.КаталогВыгрузки);

		Возврат;
			
	КонецЕсли;
	
	ОписаниеТипаВсеТипыПараметраПредставления = Обработка.ОписаниеТипаВсеТипыПараметраПредставления();
	
	ИнициализироватьОписанияПредставлений();
	УстановитьОтборОсновныхПредставлений(ЭтотОбъект);
	
	Элементы.ПараметрыВидСравнения.РежимВыбораИзСписка = Истина;
	Для Каждого КлючИЗначение Из Обработка.ДоступныеВидыСравненияОтбора() Цикл
		//@skip-check typed-value-adding-to-untyped-collection
		Элементы.ПараметрыВидСравнения.СписокВыбора.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	ЗаполнитьСписокВыбораИсточникаДанных();
	
	РежимОтладки = Обработка.МодульОбщегоНазначения().РежимОтладки();
	Элементы.ФормаСброситьКэшОписанийПредставлений.Видимость = РежимОтладки;
	Элементы.ФормаВыгрузитьОписанияПредставленийВJSON.Видимость = РежимОтладки;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

// Обрабатывает открытие формы на клиенте.
// В пакетном режиме выгрузки на клиент запускает выгрузку описаний в JSON с последующим завершением работы;
// если каталог выгрузки не указан, выводит предупреждение и завершает работу.
// Применяет восстановленную из настроек отметку «Показывать все», при переданном тексте запроса
// представления разбирает его и помещает в данные формы, а при запуске от владельца формы
// устанавливает режим вставки или изменения.
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПараметрыЗапуска = РазобратьПараметрыЗапуска(ПараметрЗапуска);
	Если ПараметрыЗапуска.ПакетныйРежимКлиент Тогда
		Если ЗначениеЗаполнено(ПараметрыЗапуска.КаталогВыгрузки) Тогда
			ВыгрузитьОписанияПредставленийВКаталог(ПараметрыЗапуска.КаталогВыгрузки, Истина);
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьРаботуПослеПредупреждения", ЭтотОбъект);
			ПоказатьПредупреждение(ОписаниеОповещения, НСтр("ru = 'Не указан каталог выгрузки'"), , НСтр("ru = 'Пакетный режим'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Реквизит восстанавливается из настроек после ПриСозданииНаСервере, где отбор установлен по умолчанию.
	Если ОтображатьВсеПредставления Тогда
		УстановитьОтборОсновныхПредставлений(ЭтотОбъект);
	КонецЕсли;
			
	РедактированиеТекстаПредставления = Ложь;
	ИдентификаторСтрокиПредставления = Неопределено;
	Если Не ПустаяСтрока(Параметры.ТекстЗапроса) Тогда
		РедактированиеТекстаПредставления = Истина;

		РезультатПомещения = ТекстЗапросаПредставленияВДанныеФормы(Параметры.ТекстЗапроса);
		Если Не РезультатПомещения.Успех Тогда
			ТекстПредупреждения = СтрШаблон("Не удалось разобрать текст запроса: %1", РезультатПомещения.ТекстОшибки);
			ПоказатьПредупреждение(Неопределено, ТекстПредупреждения, , "Ошибка при разборе текста запроса");
		Иначе
			ИдентификаторСтрокиПредставления = РезультатПомещения.ИдентификаторСтрокиПредставления;
			ПерейтиКПредставлению(ИдентификаторСтрокиПредставления);
		КонецЕсли;	
	КонецЕсли;
	
	Если ВладелецФормы <> Неопределено Тогда
		Если РедактированиеТекстаПредставления Тогда
			УстановитьРежимИзменения(ЭтотОбъект, ИдентификаторСтрокиПредставления);
		Иначе
			УстановитьРежимВставки(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПредставления

// Откладывает обработку события активизации строки списка представлений через обработчик ожидания.
&НаКлиенте
Процедура ПредставленияПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("ПредставленияПослеАктивизацииСтроки");
	ПодключитьОбработчикОжидания("ПредставленияПослеАктивизацииСтроки", 0.1, Истина);

КонецПроцедуры

// Заполняет правую панель формы по текущему представлению: доступность элементов, список
// левых значений отбора и отбор строк таблиц полей и параметров.
//@skip-check module-structure-form-event-regions
&НаКлиенте
Процедура ПредставленияПослеАктивизацииСтроки()
	
	// TODO: Перенести на сервер.
	Представление = Элементы.Представления.ТекущиеДанные;

	Если Представление = Неопределено Тогда
		ИдентификаторПредставления = Неопределено;
		Элементы.ГруппаПравая.Доступность = Ложь;
		ДоступныеЛевыеЗначенияОтбора.Очистить();
	Иначе
		ИдентификаторПредставления = Представление.ИдентификаторПредставления;
		Элементы.ГруппаПравая.Доступность = Истина;
		Элементы.ПредставленияИсточникДанных.Видимость = Представление.ЕстьИсточникДанных;
		Элементы.ПредставленияФильтр.Видимость = Представление.ЕстьФильтр;
		Элементы.ПредставленияФильтр.АвтоОтметкаНезаполненного = Представление.ФильтрОбязателен;
		Элементы.ПредставленияФильтр.ОтметкаНезаполненного = Представление.ФильтрОбязателен
															 И ПустаяСтрока(Представление.Фильтр);
		ДоступныеЛевыеЗначенияОтбора.ЗагрузитьЗначения(ДоступныеЛевыеЗначенияОтбораПредставления(ИдентификаторПредставления)); // Вызов сервера
	КонецЕсли;

	УстановитьОтборСтрок(Элементы.Поля, "ИдентификаторПредставления", ИдентификаторПредставления); // Вызов сервера
	УстановитьОтборСтрок(Элементы.Параметры, "ИдентификаторПредставления", ИдентификаторПредставления); // Вызов сервера

	УстановитьПодсказкуЗаполненияПолей();
	УстановитьВидимостьОписанияСтроки("ГруппаОписаниеПредставления", Представление);
КонецПроцедуры

// Обрабатывает изменение источника данных текущего представления: обновляет доступные
// поля и подсказку их заполнения.
//@skip-check module-structure-form-event-regions
&НаКлиенте
Процедура ПредставленияИсточникДанныхПриИзменении(Элемент)
	ПредставленияИсточникДанныхПриИзмененииНаСервере();
	УстановитьПодсказкуЗаполненияПолей();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоля

// Заполняет идентификатор представления и признак использования для новой строки таблицы полей.
&НаКлиенте
Процедура ПоляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ИдентификаторПредставления = Элементы.Представления.ТекущиеДанные.ИдентификаторПредставления;
		Элемент.ТекущиеДанные.Используется = Истина;
	КонецЕсли;
КонецПроцедуры

// Обновляет список доступных левых значений отбора при изменении поля.
&НаКлиенте
Процедура ПоляПриИзменении(Элемент)
	Значения = ДоступныеЛевыеЗначенияОтбораПредставления(Элементы.Представления.ТекущиеДанные.ИдентификаторПредставления);
	ДоступныеЛевыеЗначенияОтбора.ЗагрузитьЗначения(Значения);
КонецПроцедуры

// Выводит описание текущего поля под таблицей.
&НаКлиенте
Процедура ПоляПриАктивизацииСтроки(Элемент)
	УстановитьВидимостьОписанияСтроки("ГруппаОписаниеПоля", Элемент.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПараметры

// Обрабатывает активизацию строки таблицы параметров: настраивает выбор значения и его список выбора.
&НаКлиенте
Процедура ПараметрыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Параметры.ТекущиеДанные;

	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Отбор Тогда
		Элементы.ПараметрыИмя.КнопкаВыбора = Истина;
	Иначе
		Элементы.ПараметрыИмя.КнопкаВыбора = Неопределено;
	КонецЕсли;

	Если ТекущиеДанные <> Неопределено Тогда
		Элементы.ПараметрыЗначение.СписокВыбора.Очистить();

		Для Каждого ЭлементСписка Из ТекущиеДанные.СписокВыбора Цикл
			Элементы.ПараметрыЗначение.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		КонецЦикла;

		Элементы.ПараметрыЗначение.РежимВыбораИзСписка = Элементы.ПараметрыЗначение.СписокВыбора.Количество() > 0;
	КонецЕсли;

	УстановитьСвойстваЭлементаЗначенияПараметра();
	УстановитьВидимостьОписанияСтроки("ГруппаОписаниеПараметра", ТекущиеДанные);

КонецПроцедуры

// Заполняет реквизиты новой строки таблицы параметров: признак отбора, идентификатор
// представления и признак использования.
&НаКлиенте
Процедура ПараметрыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Представление = Элементы.Представления.ТекущиеДанные;
		Элемент.ТекущиеДанные.Отбор = Представление.ДоступныОтборы;
		Элемент.ТекущиеДанные.ИдентификаторПредставления = Представление.ИдентификаторПредставления;
		Элемент.ТекущиеДанные.Используется = Истина;
		Элемент.ТекущиеДанные.ЗначениеЭтоВыражение = Истина;
		
		УстановитьСвойстваЭлементаЗначенияПараметра();
	КонецЕсли;
КонецПроцедуры

// Обновляет свойства элемента значения параметра при изменении признака "значение является выражением".
&НаКлиенте
Процедура ПараметрыЗначениеЭтоВыражениеПриИзменении(Элемент)
	УстановитьСвойстваЭлементаЗначенияПараметра();
КонецПроцедуры

// Организует автоматический подбор значения имени отбора из доступных левых значений.
&НаКлиенте
Процедура ПараметрыИмяАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если Элементы.Параметры.ТекущиеДанные.Отбор Тогда
		СтандартнаяОбработка = Ложь;

		ДанныеВыбора = Новый СписокЗначений;

		Для Каждого ЭлементСписка Из ДоступныеЛевыеЗначенияОтбора Цикл
			Если СтрНайти(ВРег(ЭлементСписка.Значение), ВРег(Текст)) > 0 Тогда
				ДанныеВыбора.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Заполняет список выбора имени отбора доступными левыми значениями.
&НаКлиенте
Процедура ПараметрыИмяНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	Если Элементы.Параметры.ТекущиеДанные.Отбор Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ДоступныеЛевыеЗначенияОтбора;
	КонецЕсли;

КонецПроцедуры

// Отмечает строку параметра как используемую и обновляет свойства элемента значения.
&НаКлиенте
Процедура ПараметрыЗначениеПриИзменении(Элемент)
	Элементы.Параметры.ТекущиеДанные.Используется = Истина;
	УстановитьСвойстваЭлементаЗначенияПараметра();
КонецПроцедуры

// Очищает значение параметра и обновляет свойства соответствующего элемента.
&НаКлиенте
Процедура ПараметрыЗначениеОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Элементы.Параметры.ТекущиеДанные.Значение = Неопределено;
	УстановитьСвойстваЭлементаЗначенияПараметра();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Открывает форму текста запроса для текущего представления.
&НаКлиенте
Процедура ПоказатьТекстЗапроса(Команда)
	ПараметрыФормы = ПодготовитьПараметрыОткрытияТекстаЗапроса();
	ОткрытьФорму(ПолноеИмяОбработки + ".Форма.ТекстЗапроса", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

// Закрывает форму и возвращает владельцу сформированный текст запроса представления.
&НаКлиенте
Процедура ВставитьТекстЗапросаПредставления(Команда)
	ПараметрыЗапроса = ПодготовитьПараметрыОткрытияТекстаЗапроса();
	Закрыть(ПараметрыЗапроса.ТекстЗапросаПредставления);
КонецПроцедуры

// Переключает отображение всех представлений и только основных: снимает или накладывает
// отбор списка представлений по признаку «Основное».
&НаКлиенте
Процедура ПоказыватьВсеПредставления(Команда)

	ОтображатьВсеПредставления = Не ОтображатьВсеПредставления;
	УстановитьОтборОсновныхПредставлений(ЭтотОбъект);

КонецПроцедуры

// Переключает отображение только используемых полей и параметров: накладывает или снимает
// отбор таблиц по признаку использования.
&НаКлиенте
Процедура ТолькоИспользуемые(Команда)

	ОтображатьТолькоИспользуемыеПоляИПараметры = Не ОтображатьТолькоИспользуемыеПоляИПараметры;

	Элементы.ПоляТолькоИспользуемые.Пометка = ОтображатьТолькоИспользуемыеПоляИПараметры;
	Элементы.ПараметрыТолькоИспользуемые.Пометка = ОтображатьТолькоИспользуемыеПоляИПараметры;

	ИмяПоля = "Используется";
	Если ОтображатьТолькоИспользуемыеПоляИПараметры Тогда
		УстановитьОтборСтрок(Элементы.Поля, ИмяПоля, Истина);
		УстановитьОтборСтрок(Элементы.Параметры, ИмяПоля, Истина);
	Иначе
		УдалитьОтборСтрок(Элементы.Поля, ИмяПоля);
		УдалитьОтборСтрок(Элементы.Параметры, ИмяПоля);
	КонецЕсли;

КонецПроцедуры

// Устанавливает признак использования всех отобранных строк таблицы параметров.
&НаКлиенте
Процедура УстановитьФлажкиПараметров(Команда)
	УстановитьСнятьФлажки(ПараметрыПредставлений.НайтиСтроки(Новый Структура(Элементы.Параметры.ОтборСтрок)), Истина);
КонецПроцедуры

// Снимает признак использования всех отобранных строк таблицы параметров.
&НаКлиенте
Процедура СнятьФлажкиПараметров(Команда)
	УстановитьСнятьФлажки(ПараметрыПредставлений.НайтиСтроки(Новый Структура(Элементы.Параметры.ОтборСтрок)), Ложь);
КонецПроцедуры

// Устанавливает признак использования всех отобранных строк таблицы полей.
&НаКлиенте
Процедура УстановитьФлажкиПолей(Команда)
	УстановитьСнятьФлажки(ПоляПредставлений.НайтиСтроки(Новый Структура(Элементы.Поля.ОтборСтрок)), Истина);
КонецПроцедуры

// Снимает признак использования всех отобранных строк таблицы полей.
&НаКлиенте
Процедура СнятьФлажкиПолей(Команда)
	УстановитьСнятьФлажки(ПоляПредставлений.НайтиСтроки(Новый Структура(Элементы.Поля.ОтборСтрок)), Ложь);
КонецПроцедуры

// Выполняет сброс текущих настроек формы к описаниям представлений по конфигурации.
&НаКлиенте
Процедура СброситьТекущиеНастройки(Команда)
	ИнициализироватьОписанияПредставлений();
	//@skip-check invocation-form-event-handler
	ПредставленияПриАктивизацииСтроки(Элементы.Представления);
КонецПроцедуры

// Выполняет сброс кэша описаний представлений на сервере (для режима отладки).
&НаКлиенте
Процедура СброситьКэшОписанийПредставлений(Команда)
	СброситьКэшОписанийПредставленийНаСервере();
КонецПроцедуры

// Запрашивает каталог на компьютере пользователя и выгружает в него описания представлений в JSON
// (для режима отладки).
&НаКлиенте
Процедура ВыгрузитьОписанияПредставленийВJSON(Команда)
	ВыгрузитьОписанияПредставленийВКаталог("", Ложь);
КонецПроцедуры

// Переходит на страницу проекта в репозитории.
&НаКлиенте
Процедура СтраницаПроекта(Команда)
	ПерейтиПоНавигационнойСсылке("https://github.com/iljyxa/SharedQueryDesignerHRM");
КонецПроцедуры

// Запрашивает у пользователя текст запроса представления для его импорта.
&НаКлиенте
Процедура ИмпортПредставленияИзТекстаЗапроса(Команда)
	
	// Асинх не используется для совместимости с УИ
	ОписаниеОповещения = Новый ОписаниеОповещения("ВводТекстаЗапросаЗавершение" , ЭтотОбъект);
	ТекстПодсказки = "Вставьте текст запроса представления";
	ПоказатьВводСтроки(ОписаниеОповещения, "", ТекстПодсказки, , Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сохраняет описания представлений в хранилище общих настроек вместе с версиями
// конфигурации и обработки. Версии используются для проверки актуальности кэша при чтении,
// см. ОписанияПредставленийИзХранилища.
//
// Параметры:
//  ОписанияПредставлений - Соответствие Из КлючИЗначение - Описания представлений.
&НаСервере
Процедура СохранитьОписанияПредставленийВХранилище(ОписанияПредставлений)
	Обработка = ОбработкаОбъект();

	// Версия обработки хранится в комментарии метаданных внешней обработки.
	СохраняемоеЗначение = Новый Структура;
	СохраняемоеЗначение.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	СохраняемоеЗначение.Вставить("ВерсияОбработки", Обработка.Метаданные().Комментарий);
	СохраняемоеЗначение.Вставить("ОписанияПредставлений", ОписанияПредставлений);
	
	Обработка.МодульОбщегоНазначения().ХранилищеОбщихНастроекСохранить(КлючХранилищаНастроек(),
																	   "ОписанияПредставлений",
																	   СохраняемоеЗначение);
КонецПроцедуры

// Загружает описания представлений из хранилища общих настроек, если версии конфигурации
// и обработки, с которыми они были сохранены, совпадают с текущими.
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение, Неопределено - Описания представлений или Неопределено,
//                                                если кэш отсутствует или устарел.
//
&НаСервере
Функция ОписанияПредставленийИзХранилища()

	Обработка = ОбработкаОбъект();
	МодульОбщегоНазначения = Обработка.МодульОбщегоНазначения();
	СохраненноеЗначение = МодульОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючХранилищаНастроек(),
																				 "ОписанияПредставлений");
	
	ОписанияПредставлений = Неопределено;

	// Версия обработки хранится в комментарии метаданных внешней обработки.
	Если ТипЗнч(СохраненноеЗначение) = Тип("Структура")
		И СохраненноеЗначение.Свойство("ВерсияКонфигурации")
		И СохраненноеЗначение.Свойство("ВерсияОбработки")
		И СохраненноеЗначение.ВерсияКонфигурации = Метаданные.Версия
		И СохраненноеЗначение.ВерсияОбработки = Обработка.Метаданные().Комментарий Тогда
		
		ОписанияПредставлений = СохраненноеЗначение.ОписанияПредставлений;
	КонецЕсли;
	
	Возврат ОписанияПредставлений;

КонецФункции

// Возвращает ключ хранилища настроек для описаний представлений.
//
// Возвращаемое значение:
//  Строка - Ключ хранилища настроек.
&НаСервереБезКонтекста
Функция КлючХранилищаНастроек()
	Возврат "КонструкторПредставленийЗарплатаКадры";
КонецФункции

// Объект текущей обработки
// 
// Возвращаемое значение:
//  ВнешняяОбработка.КонструкторПредставленийЗарплатаКадры - Обработка объект
//
&НаСервере
Функция ОбработкаОбъект()
	
	Если ОбработкаОбъект = Неопределено Тогда
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат ОбработкаОбъект;
	
КонецФункции

// Обрабатывает результат ввода текста запроса представления и помещает его в данные формы.
//
// Параметры:
//  ТекстЗапроса - Строка - Введенный текст запроса; пустая строка отменяет ввод.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры оповещения.
//
&НаКлиенте
Процедура ВводТекстаЗапросаЗавершение(ТекстЗапроса, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		РезультатПомещения = ТекстЗапросаПредставленияВДанныеФормы(ТекстЗапроса);
		Если Не РезультатПомещения.Успех Тогда
			ТекстПредупреждения = СтрШаблон("Не удалось разобрать текст запроса: %1", РезультатПомещения.ТекстОшибки);
			ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
		Иначе
			Если Элементы.Представления.ТекущаяСтрока = РезультатПомещения.ИдентификаторСтрокиПредставления Тогда
				ПредставленияПослеАктивизацииСтроки();	
			КонецЕсли;
			
			ПерейтиКПредставлению(РезультатПомещения.ИдентификаторСтрокиПредставления);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область РаботаСФормой

// Устанавливает видимость подсказки о необходимости указания источника данных.
&НаКлиенте
Процедура УстановитьПодсказкуЗаполненияПолей()

	Представление = Элементы.Представления.ТекущиеДанные;

	Если Представление = Неопределено Тогда
		Элементы.ГруппаПодсказкаПолей.Видимость = Ложь;
	Иначе
		Элементы.ГруппаПодсказкаПолей.Видимость = Представление.ЕстьИсточникДанных
												  И ПустаяСтрока(Представление.ИсточникДанных);
	КонецЕсли;

КонецПроцедуры

// Группа скрывается, если строка не выбрана или её описание не заполнено.
//
// Параметры:
//  ИмяГруппы - Строка - Имя элемента формы - группы, содержащей надпись с описанием.
//  ТекущиеДанные - Неопределено, ДанныеФормыСтруктура - Текущая строка представления, поля
//                  или параметра; Неопределено, если строка не выбрана.
&НаКлиенте
Процедура УстановитьВидимостьОписанияСтроки(ИмяГруппы, ТекущиеДанные)
	
	Видимость = ТекущиеДанные <> Неопределено
				И ЗначениеЗаполнено(ТекущиеДанные.Описание);
	
	Элемент = Элементы.Найти(ИмяГруппы);
	Если Элемент <> Неопределено
		И Элемент.Видимость <> Видимость Тогда
			
		Элемент.Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает ограничение типа, возможность выбора типа и кнопку выбора элемента значения параметра.
&НаКлиенте
Процедура УстановитьСвойстваЭлементаЗначенияПараметра()

	ТекущиеДанные = Элементы.Параметры.ТекущиеДанные;
	Элемент = Элементы.ПараметрыЗначение;

	Если ТекущиеДанные <> Неопределено Тогда
		Если ТекущиеДанные.ЗначениеЭтоВыражение Тогда
			Элемент.ОграничениеТипа = Новый ОписаниеТипов("Строка");
		ИначеЕсли ТекущиеДанные.ДоступныеТипы.Типы().Количество() = 0 Тогда
			Элемент.ОграничениеТипа = ОписаниеТипаВсеТипыПараметраПредставления;
		Иначе
			Элемент.ОграничениеТипа = ТекущиеДанные.ДоступныеТипы;
		КонецЕсли;

		Элемент.ВыбиратьТип = ТекущиеДанные.Значение = Неопределено;
		Элемент.КнопкаВыбора = Элемент.ВыбиратьТип И Элемент.ОграничениеТипа.Типы().Количество() > 1;
	Иначе
		Элемент.ОграничениеТипа = Новый ОписаниеТипов;
		Элемент.ВыбиратьТип = Истина;
		Элемент.КнопкаВыбора = Элемент.ВыбиратьТип;
	КонецЕсли;

КонецПроцедуры

// Устанавливает условное оформление формы: выделяет обязательные параметры, скрывает вид
// сравнения для строк, не являющихся отборами, и флажок отбора, где отборы недоступны.
&НаСервере
Процедура УстановитьУсловноеОформление()

	// Выделение обязательных параметров.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("Параметры");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор,
														 "ПараметрыПредставлений.Обязательный",
														 Истина);
	//@skip-check new-font
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	// Скрытие и блокировка колонки ВидСравнения для строк, не являющихся отборами.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПараметрыВидСравнения");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "ПараметрыПредставлений.Отбор", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);

	// Скрытие флажка Отбор, когда отборы недоступны для представления.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПараметрыОтбор");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "Представления.ДоступныОтборы", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

КонецПроцедуры

// Включает режим вставки текста запроса представления: показывает кнопку вставки и делает её кнопкой по умолчанию.
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - Форма, для которой устанавливается режим.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРежимВставки(Форма)

	Форма.Параметры.РежимВставки = Истина;
	Форма.Элементы.ФормаВставитьТекстЗапросаПредставления.Видимость = Истина;
	Форма.Элементы.ФормаВставитьТекстЗапросаПредставления.КнопкаПоУмолчанию = Истина;
	
КонецПроцедуры

// Включает режим изменения текста запроса представления: показывает кнопку изменения и делает её кнопкой по умолчанию.
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - Форма, для которой устанавливается режим.
//  ИдентификаторСтрокиПредставления - Неопределено, Число - Идентификатор строки представления, иначе текст в заголовке формы.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРежимИзменения(Форма, ИдентификаторСтрокиПредставления = Неопределено)
	
	Форма.Параметры.РежимИзменения = Истина;
	Форма.Элементы.ФормаВставитьТекстЗапросаПредставления.Видимость = Истина;
	Форма.Элементы.ФормаВставитьТекстЗапросаПредставления.Заголовок = "Изменить";
	Форма.Элементы.ФормаВставитьТекстЗапросаПредставления.КнопкаПоУмолчанию = Истина;
	
	Если ИдентификаторСтрокиПредставления <> Неопределено Тогда
		ДанныеСтроки = Форма.Представления.НайтиПоИдентификатору(ИдентификаторСтрокиПредставления);
		Форма.Заголовок = ДанныеСтроки.Имя + ": " + Форма.Заголовок;
	КонецЕсли;
	
КонецПроцедуры

// Делает представление текущим в таблице формы. Если представление не основное, а отображаются только основные,
// предварительно включает отображение всех представлений, иначе строка останется скрытой отбором.
//
// Параметры:
//  ИдентификаторСтроки - Число - Идентификатор строки представления в таблице формы.
&НаКлиенте
Процедура ПерейтиКПредставлению(ИдентификаторСтроки)

	Если Не ОтображатьВсеПредставления И Не Представления.НайтиПоИдентификатору(ИдентификаторСтроки).Основное Тогда
		ОтображатьВсеПредставления = Истина;
		УстановитьОтборОсновныхПредставлений(ЭтотОбъект);
	КонецЕсли;

	Элементы.Представления.ТекущаяСтрока = ИдентификаторСтроки;

КонецПроцедуры

// Устанавливает или снимает отбор основных представлений в таблице формы по реквизиту ОтображатьВсеПредставления
// и синхронизирует с ним отметку кнопки «Показывать все».
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - Форма, для которой устанавливается отбор.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборОсновныхПредставлений(Форма)

	Форма.Элементы.ПредставленияПоказыватьВсе.Пометка = Форма.ОтображатьВсеПредставления;

	Если Форма.ОтображатьВсеПредставления Тогда
		УдалитьОтборСтрок(Форма.Элементы.Представления, "Основное");
	Иначе
		УстановитьОтборСтрок(Форма.Элементы.Представления, "Основное", Истина);
	КонецЕсли;

КонецПроцедуры

// Устанавливает отбор строк таблицы формы по полю.
//
// Параметры:
//  ЭлементФормыТаблица - ТаблицаФормы - Таблица формы.
//  ИмяПоля - Строка - Имя поля отбора.
//  Значение - Произвольный - Значение отбора.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСтрок(ЭлементФормыТаблица, ИмяПоля, Значение)

	Если ТипЗнч(ЭлементФормыТаблица.ОтборСтрок) = Тип("ФиксированнаяСтруктура") Тогда
		ОтборСтрок = Новый Структура(ЭлементФормыТаблица.ОтборСтрок);
	Иначе
		ОтборСтрок = Новый Структура;
	КонецЕсли;

	ОтборСтрок.Вставить(ИмяПоля, Значение);

	ЭлементФормыТаблица.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок); // Вызов сервера

КонецПроцедуры

// Удаляет отбор строк таблицы формы по полю.
//
// Параметры:
//  ЭлементФормыТаблица - ТаблицаФормы - Таблица формы.
//  ИмяПоля - Строка - Имя поля отбора.
&НаКлиентеНаСервереБезКонтекста
Процедура УдалитьОтборСтрок(ЭлементФормыТаблица, ИмяПоля)

	Если ЭлементФормыТаблица.ОтборСтрок = Неопределено Или Не ЭлементФормыТаблица.ОтборСтрок.Свойство(ИмяПоля) Тогда

		Возврат;
	КонецЕсли;

	ОтборСтрок = Новый Структура(ЭлементФормыТаблица.ОтборСтрок);
	ОтборСтрок.Удалить(ИмяПоля);
	ЭлементФормыТаблица.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);

КонецПроцедуры

// Устанавливает или снимает признак использования у всех строк таблицы.
//
// Параметры:
//  Таблица - ТаблицаФормы - Таблица.
//  Установить - Булево - Признак использования.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСнятьФлажки(Таблица, Установить)

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.Используется = Установить;
	КонецЦикла;

КонецПроцедуры

// Выполняет сброс кэша описаний представлений на сервере.
&НаСервере
Процедура СброситьКэшОписанийПредставленийНаСервере()
	ИнициализироватьОписанияПредставлений(Ложь);
КонецПроцедуры

// Производит заполнение всех доступных представлений с предварительной очисткой текущего состояния.
// Помещает описания представлений в кэш, в качестве которого использует хранилище настроек, с целью
// уменьшения времени повторного открытия формы.
// Текущая строка списка представлений после заполнения восстанавливается по имени представления.
//
// Параметры:
//   ЗаполнитьИзКэша - Булево - Истина - описания берутся из кэша; если кэш отсутствует или устарел,
//                              описания формируются по конфигурации и помещаются в кэш.
//                              Ложь - описания всегда формируются по конфигурации, кэш перезаписывается.
&НаСервере
Процедура ИнициализироватьОписанияПредставлений(Знач ЗаполнитьИзКэша = Истина)
	
	ИмяТекущегоПредставления = Неопределено;
	ТекущаяСтрока = Элементы.Представления.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ИмяТекущегоПредставления = Представления.НайтиПоИдентификатору(ТекущаяСтрока).Имя;
	КонецЕсли;
	
	Представления.Очистить();
	ПоляПредставлений.Очистить();
	ПараметрыПредставлений.Очистить();

	ОписанияПредставлений = Неопределено;
	Если ЗаполнитьИзКэша Тогда
		ОписанияПредставлений = ОписанияПредставленийИзХранилища();
	КонецЕсли;
	
	Обработка = ОбработкаОбъект();

	// Кэш не используется, отсутствует или устарел - формируем описания по конфигурации и кэшируем.
	Если ОписанияПредставлений = Неопределено Тогда
		ОписанияПредставлений = Обработка.ОписанияПредставленийПоКонфигурации();
		СохранитьОписанияПредставленийВХранилище(ОписанияПредставлений);
	КонецЕсли;
	
	Для Каждого КлючИзначение Из ОписанияПредставлений Цикл
		Описание = КлючИзначение.Значение;

		ИдентификаторПредставления = Новый УникальныйИдентификатор;

		Представление = Представления.Добавить();
		ЗаполнитьЗначенияСвойств(Представление, Описание);
		Представление.ИдентификаторПредставления = ИдентификаторПредставления;
		
		Описание.ДоступныеПараметры.Сортировать("Обязательный УБЫВ, Имя");

		Для Каждого ДоступныйПараметр Из Описание.ДоступныеПараметры Цикл
			Параметр = ПараметрыПредставлений.Добавить();
			ЗаполнитьЗначенияСвойств(Параметр, ДоступныйПараметр);
			Параметр.ИдентификаторПредставления = ИдентификаторПредставления;
			Параметр.Используется = ДоступныйПараметр.Обязательный;
			Параметр.СписокВыбора = ДоступныйПараметр.ДоступныеЗначения;
			Параметр.ДоступныеТипы = ДоступныйПараметр.Тип;
		КонецЦикла;

		Для Каждого ДоступноеПоле Из Описание.ДоступныеПоля Цикл
			Поле = ПоляПредставлений.Добавить();
			ЗаполнитьЗначенияСвойств(Поле, ДоступноеПоле);
			Поле.ИдентификаторПредставления = ИдентификаторПредставления;
		КонецЦикла;
		
		Представление.ШаблонПрограммногоИнтерфейса = Описание.ПрограммныйИнтерфейс.Шаблон;

		Для Каждого ПараметрПрограммногоИнтерфейса Из Описание.ПрограммныйИнтерфейс.Параметры Цикл
			Параметр = Представление.ПараметрыПрограммногоИнтерфейса.Добавить();
			ЗаполнитьЗначенияСвойств(Параметр, ПараметрПрограммногоИнтерфейса);
		КонецЦикла;
		
	КонецЦикла;

	Представления.Сортировать("Имя");
	
	НайденныеСтроки = Представления.НайтиСтроки(Новый Структура("Имя", ИмяТекущегоПредставления));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Элементы.Представления.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

// Заполняет список выбора источника данных периодическими регистрами.
// Регистры с префиксом "Удалить" игнорируются.
//
&НаСервере
Процедура ЗаполнитьСписокВыбораИсточникаДанных()

	СписокВыбора = Элементы.ПредставленияИсточникДанных.СписокВыбора;
	СписокВыбора.Очистить();
	КартинкаРегистрСведений = БиблиотекаКартинок.РегистрСведений;

	Для Каждого РегистрСведений Из Метаданные.РегистрыСведений Цикл
		Если РегистрСведений.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический
			 Или СтрНачинаетсяС(РегистрСведений.Имя, "Удалить") Тогда

			Продолжить;
		КонецЕсли;

		ЭлементСписка = СписокВыбора.Добавить();
		ЭлементСписка.Значение = РегистрСведений.Имя;
		ЭлементСписка.Представление = СтрШаблон("%1 (%2)", РегистрСведений.Представление(), РегистрСведений.Имя);
		ЭлементСписка.Картинка = КартинкаРегистрСведений;
	КонецЦикла;

	СписокВыбора.СортироватьПоПредставлению();

КонецПроцедуры

// Обрабатывает изменение источника данных представления на сервере.
// Заполняет доступные поля представления для текущего представления и источника данных.
//
&НаСервере
Процедура ПредставленияИсточникДанныхПриИзмененииНаСервере()

	Представление = Представления.НайтиПоИдентификатору(Элементы.Представления.ТекущаяСтрока);

	ПоляПредставления = ПоляПредставлений.НайтиСтроки(Новый Структура("ИдентификаторПредставления",
																	  Представление.ИдентификаторПредставления));

	Для Каждого Поле Из ПоляПредставления Цикл
		ПоляПредставлений.Удалить(Поле);
	КонецЦикла;

	ОбработкаОбъект = ОбработкаОбъект();

	Если ВРег(Представление.Имя) = ВРег("ТаблицаРегистра")
		 Или ВРег(Представление.Имя) = ВРег("СрезПоследних")
		 Или ВРег(Представление.Имя) = ВРег("СрезПервых") Тогда

		МодульОбщегоНазначения = ОбработкаОбъект.МодульОбщегоНазначения();
		//@skip-check bsl-legacy-check-static-feature-access-for-unknown-left-part
		МодульЗарплатаКадрыОбщиеНаборыДанных = МодульОбщегоНазначения.ОбщийМодуль("ЗарплатаКадрыОбщиеНаборыДанных");

		ИмяВТФильтра = "ВТФильтр";
		ОписаниеФильтра = МодульЗарплатаКадрыОбщиеНаборыДанных.ОписаниеФильтраДляСоздатьВТИмяРегистра(ИмяВТФильтра,
																									  "Период");

		Если ВРег(Представление.Имя) = ВРег("ТаблицаРегистра") Тогда
			Запрос = МодульЗарплатаКадрыОбщиеНаборыДанных.ЗапросВТИмяРегистра(Представление.ИсточникДанных,
																			  Истина,
																			  ОписаниеФильтра);
		ИначеЕсли ВРег(Представление.Имя) = ВРег("СрезПоследних") Тогда
			Запрос = МодульЗарплатаКадрыОбщиеНаборыДанных.ЗапросВТИмяРегистраСрез(Представление.ИсточникДанных,
																				  Истина,
																				  ОписаниеФильтра,
																				  ,
																				  Истина);
		Иначе
			Запрос = МодульЗарплатаКадрыОбщиеНаборыДанных.ЗапросВТИмяРегистраСрез(Представление.ИсточникДанных,
																				  Истина,
																				  ОписаниеФильтра,
																				  ,
																				  Ложь);
		КонецЕсли;

		ОписаниеПредставления = ОбработкаОбъект.НовоеОписаниеПредставления();
		ОбработкаОбъект.ПоляЗапросаВДоступныеПоляПредставления(Запрос.Текст, ОписаниеПредставления);

		Для Каждого ДоступноеПоле Из ОписаниеПредставления.ДоступныеПоля Цикл
			Поле = ПоляПредставлений.Добавить();
			ЗаполнитьЗначенияСвойств(Поле, ДоступноеПоле);
			Поле.ИдентификаторПредставления = Представление.ИдентификаторПредставления;
		КонецЦикла;
	КонецЕсли;

	ДоступныеЛевыеЗначенияОтбора.ЗагрузитьЗначения(ДоступныеЛевыеЗначенияОтбораПредставления(Представление.ИдентификаторПредставления));

КонецПроцедуры

// Подготавливает параметры открытия формы текста запроса для текущего представления.
//
// Возвращаемое значение:
//   Структура:
//     * ТекстЗапросаПредставления - Строка - текст запроса выбранного представления
//     * КодПрограммногоИнтерфейса - Строка - сформированный код программного интерфейса представления
&НаСервере
Функция ПодготовитьПараметрыОткрытияТекстаЗапроса()
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ТекстЗапросаПредставления", "");
	ПараметрыОткрытия.Вставить("КодПрограммногоИнтерфейса", "");
	
	ТекущаяСтрокаПредставления = Элементы.Представления.ТекущаяСтрока;
	Если ТекущаяСтрокаПредставления = Неопределено Тогда
		Возврат ПараметрыОткрытия;
	КонецЕсли;
	
	Представление = Представления.НайтиПоИдентификатору(ТекущаяСтрокаПредставления);
	ПараметрыОтбора = Новый Структура("Используется,ИдентификаторПредставления",
									  Истина,
									  Представление.ИдентификаторПредставления);
	ВыбранныеПоля = ПоляПредставлений.НайтиСтроки(ПараметрыОтбора);
	ВыбранныеПараметры = ПараметрыПредставлений.НайтиСтроки(ПараметрыОтбора);
	
	ПараметрыОткрытия.ТекстЗапросаПредставления = ОбработкаОбъект().СформироватьТекстЗапросаПредставления(Представление, ВыбранныеПоля, ВыбранныеПараметры);
	ПараметрыОткрытия.КодПрограммногоИнтерфейса = КодПрограммногоИнтерфейсаПредставления(Представление, ВыбранныеПоля, ВыбранныеПараметры);
	
	Возврат ПараметрыОткрытия;
		
КонецФункции

// Формирует код программного интерфейса представления: заполняет значения параметров
// программного интерфейса по данным формы и подставляет их в шаблон.
//
// Параметры:
//  Представление - ДанныеФормыЭлементКоллекции - Строка таблицы формы Представления
//  ВыбранныеПоля - Массив Из ДанныеФормыЭлементКоллекции - Используемые строки таблицы формы ПоляПредставлений
//  ВыбранныеПараметры - Массив Из ДанныеФормыЭлементКоллекции - Используемые строки таблицы формы ПараметрыПредставлений
//
// Возвращаемое значение:
//  Строка - Код программного интерфейса представления. Пустая строка, если у представления нет программного интерфейса
&НаСервере
Функция КодПрограммногоИнтерфейсаПредставления(Представление, ВыбранныеПоля, ВыбранныеПараметры)

	Если Не Представление.ЕстьПрограммныйИнтерфейс Тогда
		Возврат "";
	КонецЕсли;

	Обработка = ОбработкаОбъект();
	МодульОбщегоНазначения = Обработка.МодульОбщегоНазначения();
	МодульЗарплатаКадрыОбщиеНаборыДанных = МодульОбщегоНазначения.ОбщийМодуль("ЗарплатаКадрыОбщиеНаборыДанных");
	
	ВыбранныеПоляМассив = МодульОбщегоНазначения.ВыгрузитьКолонку(ВыбранныеПоля, "Имя");

	ВидыПараметровПрограммногоИнтерфейса = Обработка.ВидыПараметровПрограммногоИнтерфейса();

	// Значения параметров не хранятся в данных формы, они вычисляются по данным формы при каждом формировании кода.
	ПараметрыПрограммногоИнтерфейса = Представление.ПараметрыПрограммногоИнтерфейса.Выгрузить();
	ПараметрыПрограммногоИнтерфейса.Колонки.Добавить("Значение");

	Для Каждого ПараметрПрограммногоИнтерфейса Из ПараметрыПрограммногоИнтерфейса Цикл

		Если ПараметрПрограммногоИнтерфейса.Вид = ВидыПараметровПрограммногоИнтерфейса.ИменаПолей Тогда

			ПараметрПрограммногоИнтерфейса.Значение = ВыбранныеПоляМассив;

		ИначеЕсли ПараметрПрограммногоИнтерфейса.Вид = ВидыПараметровПрограммногоИнтерфейса.Фильтр Тогда

			// Пустая строка - значение не задано: для обязательного параметра в коде останется плейсхолдер.
			ПараметрПрограммногоИнтерфейса.Значение = ?(ПустаяСтрока(Представление.Фильтр),
														Неопределено,
														Представление.Фильтр);

		ИначеЕсли ПараметрПрограммногоИнтерфейса.Вид = ВидыПараметровПрограммногоИнтерфейса.ИсточникДанных Тогда

			ПараметрПрограммногоИнтерфейса.Значение = ?(ПустаяСтрока(Представление.ИсточникДанных),
														Неопределено,
														Представление.ИсточникДанных);

		ИначеЕсли ПараметрПрограммногоИнтерфейса.Вид = ВидыПараметровПрограммногоИнтерфейса.Отборы Тогда

			Отборы = Новый Массив;

			Для Каждого ВыбранныйПараметр Из ВыбранныеПараметры Цикл

				Если ВыбранныйПараметр.Отбор Тогда
					ВидСравненияСтрока = Обработка.ЗначениеПараметраВВыражениеЯзыкаЗапроса(ВыбранныйПараметр.ВидСравнения);
					Значение = ?(ВыбранныйПараметр.ЗначениеЭтоВыражение,
								 ВыбранныйПараметр.Значение,
								 Обработка.ЗначениеВЛитералВстроенногоЯзыка(ВыбранныйПараметр.Значение));
					
					МодульЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(Отборы,
																				 ВыбранныйПараметр.Имя,
																				 ВидСравненияСтрока,
																				 Значение);
				КонецЕсли;

			КонецЦикла;

			ПараметрПрограммногоИнтерфейса.Значение = Отборы;

		ИначеЕсли ПараметрПрограммногоИнтерфейса.Вид = ВидыПараметровПрограммногоИнтерфейса.ПсевдонимыПолейСКД Тогда

			ПсевдонимыПолейСКД = Новый Соответствие;

			ВыбранныйДоступныйПараметр = НайтиПоИмени(ВыбранныеПараметры,
													  ПараметрПрограммногоИнтерфейса.ДоступныйПараметр);
			Если ВыбранныйДоступныйПараметр <> Неопределено Тогда

				// Ожидаемый формат значения параметра: "Поле1 КАК Псевдоним1, Поле2 КАК Псевдоним2".
				МассивОпределений = СтрРазделить(ВыбранныйДоступныйПараметр.Значение, ",");

				Для Каждого СтрокаОпределения Из МассивОпределений Цикл
					Позиция = СтрНайти(СтрокаОпределения, " КАК ");
					Если Позиция > 0 Тогда
						ПсевдонимыПолейСКД.Вставить(СокрЛП(Лев(СтрокаОпределения, Позиция - 1)),
													СокрЛП(Сред(СтрокаОпределения, Позиция + 5)));
					КонецЕсли;
				КонецЦикла;

			КонецЕсли;

			ПараметрПрограммногоИнтерфейса.Значение = ПсевдонимыПолейСКД;

		ИначеЕсли ЗначениеЗаполнено(ПараметрПрограммногоИнтерфейса.ДоступныйПараметр) Тогда

			// Прочие параметры: значение берется из связанного доступного параметра представления.
			// Неиспользуемый параметр считается незаданным (Неопределено).
			ВыбранныйДоступныйПараметр = НайтиПоИмени(ВыбранныеПараметры,
													  ПараметрПрограммногоИнтерфейса.ДоступныйПараметр);

			Если ВыбранныйДоступныйПараметр <> Неопределено Тогда
				ПараметрПрограммногоИнтерфейса.Значение = ВыбранныйДоступныйПараметр.Значение;
			Иначе
				ПараметрПрограммногоИнтерфейса.Значение = Неопределено;
			КонецЕсли;

		Иначе
			// Обработка не требуется
		КонецЕсли;

	КонецЦикла;

	Возврат Обработка.КодПрограммногоИнтерфейса(Представление.ШаблонПрограммногоИнтерфейса,
												ПараметрыПрограммногоИнтерфейса);

КонецФункции

// Возвращает доступные левые значения отбора для указанного представления.
//
// Параметры:
//   ИдентификаторПредставления - УникальныйИдентификатор - Идентификатор представления, для которого необходимо
//   									  получить доступные левые значения отбора
//
// Возвращаемое значение:
//   Массив Из Строка - Массив доступных левых значений отбора для указанного представления
&НаСервере
Функция ДоступныеЛевыеЗначенияОтбораПредставления(Знач ИдентификаторПредставления)

	ПараметрыОтбора = Новый Структура("ИдентификаторПредставления", ИдентификаторПредставления);

	Возврат ПоляПредставлений.Выгрузить(ПараметрыОтбора).ВыгрузитьКолонку("Имя");

КонецФункции

// Разбирает текст запроса представления и помещает в данные формы.
// Если представление с таким именем уже существует, то дополняет его.
// Иначе добавляет новое.
// 
// Параметры:
//  ТекстЗапроса - Строка - Текст запроса
// 
// Возвращаемое значение:
//  Структура - Текст запроса представления в данные формы:
// * Успех - Булево - Признак успешного разбора представления и помещения в данные формы
// * ТекстОшибки - Строка - Если Успех = Ложь, то содержит текст ошибки
// * ИдентификаторСтрокиПредставления - Неопределено, Число - Если Успех = Истина, то содержит идентификатор
//															  строки таблицы формы Представления, в которору было
//															  помещено представление.
// * ИдентификаторПредставления - Неопределено, УникальныйИдентификатор - Если Успех = Истина, то содержит идентификатор
//															  			  представления.
&НаСервере
Функция ТекстЗапросаПредставленияВДанныеФормы(Знач ТекстЗапроса)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ИдентификаторСтрокиПредставления", Неопределено);
	Результат.Вставить("ИдентификаторПредставления", Неопределено);
	
	РезультатРазбора = ОбработкаОбъект().РазобратьТекстЗапросаПредставления(ТекстЗапроса);
	
	Если Не РезультатРазбора.Успех Тогда
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = РезультатРазбора.ТекстОшибки;
		Возврат Результат;	
	КонецЕсли;
	
	Представление = НайтиПоИмени(Представления, РезультатРазбора.Имя);
	Если Представление = Неопределено Тогда
		Представление = Представления.Добавить();
		Представление.ИдентификаторПредставления = Новый УникальныйИдентификатор;
		Представление.Имя = РезультатРазбора.Имя;
	КонецЕсли;
	
	Представление.ИсточникДанных = РезультатРазбора.ИсточникДанных;
	Представление.Уточнение = РезультатРазбора.Уточнение;
	Представление.Фильтр = РезультатРазбора.Фильтр;
	Представление.ЕстьИсточникДанных = Не ПустаяСтрока(Представление.ИсточникДанных);
	Представление.ЕстьФильтр = Не ПустаяСтрока(Представление.Фильтр);
	
	Результат.ИдентификаторСтрокиПредставления = Представление.ПолучитьИдентификатор();
	Результат.ИдентификаторПредставления = Представление.ИдентификаторПредставления;
	
	ПараметрыОтбора = Новый Структура("ИдентификаторПредставления", Представление.ИдентификаторПредставления);
	ПоляТекущегоПредставления = ПоляПредставлений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого ПолеПредставления Из ПоляТекущегоПредставления Цикл
		ПолеПредставления.Используется = Ложь;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из РезультатРазбора.Поля Цикл
		ИмяПоля = КлючИЗначение.Ключ;
		ВыражениеПоля = КлючИЗначение.Значение;

		ПолеПредставления = НайтиПоИмени(ПоляТекущегоПредставления, ИмяПоля);
		Если ПолеПредставления = Неопределено Тогда
			ПолеПредставления = ПоляПредставлений.Добавить();
			ПолеПредставления.ИдентификаторПредставления = Представление.ИдентификаторПредставления;
			ПолеПредставления.Имя = ИмяПоля;
		КонецЕсли;

		ПолеПредставления.Используется = Истина;
		ПолеПредставления.Выражение = ВыражениеПоля;
	КонецЦикла;
	
	ПараметрыТекущегоПредставления = ПараметрыПредставлений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого ПараметрПредставления Из ПараметрыТекущегоПредставления Цикл
		ПараметрПредставления.Используется = Ложь;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из РезультатРазбора.Параметры Цикл
		ИмяПараметра = КлючИЗначение.Ключ;
		ЗначениеПараметра = КлючИЗначение.Значение;

		ПараметрПредставления = НайтиПоИмени(ПараметрыТекущегоПредставления, ИмяПараметра);
		Если ПараметрПредставления = Неопределено Тогда
			ПараметрПредставления = ПараметрыПредставлений.Добавить();
			ПараметрПредставления.ИдентификаторПредставления = Представление.ИдентификаторПредставления;
			ПараметрПредставления.Имя = ИмяПараметра;
		КонецЕсли;

		ПараметрПредставления.Используется = Истина;
		ПараметрПредставления.Значение = ЗначениеПараметра;
		// Базовая проверка. Функция ПараметрыЗапроса удаляет кавычки. При необходимости разработать
		// аналогичную функцию.
		ПараметрПредставления.ЗначениеЭтоВыражение = СтрНайти(ЗначениеПараметра, "&") > 0;
	КонецЦикла;

	ДоступныеВидыСравненияОтбора = ОбработкаОбъект().ДоступныеВидыСравненияОтбора();
	СоответствиеВидовСравнения = Новый Соответствие;
	Для Каждого КлючИЗначение Из ДоступныеВидыСравненияОтбора Цикл
		СоответствиеВидовСравнения.Вставить(КлючИЗначение.Значение, КлючИЗначение.Ключ);
	КонецЦикла;

	Для Каждого ОписаниеОтбора Из РезультатРазбора.Отборы Цикл
		ПараметрПредставления = НайтиПоИмени(ПараметрыТекущегоПредставления, ОписаниеОтбора.ЛевоеЗначение);
		Если ПараметрПредставления = Неопределено Тогда
			ПараметрПредставления = ПараметрыПредставлений.Добавить();
			ПараметрПредставления.ИдентификаторПредставления = Представление.ИдентификаторПредставления;
			ПараметрПредставления.Имя = ОписаниеОтбора.ЛевоеЗначение;	
		КонецЕсли;
		
		ПараметрПредставления.Используется = Истина;
		ПараметрПредставления.Отбор = Истина;
		ПараметрПредставления.ВидСравнения = СоответствиеВидовСравнения[ОписаниеОтбора.ВидСравнения];
		ПараметрПредставления.Значение = ОписаниеОтбора.ПравоеЗначение;
		// Базовая проверка. Функция КоллекцияОтборПоПараметрам удаляет кавычки. При необходимости разработать
		// аналогичную функцию.
		ПараметрПредставления.ЗначениеЭтоВыражение = СтрНайти(ОписаниеОтбора.ПравоеЗначение, "&") > 0;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выполняет регистронезависимый поиск по полю Имя в коллекции.
// Добавление отдельного поля для поиска не имеет смысла т.к. коллекции очень маленькие.
// 
// Параметры:
//  Коллекция - ДанныеФормыКоллекция, Массив из ДанныеФормыЭлементКоллекции - Коллекция
//  Значение - Строка - Значение
// 
// Возвращаемое значение:
//  Неопределено, ДанныеФормыЭлементКоллекции - Найти по имени
&НаСервереБезКонтекста
Функция НайтиПоИмени(Коллекция, Значение)

	ЗначениеВРег = ВРег(Значение);

	НайденнаяСтрока = Неопределено;

	Для Каждого СтрокаКоллекции Из Коллекция Цикл
		Если ВРег(СтрокаКоллекции.Имя) = ЗначениеВРег Тогда
			НайденнаяСтрока = СтрокаКоллекции;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат НайденнаяСтрока;

КонецФункции

#КонецОбласти

#Область ВыгрузкаОписанийВJSONНаКлиент

// Выгружает описания представлений в JSON-файлы каталога на компьютере пользователя.
// Файлы формируются на сервере по конфигурации (кэш не используется) и сохраняются через
// ФайловаяСистемаКлиент.СохранитьФайлы в раскладке <Подсистема>/<Имя>.json, как в пакетном режиме.
//
// Параметры:
//  КаталогВыгрузки - Строка - Каталог выгрузки; если не указан, запрашивается у пользователя диалогом (команда формы).
//  ЗавершитьРаботу - Булево - Истина - по окончании выгрузки (или отказе от нее) завершить работу системы.
//
&НаКлиенте
Процедура ВыгрузитьОписанияПредставленийВКаталог(КаталогВыгрузки, ЗавершитьРаботу)
	
	Контекст = Новый Структура;
	Контекст.Вставить("КаталогВыгрузки", КаталогВыгрузки);
	Контекст.Вставить("ЗавершитьРаботу", ЗавершитьРаботу);
	Контекст.Вставить("Файлы", Неопределено);
	Контекст.Вставить("Подкаталоги", Неопределено);
	Контекст.Вставить("ИндексПодкаталога", 0);
	
	// Асинх не используется для совместимости с УИ
	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ВыбранныеКаталоги = Новый Массив;
		ВыбранныеКаталоги.Добавить(КаталогВыгрузки);
		ВыборКаталогаВыгрузкиЗавершение(ВыбранныеКаталоги, Контекст);
	Иначе
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		Диалог.Заголовок = "Каталог выгрузки описаний представлений";
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыборКаталогаВыгрузкиЗавершение", ЭтотОбъект, Контекст);
		ФайловаяСистемаКлиент.ПоказатьДиалогВыбора(ОписаниеОповещения, Диалог);
	КонецЕсли;
	
КонецПроцедуры

// Обрабатывает выбор каталога выгрузки: получает файлы с сервера и начинает создание подкаталогов подсистем.
//
// Параметры:
//  Результат - Массив Из Строка - Выбранный каталог.
//            - Строка - пустая строка, если пользователь отказался от установки расширения.
//            - Неопределено - пользователь отказался от выбора.
//  Контекст - Структура - См. ВыгрузитьОписанияПредставленийВКаталог
//
&НаКлиенте
Процедура ВыборКаталогаВыгрузкиЗавершение(Результат, Контекст) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		ЗавершитьВыгрузку(Контекст);
		Возврат;
	КонецЕсли;
	
	РазделительПути = ПолучитьРазделительПути();
	КаталогВыгрузки = Результат[0];
	Если Прав(КаталогВыгрузки, 1) <> "\"
		И Прав(КаталогВыгрузки, 1) <> "/" Тогда
		
		КаталогВыгрузки = КаталогВыгрузки + РазделительПути;
	КонецЕсли;
	
	Контекст.КаталогВыгрузки = КаталогВыгрузки;
	Контекст.Файлы = ФайлыВыгрузкиJSON();
	
	Контекст.Подкаталоги = Новый Массив;
	Для Каждого ФайлВыгрузки Из Контекст.Файлы Цикл
		Если Контекст.Подкаталоги.Найти(ФайлВыгрузки.Подкаталог) = Неопределено Тогда
			Контекст.Подкаталоги.Добавить(ФайлВыгрузки.Подкаталог);
		КонецЕсли;
	КонецЦикла;
	
	СоздатьОчереднойПодкаталогВыгрузки(Контекст);
	
КонецПроцедуры

// Создает очередной подкаталог подсистемы; когда все созданы - сохраняет файлы.
//
// Параметры:
//  Контекст - Структура - См. ВыгрузитьОписанияПредставленийВКаталог
//
&НаКлиенте
Процедура СоздатьОчереднойПодкаталогВыгрузки(Контекст)
	
	Если Контекст.ИндексПодкаталога >= Контекст.Подкаталоги.Количество() Тогда
		СохранитьФайлыВыгрузки(Контекст);
		Возврат;
	КонецЕсли;
	
	Подкаталог = Контекст.КаталогВыгрузки + Контекст.Подкаталоги[Контекст.ИндексПодкаталога];
	Контекст.ИндексПодкаталога = Контекст.ИндексПодкаталога + 1;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СозданиеПодкаталогаВыгрузкиЗавершение", ЭтотОбъект, Контекст);
	НачатьСозданиеКаталога(ОписаниеОповещения, Подкаталог);
	
КонецПроцедуры

// Продолжает создание подкаталогов после создания очередного.
//
// Параметры:
//  ИмяКаталога - Строка - Имя созданного каталога.
//  Контекст - Структура - См. ВыгрузитьОписанияПредставленийВКаталог
//
&НаКлиенте
Процедура СозданиеПодкаталогаВыгрузкиЗавершение(ИмяКаталога, Контекст) Экспорт
	СоздатьОчереднойПодкаталогВыгрузки(Контекст);
КонецПроцедуры

// Сохраняет подготовленные файлы в каталог выгрузки без диалога.
//
// Параметры:
//  Контекст - Структура - См. ВыгрузитьОписанияПредставленийВКаталог
//
&НаКлиенте
Процедура СохранитьФайлыВыгрузки(Контекст)
	
	РазделительПути = ПолучитьРазделительПути();
	
	ФайлыДляСохранения = Новый Массив;
	Для Каждого ФайлВыгрузки Из Контекст.Файлы Цикл
		ОтносительноеИмя = ФайлВыгрузки.Подкаталог + РазделительПути + ФайлВыгрузки.ИмяФайла;
		ФайлыДляСохранения.Добавить(Новый ОписаниеПередаваемогоФайла(ОтносительноеИмя, ФайлВыгрузки.Хранение));
	КонецЦикла;
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайлов();
	ПараметрыСохранения.Интерактивно = Ложь;
	ПараметрыСохранения.Диалог.Каталог = Контекст.КаталогВыгрузки;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СохранениеФайловВыгрузкиЗавершение", ЭтотОбъект, Контекст);
	ФайловаяСистемаКлиент.СохранитьФайлы(ОписаниеОповещения, ФайлыДляСохранения, ПараметрыСохранения);
	
КонецПроцедуры

// Показывает результат выгрузки и при необходимости завершает работу системы.
//
// Параметры:
//  ПолученныеФайлы - Массив Из ОписаниеПереданногоФайла, Неопределено - Сохраненные файлы; Неопределено - отказ.
//  Контекст - Структура - См. ВыгрузитьОписанияПредставленийВКаталог
//
&НаКлиенте
Процедура СохранениеФайловВыгрузкиЗавершение(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы <> Неопределено И Не Контекст.ЗавершитьРаботу Тогда
		ТекстОповещения = СтрШаблон("Выгружено файлов: %1", ПолученныеФайлы.Количество());
		ПоказатьОповещениеПользователя("Описания представлений выгружены", , ТекстОповещения);
	КонецЕсли;
	
	ЗавершитьВыгрузку(Контекст);
	
КонецПроцедуры

// Завершает работу системы, если выгрузка запущена в пакетном режиме.
//
// Параметры:
//  Контекст - Структура - См. ВыгрузитьОписанияПредставленийВКаталог
//
&НаКлиенте
Процедура ЗавершитьВыгрузку(Контекст)
	
	Если Контекст.ЗавершитьРаботу Тогда
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Завершает работу системы после закрытия предупреждения об ошибке пакетного режима.
//
// Параметры:
//  ДополнительныеПараметры - Неопределено - Не используется.
//
&НаКлиенте
Процедура ЗавершитьРаботуПослеПредупреждения(ДополнительныеПараметры) Экспорт
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

// Формирует описания представлений по конфигурации и помещает JSON-файлы во временное хранилище формы.
//
// Возвращаемое значение:
//  Массив Из Структура:
//   * Подкаталог - Строка - подкаталог подсистемы относительно каталога выгрузки.
//   * ИмяФайла - Строка - имя файла с расширением.
//   * Хранение - Строка - адрес содержимого файла во временном хранилище.
//
&НаСервере
Функция ФайлыВыгрузкиJSON()
	
	Обработка = ОбработкаОбъект();
	ОписанияПредставлений = Обработка.ОписанияПредставленийПоКонфигурации();
	
	Файлы = Новый Массив;
	Для Каждого ФайлВыгрузки Из Обработка.ФайлыJSONПредставлений(ОписанияПредставлений) Цикл
		
		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ФайлВыгрузки.Текст, "UTF-8", Ложь);
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("Подкаталог", ФайлВыгрузки.Подкаталог);
		ОписаниеФайла.Вставить("ИмяФайла", ФайлВыгрузки.ИмяФайла);
		ОписаниеФайла.Вставить("Хранение", ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор));
		
		Файлы.Добавить(ОписаниеФайла);
		
	КонецЦикла;
	
	Возврат Файлы;
	
КонецФункции

#КонецОбласти

#Область ПакетныйРежим

// Параметры запуска.
// 
// Возвращаемое значение:
//  См. РазобратьПараметрыЗапуска
//
&НаСервереБезКонтекста
Функция ПараметрыЗапуска()
		
	ПараметрЗапуска = СтандартныеПодсистемыСервер.ПараметрыКлиентаНаСервере(Ложь).Получить("ПараметрЗапуска");
	
	Возврат РазобратьПараметрыЗапуска(ПараметрЗапуска);
		
КонецФункции

// Разобрать параметры запуска.
// 
// Параметры:
//  СтрокаЗапуска - Строка - Строка запуска
// 
// Возвращаемое значение:
//  Структура:
//   * ПакетныйРежим - Булево - Пакетный режим: выгрузка на сервере без открытия формы
//   * ПакетныйРежимКлиент - Булево - Пакетный режим с выгрузкой на компьютер пользователя
//   * КаталогВыгрузки - Строка - Каталог выгрузки
//  
&НаКлиентеНаСервереБезКонтекста
Функция РазобратьПараметрыЗапуска(Знач СтрокаЗапуска)
	
	// Ожидаемый формат (mode - batch: выгрузка на сервере, batch_client: на клиенте;
	// out - каталог выгрузки JSON-файлов):
	// mode=batch;out=C:\temp\Представления
	
	Результат = Новый Структура;
	Результат.Вставить("ПакетныйРежим", Ложь);
	Результат.Вставить("ПакетныйРежимКлиент", Ложь);
	Результат.Вставить("КаталогВыгрузки", "");
	
	Если СтрНайти(СтрокаЗапуска, "=") = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Строка формата "ключ=значение;ключ=значение" разбирается функцией НСтр,
	// которая извлекает значение по ключу так же, как код языка из строки локализации.
	//@skip-check empty-except-statement
	Попытка
		//@skip-check bsl-nstr-string-literal-format
		Режим = НСтр(СтрокаЗапуска, "mode");
		Результат.ПакетныйРежим = Режим = "batch";
		Результат.ПакетныйРежимКлиент = Режим = "batch_client";
		//@skip-check bsl-nstr-string-literal-format
		Результат.КаталогВыгрузки = НСтр(СтрокаЗапуска, "out");
	Исключение
		// Обработка не требуется
	КонецПопытки;
		
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти
