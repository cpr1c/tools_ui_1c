// Добавляет параметр программного интерфейса в описание представления.
//
// Параметры:
//  ОписаниеПредставления - См. НовоеОписаниеПредставления
//  Имя - Строка - Имя параметра программного интерфейса.
//  ДоступныйПараметр - Строка - Имя доступного параметра представления, с которым связан данный параметр.
//                              Пустая строка - параметр не связан с доступным параметром.
//  Обязательный - Булево - Признак обязательности параметра.
//  Вид - Строка, Неопределено - Вид параметра. См. ВидыПараметровПрограммногоИнтерфейса
//  РазрешитьУдалениеСтрокиСПустымПараметром - Булево - Удалять строку шаблона, если значение параметра не задано.
//
// Возвращаемое значение:
//  Структура - Добавленный параметр. См. НовоеОписаниеПараметраПрограммногоИнтерфейса
//@skip-check method-too-many-params
Функция ДобавитьПараметрПрограммногоИнтерфейса(ОписаниеПредставления,
											   Имя,
											   ДоступныйПараметр = "",
											   Обязательный = Ложь,
											   Вид = Неопределено,
											   РазрешитьУдалениеСтрокиСПустымПараметром = Истина)
	
	ИмяФункции = "ДобавитьПараметрПрограммногоИнтерфейса";
	
	МодульОбщегоНазначенияКлиентСервер = МодульОбщегоНазначенияКлиентСервер();
	МодульОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяФункции,
														 "ОписаниеПредставления",
														 ОписаниеПредставления,
														 Тип("Структура"));
	МодульОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяФункции, "Имя", Имя, Тип("Строка"));
	МодульОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяФункции,
														 "ДоступныйПараметр",
														 ДоступныйПараметр,
														 Тип("Строка"));
	МодульОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяФункции,
														 "Вид",
														 Вид,
														 МодульОбщегоНазначенияКлиентСервер.МассивЗначений(Тип("Строка"),
																										   Тип("Неопределено")));
	МодульОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяФункции, "Обязательный", Обязательный, Тип("Булево"));
	МодульОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяФункции,
														 "РазрешитьУдалениеСтрокиСПустымПараметром",
														 РазрешитьУдалениеСтрокиСПустымПараметром,
														 Тип("Булево"));
	
	Параметр = НовоеОписаниеПараметраПрограммногоИнтерфейса();
	Параметр.Имя = Имя;
	Параметр.Обязательный = Обязательный;
	Параметр.ДоступныйПараметр = ДоступныйПараметр;
	Параметр.УдалятьСтрокуСПустымПараметром = РазрешитьУдалениеСтрокиСПустымПараметром;
	
	Если Вид <> Неопределено Тогда
		Параметр.Вид = Вид;
	КонецЕсли;
	
	ОписаниеПредставления.ПрограммныйИнтерфейс.Параметры.Добавить(Параметр);	
	
	Возврат Параметр;
	
КонецФункции
 
// Создает новое описание параметра программного интерфейса.
//
// Возвращаемое значение:
//   Структура:
//     * Имя - Строка - имя параметра
//     * Вид - Строка, Неопределено - См. ВидыПараметровПрограммногоИнтерфейса
//     * Обязательный - Булево - признак обязательности заполнения параметра
//     * ДоступныйПараметр - Неопределено, Строка - Связь с См. НовоеОписаниеПредставления().ДоступныеПараметры. Имя доступного параметра.
//     * Значение - Произвольный, Неопределено - Значение параметра
//     * УдалятьСтрокуСПустымПараметром - Булево - Удалять строку шаблона, если значение параметра не задано
//
Функция НовоеОписаниеПараметраПрограммногоИнтерфейса()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "");
	Описание.Вставить("Вид", ВидыПараметровПрограммногоИнтерфейса().Прочее);
	Описание.Вставить("Обязательный", Ложь);
	Описание.Вставить("ДоступныйПараметр", Неопределено);
	Описание.Вставить("Значение", Неопределено);
	Описание.Вставить("УдалятьСтрокуСПустымПараметром", Истина);
	
	Возврат Описание;

КонецФункции

// Возвращает соответствие видов параметров программного интерфейса их идентификаторам.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - Виды параметров:
//     * ИменаПолей - Строка - идентификатор вида параметра "Имена полей"
//     * Фильтр - Строка - идентификатор вида параметра "Фильтр"
//     * ИсточникДанных - Строка - идентификатор вида параметра "Источник данных"
//     * ПсевдонимыПолейСКД - Строка - идентификатор вида параметра "Псевдонимы полей СКД"
//     * Отборы - Строка - идентификатор вида параметра "Отборы"
//	   * Прочее - Неопределено - Прочие параметры
//
Функция ВидыПараметровПрограммногоИнтерфейса() Экспорт
	
	Виды = Новый Структура;
	Виды.Вставить("Фильтр", "Фильтр");
	Виды.Вставить("ИменаПолей", "ИменаПолей");
	Виды.Вставить("ИсточникДанных", "ИсточникДанных");
	Виды.Вставить("ПсевдонимыПолейСКД", "ПсевдонимыПолейСКД");
	Виды.Вставить("Отборы", "Отборы");
	Виды.Вставить("Прочее", Неопределено);
	
	Возврат Новый ФиксированнаяСтруктура(Виды);
	
КонецФункции

// Подставляет значение параметра в текстовый шаблон.
// Для КодПрограммногоИнтерфейса
//
//   Контракт:
//   - Неопределено означает, что параметр не задан.
//   - Любое другое значение, включая "", подставляется во все вхождения плейсхолдера.
//   - Если параметр не задан и УдалятьСтрокуСПустымПараметром = Ложь, удаляется только
//     текст плейсхолдера, строки шаблона не меняются.
//   - Если параметр не задан и УдалятьСтрокуСПустымПараметром = Истина, строка шаблона
//     с плейсхолдером обрабатывается по ее окончанию:
//     - ");" - последний аргумент вызова: строка удаляется, а ");" переносится
//       на место запятой предыдущего аргумента;
//     - "," - непоследний аргумент вызова: от строки остается только запятая,
//       чтобы сохранить позицию аргумента;
//     - иначе - самостоятельный оператор: строка удаляется целиком.
//
//   Ограничение: строка, которая заканчивается на ");", считается последним аргументом
//   многострочного вызова, поэтому плейсхолдер необязательного параметра нельзя размещать
//   в однострочном вызове вида "Результат = Метод(<Параметр>);".
//
// Параметры:
//   Шаблон                         - Строка - Текст шаблона.
//   ИмяПараметра                   - Строка - Имя без "<" и ">".
//   ЗначениеПараметра              - Строка, Неопределено - Текст для подстановки.
//   УдалятьСтрокуСПустымПараметром - Булево - Удалять строку, если значение параметра не задано.
//
// Возвращаемое значение:
//   Строка - Обработанный шаблон.
//
Функция ОбработатьПараметрШаблонаПрограммногоИнтерфейса(Шаблон,
														ИмяПараметра,
														ЗначениеПараметра,
														УдалятьСтрокуСПустымПараметром)

	Плейсхолдер = "<" + ИмяПараметра + ">";

	// Заданное значение (в том числе пустая строка) подставляется во все вхождения плейсхолдера.
	Если ЗначениеПараметра <> Неопределено Тогда
		Возврат СтрЗаменить(Шаблон, Плейсхолдер, ЗначениеПараметра);
	КонецЕсли;

	// При выключенном флаге удаляем только текст плейсхолдера, не меняя структуру строк.
	Если Не УдалятьСтрокуСПустымПараметром Тогда
		Возврат СтрЗаменить(Шаблон, Плейсхолдер, "");
	КонецЕсли;

	// Запоминаем исходный вид переводов строк, чтобы восстановить его после обработки.
	ИспользоватьWindowsПереводСтрок = СтрНайти(
		Шаблон,
		Символы.ВК + Символы.ПС) > 0;

	// Внутри функции используем единый разделитель строк.
	Шаблон = СтрЗаменить(
		Шаблон,
		Символы.ВК + Символы.ПС,
		Символы.ПС);

	СтрокиШаблона = СтрРазделить(Шаблон, Символы.ПС, Истина);

	// Обходим строки снизу вверх:
	// это позволяет безопасно удалять строки из массива.
	ИндексСтроки = СтрокиШаблона.ВГраница();

	Пока ИндексСтроки >= 0 Цикл

		СтрокаШаблона = СтрокиШаблона[ИндексСтроки];

		Если СтрНайти(СтрокаШаблона, Плейсхолдер) = 0 Тогда
			ИндексСтроки = ИндексСтроки - 1;
			Продолжить;
		КонецЕсли;

		СокращеннаяСтрока = СокрЛП(СтрокаШаблона);

		// -----------------------------------------------------------------------------
		// Случай 1. Последний аргумент вызова.
		//
		// Было:
		//     "ВТПериоды",
		//     <ИспользоватьКонецПериода>);
		//
		// Должно стать:
		//     "ВТПериоды");
		//
		// Удаляем строку последнего аргумента.
		// Запятую предыдущего аргумента заменяем на ");".
		// -----------------------------------------------------------------------------
		Если Прав(СокращеннаяСтрока, 2) = ");" Тогда

			ИндексПредыдущейСтроки = ИндексСтроки - 1;

			// Пропускаем пустые строки, если они есть между аргументами.
			Пока ИндексПредыдущейСтроки >= 0 И СокрЛП(СтрокиШаблона[ИндексПредыдущейСтроки]) = "" Цикл

				ИндексПредыдущейСтроки = ИндексПредыдущейСтроки - 1;

			КонецЦикла;

			Если ИндексПредыдущейСтроки < 0 Тогда
				ВызватьИсключение СтрШаблон("Не найдена строка предыдущего аргумента для параметра <%1>.", ИмяПараметра);
			КонецЕсли;

			ПредыдущаяСтрока = СтрокиШаблона[ИндексПредыдущейСтроки];

			// Ищем последнюю запятую в строке предыдущего аргумента.
			ПозицияЗапятой = СтрНайти(ПредыдущаяСтрока, ",", НаправлениеПоиска.СКонца);

			Если ПозицияЗапятой = 0 Тогда
				ВызватьИсключение СтрШаблон("Не найдена разделяющая запятая перед последним параметром <%1>.",
											ИмяПараметра);
			КонецЕсли;

			// Отбрасываем запятую и все символы справа от нее.
			// Затем присоединяем закрытие вызова.
			СтрокиШаблона[ИндексПредыдущейСтроки] = Лев(ПредыдущаяСтрока, ПозицияЗапятой - 1) + ");";

			// Удаляем строку вида:
			// <ИспользоватьКонецПериода>);
			СтрокиШаблона.Удалить(ИндексСтроки);
			
			ИндексСтроки = ИндексСтроки - 1;
			
			Продолжить;

		КонецЕсли;

		// ---------------------------------------------------------------------
		// Случай 2. Непоследний аргумент вызова.
		//
		// Было:
		//     <Периодичность>,
		//
		// или:
		//     ИмяПоляПериод = "<Период>",
		//
		// Стало:
		//     ,
		//
		// Позиция параметра сохраняется. Получается BSL-конструкция вида:
		//
		//     Метод(Первый, , Третий);
		// ---------------------------------------------------------------------
		Если Прав(СокращеннаяСтрока, 1) = "," Тогда

			СтрокиШаблона[ИндексСтроки] = ПолучитьОтступСтроки(СтрокаШаблона) + ",";

			ИндексСтроки = ИндексСтроки - 1;

			Продолжить;

		КонецЕсли;

		// ---------------------------------------------------------------------
		// Случай 3. Самостоятельный оператор или иной фрагмент,
		// не являющийся аргументом списка.
		//
		// Например:
		//     ПараметрыПостроения.ВключаяЗакрытые = <ВключаяЗакрытые>;
		//
		// Строка удаляется вместе с переводом строки: физически удаляем
		// ее из массива строк.
		// ---------------------------------------------------------------------
		СтрокиШаблона.Удалить(ИндексСтроки);
		
		ИндексСтроки = ИндексСтроки - 1;
		
	КонецЦикла;

	Шаблон = СтрСоединить(СтрокиШаблона, Символы.ПС);

	Если ИспользоватьWindowsПереводСтрок Тогда
		Шаблон = СтрЗаменить(Шаблон, Символы.ПС, Символы.ВК + Символы.ПС);
	КонецЕсли;

	Возврат Шаблон;

КонецФункции

// Возвращает начальные пробелы и табуляции строки.
// Для ОбработатьПараметрШаблонаПрограммногоИнтерфейса
//
// Параметры:
//   СтрокаШаблона - Строка.
//
// Возвращаемое значение:
//   Строка - Отступ до первого непробельного символа.
Функция ПолучитьОтступСтроки(СтрокаШаблона)

	Позиция = 1;
	ДлинаСтроки = СтрДлина(СтрокаШаблона);

	Пока Позиция <= ДлинаСтроки Цикл

		Символ = Сред(СтрокаШаблона, Позиция, 1);

		Если Символ <> " " И Символ <> Символы.Таб Тогда
			Прервать;
		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Возврат Лев(СтрокаШаблона, Позиция - 1);

КонецФункции

#КонецОбласти

// Возвращает описание типа, включающее булево и строку.
//
// Возвращаемое значение:
//   ОписаниеТипов - описание типа, которое может быть булево или строка
Функция ОписаниеТипаБулево()
