	ДобавитьПараметрПредставления(Описание, "ДатаНачала", ОписаниеТипаДата(), "&ДатаНачала", Обязательный, ЭтоВыражение);
	ДобавитьПараметрПредставления(Описание,
								  "ДатаОкончания",
								  ОписаниеТипаДата(),
								  "&ДатаОкончания",
								  Обязательный,
								  ЭтоВыражение);
	ДобавитьПараметрПредставления(Описание,
								  "ДатаАктуальности",
								  ОписаниеТипаДата(),
								  "&ДатаАктуальности",
								  Обязательный,
								  ЭтоВыражение);

	ПоляЗапросаВДоступныеПоляПредставления(СформироватьЗапросПредставления(Описание.Имя,
																		   "ДатаНачала,ДатаОкончания,ДатаАктуальности"),
										   Описание);
	
	ОписанияПредставлений.Вставить(Описание.Имя, Описание);

КонецПроцедуры

#КонецОбласти

#Область ТекстовыеОписанияПредставлений

// Заполняет текстовые описания представлений и их доступных полей и параметров.
// Описания хранятся в текстовых макетах обработки с именами вида ТекстовоеОписание<ИмяПредставления>
// в формате JSON:
//  {
//    "ОписаниеПредставления": "Описание представления",
//    "Поля": [ { "Имя": "ИмяПоля", "Описание": "Описание поля" }, ... ],
//    "Параметры": [ { "Имя": "ИмяПараметра", "Описание": "Описание параметра" }, ... ]
//  }
// Представления без макета и поля, отсутствующие в макете, остаются с пустым описанием.
//
// Параметры:
//  ОписанияПредставлений - Соответствие Из КлючИЗначение - См. ОписанияПредставленийПоКонфигурации
Процедура ЗаполнитьТекстовыеОписанияПредставлений(ОписанияПредставлений)

	Для Каждого КлючИЗначение Из ОписанияПредставлений Цикл
		ОписаниеПредставления = КлючИЗначение.Значение;

		ТекстовыеОписания = ТекстовыеОписанияПредставления(ОписаниеПредставления.Имя);
		Если ТекстовыеОписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеПредставления.Описание = ТекстовыеОписания.ОписаниеПредставления;

		Для Каждого ТекстовоеОписаниеПоля Из ТекстовыеОписания.Поля Цикл
			Поле = ОписаниеПредставления.ДоступныеПоля.Найти(ТекстовоеОписаниеПоля.Имя, "Имя");
			Если Поле <> Неопределено Тогда
				Поле.Описание = ТекстовоеОписаниеПоля.Описание;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекстовоеОписаниеПараметра Из ТекстовыеОписания.Параметры Цикл
			Параметр = ОписаниеПредставления.ДоступныеПараметры.Найти(ТекстовоеОписаниеПараметра.Имя, "Имя");
			Если Параметр <> Неопределено Тогда
				Параметр.Описание = ТекстовоеОписаниеПараметра.Описание;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Читает текстовые описания представления из макета обработки.
//
// Параметры:
//  ИмяПредставления - Строка - Имя представления
//
// Возвращаемое значение:
//  Структура, Неопределено - Содержимое макета описаний, см. ЗаполнитьТекстовыеОписанияПредставлений.
//                            Неопределено, если макета для представления нет.
Функция ТекстовыеОписанияПредставления(ИмяПредставления)

	ИмяМакета = ПрефиксИмениМакетаТекстовыхОписаний() + ИмяПредставления;
	Если Метаданные().Макеты.Найти(ИмяМакета) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ПолучитьМакет(ИмяМакета).ПолучитьТекст());
	ТекстовыеОписания = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Возврат ТекстовыеОписания;

КонецФункции

// Префикс имени макета с текстовыми описаниями представления.
//
// Возвращаемое значение:
//  Строка - Префикс, к которому добавляется имя представления
Функция ПрефиксИмениМакетаТекстовыхОписаний()
	Возврат "ТекстовоеОписание";
КонецФункции

#КонецОбласти

#Область КонвертацияВJSON

// Преобразует описание представления в JSON-совместимую структуру.
// Текстовые описания представления, параметров и полей выгружаются в тот же файл.
// Из программного интерфейса выгружаются только признак наличия и шаблон, параметры не выгружаются.
//
// Параметры:
//  Описание - См. НовоеОписаниеПредставления
//
// Возвращаемое значение:
//  Структура - описание представления в JSON-совместимой структуре:
//   * Подсистема, Имя, ЕстьИсточникДанных, ЕстьФильтр, Фильтр, ФильтрОбязателен, ДоступныОтборы, Основное,
//     Описание, ЕстьПрограммныйИнтерфейс - соответствуют полям описания представления
//   * Шаблон - Строка - шаблон кода программного интерфейса
//   * ДоступныеПараметры - Массив Из См. ПараметрДляJSON
//   * ДоступныеПоля - Массив Из См. ПолеДляJSON
//
Функция ПредставлениеДляJSON(Описание)

	Результат = Новый Структура;
	Результат.Вставить("Подсистема", Описание.Подсистема);
	Результат.Вставить("Имя", Описание.Имя);
	Результат.Вставить("ЕстьИсточникДанных", Описание.ЕстьИсточникДанных);
	Результат.Вставить("ЕстьФильтр", Описание.ЕстьФильтр);
	Результат.Вставить("Фильтр", Описание.Фильтр);
	Результат.Вставить("ФильтрОбязателен", Описание.ФильтрОбязателен);
	Результат.Вставить("ДоступныОтборы", Описание.ДоступныОтборы);
	Результат.Вставить("Основное", Описание.Основное);
	Результат.Вставить("Описание", Описание.Описание);
	Результат.Вставить("ЕстьПрограммныйИнтерфейс", Описание.ЕстьПрограммныйИнтерфейс);
	Результат.Вставить("Шаблон", Описание.ПрограммныйИнтерфейс.Шаблон);

	МассивПараметров = Новый Массив;
	Для Каждого СтрокаПараметра Из Описание.ДоступныеПараметры Цикл
		МассивПараметров.Добавить(ПараметрДляJSON(СтрокаПараметра));
	КонецЦикла;
	Результат.Вставить("ДоступныеПараметры", МассивПараметров);

	МассивПолей = Новый Массив;
	Для Каждого СтрокаПоля Из Описание.ДоступныеПоля Цикл
		МассивПолей.Добавить(ПолеДляJSON(СтрокаПоля));
	КонецЦикла;
	Результат.Вставить("ДоступныеПоля", МассивПолей);

	Возврат Результат;

КонецФункции

// Преобразует строку таблицы ДоступныеПараметры в JSON-совместимую структуру.
//
// Параметры:
//  СтрокаПараметра - СтрокаТаблицыЗначений - строка таблицы ДоступныеПараметры.
//
// Возвращаемое значение:
//  Структура - структура, совместимая с JSON.
//
Функция ПараметрДляJSON(СтрокаПараметра)

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", СтрокаПараметра.Имя);
	Параметр.Вставить("Тип", ПредставлениеТипов(СтрокаПараметра.Тип));

	Если СтрокаПараметра.Значение = Неопределено Тогда
		Параметр.Вставить("Значение", Неопределено);
	Иначе
		Параметр.Вставить("Значение", СтрокаПараметра.Значение);
	КонецЕсли;

	Параметр.Вставить("Обязательный", СтрокаПараметра.Обязательный);
	Параметр.Вставить("Описание", СтрокаПараметра.Описание);
	Параметр.Вставить("ДоступныеЗначения", СписокЗначенийДляJSON(СтрокаПараметра.ДоступныеЗначения));
	Параметр.Вставить("ЗначениеЭтоВыражение", СтрокаПараметра.ЗначениеЭтоВыражение);

	Возврат Параметр;

КонецФункции

// Преобразует строку таблицы ДоступныеПоля в JSON-совместимую структуру.
//
// Параметры:
//  СтрокаПоля - СтрокаТаблицыЗначений - строка таблицы ДоступныеПоля.
//
// Возвращаемое значение:
//  Структура - структура, совместимая с JSON.
//
Функция ПолеДляJSON(СтрокаПоля)

	Поле = Новый Структура;
	Поле.Вставить("Имя", СтрокаПоля.Имя);
	Поле.Вставить("Выражение", СтрокаПоля.Выражение);
	Поле.Вставить("Описание", СтрокаПоля.Описание);

	Возврат Поле;

КонецФункции

// Преобразует ОписаниеТипов в массив строк с именами типов,
// как ожидает схема ("Тип": ["Строка"], ["СправочникСсылка.Организации"] и т.п.).
//
// Параметры:
//  ОписаниеТиповЗначения - ОписаниеТипов - описание типов.
//
// Возвращаемое значение:
//  Массив Из Строка - массив строк с именами типов.
//
Функция ПредставлениеТипов(ОписаниеТиповЗначения)

	МассивТипов = Новый Массив;

	Если ОписаниеТиповЗначения = Неопределено Тогда
		Возврат МассивТипов;
	КонецЕсли;

	Для Каждого Тип Из ОписаниеТиповЗначения.Типы() Цикл
		МассивТипов.Добавить(Строка(Тип));
	КонецЦикла;

	Возврат МассивТипов;

КонецФункции

// Преобразует СписокЗначений в массив структур {Значение, Представление}.
//
// Параметры:
//  СписокЗначений - СписокЗначений Из ЭлементСпискаЗначений - список значений.
//
// Возвращаемое значение:
//  Массив Из Структура - массив структур {Значение, Представление}.
//
Функция СписокЗначенийДляJSON(СписокЗначений)

	Результат = Новый Массив;

	Если СписокЗначений = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из СписокЗначений Цикл
		Строка = Новый Структура;
		Строка.Вставить("Значение", Элемент.Значение);
		Строка.Вставить("Представление", Элемент.Представление);
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подкаталог выгрузки представления: имя подсистемы с заменой пробелов на "_",
// для общих представлений - "Общие".
//
// Параметры:
//  Описание - См. НовоеОписаниеПредставления
//
// Возвращаемое значение:
//  Строка - имя подкаталога.
//
Функция ПодкаталогВыгрузкиПредставления(Описание)
	
	Если ПустаяСтрока(Описание.Подсистема) Тогда
		Возврат "Общие";
	КонецЕсли;
	
	Возврат СтрЗаменить(Описание.Подсистема, " ", "_");
	
КонецФункции

// Параметры записи JSON: переводы строк LF, отступ 2 пробела.
//
// Возвращаемое значение:
//  ПараметрыЗаписиJSON
//
Функция ПараметрыЗаписиJSONВыгрузки()
	Возврат Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, "  ");
КонецФункции

// Пишет подготовленную структуру в JSON-файл с отступами для читаемости.
//
// Параметры:
//  Структура - См. ПредставлениеДляJSON
//  ПутьКФайлу - Строка - полный путь к файлу.
//
Процедура ЗаписатьСтруктуруВJSONФайл(Структура, ПутьКФайлу)

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьКФайлу, , , ПараметрыЗаписиJSONВыгрузки());

	ЗаписатьJSON(Запись, Структура);

	Запись.Закрыть();

КонецПроцедуры

// Преобразует подготовленную структуру в текст JSON с отступами для читаемости.
//
// Параметры:
//  Структура - См. ПредставлениеДляJSON
//
// Возвращаемое значение:
//  Строка - текст JSON.
//
Функция ТекстJSON(Структура)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыЗаписиJSONВыгрузки());

	ЗаписатьJSON(Запись, Структура);

	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область РаботаСЗапросом

// Конвертирует параметр представления таблицы формы Параметры для текста запроса представления
// 
// Параметры:
//  ВыбранныйПараметр - ДанныеФормыЭлементКоллекции - Выбранный параметр таблицы ПараметрыПредставления
//  РазделительПараметров - Строка - Разделитель параметров. В случае указания нескольких отборов, они должны
//  								 быть разделены постфиксом. Иначе при разботе текста представления будет использоваться
//  								 только последний.
// 
// Возвращаемое значение:
//  Строка - Параметр на языке запроса
Функция ВыбранныйПараметрВВыражениеЯзыкаЗапроса(ВыбранныйПараметр, РазделительПараметров = "")
	
	Значение = ?(ВыбранныйПараметр.ЗначениеЭтоВыражение,
				 ВыбранныйПараметр.Значение,
				 ЗначениеПараметраВВыражениеЯзыкаЗапроса(ВыбранныйПараметр.Значение));
	
	Если ВыбранныйПараметр.Отбор Тогда
		// Необходимо преобразовать в 3 отдельных отбора ЛевоеЗначение, ВидСравнения, ПравоеЗначение
		ШаблонОтбора = """ЛевоеЗначение%1"" = ""%2""
					   |	И ""ВидСравнения%1"" = %3
					   |	И ""ПравоеЗначение%1"" = %4";
		
		Возврат СтрШаблон(ШаблонОтбора,
						  РазделительПараметров,
						  ВыбранныйПараметр.Имя,
						  ЗначениеПараметраВВыражениеЯзыкаЗапроса(ВыбранныйПараметр.ВидСравнения),
						  Значение);
	Иначе				 
		Возврат СтрШаблон("""%1"" = %2", ВыбранныйПараметр.Имя, Значение);
	КонецЕсли;

КонецФункции

// Конвертирует значение в выражение на языке запроса
// 
// Параметры:
//  Значение - Булево, Строка, Дата, Число, ВидСравненияКомпоновкиДанных - Значение
// 
// Возвращаемое значение:
//  Строка - Значение параметра в выражение языка запроса
Функция ЗначениеПараметраВВыражениеЯзыкаЗапроса(Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='""ДАТАВРЕМЯ(""yyyy, MM, dd, HH, mm, ss"")""';");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=; ЧГ=;");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=ЛОЖЬ; БИ=ИСТИНА;");
	ИначеЕсли ТипЗначения = Тип("ВидСравненияКомпоновкиДанных") Тогда
		СоответствиеВидовСравнений = ДоступныеВидыСравненияОтбора();

		ВыражениеЯзыкаЗапроса = СоответствиеВидовСравнений[Значение];
		Если ВыражениеЯзыкаЗапроса = Неопределено Тогда
			ВызватьИсключение "Недопустимый вид сравнения " + Значение;
		КонецЕсли;

		Возврат """" + ВыражениеЯзыкаЗапроса + """";
	КонецЕсли;

	Возврат """" + Строка(Значение) + """";

КонецФункции

// Разбирает на составные части полное имя представления, которое указывается после ключевого
// слова ПОМЕСТИТЬ
// 
// Параметры:
//  ПолноеИмя - Строка - Полное имя представления вида Представления_ИмяПредставления_<...>
// 
// Возвращаемое значение:
//  Структура - Разобрать полное имя представления:
// * Имя - Строка - Имя. Пустое, если не удалось разобрать
// * ИсточникДанных - Строка - Источник данных
// * Уточнение - Строка - Постфикс
Функция РазобратьПолноеИмяПредставления(ПолноеИмя)

	Результат = Новый Структура;
	Результат.Вставить("Имя", "");
	Результат.Вставить("ИсточникДанных", "");
	Результат.Вставить("Уточнение", "");

	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Результат;
	КонецЕсли;

	ЧастиПолногоИмени = СтрРазделить(ПолноеИмя, "_");
	
	Если ЧастиПолногоИмени.Количество() = 1 Тогда
		Если ВРег(ЧастиПолногоИмени[0]) <> ВРег("Представления") Тогда
			Результат.Имя = ЧастиПолногоИмени[0];
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;

	Результат.Имя = ЧастиПолногоИмени[1];

	Если (ЭтоИмяПредставленияСИсточникомДанных(Результат.Имя)) И ЧастиПолногоИмени.Количество() > 3 Тогда
		ЗаполнитьЗначенияСвойств(Результат, РазобратьИмяПредставленияСИменемРегистра(ЧастиПолногоИмени));
	ИначеЕсли ЧастиПолногоИмени.Количество() >= 3 Тогда
		Результат.ИсточникДанных = ЧастиПолногоИмени[2];
		Если ЧастиПолногоИмени.Количество() > 3 Тогда
			МодульОбщегоНазначения = МодульОбщегоНазначения();
			МодульОбщегоНазначенияБЗККлиентСервер = МодульОбщегоНазначения.ОбщийМодуль(
				"ОбщегоНазначенияБЗККлиентСервер");
			ЧастиУточнения = МодульОбщегоНазначенияБЗККлиентСервер.СрезМассива(ЧастиПолногоИмени, 3);
			Результат.Уточнение = СтрСоединить(ЧастиУточнения, "_");
		КонецЕсли;
	Иначе
		// Обработка не требуется
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет, соответствует ли имя источника данных одному из стандартных имен представлений.
//
// Параметры:
//   Имя - Строка - Имя источника данных для проверки.
//
// Возвращаемое значение:
//   Булево - Истина, если имя соответствует "ТаблицаРегистра", "СрезПервых" или "СрезПоследних", иначе Ложь
Функция ЭтоИмяПредставленияСИсточникомДанных(Имя)
	Возврат ВРег(Имя) = ВРег("ТаблицаРегистра")
		  Или ВРег(Имя) = ВРег("СрезПервых")
		  Или ВРег(Имя) = ВРег("СрезПоследних");
КонецФункции

// Разбирает имя представления с именем регистра на составные части.
//
// Параметры:
//   ЧастиПолногоИмени - Массив Из Строка - части полного имени представления, разбитые по символу "_".
//
// Возвращаемое значение:
//   Структура - содержит имя представления, источник данных и уточнение:
//	   * ИсточникДанных - Строка - источник данных.
//	   * Уточнение - Строка - уточнение.
//
Функция РазобратьИмяПредставленияСИменемРегистра(ЧастиПолногоИмени)
	
	Результат = Новый Структура("ИсточникДанных, Уточнение", "", "", "");
	
	МодульОбщегоНазначения = МодульОбщегоНазначения();
	МодульОбщегоНазначенияБЗККлиентСервер = МодульОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияБЗККлиентСервер");
	
	ИндексИмениРегистра = 2;
		
	// Представление может содержать в качестве источника данных регистр, который может иметь префиксацию с "_".
	// Также может содержать уточнение через "_". В таком случае необходим поиск по метаданным.
	Для Индекс = 0 По ЧастиПолногоИмени.ВГраница() - ИндексИмениРегистра Цикл
		ЧастиПроверяемогоИмени = МодульОбщегоНазначенияБЗККлиентСервер.СрезМассива(ЧастиПолногоИмени,
																				   ИндексИмениРегистра,
																				   ЧастиПолногоИмени.ВГраница()
																				   - Индекс);
		ПроверяемоеИмя = СтрСоединить(ЧастиПроверяемогоИмени, "_");
		Если Метаданные.РегистрыСведений.Найти(ПроверяемоеИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.ИсточникДанных = ПроверяемоеИмя;
		Если Индекс > 0 Тогда
			ЧастиУточнения = МодульОбщегоНазначенияБЗККлиентСервер.СрезМассива(ЧастиПолногоИмени,
																			   ЧастиПолногоИмени.ВГраница()
																			   - Индекс
																			   + 1);

			Результат.Уточнение = СтрСоединить(ЧастиУточнения, "_");
		КонецЕсли;

		Прервать;
	КонецЦикла;

	Если ПустаяСтрока(Результат.ИсточникДанных) Тогда
		ЧастиИсточникаДанных = МодульОбщегоНазначенияБЗККлиентСервер.СрезМассива(ЧастиПолногоИмени, ИндексИмениРегистра);
		Результат.ИсточникДанных = СтрСоединить(ЧастиИсточникаДанных, "_");
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли

