	Возврат Путь;

КонецФункции

// Родительский каталог для пути с завершающим разделителем или без него.
//
// Параметры:
//  Путь - Строка - путь, для которого нужен родительский каталог.
//
// Возвращаемое значение:
//  Строка - путь родительского каталога или пустая строка.
//
&НаКлиентеНаСервереБезКонтекста
Функция РодительскийКаталог(Знач Путь)

	Обрезанный = Путь;
	Пока СтрЗаканчиваетсяНа(Обрезанный, "\") Или СтрЗаканчиваетсяНа(Обрезанный, "/") Цикл
		Обрезанный = Лев(Обрезанный, СтрДлина(Обрезанный) - 1);
	КонецЦикла;

	Файл = Новый Файл(Обрезанный);

	Возврат Файл.Путь;

КонецФункции

// Истина для имён каталогов вида 8.3.27.2214.
//
// Параметры:
//  Имя - Строка - имя каталога.
//
// Возвращаемое значение:
//  Булево - Истина, если имя состоит из чисел, разделённых точками.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоНомерВерсии(Знач Имя)

	Части = СтрРазделить(Имя, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Часть Из Части Цикл
		Если ПустаяСтрока(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Сч = 1 По СтрДлина(Часть) Цикл
			Знак = Сред(Часть, Сч, 1);
			Если Знак < "0" Или Знак > "9" Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Каталоги версий от самой свежей к самой старой.
//
// Параметры:
//  Каталоги - Массив из Файл - каталоги версий платформы.
//
// Возвращаемое значение:
//  Массив из Файл - те же каталоги в порядке убывания версии.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПоУбываниюВерсий(Знач Каталоги)

	Список = Новый СписокЗначений;
	Для Каждого Каталог Из Каталоги Цикл
		Список.Добавить(Каталог, КлючСортировкиВерсии(Каталог.Имя));
	КонецЦикла;
	Список.СортироватьПоПредставлению(НаправлениеСортировки.Убыв);

	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ключ сортировки версии: каждый сегмент дополнен нулями до шести знаков.
//
// Параметры:
//  Имя - Строка - имя каталога версии.
//
// Возвращаемое значение:
//  Строка - ключ, пригодный для строковой сортировки версий.
//
&НаКлиентеНаСервереБезКонтекста
Функция КлючСортировкиВерсии(Знач Имя)

	Ключ = "";
	Для Каждого Часть Из СтрРазделить(Имя, ".", Ложь) Цикл
		Ключ = Ключ + Прав("000000" + Часть, 6);
	КонецЦикла;

	Возврат Ключ;

КонецФункции

// Предпочитаем русский пакет, иначе первый попавшийся.
//
// Параметры:
//  Файлы - Массив из Файл - найденные файлы справки.
//
// Возвращаемое значение:
//  Строка - полный путь выбранного файла.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЛучшийФайлСправки(Знач Файлы)

	Для Каждого Файл Из Файлы Цикл
		Если СтрЗаканчиваетсяНа(НРег(Файл.ИмяБезРасширения), "_ru") Тогда
			Возврат Файл.ПолноеИмя;
		КонецЕсли;
	КонецЦикла;

	Возврат Файлы[0].ПолноеИмя;

КонецФункции

// Записывает длительность шага, если сбор замеров включён.
//
// Параметры:
//  Замеры - Соответствие из КлючИЗначение, Неопределено - коллекция замеров; Неопределено - замеры не собираются.
//  Шаг    - Строка - имя шага.
//  Начало - Число - момент начала шага в миллисекундах.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьЗамер(Знач Замеры, Знач Шаг, Знач Начало)

	Если Замеры <> Неопределено Тогда
		Замеры.Вставить(Шаг, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли

////////////////////////////////////////////////////////////////////////////////
// Движок справки, работа с данными пакета: всё, что трогает файлы.
//
// Код клиент-серверный: тонкий и толстый клиенты и сервер умеют всё, что здесь нужно.
// Где именно читать - решает вызывающий по доступности файла: пакет лежит рядом с
// клиентом, но серверу он может быть недоступен (другая машина, Linux, сетевой каталог),
// и наоборот.
//
// Веб-клиент файлов не видит вовсе, поэтому там каждый метод отказывает с именем метода
// в тексте: путь один - работать на сервере, а если и там пакета нет, вызывающий
// сообщает об этом пользователю. Молчаливая заглушка прятала бы причину.
//
// Вызовы без состояния: всё, что нужно для чтения статьи, приносит с собой вызывающий.
//
// Директивы компиляции не проставлены намеренно: сборщик ставит
// &НаКлиентеНаСервереБезКонтекста в модуле формы и оставляет как есть в стенде.
////////////////////////////////////////////////////////////////////////////////

// Единая точка отказа для веб-клиента. Молчаливая заглушка прячет причину, поэтому
// метод честно говорит, что именно не выполнилось: вызывающий вызывает исключение с
// этим текстом и уходит на сервер, а в журнале и в отладке видно, где это случилось.
//
// Текст возвращается, а не вызывается исключение здесь же: так ветка веб-клиента
// остаётся обычным ВызватьИсключение, а не возвратом значения.
//
// Параметры:
//  ИмяМетода - Строка - метод, который вызвали не в том месте.
//
// Возвращаемое значение:
//  Строка - текст исключения для веб-клиента.
//
&НаКлиентеНаСервереБезКонтекста
Функция ВебКлиентНеПоддерживается(Знач ИмяМетода)

	Возврат СтрШаблон(
		НСтр("ru = 'Метод %1 в веб-клиенте не поддерживается: файлы читаются на сервере'"),
		ИмяМетода);

КонецФункции

#КонецОбласти

#Область Иконки

////////////////////////////////////////////////////////////////////////////////
// Иконки дерева содержания.
//
// Сами изображения хранятся в общих картинках конфигурации: УИ_Раздел,
// УИ_ОбъектМетаданных, УИ_Метод, УИ_Свойство, УИ_Событие, УИ_Статья.
////////////////////////////////////////////////////////////////////////////////

// Возвращает картинки видов узлов оглавления.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//    * Ключ - Строка - вид узла: Раздел, Объект, Метод, Свойство, Событие, Статья
//    * Значение - Картинка
//
&НаКлиенте
Функция ИконкиУзлов()

	Иконки = Новый Соответствие;
	Иконки.Вставить("Раздел",   БиблиотекаКартинок.УИ_Раздел);
	Иконки.Вставить("Объект",   БиблиотекаКартинок.УИ_ОбъектМетаданных);
	Иконки.Вставить("Метод",    БиблиотекаКартинок.УИ_Метод);
	Иконки.Вставить("Свойство", БиблиотекаКартинок.УИ_Свойство);
	Иконки.Вставить("Событие",  БиблиотекаКартинок.УИ_Событие);
	Иконки.Вставить("Статья",   БиблиотекаКартинок.УИ_Статья);

	Возврат Иконки;

КонецФункции

#КонецОбласти

#КонецОбласти
