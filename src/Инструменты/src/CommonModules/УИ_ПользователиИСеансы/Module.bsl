#Область ПрограммныйИнтерфейс

// Возвращает пустые данные пользователя информационной базы, которые редактирует форма пользователя.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя пользователя
//   * ПолноеИмя - Строка - полное имя пользователя
//   * АдресЭлектроннойПочты - Строка - адрес электронной почты
//   * АутентификацияСтандартная - Булево - разрешена аутентификация 1С:Предприятия
//   * ПоказыватьВСпискеВыбора - Булево - показывать пользователя в списке выбора при запуске
//   * ЗапрещеноИзменятьПароль - Булево - пользователю запрещено изменять пароль
//   * ЗапрещеноВосстанавливатьПароль - Булево - пользователю запрещено восстанавливать пароль
//   * ИмяПолитикиПаролей - Строка - имя политики паролей, пустая строка - параметры информационной базы
//   * АутентификацияOpenID - Булево - разрешена аутентификация OpenID
//   * АутентификацияOpenIDConnect - Булево - разрешена аутентификация OpenID Connect
//   * АутентификацияТокеномДоступа - Булево - разрешена аутентификация токеном доступа
//   * АутентификацияЧерезЭлектроннуюПочту - Булево - разрешена аутентификация через электронную почту
//   * АутентификацияQRКодом - Булево - разрешена аутентификация по QR-коду
//   * АутентификацияОС - Булево - разрешена аутентификация операционной системы
//   * ПользовательОС - Строка - пользователь операционной системы в формате \\Домен\Пользователь
//   * ЗащитаОтОпасныхДействий - Булево - предупреждать об опасных действиях
//   * РежимЗапуска - Строка - имя значения РежимЗапускаКлиентскогоПриложения: Авто, ОбычноеПриложение,
//                             УправляемоеПриложение
//   * Язык - Строка - имя языка, пустая строка - язык не задан
//   * ОсновнойИнтерфейс - Строка - имя интерфейса, пустая строка - интерфейс не задан
//   * Роли - Массив из Строка - имена ролей пользователя
Функция НовыеДанныеПользователяИБ() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Имя", "");
	Данные.Вставить("ПолноеИмя", "");
	Данные.Вставить("АдресЭлектроннойПочты", "");
	Данные.Вставить("АутентификацияСтандартная", Ложь);
	Данные.Вставить("ПоказыватьВСпискеВыбора", Ложь);
	Данные.Вставить("ЗапрещеноИзменятьПароль", Ложь);
	Данные.Вставить("ЗапрещеноВосстанавливатьПароль", Ложь);
	Данные.Вставить("ИмяПолитикиПаролей", "");
	Данные.Вставить("АутентификацияOpenID", Ложь);
	Данные.Вставить("АутентификацияOpenIDConnect", Ложь);
	Данные.Вставить("АутентификацияТокеномДоступа", Ложь);
	Данные.Вставить("АутентификацияЧерезЭлектроннуюПочту", Ложь);
	Данные.Вставить("АутентификацияQRКодом", Ложь);
	Данные.Вставить("АутентификацияОС", Ложь);
	Данные.Вставить("ПользовательОС", "");
	Данные.Вставить("ЗащитаОтОпасныхДействий", Ложь);
	Данные.Вставить("РежимЗапуска", "Авто");
	Данные.Вставить("Язык", "");
	Данные.Вставить("ОсновнойИнтерфейс", "");
	Данные.Вставить("Роли", Новый Массив);
	Возврат Данные;

КонецФункции

// Возвращает сведения пользователя информационной базы для формы пользователя. Без права "Администрирование"
// платформа отдает найденного пользователя только с именем, полным именем, языком и признаком
// установленного пароля, поэтому остальные сведения своей карточки берутся у пользователя текущего сеанса -
// на момент входа в программу. Полное имя, язык и признак пароля, которые пользователь может изменить
// о себе, берутся у найденного пользователя: так видны уже записанные значения. Сведения других
// пользователей без этого права не читаются.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - найденный пользователь
//
// Возвращаемое значение:
//  Неопределено - сведения пользователя прочитать нельзя
//  Структура:
//   * Данные - см. НовыеДанныеПользователяИБ
//   * Идентификатор - УникальныйИдентификатор - идентификатор пользователя
//   * Имя - Строка - имя пользователя
//   * ПарольУстановлен - Булево - у пользователя установлен пароль
Функция СведенияПользователяИБДляФормы(ПользовательИБ) Экспорт

	ПрочитанныйПользователь = ЧитаемыйПользовательИБ(ПользовательИБ);
	Если ПрочитанныйПользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = ДанныеПользователяИБ(ПрочитанныйПользователь);
	Данные.ПолноеИмя = ПользовательИБ.ПолноеИмя;
	Данные.Язык = ИмяОбъектаМетаданных(ПользовательИБ.Язык);

	Сведения = Новый Структура;
	Сведения.Вставить("Данные", Данные);
	Сведения.Вставить("Идентификатор", ПрочитанныйПользователь.УникальныйИдентификатор);
	Сведения.Вставить("Имя", ПрочитанныйПользователь.Имя);
	Сведения.Вставить("ПарольУстановлен", ПользовательИБ.ПарольУстановлен);
	Возврат Сведения;

КонецФункции

// Возвращает данные пользователя информационной базы.
// Свойств, которых нет в текущей версии платформы, у пользователя нет: в данных остаются их пустые значения,
// см. ДоступныеСвойстваПользователяИБ.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - пользователь
//
// Возвращаемое значение:
//  см. НовыеДанныеПользователяИБ
Функция ДанныеПользователяИБ(ПользовательИБ) Экспорт

	Данные = НовыеДанныеПользователяИБ();
	ЗаполнитьЗначенияСвойств(Данные, ПользовательИБ, , ИменаСвойствСОсобымЗаполнением());
	Данные.ЗащитаОтОпасныхДействий = ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
	Данные.РежимЗапуска = ИмяРежимаЗапуска(ПользовательИБ.РежимЗапуска);
	Данные.Язык = ИмяОбъектаМетаданных(ПользовательИБ.Язык);
	Данные.ОсновнойИнтерфейс = ИмяОбъектаМетаданных(ПользовательИБ.ОсновнойИнтерфейс);
	Для Каждого Роль Из ПользовательИБ.Роли Цикл
		Данные.Роли.Добавить(Роль.Имя);
	КонецЦикла;
	Возврат Данные;

КонецФункции

// Возвращает данные пользователей информационной базы для списка пользователей. Без права "Администрирование"
// в списке только пользователь текущего сеанса: сведения других пользователей без этого права не читаются,
// см. СведенияПользователяИБДляФормы.
//
// Возвращаемое значение:
//  Массив из см. ДанныеПользователяИБДляСписка
Функция ДанныеПользователейИБДляСписка() Экспорт

	Если ЕстьПравоАдминистрированияПользователей() Тогда
		СписокПользователейИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Иначе
		СписокПользователейИБ = Новый Массив;
		ТекущийПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя());
		Если ТекущийПользовательИБ <> Неопределено Тогда
			СписокПользователейИБ.Добавить(ТекущийПользовательИБ);
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого ПользовательИБ Из СписокПользователейИБ Цикл
		Данные = ДанныеСтрокиСпискаПользователяИБ(ПользовательИБ);
		Если Данные <> Неопределено Тогда
			Результат.Добавить(Данные);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает данные пользователя информационной базы для строки списка пользователей.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор пользователя
//
// Возвращаемое значение:
//  Неопределено - пользователь не найден, например, удален, или без права "Администрирование"
//                 это не пользователь текущего сеанса
//  Структура - свойства пользователя, см. НовыеДанныеПользователяИБ, в которых режим запуска, язык
//              и основной интерфейс заданы представлениями, а вместо массива ролей:
//   * ИменаРолей - Строка - имена ролей через запятую, упорядоченные по возрастанию
//   * Идентификатор - УникальныйИдентификатор - идентификатор пользователя
//   * ЭтоТекущийПользователь - Булево - пользователь текущего сеанса
//   * ПарольУстановлен - Булево - у пользователя установлен пароль
Функция ДанныеПользователяИБДляСписка(Идентификатор) Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Идентификатор);
	Если ПользовательИБ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДанныеСтрокиСпискаПользователяИБ(ПользовательИБ);

КонецФункции

// Возвращает данные для создания пользователя информационной базы: значения, которые платформа задает
// новому пользователю, с включенной аутентификацией 1С:Предприятия и показом в списке выбора,
// как при создании пользователя в конфигураторе.
//
// Возвращаемое значение:
//  см. НовыеДанныеПользователяИБ
Функция ДанныеСоздаваемогоПользователяИБ() Экспорт

	Данные = ДанныеПользователяИБ(ПользователиИнформационнойБазы.СоздатьПользователя());
	Данные.АутентификацияСтандартная = Истина;
	Данные.ПоказыватьВСпискеВыбора = Истина;
	Возврат Данные;

КонецФункции

// Возвращает данные для создания пользователя информационной базы копированием существующего.
// Копируются роли и настройки, а сведения, которые относятся к конкретному человеку, очищаются:
// имя, полное имя, адрес электронной почты и пользователь операционной системы. Пароль не копируется.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - копируемый пользователь
//
// Возвращаемое значение:
//  см. НовыеДанныеПользователяИБ
Функция ДанныеКопированияПользователяИБ(ПользовательИБ) Экспорт

	Данные = ДанныеПользователяИБ(ПользовательИБ);
	Данные.Имя = "";
	Данные.ПолноеИмя = "";
	Данные.АдресЭлектроннойПочты = "";
	Данные.ПользовательОС = "";
	Возврат Данные;

КонецФункции

// Заполняет свойства пользователя информационной базы.
// Роли меняются только среди ролей метаданных сеанса: роли, которых в них нет, у пользователя остаются.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - заполняемый пользователь
//  Данные - см. НовыеДанныеПользователяИБ
Процедура ЗаполнитьПользователяИБ(ПользовательИБ, Данные) Экспорт

	ЗаполнитьЗначенияСвойств(ПользовательИБ, Данные, , ИменаСвойствСОсобымЗаполнением());

	ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Данные.ЗащитаОтОпасныхДействий;

	ПользовательИБ.РежимЗапуска = РежимЗапускаПоИмени(Данные.РежимЗапуска);
	ПользовательИБ.Язык = ЯзыкПоИмени(Данные.Язык);
	ПользовательИБ.ОсновнойИнтерфейс = ?(ПустаяСтрока(Данные.ОсновнойИнтерфейс), Неопределено,
		Метаданные.Интерфейсы.Найти(Данные.ОсновнойИнтерфейс));

	ВыбранныеРоли = Новый Соответствие;
	Для Каждого ИмяРоли Из Данные.Роли Цикл
		ВыбранныеРоли.Вставить(ИмяРоли, Истина);
	КонецЦикла;
	Для Каждого Роль Из Метаданные.Роли Цикл
		РольВыбрана = (ВыбранныеРоли[Роль.Имя] <> Неопределено);
		Если РольВыбрана = ПользовательИБ.Роли.Содержит(Роль) Тогда
			Продолжить;
		КонецЕсли;
		Если РольВыбрана Тогда
			ПользовательИБ.Роли.Добавить(Роль);
		Иначе
			ПользовательИБ.Роли.Удалить(Роль);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Записывает пользователя информационной базы: существующего или нового.
// Без права "Администрирование" записываются только сведения, которые пользователь может изменить
// о себе: полное имя, язык и пароль.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор существующего пользователя;
//                  пустой идентификатор - создается новый пользователь
//  Данные - см. НовыеДанныеПользователяИБ
//  Пароль - Строка, Неопределено - новый пароль пользователя; Неопределено - пароль не меняется
//
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор записанного пользователя
Функция ЗаписатьПользователяИБ(Идентификатор, Данные, Пароль = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Идентификатор);
		Если ПользовательИБ = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Пользователь информационной базы не найден, возможно, он удален.'");
		КонецЕсли;
	Иначе
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	КонецЕсли;

	Если ЕстьПравоАдминистрированияПользователей() Тогда
		ЗаполнитьПользователяИБ(ПользовательИБ, Данные);
	Иначе
		ЗаполнитьСвоиДанныеПользователяИБ(ПользовательИБ, Данные);
	КонецЕсли;
	Если Пароль <> Неопределено Тогда
		ПользовательИБ.Пароль = Пароль;
	КонецЕсли;
	ПользовательИБ.Записать();
	Возврат ПользовательИБ.УникальныйИдентификатор;

КонецФункции

// Удаляет пользователя информационной базы. Пользователя, под которым выполнен вход в программу,
// удалить нельзя: иначе текущий пользователь потеряет доступ к информационной базе.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор удаляемого пользователя
Процедура УдалитьПользователяИБ(Идентификатор) Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Идентификатор);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь информационной базы не найден, возможно, он уже удален.'");
	КонецЕсли;
	Если ЭтоТекущийПользователь(ПользовательИБ.Имя) Тогда
		ВызватьИсключение НСтр("ru = 'Нельзя удалить пользователя, под которым выполнен вход в программу.'");
	КонецЕсли;
	ПользовательИБ.Удалить();

КонецПроцедуры

// Возвращает признаки наличия у пользователя информационной базы свойств, которые появились
// в новых версиях платформы и могут отсутствовать в текущей.
//
// Возвращаемое значение:
//  Структура - ключ - имя свойства пользователя, значение - Булево: Истина, если свойство есть
Функция ДоступныеСвойстваПользователяИБ() Экспорт

	ЗначенияСвойств = Новый Структура(ИменаСвойствНовыхВерсийПлатформы());
	ЗаполнитьЗначенияСвойств(ЗначенияСвойств, ПользователиИнформационнойБазы.ТекущийПользователь());

	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из ЗначенияСвойств Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение <> Неопределено);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает имена политик паролей пользователей информационной базы, упорядоченные по возрастанию.
// В версиях платформы без политик паролей и без права "Администрирование" возвращает пустой массив.
//
// Возвращаемое значение:
//  Массив из Строка - имена политик паролей
Функция ИменаПолитикПаролей() Экспорт

	Если Не ДоступныеСвойстваПользователяИБ().ИмяПолитикиПаролей Или Не ЕстьПравоАдминистрированияПользователей() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	//@skip-check server-execution-safe-mode
	МенеджерПолитик = Вычислить("ПолитикиПаролейПользователей");
	ИменаПолитик = Новый СписокЗначений;
	Для Каждого Политика Из МенеджерПолитик.ПолучитьПолитики() Цикл
		ИменаПолитик.Добавить(Политика.Имя);
	КонецЦикла;
	ИменаПолитик.СортироватьПоЗначению();
	Возврат ИменаПолитик.ВыгрузитьЗначения();

КонецФункции

// Проверяет пароль по политике паролей. Проверить можно только введенный пароль:
// у установленного пароля в информационной базе хранится только хеш.
//
// Параметры:
//  Пароль - Строка - проверяемый пароль
//  ИмяПолитики - Строка - имя политики паролей; если политика не задана или не найдена,
//                пароль проверяется по параметрам информационной базы
//  Идентификатор - УникальныйИдентификатор - пользователь, для которого проверяется повторение последних
//                  паролей; пустой идентификатор - новый пользователь, повторение не проверяется
//
// Возвращаемое значение:
//  Структура:
//   * Требования - Строка - чьи требования проверены: политика паролей или параметры информационной базы
//   * Нарушения - Массив из Строка - описания нарушенных требований; пустой массив - пароль подходит
Функция ПроверитьПарольПоПолитике(Пароль, ИмяПолитики, Идентификатор) Экспорт

	//@skip-check server-execution-safe-mode
	МенеджерПолитик = Вычислить("ПолитикиПаролейПользователей");
	Политика = Неопределено;
	Если Не ПустаяСтрока(ИмяПолитики) Тогда
		Политика = МенеджерПолитик.НайтиПоИмени(ИмяПолитики);
	КонецЕсли;

	Результат = Новый Структура("Требования, Нарушения", "", Новый Массив);
	Если Политика = Неопределено Тогда
		Результат.Требования = НСтр("ru = 'параметры информационной базы'");
	Иначе
		Результат.Требования = СтрШаблон(НСтр("ru = 'политика паролей ""%1""'"), ИмяПолитики);
	КонецЕсли;

	ПользовательИБ = Неопределено;
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Идентификатор);
	КонецЕсли;

	ТекстыНарушений = ТекстыНарушенийПолитикиПаролей();
	Для Каждого Нарушение Из МенеджерПолитик.ПроверитьСоответствиеПароляПолитике(Пароль, Политика, ПользовательИБ) Цикл
		ТекстНарушения = ТекстыНарушений[Нарушение];
		Результат.Нарушения.Добавить(?(ТекстНарушения = Неопределено, Строка(Нарушение), ТекстНарушения));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает отметку платформы о несоответствии установленного пароля требованиям. Платформа сверяет
// установленный пароль с требованиями при входе пользователя и снимает отметку при смене пароля.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - пользователь
//
// Возвращаемое значение:
//  Булево, Неопределено - Истина, если пароль отмечен как не соответствующий требованиям;
//                         Неопределено, если пользователь не найден или в версии платформы нет такой отметки
Функция ПарольОтмеченНесоответствующимТребованиям(Идентификатор) Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Идентификатор);
	Если ПользовательИБ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отметка = Новый Структура("ПарольНеСоответствуетТребованиям");
	ЗаполнитьЗначенияСвойств(Отметка, ПользовательИБ);
	Возврат Отметка.ПарольНеСоответствуетТребованиям;

КонецФункции

// Возвращает имя события, которое оповещает об изменении пользователя информационной базы.
// Параметр оповещения - УникальныйИдентификатор записанного пользователя.
//
// Возвращаемое значение:
//  Строка - имя события
Функция ИмяСобытияЗаписиПользователяИБ() Экспорт

	Возврат "Запись_ПользовательИБ";

КонецФункции

// Возвращает признак наличия у текущего пользователя права "Администрирование", без которого платформа
// не дает работать с другими пользователями информационной базы.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть
Функция ЕстьПравоАдминистрированияПользователей() Экспорт

	Возврат ПравоДоступа("Администрирование", Метаданные);

КонецФункции

// Возвращает признак того, что имя принадлежит пользователю текущего сеанса.
//
// Параметры:
//  Имя - Строка - имя пользователя информационной базы
//
// Возвращаемое значение:
//  Булево - Истина, если это пользователь текущего сеанса
Функция ЭтоТекущийПользователь(Имя) Экспорт

	Возврат (НРег(Имя) = НРег(ИмяПользователя()));

КонецФункции

// Возвращает данные сеансов информационной базы для списка сеансов. Нужно право "Администрирование".
//
// Возвращаемое значение:
//  Массив из Структура - данные сеансов:
//   * ТекущийСеанс - Булево - Истина для сеанса, в котором выполняется вызов
//   * НомерСеанса - Число
//   * НачалоСеанса - Дата
//   * Пользователь - Строка - имя пользователя информационной базы
//   * ПредставлениеПриложения - Строка
//   * ИмяКомпьютера - Строка
//   * НомерСоединения - Число
//   * ФоновоеЗаданиеНаименование - Строка - свойства фонового задания есть, только если сеанс его выполняет,
//                                  см. ДобавитьДанныеФоновогоЗадания
Функция ДанныеСеансовИБ() Экспорт

	НомерТекущегоСеанса = НомерСеансаИнформационнойБазы();
	ДанныеСеансов = Новый Массив;
	Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
		Данные = Новый Структура;
		Данные.Вставить("ТекущийСеанс", (Сеанс.НомерСеанса = НомерТекущегоСеанса));
		Данные.Вставить("НомерСеанса", Сеанс.НомерСеанса);
		Данные.Вставить("НачалоСеанса", Сеанс.НачалоСеанса);
		Данные.Вставить("Пользователь", ИмяПользователяСеанса(Сеанс.Пользователь));
		Данные.Вставить("ПредставлениеПриложения", ПредставлениеПриложения(Сеанс.ИмяПриложения));
		Данные.Вставить("ИмяКомпьютера", Сеанс.ИмяКомпьютера);
		Данные.Вставить("НомерСоединения", Сеанс.НомерСоединения);
		ДобавитьДанныеФоновогоЗадания(Данные, Сеанс.ПолучитьФоновоеЗадание());
		ДанныеСеансов.Добавить(Данные);
	КонецЦикла;
	Возврат ДанныеСеансов;

КонецФункции

// Возвращает данные соединений информационной базы для списка соединений. Нужно право "Администрирование".
//
// Возвращаемое значение:
//  Массив из Структура - данные соединений:
//   * ТекущееСоединение - Булево - Истина для соединения, в котором выполняется вызов
//   * НомерСоединения - Число
//   * НачалоСоединения - Дата
//   * Пользователь - Строка - имя пользователя информационной базы
//   * ПредставлениеПриложения - Строка
//   * ИмяКомпьютера - Строка
//   * НомерСеанса - Число - сеанс, который обслуживает соединение; 0, если соединение свободно
//   * Активно - Булево - Истина, если соединение обслуживает сеанс
Функция ДанныеСоединенийИБ() Экспорт

	НомерТекущегоСоединения = НомерСоединенияИнформационнойБазы();
	ДанныеСоединений = Новый Массив;
	Для Каждого Соединение Из ПолучитьСоединенияИнформационнойБазы() Цикл
		Данные = Новый Структура;
		Данные.Вставить("ТекущееСоединение", (Соединение.НомерСоединения = НомерТекущегоСоединения));
		Данные.Вставить("НомерСоединения", Соединение.НомерСоединения);
		Данные.Вставить("НачалоСоединения", Соединение.НачалоСоединения);
		Данные.Вставить("Пользователь", ИмяПользователяСеанса(Соединение.Пользователь));
		Данные.Вставить("ПредставлениеПриложения", ПредставлениеПриложения(Соединение.ИмяПриложения));
		Данные.Вставить("ИмяКомпьютера", Соединение.ИмяКомпьютера);
		Данные.Вставить("НомерСеанса", Соединение.НомерСеанса);
		Данные.Вставить("Активно", ЗначениеЗаполнено(Соединение.НомерСеанса));
		ДанныеСоединений.Добавить(Данные);
	КонецЦикла;
	Возврат ДанныеСоединений;

КонецФункции

// Возвращает параметры подключения к кластеру серверов, в котором работает информационная база.
// Адрес и порт кластера берутся из строки соединения информационной базы, порт агента сервера
// на единицу меньше порта кластера, имя COM-соединителя - по версии платформы сервера.
//
// Возвращаемое значение:
//  Структура:
//   * ЭтоФайловаяБаза - Булево - Истина для файлового варианта информационной базы, в нем кластера нет
//   * ВерсияСервера - Строка - версия платформы сервера, например "8.3.27.2130"
//   * ИмяCOMСоединителя - Строка - например, "V83.COMConnector"
//   * АдресАгентаСервера - Строка
//   * ПортАгентаСервера - Число
//   * ПортКластера - Число
//   * АдресСервераАдминистрирования - Строка - адрес сервера администрирования (RAS): сервер агента и порт 1545
//   * ИмяИнформационнойБазы - Строка - имя информационной базы в кластере
Функция ПараметрыПодключенияККластеру() Экспорт

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	Параметры = Новый Структура;
	Параметры.Вставить("ЭтоФайловаяБаза", (СтрНайти(ВРег(СтрокаСоединения), "FILE=") = 1));
	Параметры.Вставить("ВерсияСервера", ИнформацияОСистеме.ВерсияПриложения);
	Параметры.Вставить("ИмяCOMСоединителя", ИмяCOMСоединителя(ИнформацияОСистеме.ВерсияПриложения));
	Параметры.Вставить("АдресАгентаСервера", "localhost");
	Параметры.Вставить("ПортКластера", 1541);
	Параметры.Вставить("ИмяИнформационнойБазы", ЗначениеПараметраСтрокиСоединения(СтрокаСоединения, "Ref"));

	АдресСервера = СокрЛП(СтрРазделить(ЗначениеПараметраСтрокиСоединения(СтрокаСоединения, "Srvr") + ",", ",")[0]);
	ПрефиксПротокола = "tcp://";
	Если СтрНачинаетсяС(НРег(АдресСервера), ПрефиксПротокола) Тогда
		АдресСервера = Сред(АдресСервера, СтрДлина(ПрефиксПротокола) + 1);
	КонецЕсли;
	ПозицияПорта = СтрНайти(АдресСервера, ":");
	Если ПозицияПорта > 0 Тогда
		Параметры.ПортКластера = Число(Сред(АдресСервера, ПозицияПорта + 1));
		АдресСервера = Лев(АдресСервера, ПозицияПорта - 1);
	КонецЕсли;
	Если Не ПустаяСтрока(АдресСервера) Тогда
		Параметры.АдресАгентаСервера = АдресСервера;
	КонецЕсли;
	Параметры.Вставить("ПортАгентаСервера", Параметры.ПортКластера - 1);
	Параметры.Вставить("АдресСервераАдминистрирования", Параметры.АдресАгентаСервера + ":1545");
	Возврат Параметры;

КонецФункции

// Подключается к кластеру серверов через сервер администрирования (RAS) утилитой rac из каталога платформы сервера:
// находит кластер по порту из строки соединения и информационную базу по имени. Нужно право "Администрирование".
// Пароль администратора кластера передается утилите rac в командной строке на сервере.
// При ошибке вызывает исключение с описанием, что случилось и что проверить.
//
// Параметры:
//  ПараметрыКластера - см. ПараметрыПодключенияККластеру
//  ИмяАдминистратора - Строка - имя администратора кластера; пустая строка, если администраторы кластера не заданы
//  ПарольАдминистратора - Строка - пароль администратора кластера
//
// Возвращаемое значение:
//  Структура:
//   * Кластер - Строка - идентификатор кластера
//   * ИнформационнаяБаза - Строка - идентификатор информационной базы в кластере
Функция ПодключениеККластеруЧерезRAS(ПараметрыКластера, ИмяАдминистратора, ПарольАдминистратора) Экспорт

	ПроверитьПравоАдминистрирования();
	ПортКластера = Формат(ПараметрыКластера.ПортКластера, "ЧГ=0");
	АдресКластера = СтрШаблон("%1:%2", ПараметрыКластера.АдресАгентаСервера, ПортКластера);

	ПортАгентаСервера = Формат(ПараметрыКластера.ПортАгентаСервера, "ЧГ=0");
	ТекстОшибкиСписка = СтрШаблон(НСтр("ru = 'Сервер администрирования кластера (RAS) %1 не выдал список кластеров.
		|Сервер администрирования - отдельная служба ras, по умолчанию на порту 1545. Проверьте, что она запущена
		|на сервере %2, например командой: ras cluster --port=1545 %2:%3'"), ПараметрыКластера.АдресСервераАдминистрирования,
		ПараметрыКластера.АдресАгентаСервера, ПортАгентаСервера);
	Кластер = "";
	Для Каждого Запись Из ЗаписиВыводаRAC(ВыводRAC(ПараметрыКластера, "cluster list", ТекстОшибкиСписка)) Цикл
		Если ЗначениеЗаписиRAC(Запись, "port") = ПортКластера Тогда
			Кластер = ЗначениеЗаписиRAC(Запись, "cluster");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Кластер) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер администрирования (RAS) %1 не знает кластера с портом %2.
			|Порт кластера взят из параметра Srvr строки соединения информационной базы; если порт там не указан,
			|используется порт по умолчанию 1541.'"), ПараметрыКластера.АдресСервераАдминистрирования, ПортКластера);
	КонецЕсли;

	ТекстОшибкиВхода = СтрШаблон(НСтр("ru = 'Не удалось войти в кластер серверов %1 через сервер администрирования (RAS).
		|Если в кластере заданы администраторы, укажите на странице ""Сеансы"" имя и пароль одного из них.
		|Если администраторов кластера нет, оставьте эти поля пустыми.'"), АдресКластера);
	АргументыКоманды = СтрШаблон("infobase summary list --cluster=%1%2", Кластер,
		АргументыАдминистратораRAC(ИмяАдминистратора, ПарольАдминистратора));
	ИмяБазы = НРег(ПараметрыКластера.ИмяИнформационнойБазы);
	ИнформационнаяБаза = "";
	Для Каждого Запись Из ЗаписиВыводаRAC(ВыводRAC(ПараметрыКластера, АргументыКоманды, ТекстОшибкиВхода)) Цикл
		Если НРег(ЗначениеЗаписиRAC(Запись, "name")) = ИмяБазы Тогда
			ИнформационнаяБаза = ЗначениеЗаписиRAC(Запись, "infobase");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ИнформационнаяБаза) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В кластере серверов %1 нет информационной базы ""%2"".
			|Имя базы взято из параметра Ref строки соединения информационной базы. Проверьте, что база
			|зарегистрирована в этом кластере под тем же именем.'"), АдресКластера, ПараметрыКластера.ИмяИнформационнойБазы);
	КонецЕсли;

	Возврат Новый Структура("Кластер, ИнформационнаяБаза", Кластер, ИнформационнаяБаза);

КонецФункции

// Завершает сеансы информационной базы через сервер администрирования (RAS), см. ПодключениеККластеруЧерезRAS.
// Нужно право "Администрирование".
//
// Параметры:
//  ПараметрыКластера - см. ПараметрыПодключенияККластеру
//  ПодключениеRAS - см. ПодключениеККластеруЧерезRAS
//  НомераСеансов - Массив из Число - номера завершаемых сеансов
//  ИмяАдминистратора - Строка - имя администратора кластера; пустая строка, если администраторы кластера не заданы
//  ПарольАдминистратора - Строка - пароль администратора кластера
//
// Возвращаемое значение:
//  Структура:
//   * КоличествоЗавершенных - Число
//   * Ошибки - Массив из Строка - описания сеансов, которые не удалось завершить
//   * НенайденныеСеансы - Массив из Число - сеансы, которых уже нет в кластере
Функция ЗавершитьСеансыЧерезRAS(ПараметрыКластера, ПодключениеRAS, НомераСеансов, ИмяАдминистратора,
	ПарольАдминистратора) Экспорт

	ПроверитьПравоАдминистрирования();
	АргументыАдминистратора = АргументыАдминистратораRAC(ИмяАдминистратора, ПарольАдминистратора);
	АргументыКоманды = СтрШаблон("session list --cluster=%1 --infobase=%2%3", ПодключениеRAS.Кластер,
		ПодключениеRAS.ИнформационнаяБаза, АргументыАдминистратора);
	ВыводСеансов = ВыводRAC(ПараметрыКластера, АргументыКоманды,
		НСтр("ru = 'Сервер администрирования (RAS) не выдал список сеансов информационной базы.'"));
	ИдентификаторыСеансов = Новый Соответствие;
	Для Каждого Запись Из ЗаписиВыводаRAC(ВыводСеансов) Цикл
		ИдентификаторыСеансов.Вставить(ЗначениеЗаписиRAC(Запись, "session-id"), ЗначениеЗаписиRAC(Запись, "session"));
	КонецЦикла;

	Результат = Новый Структура("КоличествоЗавершенных, Ошибки, НенайденныеСеансы", 0, Новый Массив, Новый Массив);
	Для Каждого НомерСеанса Из НомераСеансов Цикл
		НомерСеансаСтрокой = Формат(НомерСеанса, "ЧГ=0");
		ИдентификаторСеанса = ИдентификаторыСеансов.Получить(НомерСеансаСтрокой);
		Если ИдентификаторСеанса = Неопределено Тогда
			Результат.НенайденныеСеансы.Добавить(НомерСеанса);
			Продолжить;
		КонецЕсли;
		АргументыКоманды = СтрШаблон("session terminate --cluster=%1 --session=%2%3", ПодключениеRAS.Кластер,
			ИдентификаторСеанса, АргументыАдминистратора);
		Попытка
			ВыводRAC(ПараметрыКластера, АргументыКоманды, СтрШаблон(
				НСтр("ru = 'Сеанс %1 не завершен: кластер серверов отказал в завершении.'"), НомерСеансаСтрокой));
			Результат.КоличествоЗавершенных = Результат.КоличествоЗавершенных + 1;
		Исключение
			Результат.Ошибки.Добавить(ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает пустые данные блокировки сеансов информационной базы, которые редактирует форма блокировки сеансов.
//
// Возвращаемое значение:
//  Структура:
//   * Установлена - Булево - Истина, если блокировка включена
//   * Начало - Дата - начало действия блокировки; пустая дата - с момента установки
//   * Конец - Дата - конец действия блокировки; пустая дата - без ограничения
//   * Сообщение - Строка - текст, который увидит пользователь при попытке начать сеанс
//   * КодРазрешения - Строка - код, с которым можно начать сеанс вопреки блокировке (параметр запуска /UC)
//   * Параметр - Строка - произвольный текст, который используют конфигурации
Функция НовыеДанныеБлокировкиСеансов() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Установлена", Ложь);
	Данные.Вставить("Начало", Дата(1, 1, 1));
	Данные.Вставить("Конец", Дата(1, 1, 1));
	Данные.Вставить("Сообщение", "");
	Данные.Вставить("КодРазрешения", "");
	Данные.Вставить("Параметр", "");
	Возврат Данные;

КонецФункции

// Возвращает данные текущей блокировки сеансов информационной базы. Нужно право "Администрирование".
//
// Возвращаемое значение:
//  см. НовыеДанныеБлокировкиСеансов
Функция ДанныеБлокировкиСеансов() Экспорт

	ПроверитьПравоАдминистрирования();
	Данные = НовыеДанныеБлокировкиСеансов();
	ЗаполнитьЗначенияСвойств(Данные, ПолучитьБлокировкуСеансов());
	Возврат Данные;

КонецФункции

// Устанавливает блокировку сеансов информационной базы по данным. Нужно право "Администрирование".
//
// Параметры:
//  Данные - см. НовыеДанныеБлокировкиСеансов
Процедура УстановитьБлокировкуСеансовПоДанным(Данные) Экспорт

	ПроверитьПравоАдминистрирования();
	Блокировка = Новый БлокировкаСеансов;
	ЗаполнитьЗначенияСвойств(Блокировка, Данные);
	УстановитьБлокировкуСеансов(Блокировка);

КонецПроцедуры

// Включает или выключает монопольный режим текущего сеанса. Нужно право "Администрирование".
// Платформа не включает монопольный режим, пока с информационной базой работают другие сеансы.
//
// Параметры:
//  Включить - Булево - Истина, чтобы включить монопольный режим
//
// Возвращаемое значение:
//  Булево - Истина, если после изменения монопольный режим включен
Функция УстановитьМонопольныйРежимСеанса(Включить) Экспорт

	ПроверитьПравоАдминистрирования();
	Если МонопольныйРежим() <> Включить Тогда
		УстановитьМонопольныйРежим(Включить);
	КонецЕсли;
	Возврат МонопольныйРежим();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свойства, которые заполняются отдельно: их значения в данных и у пользователя имеют разные типы.
//
// Возвращаемое значение:
//  Строка - имена свойств через запятую
Функция ИменаСвойствСОсобымЗаполнением()

	Возврат "ЗащитаОтОпасныхДействий, РежимЗапуска, Язык, ОсновнойИнтерфейс, Роли";

КонецФункции

// Свойства пользователя, которых может не быть в текущей версии платформы.
//
// Возвращаемое значение:
//  Строка - имена свойств через запятую
Функция ИменаСвойствНовыхВерсийПлатформы()

	Возврат "АдресЭлектроннойПочты, ЗапрещеноВосстанавливатьПароль, ИмяПолитикиПаролей, АутентификацияOpenIDConnect, 
			|АутентификацияТокеномДоступа, АутентификацияЧерезЭлектроннуюПочту, АутентификацияQRКодом";

КонецФункции

// Возвращает описания нарушений политики паролей по значениям РезультатПроверкиСоответствияПароляПолитике.
// Значения перечисления получаются по имени: в версиях платформы без политик паролей его нет.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - РезультатПроверкиСоответствияПароляПолитике - нарушение политики паролей
//   * Значение - Строка - описание нарушения для пользователя
Функция ТекстыНарушенийПолитикиПаролей()

	ИменаИТексты = Новый Структура;
	ИменаИТексты.Вставить("НеСоответствуетТребованиямМинимальнойДлины", НСтр("ru = 'Пароль короче минимальной длины.'"));
	ИменаИТексты.Вставить("НеСоответствуетТребованиямСложности",
		НСтр("ru = 'Пароль не соответствует требованиям сложности.'"));
	ИменаИТексты.Вставить("НеСоответствуетТребованиямПроверкиРаскрытия",
		НСтр("ru = 'Пароль найден среди раскрытых паролей.'"));
	ИменаИТексты.Вставить("НеСоответствуетТребованиямОграниченияПовторенияСредиПоследних",
		НСтр("ru = 'Пароль совпадает с одним из последних паролей пользователя.'"));

	Тексты = Новый Соответствие;
	Для Каждого ИмяИТекст Из ИменаИТексты Цикл
		Попытка
			//@skip-check server-execution-safe-mode
			ЗначениеНарушения = Вычислить("РезультатПроверкиСоответствияПароляПолитике." + ИмяИТекст.Ключ);
		Исключение
			Продолжить;
		КонецПопытки;
		Тексты.Вставить(ЗначениеНарушения, ИмяИТекст.Значение);
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Заполняет сведения, которые пользователь без права "Администрирование" может изменить о себе:
// полное имя и язык. Пароль устанавливается отдельно.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - заполняемый пользователь
//  Данные - см. НовыеДанныеПользователяИБ
Процедура ЗаполнитьСвоиДанныеПользователяИБ(ПользовательИБ, Данные)

	ПользовательИБ.ПолноеИмя = Данные.ПолноеИмя;
	ПользовательИБ.Язык = ЯзыкПоИмени(Данные.Язык);

КонецПроцедуры

// Возвращает пользователя, сведения которого можно прочитать: с правом "Администрирование" - найденного
// пользователя, без него - пользователя текущего сеанса, если найден он сам, см. СведенияПользователяИБДляФормы.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - найденный пользователь
//
// Возвращаемое значение:
//  ПользовательИнформационнойБазы, Неопределено - Неопределено, если сведения пользователя прочитать нельзя
Функция ЧитаемыйПользовательИБ(ПользовательИБ)

	Если ЕстьПравоАдминистрированияПользователей() Тогда
		Возврат ПользовательИБ;
	КонецЕсли;
	Если ЭтоТекущийПользователь(ПользовательИБ.Имя) Тогда
		Возврат ПользователиИнформационнойБазы.ТекущийПользователь();
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Возвращает данные пользователя для строки списка пользователей, см. ДанныеПользователяИБДляСписка.
// Полное имя, язык и признак пароля берутся у найденного пользователя, как в СведенияПользователяИБДляФормы.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы - найденный пользователь
//
// Возвращаемое значение:
//  см. ДанныеПользователяИБДляСписка
Функция ДанныеСтрокиСпискаПользователяИБ(ПользовательИБ)

	ПрочитанныйПользователь = ЧитаемыйПользовательИБ(ПользовательИБ);
	Если ПрочитанныйПользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = ДанныеПользователяИБ(ПрочитанныйПользователь);
	Данные.ПолноеИмя = ПользовательИБ.ПолноеИмя;
	Данные.РежимЗапуска = ПредставлениеРежимаЗапуска(ПрочитанныйПользователь.РежимЗапуска);
	Данные.Язык = ПредставлениеОбъектаМетаданных(ПользовательИБ.Язык);
	Данные.ОсновнойИнтерфейс = ПредставлениеОбъектаМетаданных(ПрочитанныйПользователь.ОсновнойИнтерфейс);

	ИменаРолей = Новый СписокЗначений;
	ИменаРолей.ЗагрузитьЗначения(Данные.Роли);
	ИменаРолей.СортироватьПоЗначению();
	Данные.Вставить("ИменаРолей", СтрСоединить(ИменаРолей.ВыгрузитьЗначения(), ", "));
	Данные.Удалить("Роли");

	Данные.Вставить("Идентификатор", ПрочитанныйПользователь.УникальныйИдентификатор);
	Данные.Вставить("ЭтоТекущийПользователь", ЭтоТекущийПользователь(ПользовательИБ.Имя));
	Данные.Вставить("ПарольУстановлен", ПользовательИБ.ПарольУстановлен);
	Возврат Данные;

КонецФункции

Функция ЯзыкПоИмени(ИмяЯзыка)

	Возврат ?(ПустаяСтрока(ИмяЯзыка), Неопределено, Метаданные.Языки.Найти(ИмяЯзыка));

КонецФункции

Функция ИмяОбъектаМетаданных(ОбъектМетаданных)

	Возврат ?(ОбъектМетаданных = Неопределено, "", ОбъектМетаданных.Имя);

КонецФункции

Функция ПредставлениеОбъектаМетаданных(ОбъектМетаданных)

	Возврат ?(ОбъектМетаданных = Неопределено, "", ОбъектМетаданных.Представление());

КонецФункции

Функция ИмяРежимаЗапуска(РежимЗапуска)

	Если РежимЗапуска = РежимЗапускаКлиентскогоПриложения.ОбычноеПриложение Тогда
		Возврат "ОбычноеПриложение";
	КонецЕсли;
	Если РежимЗапуска = РежимЗапускаКлиентскогоПриложения.УправляемоеПриложение Тогда
		Возврат "УправляемоеПриложение";
	КонецЕсли;
	Возврат "Авто";

КонецФункции

Функция ПредставлениеРежимаЗапуска(РежимЗапуска)

	Если РежимЗапуска = РежимЗапускаКлиентскогоПриложения.ОбычноеПриложение Тогда
		Возврат НСтр("ru = 'Обычное приложение'");
	КонецЕсли;
	Если РежимЗапуска = РежимЗапускаКлиентскогоПриложения.УправляемоеПриложение Тогда
		Возврат НСтр("ru = 'Управляемое приложение'");
	КонецЕсли;
	Возврат НСтр("ru = 'Авто'");

КонецФункции

Функция РежимЗапускаПоИмени(ИмяРежима)

	Если ИмяРежима = "ОбычноеПриложение" Тогда
		Возврат РежимЗапускаКлиентскогоПриложения.ОбычноеПриложение;
	КонецЕсли;
	Если ИмяРежима = "УправляемоеПриложение" Тогда
		Возврат РежимЗапускаКлиентскогоПриложения.УправляемоеПриложение;
	КонецЕсли;
	Возврат РежимЗапускаКлиентскогоПриложения.Авто;

КонецФункции

Функция ИмяПользователяСеанса(ПользовательИБ)

	Возврат ?(ПользовательИБ = Неопределено, "", ПользовательИБ.Имя);

КонецФункции

// Добавляет в данные сеанса свойства фонового задания, которое выполняет сеанс, см. ДанныеСеансовИБ.
//
// Параметры:
//  Данные - Структура - данные сеанса
//  ФоновоеЗадание - ФоновоеЗадание, Неопределено - задание сеанса; Неопределено, если сеанс не фоновый
Процедура ДобавитьДанныеФоновогоЗадания(Данные, ФоновоеЗадание)

	Если ФоновоеЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные.Вставить("ФоновоеЗаданиеНаименование", ФоновоеЗадание.Наименование);
	Данные.Вставить("ФоновоеЗаданиеИмяМетода", ФоновоеЗадание.ИмяМетода);
	Данные.Вставить("ФоновоеЗаданиеКлюч", ФоновоеЗадание.Ключ);
	Данные.Вставить("ФоновоеЗаданиеСостояние", Строка(ФоновоеЗадание.Состояние));
	Данные.Вставить("ФоновоеЗаданиеНачало", ФоновоеЗадание.Начало);
	Данные.Вставить("ФоновоеЗаданиеКонец", ФоновоеЗадание.Конец);
	Данные.Вставить("ФоновоеЗаданиеРегламентноеЗадание", Строка(ФоновоеЗадание.РегламентноеЗадание));
	Данные.Вставить("ФоновоеЗаданиеРасположение", ФоновоеЗадание.Расположение);
	Данные.Вставить("ФоновоеЗаданиеИдентификатор", Строка(ФоновоеЗадание.УникальныйИдентификатор));

КонецПроцедуры

// Возвращает имя COM-соединителя версии платформы, например "V83.COMConnector" или "V85.COMConnector".
//
// Параметры:
//  ВерсияПлатформы - Строка - версия платформы, например "8.3.27.2130"
//
// Возвращаемое значение:
//  Строка - имя COM-соединителя
Функция ИмяCOMСоединителя(ВерсияПлатформы)

	НомераВерсии = СтрРазделить(ВерсияПлатформы, ".");
	Возврат СтрШаблон("V%1%2.COMConnector", НомераВерсии[0], НомераВерсии[1]);

КонецФункции

// Возвращает значение параметра строки соединения информационной базы без кавычек.
//
// Параметры:
//  СтрокаСоединения - Строка - строка соединения, например Srvr="server";Ref="base";
//  ИмяПараметра - Строка - имя параметра, например Srvr
//
// Возвращаемое значение:
//  Строка - значение параметра; пустая строка, если параметра нет
Функция ЗначениеПараметраСтрокиСоединения(СтрокаСоединения, ИмяПараметра)

	Префикс = ВРег(ИмяПараметра) + "=";
	Для Каждого ЧастьСтроки Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
		ПараметрИЗначение = СокрЛП(ЧастьСтроки);
		Если СтрНачинаетсяС(ВРег(ПараметрИЗначение), Префикс) Тогда
			Возврат СтрЗаменить(Сред(ПараметрИЗначение, СтрДлина(Префикс) + 1), """", "");
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ПроверитьПравоАдминистрирования()

	Если Не ЕстьПравоАдминистрированияПользователей() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав: для работы с сеансами информационной базы нужно право ""Администрирование"".'");
	КонецЕсли;

КонецПроцедуры

// Выполняет утилиту rac из каталога платформы сервера с адресом сервера администрирования из параметров кластера.
// Если rac завершилась с ошибкой, вызывает исключение: переданный текст ошибки и вывод rac.
//
// Параметры:
//  ПараметрыКластера - см. ПараметрыПодключенияККластеру
//  АргументыКоманды - Строка - режим, команда и параметры rac, например "cluster list"
//  ТекстОшибки - Строка - описание ошибки для пользователя, если rac завершилась с ошибкой
//
// Возвращаемое значение:
//  Строка - вывод rac
Функция ВыводRAC(ПараметрыКластера, АргументыКоманды, ТекстОшибки)

	ИмяИсполняемогоФайла = ?(УИ_ОбщегоНазначенияКлиентСервер.ЭтоWindows(), "rac.exe", "rac");
	КаталогПлатформы = КаталогПрограммы();
	ИмяФайлаRAC = УИ_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогПлатформы, ИмяИсполняемогоФайла);
	ФайлRAC = Новый Файл(ИмяФайлаRAC);
	Если Не ФайлRAC.Существует() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'На сервере 1С:Предприятия не найдена утилита администрирования rac: %1.
			|Она входит в состав платформы сервера.'"), ИмяФайлаRAC);
	КонецЕсли;

	СтрокаКоманды = СтрШаблон("""%1"" %2 %3", ИмяФайлаRAC, ПараметрыКластера.АдресСервераАдминистрирования,
		АргументыКоманды);
	РезультатКоманды = УИ_ОбщегоНазначения.РезультатВыполненияКомандыСистемыУпрощенно(СтрокаКоманды);
	Если РезультатКоманды.КодВозврата <> 0 Тогда
		ВыводОшибки = СокрЛП(РезультатКоманды.ВыводКоманды);
		ВызватьИсключение СтрШаблон(НСтр("ru = '%1
			|Техническая информация (rac, код возврата %2): %3'"), ТекстОшибки, РезультатКоманды.КодВозврата, ВыводОшибки);
	КонецЕсли;
	Возврат РезультатКоманды.ВыводКоманды;

КонецФункции

// Разбирает вывод rac: записи разделены пустыми строками, в каждой строке "имя : значение".
// Дефис в именах свойств заменяется подчеркиванием, чтобы имя было ключом структуры: session-id - session_id.
// Строки, которые не похожи на свойство, заканчивают текущую запись.
//
// Параметры:
//  ВыводКоманды - Строка - вывод rac
//
// Возвращаемое значение:
//  Массив из Структура - записи вывода: ключ - имя свойства, значение - строка без кавычек
Функция ЗаписиВыводаRAC(ВыводКоманды)

	Записи = Новый Массив;
	Запись = Неопределено;
	Для Каждого СтрокаВывода Из СтрРазделить(ВыводКоманды, Символы.ПС, Истина) Цикл
		ТекущаяСтрока = СокрЛП(СтрокаВывода);
		ПозицияРазделителя = СтрНайти(ТекущаяСтрока, ":");
		ИмяСвойства = "";
		Если ПозицияРазделителя > 0 Тогда
			ИмяСвойства = СтрЗаменить(СокрЛП(Лев(ТекущаяСтрока, ПозицияРазделителя - 1)), "-", "_");
		КонецЕсли;
		Если Не ЭтоИмяСвойстваRAC(ИмяСвойства) Тогда
			Запись = Неопределено;
			Продолжить;
		КонецЕсли;
		Если Запись = Неопределено Тогда
			Запись = Новый Структура;
			Записи.Добавить(Запись);
		КонецЕсли;
		Значение = СокрЛП(Сред(ТекущаяСтрока, ПозицияРазделителя + 1));
		Кавычка = """";
		Если СтрДлина(Значение) > СтрДлина(Кавычка) И СтрНачинаетсяС(Значение, Кавычка)
			И СтрЗаканчиваетсяНа(Значение, Кавычка) Тогда
			Значение = Сред(Значение, СтрДлина(Кавычка) + 1);
			Значение = Лев(Значение, СтрДлина(Значение) - СтрДлина(Кавычка));
		КонецЕсли;
		Запись.Вставить(ИмяСвойства, Значение);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Возвращает значение свойства записи вывода rac, см. ЗаписиВыводаRAC.
//
// Параметры:
//  Запись - Структура - запись вывода rac
//  ИмяСвойства - Строка - имя свойства, как его выводит rac, например "session-id"
//
// Возвращаемое значение:
//  Строка - значение свойства; пустая строка, если свойства в записи нет
Функция ЗначениеЗаписиRAC(Запись, ИмяСвойства)

	Значение = "";
	Если Запись.Свойство(СтрЗаменить(ИмяСвойства, "-", "_"), Значение) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращает признак того, что строка годится как имя свойства записи вывода rac и ключ структуры:
// латинские строчные буквы, цифры и подчеркивание, первый символ - буква.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства с дефисами, замененными подчеркиванием
//
// Возвращаемое значение:
//  Булево - Истина, если это имя свойства
Функция ЭтоИмяСвойстваRAC(ИмяСвойства)

	Если ПустаяСтрока(ИмяСвойства) Или СтрНайти("0123456789_", Лев(ИмяСвойства, 1)) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyz0123456789_";
	Для НомерСимвола = 1 По СтрДлина(ИмяСвойства) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(ИмяСвойства, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Возвращает параметры аутентификации администратора кластера для rac; пустую строку, если имя не указано.
//
// Параметры:
//  ИмяАдминистратора - Строка
//  ПарольАдминистратора - Строка
//
// Возвращаемое значение:
//  Строка - параметры с пробелом в начале
Функция АргументыАдминистратораRAC(ИмяАдминистратора, ПарольАдминистратора)

	Если ПустаяСтрока(ИмяАдминистратора) Тогда
		Возврат "";
	КонецЕсли;
	ИмяДляКоманды = ЗначениеАргументаRAC(ИмяАдминистратора);
	ПарольДляКоманды = ЗначениеАргументаRAC(ПарольАдминистратора);
	Возврат СтрШаблон(" --cluster-user=%1 --cluster-pwd=%2", ИмяДляКоманды, ПарольДляКоманды);

КонецФункции

// Возвращает значение параметра командной строки rac в кавычках. Команда выполняется из командного файла:
// в Windows знак процента удваивается, в Linux значение берется в одинарные кавычки.
//
// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Строка - значение для командной строки
Функция ЗначениеАргументаRAC(Значение)

	Если Не УИ_ОбщегоНазначенияКлиентСервер.ЭтоWindows() Тогда
		Возврат "'" + СтрЗаменить(Значение, "'", "'\''") + "'";
	КонецЕсли;
	Если СтрНайти(Значение, """") > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Имя или пароль администратора кластера содержит двойную кавычку: на сервере Windows
			|такое значение нельзя передать утилите rac.'");
	КонецЕсли;
	Возврат """" + СтрЗаменить(Значение, "%", "%%") + """";

КонецФункции

#КонецОбласти
