////////////////////////////////////////////////////////////////////////////////
// Разбор контейнера пакета справки 1С (*.hbk) и распаковка zip-записей.
// Разбор контейнера выполняется в памяти, без временных файлов.
//

#Область ПрограммныйИнтерфейс

// Разбирает контейнер пакета справки на сущности.
// Все операции чтения контейнера выполняются в памяти.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое файла пакета справки (*.hbk).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - имя сущности -> ДвоичныеДанные - тело сущности.
//
Функция РаспаковатьПакет(Знач Данные) Экспорт
	
	РазмерФайла = ПроверитьДанныеПакета(Данные);
	
	Заголовок = СтрокаБайтов(Данные, 0, 64);
	РазмерТаблицы = ЧислоИзHex(Заголовок, 18);
	СмещениеТаблицы = 47;
	
	Если РазмерТаблицы <= 0 Или РазмерТаблицы % 12 <> 0
		Или СмещениеТаблицы + РазмерТаблицы > РазмерФайла Тогда
		ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: некорректный размер таблицы сущностей.'");
	КонецЕсли;
	
	Таблица = СтрокаБайтов(Данные, СмещениеТаблицы, РазмерТаблицы);
	КоличествоЗаписей = РазмерТаблицы / 12;
	Сущности = Новый Соответствие;
	
	Для Индекс = 0 По КоличествоЗаписей - 1 Цикл
		
		СмещениеЗаписи = Индекс * 12;
		АдресЗаголовка = Целое32(Таблица, СмещениеЗаписи);
		АдресТела = Целое32(Таблица, СмещениеЗаписи + 4);
		Признак = Целое32(Таблица, СмещениеЗаписи + 8);
		
		Если Признак <> 2147483647 Тогда
			ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: некорректная запись таблицы сущностей.'");
		КонецЕсли;
		
		Если АдресЗаголовка + 51 > РазмерФайла Или АдресТела + 31 > РазмерФайла Тогда
			ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: адрес сущности за пределами файла.'");
		КонецЕсли;
		
		ДлинаИмени = ЧислоИзHex(СтрокаБайтов(Данные, АдресЗаголовка, 11), 2);
		Если ДлинаИмени < 24 Или АдресЗаголовка + 51 + ДлинаИмени - 24 > РазмерФайла Тогда
			ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: некорректная длина имени сущности.'");
		КонецЕсли;
		
		Имя = ПолучитьСтрокуИзДвоичныхДанных(
			ПрочитатьФрагмент(Данные, АдресЗаголовка + 51, ДлинаИмени - 24), "UTF-16LE");
		
		ДлинаТела = ЧислоИзHex(СтрокаБайтов(Данные, АдресТела, 11), 2);
		Если АдресТела + 31 + ДлинаТела > РазмерФайла Тогда
			ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: тело сущности за пределами файла.'");
		КонецЕсли;
		
		Сущности.Вставить(Имя, ПрочитатьФрагмент(Данные, АдресТела + 31, ДлинаТела));
		
	КонецЦикла;
	
	Возврат Сущности;
	
КонецФункции

// Распаковывает одну локальную запись zip-архива (например, сущность PackBlock).
// Для распаковки запись дополняется центральным каталогом в памяти, а распакованные
// данные читаются платформенным ридером через один временный файл.
//
// Параметры:
//  Запись - ДвоичныеДанные - локальная запись архива, начинающаяся с сигнатуры 50 4B 03 04.
//
// Возвращаемое значение:
//  ДвоичныеДанные - распакованное содержимое записи.
//
Функция РаспаковатьЗапись(Знач Запись) Экспорт
	
	РазмерЗаписи = ПроверитьДанныеЗаписи(Запись);
	
	#Если ВебКлиент Или МобильныйКлиент Тогда
		ВызватьИсключение НСтр("ru = 'Распаковка записей архива не поддерживается в веб-клиенте и мобильном клиенте.'");
	#КонецЕсли
	
	Шапка = СтрокаБайтов(Запись, 0, 30);
	ДлинаИмени = Целое16(Шапка, 26);
	ДлинаДополнения = Целое16(Шапка, 28);
	РазмерСжатыхДанных = Целое32(Шапка, 18);
	
	РазмерЛокальнойЗаписи = 30 + ДлинаИмени + ДлинаДополнения + РазмерСжатыхДанных;
	Если РазмерЛокальнойЗаписи > РазмерЗаписи Тогда
		ВызватьИсключение НСтр("ru = 'Запись архива повреждена: размер записи превышает доступные данные.'");
	КонецЕсли;
	
	ШапкаHex = HexСтрокаБайтов(Запись, 0, 30);
	ИмяHex = HexСтрокаБайтов(Запись, 30, ДлинаИмени);
	ДанныеКаталога = ПолучитьДвоичныеДанныеИзHexСтроки(
		ЗаголовокКаталогаHex(ШапкаHex, ИмяHex, ДлинаИмени) + КонецКаталогаHex(ДлинаИмени, РазмерЛокальнойЗаписи));
	
	Поток = Новый ПотокВПамяти;
	ЗаписатьФрагмент(Запись, Поток, 0, РазмерЛокальнойЗаписи);
	ЗаписатьФрагмент(ДанныеКаталога, Поток, 0, ДанныеКаталога.Размер());
	ДанныеАрхива = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
	Возврат РаспаковатьАрхив(ДанныеАрхива);
	
КонецФункции

// Распаковывает одну локальную запись zip-архива и возвращает её содержимое как текст UTF-8.
//
// Параметры:
//  Запись - ДвоичныеДанные - локальная запись архива, начинающаяся с сигнатуры 50 4B 03 04.
//
// Возвращаемое значение:
//  Строка - распакованный текст.
//
Функция ТекстЗаписи(Знач Запись) Экспорт
	
	Возврат ПолучитьСтрокуИзДвоичныхДанных(РаспаковатьЗапись(Запись), "UTF-8");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что переданы двоичные данные пакета справки достаточного размера.
//
// Параметры:
//  Данные - ДвоичныеДанные - проверяемые данные.
//
// Возвращаемое значение:
//  Число - размер данных в байтах.
//
Функция ПроверитьДанныеПакета(Знач Данные)
	
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидались двоичные данные пакета справки.'");
	КонецЕсли;
	
	Размер = Данные.Размер();
	Если Размер < 64 Тогда
		ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: размер файла меньше заголовка.'");
	КонецЕсли;
	
	Возврат Размер;
	
КонецФункции

// Проверяет, что передана локальная запись zip-архива.
//
// Параметры:
//  Запись - ДвоичныеДанные - проверяемые данные.
//
// Возвращаемое значение:
//  Число - размер записи в байтах.
//
Функция ПроверитьДанныеЗаписи(Знач Запись)
	
	Если ТипЗнч(Запись) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидались двоичные данные записи архива.'");
	КонецЕсли;
	
	Размер = Запись.Размер();
	Если Размер < 30 Тогда
		ВызватьИсключение НСтр("ru = 'Запись архива повреждена: размер меньше локального заголовка.'");
	КонецЕсли;
	
	Если HexСтрокаБайтов(Запись, 0, 4) <> "504B0304" Тогда
		ВызватьИсключение НСтр("ru = 'Ожидалась локальная запись zip-архива.'");
	КонецЕсли;
	
	Возврат Размер;
	
КонецФункции

// Извлекает единственный элемент собранного архива и возвращает его как двоичные данные.
//
// Параметры:
//  ДанныеАрхива - ДвоичныеДанные - архив, содержащий одну локальную запись и центральный каталог.
//
// Возвращаемое значение:
//  ДвоичныеДанные - распакованное содержимое записи.
//
Функция РаспаковатьАрхив(Знач ДанныеАрхива)
	
	#Если ВебКлиент Или МобильныйКлиент Тогда
		ВызватьИсключение НСтр("ru = 'Распаковка записей архива не поддерживается в веб-клиенте и мобильном клиенте.'");
		Возврат Неопределено;
	#Иначе
		
		Каталог = КаталогИзвлечения();
		СоздатьКаталог(Каталог);
		
		Поток = ДанныеАрхива.ОткрытьПотокДляЧтения();
		ЧтениеZip = Новый ЧтениеZipФайла(Поток);
		Элементы = ЧтениеZip.Элементы;
		
		Если Элементы.Количество() <> 1 Тогда
			ЧтениеZip.Закрыть();
			УдалитьФайлы(Каталог);
			ВызватьИсключение НСтр("ru = 'Не удалось прочитать запись архива.'");
		КонецЕсли;
		
		ЧтениеZip.Извлечь(Элементы[0], Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		ЧтениеZip.Закрыть();
		
		Файлы = НайтиФайлы(Каталог, "*", Ложь);
		Если Файлы.Количество() <> 1 Тогда
			УдалитьФайлы(Каталог);
			ВызватьИсключение НСтр("ru = 'Не удалось извлечь запись архива.'");
		КонецЕсли;
		
		Результат = Новый ДвоичныеДанные(Файлы[0].ПолноеИмя);
		УдалитьФайлы(Каталог);
		
		Возврат Результат;
		
	#КонецЕсли
	
КонецФункции

// Возвращает путь к новому временному каталогу для извлечения записи архива.
//
// Возвращаемое значение:
//  Строка - полный путь к каталогу.
//
Функция КаталогИзвлечения()
	
	Возврат КаталогВременныхФайлов() + ПолучитьРазделительПути()
		+ "УИ_ПакетСправки_" + Строка(Новый УникальныйИдентификатор());
	
КонецФункции

// Читает фрагмент двоичных данных по смещению.
//
// Параметры:
//  Данные - ДвоичныеДанные - источник данных.
//  Смещение - Число - смещение фрагмента в байтах от начала данных.
//  Длина - Число - длина фрагмента в байтах.
//
// Возвращаемое значение:
//  ДвоичныеДанные - прочитанный фрагмент.
//
Функция ПрочитатьФрагмент(Знач Данные, Знач Смещение, Знач Длина)
	
	Если Длина <= 0 Тогда
		Возврат ПолучитьДвоичныеДанныеИзСтроки("");
	КонецЕсли;
	
	Поток = Новый ПотокВПамяти;
	ЗаписатьФрагмент(Данные, Поток, Смещение, Длина);
	
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
КонецФункции

// Записывает фрагмент двоичных данных в поток.
//
// Параметры:
//  Данные - ДвоичныеДанные - источник данных.
//  Поток - Поток - поток, в который записывается фрагмент.
//  Смещение - Число - смещение фрагмента в байтах от начала данных.
//  Длина - Число - длина фрагмента в байтах.
//
Процедура ЗаписатьФрагмент(Знач Данные, Знач Поток, Знач Смещение, Знач Длина)
	
	Если Длина <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПотокЧтения = Данные.ОткрытьПотокДляЧтения();
	ПотокЧтения.Перейти(Смещение, ПозицияВПотоке.Начало);
	ПотокЧтения.КопироватьВ(Поток, Длина);
	ПотокЧтения.Закрыть();
	
КонецПроцедуры

// Возвращает байты фрагмента данных как строку, в которой один символ соответствует одному байту.
//
// Параметры:
//  Данные - ДвоичныеДанные - источник данных.
//  Смещение - Число - смещение фрагмента в байтах от начала данных.
//  Длина - Число - длина фрагмента в байтах.
//
// Возвращаемое значение:
//  Строка - символы с кодами 0..255.
//
Функция СтрокаБайтов(Знач Данные, Знач Смещение, Знач Длина)
	
	Возврат ПолучитьСтрокуИзДвоичныхДанных(ПрочитатьФрагмент(Данные, Смещение, Длина), "ISO-8859-1");
	
КонецФункции

// Возвращает фрагмент данных в виде строки шестнадцатеричных цифр.
//
// Параметры:
//  Данные - ДвоичныеДанные - источник данных.
//  Смещение - Число - смещение фрагмента в байтах от начала данных.
//  Длина - Число - длина фрагмента в байтах.
//
// Возвращаемое значение:
//  Строка - шестнадцатеричное представление фрагмента.
//
Функция HexСтрокаБайтов(Знач Данные, Знач Смещение, Знач Длина)
	
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(ПрочитатьФрагмент(Данные, Смещение, Длина));
	
КонецФункции

// Читает число из восьми шестнадцатеричных символов строки.
//
// Параметры:
//  Строка - Строка - строка, содержащая шестнадцатеричные символы.
//  Позиция - Число - позиция первого символа числа в строке, начиная с нуля.
//
// Возвращаемое значение:
//  Число - прочитанное число.
//
Функция ЧислоИзHex(Знач Строка, Знач Позиция)
	
	Если СтрДлина(Строка) < Позиция + 8 Тогда
		ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: недостаточно данных для чтения шестнадцатеричного числа.'");
	КонецЕсли;
	
	Результат = 0;
	Для Индекс = Позиция + 1 По Позиция + 8 Цикл
		Результат = Результат * 16 + ЗначениеHexСимвола(Сред(Строка, Индекс, 1));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает числовое значение шестнадцатеричного символа.
//
// Параметры:
//  Символ - Строка - один шестнадцатеричный символ.
//
// Возвращаемое значение:
//  Число - значение символа от 0 до 15.
//
Функция ЗначениеHexСимвола(Знач Символ)
	
	Код = КодСимвола(Символ);
	КодНоль = КодСимвола("0");
	КодБольшаяА = КодСимвола("A");
	КодМалаяА = КодСимвола("a");
	
	Если Код >= КодНоль И Код <= КодНоль + 9 Тогда
		Возврат Код - КодНоль;
	КонецЕсли;
	
	Если Код >= КодБольшаяА И Код <= КодБольшаяА + 5 Тогда
		Возврат Код - КодБольшаяА + 10;
	КонецЕсли;
	
	Если Код >= КодМалаяА И Код <= КодМалаяА + 5 Тогда
		Возврат Код - КодМалаяА + 10;
	КонецЕсли;
	
	ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: ожидалась шестнадцатеричная цифра.'");
	
КонецФункции

// Читает двухбайтовое целое число (little-endian) из строки байтов.
//
// Параметры:
//  Строка - Строка - строка байтов, полученная функцией СтрокаБайтов.
//  Позиция - Число - позиция первого байта числа, начиная с нуля.
//
// Возвращаемое значение:
//  Число - прочитанное число.
//
Функция Целое16(Знач Строка, Знач Позиция)
	
	Если СтрДлина(Строка) < Позиция + 2 Тогда
		ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: недостаточно данных для чтения числа.'");
	КонецЕсли;
	
	Возврат КодСимвола(Строка, Позиция + 1) + КодСимвола(Строка, Позиция + 2) * 256;
	
КонецФункции

// Читает четырехбайтовое целое число (little-endian) из строки байтов.
//
// Параметры:
//  Строка - Строка - строка байтов, полученная функцией СтрокаБайтов.
//  Позиция - Число - позиция первого байта числа, начиная с нуля.
//
// Возвращаемое значение:
//  Число - прочитанное число.
//
Функция Целое32(Знач Строка, Знач Позиция)
	
	Если СтрДлина(Строка) < Позиция + 4 Тогда
		ВызватьИсключение НСтр("ru = 'Пакет справки поврежден: недостаточно данных для чтения числа.'");
	КонецЕсли;
	
	Возврат КодСимвола(Строка, Позиция + 1)
		+ КодСимвола(Строка, Позиция + 2) * 256
		+ КодСимвола(Строка, Позиция + 3) * 65536
		+ КодСимвола(Строка, Позиция + 4) * 16777216;
	
КонецФункции

// Представляет число строкой шестнадцатеричных цифр (little-endian).
//
// Параметры:
//  Число - Число - неотрицательное число.
//  Байт - Число - количество байтов в представлении.
//
// Возвращаемое значение:
//  Строка - шестнадцатеричное представление числа.
//
Функция HexИзЦелого(Знач Число, Знач Байт)
	
	Цифры = "0123456789ABCDEF";
	Результат = "";
	Остаток = Число;
	
	Для Индекс = 1 По Байт Цикл
		ЗначениеБайта = Остаток % 256;
		Остаток = (Остаток - ЗначениеБайта) / 256;
		Результат = Результат
			+ Сред(Цифры, Цел(ЗначениеБайта / 16) + 1, 1)
			+ Сред(Цифры, ЗначениеБайта % 16 + 1, 1);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Собирает заголовок центрального каталога zip для одной локальной записи.
//
// Параметры:
//  ШапкаHex - Строка - локальный заголовок записи (30 байтов) в виде шестнадцатеричной строки.
//  ИмяHex - Строка - имя файла из локального заголовка в виде шестнадцатеричной строки.
//  ДлинаИмени - Число - длина имени файла в локальном заголовке.
//
// Возвращаемое значение:
//  Строка - заголовок центрального каталога в виде шестнадцатеричной строки.
//
Функция ЗаголовокКаталогаHex(Знач ШапкаHex, Знач ИмяHex, Знач ДлинаИмени)
	
	Возврат "504B0102"
		+ Сред(ШапкаHex, 9, 4)
		+ Сред(ШапкаHex, 9, 4)
		+ Сред(ШапкаHex, 13, 4)
		+ Сред(ШапкаHex, 17, 4)
		+ Сред(ШапкаHex, 21, 4)
		+ Сред(ШапкаHex, 25, 4)
		+ Сред(ШапкаHex, 29, 8)
		+ Сред(ШапкаHex, 37, 8)
		+ Сред(ШапкаHex, 45, 8)
		+ Сред(ШапкаHex, 53, 4)
		+ "0000"
		+ "0000"
		+ "0000"
		+ "0000"
		+ "00000000"
		+ "00000000"
		+ Сред(ИмяHex, 1, ДлинаИмени * 2);
	
КонецФункции

// Собирает признак конца центрального каталога zip для одной записи.
//
// Параметры:
//  ДлинаИмени - Число - длина имени файла в локальном заголовке.
//  РазмерЛокальнойЗаписи - Число - полный размер локальной записи в байтах.
//
// Возвращаемое значение:
//  Строка - признак конца центрального каталога в виде шестнадцатеричной строки.
//
Функция КонецКаталогаHex(Знач ДлинаИмени, Знач РазмерЛокальнойЗаписи)
	
	Возврат "504B0506"
		+ "0000"
		+ "0000"
		+ "0100"
		+ "0100"
		+ HexИзЦелого(46 + ДлинаИмени, 4)
		+ HexИзЦелого(РазмерЛокальнойЗаписи, 4)
		+ "0000";
	
КонецФункции

#КонецОбласти
