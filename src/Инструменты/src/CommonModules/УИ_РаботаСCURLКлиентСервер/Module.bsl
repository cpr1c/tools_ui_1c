Функция ОбработатьПеренаправлениеШелл(ТокеныКоманды)

	Результат = Новый Структура;
	ТокеныБезПеренаправления = Новый Массив;
	Перенаправления = Новый Массив;
	ОператорыПеренаправленияШелл = ОператорыПеренаправленияШелл();
	КоличествоТокенов = ТокеныКоманды.Количество();
	Счетчик = 0;
	ДваТокена = 2;
	Пока Счетчик < КоличествоТокенов Цикл
		Токен = ТокеныКоманды[Счетчик];

		Если ОператорыПеренаправленияШелл.Найти(Токен) <> Неопределено Тогда
			ЦельПеренаправления = ?(Счетчик + 1 < КоличествоТокенов, ТокеныКоманды[Счетчик + 1], Неопределено);
			ОписаниеПеренаправления = НовоеПеренаправлениеШелл(Токен, ЦельПеренаправления);
			Перенаправления.Добавить(ОписаниеПеренаправления);
			Счетчик = Счетчик + ДваТокена;
			Продолжить;
		КонецЕсли;

		ОператорНайден = Ложь;
		Для Каждого Оператор Из ОператорыПеренаправленияШелл Цикл
			Если СтрНачинаетсяС(Токен, Оператор) Тогда
				ЦельПеренаправления = Прав(Токен, СтрДлина(Токен) - СтрДлина(Оператор));
				ОписаниеПеренаправления = НовоеПеренаправлениеШелл(Оператор, ЦельПеренаправления);
				ОператорНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ОператорНайден Тогда
			Счетчик = Счетчик + 1;
			Продолжить;
		КонецЕсли;

		ТокеныБезПеренаправления.Добавить(Токен);
		Счетчик = Счетчик + 1;

	КонецЦикла;
	Результат.Вставить("Перенаправления", Перенаправления);
	Результат.Вставить("ТокеныБезПеренаправления", ТокеныБезПеренаправления);
	Возврат Результат;

КонецФункции

Функция НовоеПеренаправлениеШелл(Операция, ЦельПеренаправления)
	ОписаниеПеренаправления = Новый Структура("Операция, ЦельПеренаправления", Операция, ЦельПеренаправления);
