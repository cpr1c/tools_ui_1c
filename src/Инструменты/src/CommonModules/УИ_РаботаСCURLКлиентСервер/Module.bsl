Функция ОбработатьФорму(ЗначениеПараметра)

	КлючИЗначение = РазделитьСтроку(ЗначениеПараметра, "=", 1);
	
	ОписаниеФормы = Новый Структура("Имя", КлючИЗначение[0]);
	Значение = ?(КлючИЗначение.Количество() > 1, КлючИЗначение[1], Неопределено);
	ОписаниеФормы.Вставить("Значение", Значение);
	Возврат ОписаниеФормы;
	
КонецФункции

Функция РазделитьСтроку(Знач СтрокаПоиска, Знач Разделитель, Знач МаксимальноеКоличествоДелений)

	Результат = Новый Массив;
	ПозицияРазделителя = СтрНайти(СтрокаПоиска, Разделитель);
	Пока ПозицияРазделителя > 0 И МаксимальноеКоличествоДелений > 0 Цикл
		Результат.Добавить(Лев(СтрокаПоиска, ПозицияРазделителя - 1));
		МаксимальноеКоличествоДелений = МаксимальноеКоличествоДелений - 1;
		СтрокаПоиска = Сред(СтрокаПоиска, ПозицияРазделителя + 1);
		ПозицияРазделителя = СтрНайти(СтрокаПоиска, Разделитель);
	КонецЦикла;
	Если ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Результат.Добавить(СтрокаПоиска);
	КонецЕсли;
	Возврат Результат;

КонецФункции

