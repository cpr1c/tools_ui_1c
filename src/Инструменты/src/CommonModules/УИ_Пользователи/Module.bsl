#Область ПрограммныйИнтерфейс

// Проверяет, есть ли у текущего или указанного пользователя информационной базы полные права.
//
// Полноправным считается пользователь с правом «Администрирование данных», а если
// ПроверятьПраваАдминистрированияСистемы = Истина, то еще и с правом «Администрирование».
// Если список пользователей информационной базы пуст, текущий пользователь полноправный.
//
// Параметры:
//  Пользователь - Неопределено - проверяется текущий пользователь информационной базы.
//               - ПользовательИнформационнойБазы - проверяется указанный пользователь.
//               - УникальныйИдентификатор - идентификатор пользователя информационной базы.
//               - Строка - имя пользователя информационной базы.
//  ПроверятьПраваАдминистрированияСистемы - Булево - дополнительно проверить право «Администрирование».
//  УчитыватьПривилегированныйРежим - Булево - для текущего пользователя вернуть Истина,
//                 если установлен привилегированный режим.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь полноправный; Ложь, если нет или пользователь информационной базы не найден.
Функция ЭтоПолноправныйПользователь(Пользователь = Неопределено, ПроверятьПраваАдминистрированияСистемы = Ложь,
	УчитыватьПривилегированныйРежим = Истина) Экспорт

	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	ПроверяемыйПользовательИБ = ПроверяемыйПользовательИнформационнойБазы(Пользователь, ТекущийПользовательИБ);
	Если ПроверяемыйПользовательИБ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПроверяемыйПользовательИБ.УникальныйИдентификатор = ТекущийПользовательИБ.УникальныйИдентификатор Тогда
		Если УчитыватьПривилегированныйРежим И ПривилегированныйРежим() Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат ПравоДоступа("АдминистрированиеДанных", Метаданные)
			И (Не ПроверятьПраваАдминистрированияСистемы Или ПравоДоступа("Администрирование", Метаданные));
	КонецЕсли;

	Возврат ПравоДоступа("АдминистрированиеДанных", Метаданные, ПроверяемыйПользовательИБ)
		И (Не ПроверятьПраваАдминистрированияСистемы
			Или ПравоДоступа("Администрирование", Метаданные, ПроверяемыйПользовательИБ));

КонецФункции

// Генерирует пароль по именованной политике пользователя или по параметрам информационной базы.
//
// Параметры:
//  ИмяПользователя - Строка - имя пользователя ИБ.
// Возвращаемое значение:
//  Строка - новый пароль.
Функция НовыйПарольПоПолитикеПользователя(ИмяПользователя) Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь информационной базы не найден.'");
	КонецЕсли;

	Свойства = Новый Структура("ИмяПолитикиПаролей");
	ЗаполнитьЗначенияСвойств(Свойства, ПользовательИБ);
	Политика = Неопределено;
	Если Свойства.ИмяПолитикиПаролей <> Неопределено Тогда
		МенеджерПолитик = УИ_ОбщегоНазначенияКлиентСервер.ВычислитьВБезопасномРежиме("ПолитикиПаролейПользователей");
		Если ЗначениеЗаполнено(Свойства.ИмяПолитикиПаролей) Тогда
			Политика = МенеджерПолитик.НайтиПоИмени(Свойства.ИмяПолитикиПаролей);
		КонецЕсли;
	КонецЕсли;
	Если Политика = Неопределено Тогда
		МинимальнаяДлина = ПолучитьМинимальнуюДлинуПаролейПользователей();
		ПроверятьСложность = ПолучитьПроверкуСложностиПаролейПользователей();
	Иначе
		МинимальнаяДлина = Политика.МинимальнаяДлинаПаролей;
		ПроверятьСложность = Политика.ПроверкаСложностиПаролей;
	КонецЕсли;

	ДлинаВременногоПароля = 12;
	Если МинимальнаяДлина > ДлинаВременногоПароля Тогда
		ДлинаВременногоПароля = МинимальнаяДлина;
	КонецЕсли;
	Пароль = СгенерироватьПароль(ДлинаВременногоПароля, Истина, Истина, Истина, ПроверятьСложность);
	Если Свойства.ИмяПолитикиПаролей <> Неопределено Тогда
		Нарушения = МенеджерПолитик.ПроверитьСоответствиеПароляПолитике(Пароль, Политика, ПользовательИБ);
		Если Нарушения.Количество() > 0 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Политика пользователя не разрешает временный пароль: %1.'"), СтрСоединить(Нарушения, ", "));
		КонецЕсли;
	КонецЕсли;
	Возврат Пароль;

КонецФункции

// Формирует пароль заданной длины. Каждый выбранный вид символов встречается хотя бы один раз,
// затем знаки перемешиваются алгоритмом Фишера-Йетса.
//
// Параметры:
//  ДлинаПароля - Число - целое положительное число, не меньше количества выбранных видов символов.
//  ВерхнийРегистр - Булево - использовать прописные латинские буквы.
//  НижнийРегистр - Булево - использовать строчные латинские буквы.
//  Цифры - Булево - использовать цифры от 0 до 9.
//  Символы - Булево - использовать специальные символы, пригодные для командной строки.
//
// Возвращаемое значение:
//  Строка - случайный пароль.
Функция СгенерироватьПароль(ДлинаПароля, ВерхнийРегистр, НижнийРегистр, Цифры, Символы) Экспорт

	Если ТипЗнч(ДлинаПароля) <> Тип("Число") Или ДлинаПароля < 1 Или ДлинаПароля <> Цел(ДлинаПароля) Тогда
		ВызватьИсключение НСтр("ru = 'Длина пароля должна быть положительным целым числом.'");
	КонецЕсли;

	Алфавиты = Новый Массив;
	Если ВерхнийРегистр Тогда
		Алфавиты.Добавить("ABCDEFGHIJKLMNOPQRSTUVWXYZ");
	КонецЕсли;
	Если НижнийРегистр Тогда
		Алфавиты.Добавить("abcdefghijklmnopqrstuvwxyz");
	КонецЕсли;
	Если Цифры Тогда
		Алфавиты.Добавить("0123456789");
	КонецЕсли;
	Если Символы Тогда
		Алфавиты.Добавить("!?@#$%&*+=");
	КонецЕсли;
	ЧислоГрупп = Алфавиты.Количество();
	Если ЧислоГрупп = 0 Или ДлинаПароля < ЧислоГрупп Тогда
		ВызватьИсключение НСтр("ru = 'Выберите хотя бы один вид символов и укажите длину не меньше количества выбранных видов.'");
	КонецЕсли;

	ГенераторПозиций = НовыйГенераторДляПароля();

	КоличествоПоГруппам = Новый Массив;
	Для Индекс = 1 По ЧислоГрупп Цикл
		КоличествоПоГруппам.Добавить(1);
	КонецЦикла;
	Для Позиция = ЧислоГрупп + 1 По ДлинаПароля Цикл
		Группа = ГенераторПозиций.СлучайноеЧисло(0, ЧислоГрупп - 1);
		КоличествоПоГруппам[Группа] = КоличествоПоГруппам[Группа] + 1;
	КонецЦикла;

	Знаки = Новый Массив;
	Для Группа = 0 По ЧислоГрупп - 1 Цикл
		Алфавит = Алфавиты[Группа];
		ГенераторЗнаков = НовыйГенераторДляПароля();
		Для Позиция = 1 По КоличествоПоГруппам[Группа] Цикл
			Индекс = ГенераторЗнаков.СлучайноеЧисло(1, СтрДлина(Алфавит));
			Знаки.Добавить(Сред(Алфавит, Индекс, 1));
		КонецЦикла;
	КонецЦикла;

	ПоследняяПозиция = ДлинаПароля - 1;
	Для Позиция = 0 По ПоследняяПозиция - 1 Цикл
		Индекс = ГенераторПозиций.СлучайноеЧисло(Позиция, ПоследняяПозиция);
		Знак = Знаки[Индекс];
		Знаки[Индекс] = Знаки[Позиция];
		Знаки[Позиция] = Знак;
	КонецЦикла;
	Возврат СтрСоединить(Знаки, "");

КонецФункции

// Возвращает начальные настройки генерации пароля по политике паролей или по параметрам информационной базы.
//
// Параметры:
//  ИмяПолитикиПаролей - Строка - имя политики паролей; если не задано или политика не найдена,
//                       берутся параметры информационной базы.
//
// Возвращаемое значение:
//  Структура:
//   * ДлинаПароля - Число - не меньше 12 и не меньше минимальной длины пароля.
//   * ВерхнийРегистр - Булево - использовать прописные латинские буквы.
//   * НижнийРегистр - Булево - использовать строчные латинские буквы.
//   * Цифры - Булево - использовать цифры.
//   * Символы - Булево - использовать специальные символы; включено, если требуется проверка сложности.
//   * Требования - Строка - описание требований к паролю.
Функция НастройкиГенерацииПароля(ИмяПолитикиПаролей = "") Экспорт

	Политика = Неопределено;
	Если ЗначениеЗаполнено(ИмяПолитикиПаролей) Тогда
		Попытка
			МенеджерПолитик = УИ_ОбщегоНазначенияКлиентСервер.ВычислитьВБезопасномРежиме("ПолитикиПаролейПользователей");
			Политика = МенеджерПолитик.НайтиПоИмени(ИмяПолитикиПаролей);
		Исключение
			Политика = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Политика = Неопределено Тогда
		МинимальнаяДлина = ПолучитьМинимальнуюДлинуПаролейПользователей();
		ПроверятьСложность = ПолучитьПроверкуСложностиПаролейПользователей();
		Источник = НСтр("ru = 'Параметры информационной базы'");
	Иначе
		МинимальнаяДлина = Политика.МинимальнаяДлинаПаролей;
		ПроверятьСложность = Политика.ПроверкаСложностиПаролей;
		Источник = СтрШаблон(НСтр("ru = 'Политика паролей ""%1""'"), ИмяПолитикиПаролей);
	КонецЕсли;

	Если ПроверятьСложность Тогда
		ТекстСложности = НСтр("ru = 'проверка сложности включена'");
	Иначе
		ТекстСложности = НСтр("ru = 'проверка сложности выключена'");
	КонецЕсли;

	ДлинаПароля = 12;
	Если МинимальнаяДлина > ДлинаПароля Тогда
		ДлинаПароля = МинимальнаяДлина;
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("ДлинаПароля", ДлинаПароля);
	Настройки.Вставить("ВерхнийРегистр", Истина);
	Настройки.Вставить("НижнийРегистр", Истина);
	Настройки.Вставить("Цифры", Истина);
	Настройки.Вставить("Символы", ПроверятьСложность);
	Настройки.Вставить("Требования", Источник + ":" + Символы.ПС
		+ СтрШаблон(НСтр("ru = 'минимальная длина %1, %2.'"), МинимальнаяДлина, ТекстСложности));
	Возврат Настройки;

КонецФункции

// Готовит запуск клиента 1С под пользователем за один серверный вызов: определяет способ входа и, если нужно,
// устанавливает пользователю временный пароль. Данные для восстановления исходного пароля остаются на сервере
// во временном хранилище, клиент получает только его адрес.
//
// Параметры:
//  ИмяПользователя - Строка - имя пользователя ИБ, под которым запускается клиент.
//  РежимЗапускаПодПользователем - Булево - разрешено ли установить пользователю временный пароль.
//
// Возвращаемое значение:
//  см. НовыйРезультатПодготовкиЗапускаСеанса1С
Функция ПодготовитьЗапускСеанса1С(ИмяПользователя, РежимЗапускаПодПользователем) Экспорт

	Результат = НовыйРезультатПодготовкиЗапускаСеанса1С();

	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если НРег(ТекущийПользовательИБ.Имя) = НРег(ИмяПользователя) Тогда
		Если ТекущийПользовательИБ.АутентификацияОС Тогда
			Результат.ВходЧерезОС = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если Не РежимЗапускаПодПользователем Тогда
		Возврат Результат;
	КонецЕсли;

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Пользователь информационной базы ""%1"" не найден.'"), ИмяПользователя);
	КонецЕсли;
	Если ПользовательИБ.АутентификацияСтандартная И Не ПользовательИБ.ПарольУстановлен Тогда
		Возврат Результат;
	КонецЕсли;

	ВременныйПароль = НовыйПарольПоПолитикеПользователя(ИмяПользователя);
	ДанныеВосстановления = Новый Структура;
	ДанныеВосстановления.Вставить("АутентификацияСтандартная", ПользовательИБ.АутентификацияСтандартная);
	ДанныеВосстановления.Вставить("СохраняемоеЗначениеПароля", ПользовательИБ.СохраняемоеЗначениеПароля);

	Результат.НомераСеансовДоЗапуска = НомераСеансовПользователя(ИмяПользователя);
	Результат.АдресДанныхВосстановления = ПоместитьВоВременноеХранилище(ДанныеВосстановления,
		Новый УникальныйИдентификатор);

	ПользовательИБ.АутентификацияСтандартная = Истина;
	ПользовательИБ.Пароль = ВременныйПароль;
	ПользовательИБ.Записать();

	Результат.ВременныйПароль = ВременныйПароль;
	Возврат Результат;

КонецФункции

// Восстанавливает исходный пароль пользователя после запуска клиента 1С с временным паролем.
// Повторный вызов с тем же адресом ничего не делает.
//
// Параметры:
//  ИмяПользователя - Строка - имя пользователя ИБ.
//  АдресДанныхВосстановления - Строка - адрес во временном хранилище, см. ПодготовитьЗапускСеанса1С
Процедура ВосстановитьПарольПослеЗапускаСеанса1С(ИмяПользователя, АдресДанныхВосстановления) Экспорт

	Если Не ЭтоАдресВременногоХранилища(АдресДанныхВосстановления) Тогда
		Возврат;
	КонецЕсли;
	ДанныеВосстановления = ПолучитьИзВременногоХранилища(АдресДанныхВосстановления);
	Если ТипЗнч(ДанныеВосстановления) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательИБ <> Неопределено Тогда
		ПользовательИБ.АутентификацияСтандартная = ДанныеВосстановления.АутентификацияСтандартная;
		ПользовательИБ.СохраняемоеЗначениеПароля = ДанныеВосстановления.СохраняемоеЗначениеПароля;
		ПользовательИБ.Записать();
	КонецЕсли;
	УдалитьИзВременногоХранилища(АдресДанныхВосстановления);

КонецПроцедуры

// Проверяет, вошел ли пользователь в новый сеанс, и в этом случае сразу восстанавливает его исходный пароль.
//
// Параметры:
//  ИмяПользователя - Строка - имя пользователя ИБ.
//  НомераСеансовДоЗапуска - Массив из Число - номера сеансов пользователя до запуска клиента.
//  АдресДанныхВосстановления - Строка - адрес во временном хранилище, см. ПодготовитьЗапускСеанса1С
//
// Возвращаемое значение:
//  Булево - Истина, если у пользователя появился новый сеанс и пароль восстановлен.
Функция ВосстановитьПарольПриВходеПользователя(ИмяПользователя, НомераСеансовДоЗапуска,
	АдресДанныхВосстановления) Экспорт

	Для Каждого НомерСеанса Из НомераСеансовПользователя(ИмяПользователя) Цикл
		Если НомераСеансовДоЗапуска.Найти(НомерСеанса) = Неопределено Тогда
			ВосстановитьПарольПослеЗапускаСеанса1С(ИмяПользователя, АдресДанныхВосстановления);
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Находит пользователя информационной базы, права которого нужно проверить, см. ЭтоПолноправныйПользователь.
// Поиск выполняется в привилегированном режиме: без права администрирования платформа
// возвращает вместо сведений о других пользователях значения по умолчанию.
//
// Параметры:
//  Пользователь - Неопределено, ПользовательИнформационнойБазы, УникальныйИдентификатор, Строка -
//                 см. ЭтоПолноправныйПользователь
//  ТекущийПользовательИБ - ПользовательИнформационнойБазы - текущий пользователь информационной базы.
//
// Возвращаемое значение:
//  ПользовательИнформационнойБазы, Неопределено - найденный пользователь; Неопределено, если не найден.
Функция ПроверяемыйПользовательИнформационнойБазы(Пользователь, ТекущийПользовательИБ)

	Если Пользователь = Неопределено Тогда
		Возврат ТекущийПользовательИБ;
	КонецЕсли;
	ТипПользователя = ТипЗнч(Пользователь);
	Если ТипПользователя = Тип("ПользовательИнформационнойБазы") Тогда
		Возврат Пользователь;
	КонецЕсли;
	Если ТипПользователя <> Тип("Строка") И ТипПользователя <> Тип("УникальныйИдентификатор") Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстанавливатьПривилегированныйРежим = Не ПривилегированныйРежим();
	Если УстанавливатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	Если ТипПользователя = Тип("Строка") Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Пользователь);
	Иначе
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь);
	КонецЕсли;

	Если УстанавливатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Возврат ПользовательИБ;

КонецФункции

// Результат подготовки запуска клиента 1С.
//
// Возвращаемое значение:
//  Структура:
//   * ВходЧерезОС - Булево - клиент запускается без имени пользователя и входит через аутентификацию ОС.
//   * ВременныйПароль - Строка - временный пароль для запуска; пустая строка, если пароль не менялся
//                               и клиент запускается с именем пользователя без пароля.
//   * НомераСеансовДоЗапуска - Массив из Число - номера сеансов пользователя до запуска клиента.
//   * АдресДанныхВосстановления - Строка - адрес данных для восстановления исходного пароля.
Функция НовыйРезультатПодготовкиЗапускаСеанса1С()

	Результат = Новый Структура;
	Результат.Вставить("ВходЧерезОС", Ложь);
	Результат.Вставить("ВременныйПароль", "");
	Результат.Вставить("НомераСеансовДоЗапуска", Новый Массив);
	Результат.Вставить("АдресДанныхВосстановления", "");
	Возврат Результат;

КонецФункции

// Возвращает номера текущих сеансов пользователя информационной базы.
//
// Параметры:
//  ИмяПользователя - Строка - имя пользователя ИБ.
//
// Возвращаемое значение:
//  Массив из Число - номера сеансов.
Функция НомераСеансовПользователя(ИмяПользователя)

	НомераСеансов = Новый Массив;
	Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
		Если Сеанс.Пользователь <> Неопределено И Сеанс.Пользователь.Имя = ИмяПользователя Тогда
			НомераСеансов.Добавить(Сеанс.НомерСеанса);
		КонецЕсли;
	КонецЦикла;
	Возврат НомераСеансов;

КонецФункции

// Создает генератор случайных чисел с отдельным начальным числом. Для перестановки и каждого алфавита
// берется свой генератор, в том числе при вызовах подряд.
//
// Возвращаемое значение:
//  ГенераторСлучайныхЧисел - новый генератор.
Функция НовыйГенераторДляПароля()

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Строка(Новый УникальныйИдентификатор));
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеширование.ХешСумма);
	Возврат Новый ГенераторСлучайныхЧисел(Буфер.ПрочитатьЦелое32(0));

КонецФункции

#КонецОбласти
