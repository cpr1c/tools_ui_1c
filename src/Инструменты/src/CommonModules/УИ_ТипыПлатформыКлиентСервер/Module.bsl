// Используется последняя релизная(стабильная, тестовые версии опускаются) версия, 
// доступная на момент выхода релиза инструментов
// BSLLS:LineLength-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:Typo-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MethodSize-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:CommitTransactionOutsideTryCatch-off
// BSLLS:ExecuteExternalCodeInCommonModule-off
// BSLLS:MagicNumber-off

#Область ПрограммныйИнтерфейс

// Описание типа платформы по имени.
// 
// Параметры:
//  ИмяТипа - Строка- Имя типа
// 
// Возвращаемое значение:
//  см. НовыйОписаниеТипаПлатформы
// Возвращаемое значение:
//  Неопределено - описания для такого типа нет
Функция ОписаниеТипаПлатформыПоИмени(ИмяТипа) Экспорт
	ИмяПроцедурыОписанияТипа = "ОписаниеТипаПлатформы" + ИмяТипа;
	
	Попытка
		
		Возврат ВычислитьВБезопасномРежиме(ИмяПроцедурыОписанияТипа	+ "()");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Описание типа платформы по типу.
// 
// Параметры:
//  Тип - Тип- Тип
// 
// Возвращаемое значение:
//  см. НовыйОписаниеТипаПлатформы
// Возвращаемое значение:
//  Неопределено - описания для такого типа нет
Функция ОписаниеТипаПлатформыПоТипу(Тип) Экспорт
	ИдентификаторТипа = ИдентификаторТипа(Тип);
	
	ОписанияТиповПоИдентификатору = ОписанияТиповПоИдентификатору(ИдентификаторТипа);
	
	Если ТипЗнч(ОписанияТиповПоИдентификатору) <> Тип("Массив") Тогда
		Возврат ОписанияТиповПоИдентификатору;
	КонецЕсли;
	
	Если ОписанияТиповПоИдентификатору.Количество() = 1 Тогда
		Возврат ОписанияТиповПоИдентификатору[0];
	КонецЕсли;
	Если ОписанияТиповПоИдентификатору.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеСМаксимальнойПлатформой = ОписанияТиповПоИдентификатору[0];
	Для Каждого ТекОписание Из ОписанияТиповПоИдентификатору Цикл
		Если ОписаниеСМаксимальнойПлатформой.МинимальнаяПлатформа < ТекОписание.МинимальнаяПлатформа Тогда
			ОписаниеСМаксимальнойПлатформой = ТекОписание;
		КонецЕсли;

		Попытка
			ТипЭлементаОписания = Тип(ТекОписание.Имя);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если ТипЭлементаОписания = Тип Тогда
			Возврат ТекОписание;
		КонецЕсли;
	КонецЦикла;
	
	Возврат  ОписаниеСМаксимальнойПлатформой;
	
КонецФункции

// Описание типа платформы по идентификатору.
// 
// Параметры:
//  ИдентификаторТипа - Строка-
// 
// Возвращаемое значение:
//  см. НовыйОписаниеТипаПлатформы
// Возвращаемое значение:
// Массив из см. НовыйОписаниеТипаПлатформы - Если для идентификатора найдено несколько типов. 
//	Может быть изза косяка с сериализацией типов в самой платформе. После этго нужно проверить типы дополнительно
// Возвращаемое значение:
//  Неопределено - описания для такого типа нет
Функция ОписанияТиповПоИдентификатору(ИдентификаторТипа) Экспорт
	ИдентификаторДляПолученияОписания = ИдентификаторТипа;
	Если СтрНайти(ИдентификаторДляПолученияОписания, ".") > 0 Тогда
		ЧастиИдентификатора = СтрРазделить(ИдентификаторДляПолученияОписания, ".");
		ИдентификаторДляПолученияОписания = ЧастиИдентификатора[0];
	КонецЕсли;
	ИмяПроцедурыОписанияТипа = "ОписаниеТипаПлатформыПоИдентификатору" + ИдентификаторДляПолученияОписания;
	
	Попытка
		Возврат ВычислитьВБезопасномРежиме(ИмяПроцедурыОписанияТипа	+ "()");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Новый описание типа платформы.
// 
// Возвращаемое значение:
//  Структура - Новый описание типа платформы:
// * Имя - Строка - 
// * ИмяАнгл - Строка - 
// * МинимальнаяПлатформа - Число - 
// * ЭтоКоллекция - Булево - 
// * ЭтоПеречисление - Булево - 
// * ТипыЭлементаКоллекции - Строка - 
// * Доступность - Строка- 
// * Свойства - Массив из см. НовыйОписаниеСвойстваТипа - 
// * Значения - Массив из см. НовыйОписаниеЗначенияТипа- 
// * Методы - Массив из см. НовыйОписаниеМетодаТипа- 
// * Конструкторы - Массив из см. НовыйОписаниеКонструктораТипа- 
Функция НовыйОписаниеТипаПлатформы() Экспорт
	Описание = Новый Структура;
	Описание.Вставить("Имя", "");
	Описание.Вставить("ИмяАнгл", "");
	Описание.Вставить("МинимальнаяПлатформа", 0);
	Описание.Вставить("ЭтоКоллекция", Ложь);
	Описание.Вставить("ЭтоПеречисление", Ложь);
	Описание.Вставить("ТипыЭлементаКоллекции", "");
	Описание.Вставить("Доступность", "");
	Описание.Вставить("Свойства", Новый Массив);
	Описание.Вставить("Значения", Новый Массив);
	Описание.Вставить("Методы", Новый Массив);
	Описание.Вставить("Конструкторы", Новый Массив);
	
	Возврат Описание;
КонецФункции

