Функция ОписаниеТипаПлатформыCOMSafeArray() Экспорт
	Описание = НовыйТипПлатформы("COMSafeArray", "COMSafeArray", ВерсияПлатформы8000000(), Ложь, Ложь, ДоступностьСТЛСТТНКВС(), "");
	ДобавитьМетодВТипПлафтормы(Описание, "GetDimensions", "GetDimensions", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "GetLength", "GetLength", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "GetLowerBound", "GetLowerBound", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "GetType", "GetType", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "GetUpperBound", "GetUpperBound", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "GetValue", "GetValue", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "IsResizable", "IsResizable", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "Resize", "Resize", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "SetValue", "SetValue", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");
	ДобавитьМетодВТипПлафтормы(Описание, "Выгрузить", "Unload", ВерсияПлатформы8000000(), ДоступностьСТЛСТВС(), Ложь, "");

	Возврат Описание;
КонецФункции

