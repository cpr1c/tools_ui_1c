&НаСервере
Процедура ПодключитьМодулиНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	МакетКартинок = ОбработкаОбъект.ПолучитьМакет("УИ_Портативный_ОбщиеКартинки");
	ЧтениеZIP = Новый ЧтениеZipФайла(МакетКартинок.ОткрытьПотокДляЧтения());

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременногоФайла);
	ЧтениеZIP.ИзвлечьВсе(ИмяВременногоФайла);
	ЧтениеZIP.Закрыть();
	ОписаниеМодулей=ОписаниеМодулейИнструментовДляПодключения();

	УИ_БиблиотекаКартинок=Новый Структура;
	МодулиДляПодключенияНаСервере=Новый Массив;

	Для Каждого КлючЗначение Из ОписаниеМодулей Цикл
		Описание = КлючЗначение.Значение;

		Если Описание.Тип = "ОбщаяКартинка" Тогда
			ИмяФайлаКартинки = ИмяВременногоФайла + ПолучитьРазделительПути() + Описание.ИмяФайла;
			УИ_БиблиотекаКартинок.Вставить(Описание.Имя, Новый Картинка(ИмяФайлаКартинки));
		Иначе
			ИмяМакета = Описание.Тип + "_" + Описание.Имя;
			ДДМакета = ОбработкаОбъект.ПолучитьМакет(ИмяМакета);
			МодулиДляПодключенияНаСервере.Добавить(Новый Структура("ЭтоОтчет, Адрес", Описание.Вид = "Отчет",
				ПоместитьВоВременноеХранилище(ДДМакета, УникальныйИдентификатор)));

		КонецЕсли;

	КонецЦикла;
	ПодключитьВнешниеМодулиНаСервере(МодулиДляПодключенияНаСервере);

	АдресЛокальнойБиблиотекиКартинок=ПоместитьВоВременноеХранилище(УИ_БиблиотекаКартинок, УникальныйИдентификатор);
	ЗаписатьАдресЛокальнойБиблиотекиКартинокВХранилищеНастроек(АдресЛокальнойБиблиотекиКартинок);

	//@skip-check empty-except-statement
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокЭлементаИнструмента(Имя, Синоним, ТекстПоиска = "")
	Заголовок=Синоним;
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок=Имя;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстПоиска) Тогда
		ЗаголовокИзначальный=Заголовок;
		ЗаголовокДляПоиска=НРег(ЗаголовокИзначальный);
		НовыйЗаголовок="";
		ДлинаСтрокиПоиска=СтрДлина(ТекстПоиска);

		ПозицияСимвола=СтрНайти(ЗаголовокДляПоиска, ТекстПоиска);
		Пока ПозицияСимвола > 0 Цикл
			ФорматированнаяСтрокаПоиска=Новый ФорматированнаяСтрока(Сред(ЗаголовокИзначальный, ПозицияСимвола,
				ДлинаСтрокиПоиска), Новый Шрифт(, , , Истина), WebЦвета.Красный);
			НовыйЗаголовок=Новый ФорматированнаяСтрока(НовыйЗаголовок, Лев(ЗаголовокИзначальный, ПозицияСимвола - 1),
				ФорматированнаяСтрокаПоиска);

			ЗаголовокИзначальный=Сред(ЗаголовокИзначальный, ПозицияСимвола + ДлинаСтрокиПоиска);
			ЗаголовокДляПоиска=НРег(ЗаголовокИзначальный);

			ПозицияСимвола=СтрНайти(ЗаголовокДляПоиска, ТекстПоиска);

		КонецЦикла;

		Если ЗначениеЗаполнено(НовыйЗаголовок) Тогда
			НовыйЗаголовок=Новый ФорматированнаяСтрока(НовыйЗаголовок, ЗаголовокИзначальный);
			Заголовок=НовыйЗаголовок;
		КонецЕсли;
	КонецЕсли;
	Возврат Заголовок;
КонецФункции


&НаКлиенте
Процедура ОбработатьПоиск(СтрокаПоискаПереданная)
	СортированныйСписок=СортированныйСписокМодулейИнструментовДляКнопок();

	Поиск=СокрЛП(НРег(СтрокаПоискаПереданная));

	Для Каждого ЭлементСпискаИнструментов Из СортированныйСписок Цикл
		ОписаниеИнструмента = ЭлементСпискаИнструментов.Значение;

		ВидимостьЭлемента=Истина;
		Если ЗначениеЗаполнено(Поиск) Тогда
			ВидимостьЭлемента=СтрНайти(НРег(ОписаниеИнструмента.Имя), Поиск) > 0 Или СтрНайти(
				НРег(ОписаниеИнструмента.Синоним), Поиск) > 0;
		КонецЕсли;

		ИменаРазделовИнструмента = ИменаРазделовРазмещенияИнструмента(ОписаниеИнструмента);

		Для Каждого ТекИмяРаздела Из ИменаРазделовИнструмента Цикл
			ИмяЭлементаВРазделе = ИмяЭлементаИнструментаВРазделе(ОписаниеИнструмента.Имя, ТекИмяРаздела);
			Элементы[ИмяЭлементаВРазделе].Видимость=ВидимостьЭлемента;
			Элементы[ИмяЭлементаВРазделе].Заголовок=ЗаголовокЭлементаИнструмента(
			ОписаниеИнструмента.Имя, ОписаниеИнструмента.Синоним, Поиск);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СоздатьГруппыПодсистемИнструментов()
	ОписаниеПодсистем = ОписаниеПодсистемИнструментовДляПодключения();

	Для Каждого ТекПодсистема Из ОписаниеПодсистем.Порядок Цикл
		ЗаголовокПодсистемы = ОписаниеПодсистем.Подсистемы[ТекПодсистема];

		НоваяГруппа = Элементы.Добавить("Раздел_" + ТекПодсистема, Тип("ГруппаФормы"),
			Элементы.ГруппаКомандыИнструментовРазделы);
		НоваяГруппа.Заголовок = ЗаголовокПодсистемы;
		НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НоваяГруппа.ОтображатьЗаголовок = Истина;
		НоваяГруппа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПерераспределитьРазделыПоКолонкам(ОбщееКоличествоКомандИнструментов)
	КоличествоКолонок = 2;
	КоличествоКомандВКаждойКолонке = Цел(ОбщееКоличествоКомандИнструментов / КоличествоКолонок);

	БазовоеИмяКолонки = "ГруппаКомандыИнструментовРазделы";

	РаспределениеПоРазделам = Новый Структура;

	Для Н = 0 По КоличествоКолонок - 1 Цикл
		Если ЗначениеЗаполнено(Н) Тогда
			ИмяРаздела = БазовоеИмяКолонки + Н;
		Иначе
			ИмяРаздела = БазовоеИмяКолонки;
		КонецЕсли;

		РаспределениеПоРазделам.Вставить(ИмяРаздела, Новый Массив);
	КонецЦикла;

	ГруппыРазделов = Элементы.ГруппаКомандыИнструментовРазделы.ПодчиненныеЭлементы;

	ОстатокРаздела = КоличествоКомандВКаждойКолонке;
	ТекущийНомерРаздела = 0;
	ТекущееИмяРаздела = БазовоеИмяКолонки;
	Для Каждого ТекРаздел Из ГруппыРазделов Цикл
		Если ТипЗнч(ТекРаздел) <> Тип("ГруппаФормы") Тогда
			КоличествоЭлементовВРазделе = 1;
		Иначе
			КоличествоЭлементовВРазделе = ТекРаздел.ПодчиненныеЭлементы.Количество();
		КонецЕсли;      
		
		//Если текущий раздел не влазиет более чем на половину переносим его на следующий раздел, если он не крайний      
		Если (КоличествоЭлементовВРазделе / ОстатокРаздела > 2 Или ОстатокРаздела < 0) И ТекущийНомерРаздела + 1
			<> КоличествоКолонок Тогда
			ТекущийНомерРаздела = ТекущийНомерРаздела + 1;
			ТекущееИмяРаздела = БазовоеИмяКолонки + ТекущийНомерРаздела;
			ОстатокРаздела = КоличествоКомандВКаждойКолонке;
		КонецЕсли;

		ОстатокРаздела = ОстатокРаздела - КоличествоЭлементовВРазделе;

		РаспределениеПоРазделам[ТекущееИмяРаздела].Добавить(ТекРаздел);
	КонецЦикла;

	Для Каждого КлючЗначение Из РаспределениеПоРазделам Цикл
		ГруппаРаздела = Элементы[КлючЗначение.Ключ];

		Для Каждого ТекРаздел Из КлючЗначение.Значение Цикл
			Если ТекРаздел.Родитель = ГруппаРаздела Тогда
				Продолжить;
			КонецЕсли;
			Элементы.Переместить(ТекРаздел, ГруппаРаздела);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СоздатьКомандыОткрытияИнструментовНаФорме()
	СоздатьГруппыПодсистемИнструментов();

	ОписаниеИнструментов=СортированныйСписокМодулейИнструментовДляКнопок();


	//Четный=Ложь;  
	КоличествоКомандИнструментов = 0;
	Для Каждого ЭлементСписка Из ОписаниеИнструментов Цикл
		Описание=ЭлементСписка.Значение;

		Если Описание.НеВыводитьВИнтерфейс Тогда
			Продолжить;
		КонецЕсли;

		РодителиДляДобавления = ИменаРазделовРазмещенияИнструмента(Описание);

		Для Каждого ТекИмяРодителя Из РодителиДляДобавления Цикл
			ТекРодитель = Элементы[ТекИмяРодителя];

			Элемент=Элементы.Добавить(ИмяЭлементаИнструментаВРазделе(Описание.Имя, ТекРодитель.Имя), Тип(
				"ДекорацияФормы"), ТекРодитель);
			//Элемент.ИмяКоманды=Описание.Имя;
			Элемент.Заголовок=ЗаголовокЭлементаИнструмента(Описание.Имя, Описание.Синоним);
			Элемент.Вид=ВидДекорацииФормы.Надпись;
			Элемент.Гиперссылка=Истина;
			Элемент.Подсказка=Описание.Подсказка;
			Элемент.ОтображениеПодсказки=ОтображениеПодсказки.ОтображатьСнизу;
			Элемент.УстановитьДействие("Нажатие", "Подключаемый_ОткрытьКомандуИнструмента");

			КоличествоКомандИнструментов = КоличествоКомандИнструментов + 1;
		КонецЦикла;
	КонецЦикла;

	ПерераспределитьРазделыПоКолонкам(КоличествоКомандИнструментов);
КонецПроцедуры

// Новый описание подсистем.
// 
// Возвращаемое значение:
//  Структура - Новый описание подсистем:
// * Подсистемы - Структура - 
// * Порядок - Массив из Строка- 
&НаКлиентеНаСервереБезКонтекста
Функция НовыйОписаниеПодсистем()
	ОписаниеПодсистем = Новый Структура;
	ОписаниеПодсистем.Вставить("Подсистемы", Новый Структура);
	ОписаниеПодсистем.Вставить("Порядок", Новый Массив);

	Возврат ОписаниеПодсистем;
КонецФункции

// Новый описание модуля.
// 
// Возвращаемое значение:
//  Структура - Новый описание модуля:
// * Имя - Строка - 
// * Синоним - Строка - 
// * ИмяФайла - Строка - 
// * Подсказка - Строка - 
// * НеВыводитьВИнтерфейс - Булево - 
// * Тип - Строка - 
// * Вид - Строка - 
// * Команды - Неопределено - 
// * Подсистемы - Массив из Строка- 
&НаКлиентеНаСервереБезКонтекста
Функция НовыйОписаниеМодуля() 
	Описание=Новый Структура;
	Описание.Вставить("Имя", "");
	Описание.Вставить("Синоним", "");
	Описание.Вставить("ИмяФайла", "");
	Описание.Вставить("Подсказка", "");
	Описание.Вставить("НеВыводитьВИнтерфейс", Ложь);
	Описание.Вставить("Тип", "Инструмент");
	Описание.Вставить("Вид", "Обработка");
	Описание.Вставить("Команды", Неопределено);
	Описание.Вставить("Подсистемы", Новый Массив);

	Возврат Описание;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СортированныйСписокМодулейИнструментовДляКнопок()
	ОписаниеМодулей=ОписаниеМодулейИнструментовДляПодключения();
	
	СписокМодулей=Новый СписокЗначений();
	
	Для Каждого КлючЗначение Из ОписаниеМодулей Цикл
		Описание=КлючЗначение.Значение;
		Если Описание.Тип <> "Инструмент" Тогда
			Продолжить;
		КонецЕсли;
		Если Описание.НеВыводитьВИнтерфейс Тогда
			Продолжить;
		КонецЕсли;
		
		СписокМодулей.Добавить(Описание, Описание.Синоним);
	КонецЦикла;
	
	СписокМодулей.СортироватьПоПредставлению();
	Возврат СписокМодулей;
КонецФункции

