&НаКлиенте
Процедура Подключаемый_ОткрытьКомандуИнструмента(Команда)
	РазделительИмени = РазделительИмениЭлементаФормыКомандыИнструмента();
	Позиция=СтрНайти(Команда.Имя, РазделительИмени);
	ИмяИнструмента = Лев(Команда.Имя, Позиция - 1);

	ОписанияМодулей=ОписаниеМодулейИнструментовДляПодключения();
	ОписаниеМодуля=ОписанияМодулей[ИмяИнструмента];

	Если ОписаниеМодуля.Вид = "Отчет" Тогда
		ОткрытьФорму("ВнешнийОтчет." + ИмяИнструмента + ".Форма", , ЭтаФорма);
	Иначе
		ОткрытьФорму("ВнешняяОбработка." + ИмяИнструмента + ".Форма", , ЭтаФорма);
	КонецЕсли;
КонецПроцедуры


