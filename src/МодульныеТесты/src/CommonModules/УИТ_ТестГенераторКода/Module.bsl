// Проверяет преобразование уникального идентификатора в строку кода.
Процедура УникальныйИдентификаторВСтрокуКода() Экспорт

	Идентификатор = Новый УникальныйИдентификатор("c4b1a5a1-4d2e-4e5f-9c1a-2b3c4d5e6f70");
	ПроверитьИсполнениеКода(УИ_ГенераторКода.УникальныйИдентификаторВСтрокуКода(Идентификатор), Идентификатор);

	ОжидаемоеЗначение = СтрШаблон("Новый УникальныйИдентификатор(""%1"")", Строка(Идентификатор));

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.УникальныйИдентификаторВСтрокуКода(Идентификатор))
		.Равно(ОжидаемоеЗначение);

КонецПроцедуры

// Проверяет преобразование границы с разными видами границы в строку кода.
Процедура ГраницаВСтрокуКода() Экспорт

	ПроверитьИсполнениеКода(УИ_ГенераторКода.ГраницаВСтрокуКода(Новый Граница(Дата(2024, 1, 15), ВидГраницы.Включая)),
		Новый Граница(Дата(2024, 1, 15), ВидГраницы.Включая));
	ПроверитьИсполнениеКода(УИ_ГенераторКода.ГраницаВСтрокуКода(Новый Граница(Дата(2024, 1, 15), ВидГраницы.Исключая)),
		Новый Граница(Дата(2024, 1, 15), ВидГраницы.Исключая));

	ГраницаВключая = Новый Граница(Дата(2024, 1, 15), ВидГраницы.Включая);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.ГраницаВСтрокуКода(ГраницаВключая), "Граница включая")
		.Равно("Новый Граница('20240115', ВидГраницы.Включая)");

	ГраницаИсключая = Новый Граница(Дата(2024, 1, 15), ВидГраницы.Исключая);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.ГраницаВСтрокуКода(ГраницаИсключая), "Граница исключая")
		.Равно("Новый Граница('20240115', ВидГраницы.Исключая)");

КонецПроцедуры

// Проверяет преобразование момента времени в строку кода.
