#Область СлужебныеПроцедурыИФункции

// Формирует ожидаемый код получения ссылки по уникальному идентификатору.
//
// Параметры:
//  ИмяКоллекции - Строка - имя коллекции объектов метаданных, например "Справочники"
//  ИмяОбъекта - Строка - имя объекта метаданных
//  Ссылка - ЛюбаяСсылка - ссылка, для которой формируется код
//
// Возвращаемое значение:
//  Строка - ожидаемый код
Функция ОжидаемыйКодСсылки(ИмяКоллекции, ИмяОбъекта, Ссылка)

	Возврат СтрШаблон("%1.%2.ПолучитьСсылку(Новый УникальныйИдентификатор(""%3""))",
		ИмяКоллекции,
		ИмяОбъекта,
		Строка(Ссылка.УникальныйИдентификатор()));

КонецФункции

// Формирует ожидаемый заголовок сгенерированного кода.
//
// Параметры:
//  Инструмент - Строка - имя инструмента
//  ИмяФайлаИнструмента - Строка - имя файла инструмента
//  ИмяГенерируемойЗаписи - Строка - имя генерируемой записи
//  Пользователь - Строка - имя пользователя
//  ТекстДополнительныхДанных - Строка - дополнительные данные в виде готового текста
//
// Возвращаемое значение:
//  Строка - ожидаемый заголовок
Функция ОжидаемыйЗаголовокКода(Инструмент, ИмяФайлаИнструмента, ИмяГенерируемойЗаписи, Пользователь,
	ТекстДополнительныхДанных)

	Возврат СтрШаблон("// Сгенерировано с помощью инструмента ""%1"" из набора ""Универсальные инструменты 1С""
		|// https://github.com/cpr1c/tools_ui_1c
		|//
		|// Дата - %2
		|// Имя файла инструмента - %3
		|// Имя - %4
		|// Пользователь - %5
		|%6
		|",
		Инструмент,
		ТекущаяДатаСеанса(),
		ИмяФайлаИнструмента,
		ИмяГенерируемойЗаписи,
		Пользователь,
		ТекстДополнительныхДанных);

КонецФункции

// Формирует ожидаемый текст заглушки для неподдерживаемого типа значения.
//
// Параметры:
//  Значение - Произвольный - значение неподдерживаемого типа
//
// Возвращаемое значение:
//  Строка - ожидаемый текст заглушки
Функция ЗаглушкаНеподдерживаемогоТипа(Значение)

	Возврат "???//Тип " + Строка(ТипЗнч(Значение)) + " пока не поддерживается для генерации";

КонецФункции

// Формирует ожидаемый код создания картинки.
//
// Ожидаемый base64 берется из той же картинки, что передается в генератор:
// платформа может перекодировать изображение при загрузке, поэтому исходные
// байты и результат ПолучитьДвоичныеДанные() сравнивать нельзя.
//
// Параметры:
//  Картинка - Картинка - картинка, для которой формируется код
//
// Возвращаемое значение:
//  Строка - ожидаемый код
Функция ОжидаемыйКодКартинки(Картинка)
	Возврат "Новый Картинка(Base64Значение(""" + СтрЗаменить(Base64Строка(Картинка.ПолучитьДвоичныеДанные()),
															 Символы.ПС,
															 Символы.ПС + "|") + """))";

КонецФункции

// Проверяет, что сгенерированный код-выражение при выполнении дает переданное значение.
//
// Параметры:
//  Код - Строка - сгенерированный код
//  ОжидаемоеЗначение - Произвольный - значение, переданное в метод генерации
Процедура ПроверитьИсполнениеКода(Код, ОжидаемоеЗначение)

	ЮТест.ОжидаетЧто(ВычислитьВБезопасномРежиме(Код), СтрШаблон("Результат выполнения кода: %1", Код))
		.Равно(ОжидаемоеЗначение);

КонецПроцедуры

// Проверяет, что сгенерированный код заполнения коллекции при выполнении дает
// коллекцию, эквивалентную переданной в метод генерации.
//
// Параметры:
//  Код - Строка - сгенерированный код (последовательность операторов)
//  ИмяПеременной - Строка - имя переменной, в которую генератор помещает коллекцию
//  ОжидаемоеЗначение - Произвольный - значение, переданное в метод генерации
Процедура ПроверитьИсполнениеКодаКоллекции(Код, ИмяПеременной, ОжидаемоеЗначение)

	ПолученноеЗначение = ВыполнитьКодИПолучитьПеременную(Код, ИмяПеременной);

	ЮТест.ОжидаетЧто(ЗначенияЭквивалентны(ПолученноеЗначение, ОжидаемоеЗначение),
		СтрШаблон("Результат выполнения кода: %1", Код))
		.Равно(Истина);

КонецПроцедуры

// Выполняет сгенерированный код и возвращает значение указанной переменной.
//
// Параметры:
//  Код - Строка - сгенерированный код
//  ИмяПеременной - Строка - имя переменной, значение которой нужно получить
//
// Возвращаемое значение:
//  Произвольный - значение переменной после выполнения кода
Функция ВыполнитьКодИПолучитьПеременную(Код, ИмяПеременной)

	Приемник = Новый Структура("Значение");

	УстановитьБезопасныйРежим(Истина);
	Выполнить(Код + Символы.ПС + "Приемник.Значение = " + ИмяПеременной + ";");
	УстановитьБезопасныйРежим(Ложь);

	Возврат Приемник.Значение;

КонецФункции

// Вычисляет выражение в безопасном режиме.
//
// Параметры:
//  Код - Строка - вычисляемое выражение
//
// Возвращаемое значение:
//  Произвольный - результат вычисления
Функция ВычислитьВБезопасномРежиме(Код)

	УстановитьБезопасныйРежим(Истина);
	Результат = Вычислить(Код);
	УстановитьБезопасныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Сравнивает значения по содержимому, включая коллекции.
//
// Параметры:
//  Первое - Произвольный - первое значение
//  Второе - Произвольный - второе значение
//
// Возвращаемое значение:
//  Булево - Истина, если значения эквивалентны
Функция ЗначенияЭквивалентны(Первое, Второе)

	Если ТипЗнч(Первое) <> ТипЗнч(Второе) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Первое);

	Если ТипЗначения = Тип("Массив") Тогда
		Если Первое.Количество() <> Второе.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Индекс = 0 По Первое.Количество() - 1 Цикл
			Если Не ЗначенияЭквивалентны(Первое[Индекс], Второе[Индекс]) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;

	Если ТипЗначения = Тип("СписокЗначений") Тогда
		Если Первое.Количество() <> Второе.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Индекс = 0 По Первое.Количество() - 1 Цикл
			ЭлементПервый = Первое[Индекс];
			ЭлементВторой = Второе[Индекс];
			Если ЭлементПервый.Представление <> ЭлементВторой.Представление
				Или ЭлементПервый.Пометка <> ЭлементВторой.Пометка Тогда
				Возврат Ложь;
			КонецЕсли;
			Если Не ЗначенияЭквивалентны(ЭлементПервый.Значение, ЭлементВторой.Значение)
				Или Не ЗначенияЭквивалентны(ЭлементПервый.Картинка, ЭлементВторой.Картинка) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;

	Возврат Первое = Второе;

КонецФункции

#КонецОбласти
