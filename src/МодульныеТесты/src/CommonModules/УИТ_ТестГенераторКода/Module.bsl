// Проверяет генерацию кода для массива с вложенным массивом.
//
// Перед кодом вложенной коллекции генератор выводит пустую строку:
// шаблон вставки в модуле начинается с перевода строки (многострочный литерал).
Процедура МассивВМассиве() Экспорт

	ВложенныйМассив = Новый Массив;
	ВложенныйМассив.Добавить(2);
	ВложенныйМассив.Добавить(3);

	Значение = Новый Массив;
	Значение.Добавить(1);
	Значение.Добавить(ВложенныйМассив);

	ОжидаемыйКод = "М = Новый Массив;" + Символы.ПС
		+ "М.Добавить(1);" + Символы.ПС
		+ Символы.ПС + "М_1 = Новый Массив;" + Символы.ПС
		+ "М_1.Добавить(2);" + Символы.ПС
		+ "М_1.Добавить(3);" + Символы.ПС
		+ "М.Добавить(М_1);";

	ПроверитьИсполнениеКодаКоллекции(УИ_ГенераторКода.МассивВСтрокуКода(Значение, "М"), "М", Значение);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.МассивВСтрокуКода(Значение, "М"))
		.Равно(ОжидаемыйКод);

КонецПроцедуры

