#Область ПрограммныйИнтерфейс

// Регистрирует тестовые наборы и тесты модуля.
//
// Возвращаемое значение:
//  ОбщийМодуль - модуль регистрации тестов, см. ЮТТесты
Функция ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("ГенераторКода.Примитивы", "ГенераторКода")
		.ДобавитьТест("БулевоВСтрокуКода")
		.ДобавитьТест("ЧислоВСтрокуКода")
		.ДобавитьТест("СтрокаВСтрокуКодаЭкранированиеКавычек")
		.ДобавитьТест("СтрокаВСтрокуКодаМногострочнаяСтрока")
		.ДобавитьТест("НеопределеноВСтрокуКода")
		.ДобавитьТест("NullВСтрокуКода")
		.ДобавитьТест("ДатаВСтрокуКодаБезВремени")
		.ДобавитьТест("ДатаВСтрокуКодаСоВременем");

	ЮТТесты.ДобавитьТестовыйНабор("ГенераторКода.СлужебныеТипы", "ГенераторКода")
		.ДобавитьТест("УникальныйИдентификаторВСтрокуКода")
		.ДобавитьТест("ГраницаВСтрокуКода")
		.ДобавитьТест("МоментВремениВСтрокуКода")
		.ДобавитьТест("ДвоичныеДанныеВСтрокуКода")
		.ДобавитьТест("КартинкаВСтрокуКодаПустаяКартинка")
		.ДобавитьТест("КартинкаВСтрокуКодаЗаполненнаяКартинка");

	ЮТТесты.ДобавитьТестовыйНабор("ГенераторКода.Коллекции", "ГенераторКода")
		.ДобавитьТест("МассивВСтрокуКодаПростымиЗначениями")
		.ДобавитьТест("МассивВСтрокуКодаПустой")
		.ДобавитьТест("МассивВСтрокуКодаБезИмениПеременной")
		.ДобавитьТест("СписокЗначенийВСтрокуКодаПростымиЗначениями")
		.ДобавитьТест("СписокЗначенийВСтрокуКодаПустой")
		.ДобавитьТест("СписокЗначенийВСтрокуКодаБезИмениПеременной")
		.ДобавитьТест("СписокЗначенийВСтрокуКодаПредставление")
		.ДобавитьТест("СписокЗначенийВСтрокуКодаПометка")
		.ДобавитьТест("СписокЗначенийВСтрокуКодаКартинка");

	ЮТТесты.ДобавитьТестовыйНабор("ГенераторКода.ВложенныеКоллекции", "ГенераторКода")
		.ДобавитьТест("МассивВМассиве")
		.ДобавитьТест("МассивВМассивеДваУровняВложенности")
		.ДобавитьТест("МассивСНесколькимиВложеннымиКоллекциями")
		.ДобавитьТест("МассивСоВложеннымСпискомЗначений")
		.ДобавитьТест("СписокЗначенийСоВложеннымМассивом")
		.ДобавитьТест("СписокЗначенийСоВложеннымСпискомЗначений")
		.ДобавитьТест("СписокЗначенийСНесколькимиВложеннымиКоллекциями");

	ЮТТесты.ДобавитьТестовыйНабор("ГенераторКода.Ссылки", "ГенераторКода")
		.ДобавитьТест("СсылкаВСтрокуКодаСправочникЗаполненнаяСсылка").ВТранзакции()
		.ДобавитьТест("СсылкаВСтрокуКодаСправочникПустаяСсылка")
//		.ДобавитьТест("СсылкаВСтрокуКодаПредопределенныйЭлемент")
		.ДобавитьТест("СсылкаВСтрокуКодаДокументПустаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаДокументЗаполненнаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаПеречисление")
		.ДобавитьТест("СсылкаВСтрокуКодаПланВидовХарактеристикПустаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаПланВидовХарактеристикЗаполненнаяСсылка")
