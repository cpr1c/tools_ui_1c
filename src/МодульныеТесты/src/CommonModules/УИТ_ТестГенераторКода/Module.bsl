		.ДобавитьТест("СсылкаВСтрокуКодаПланВидовРасчетаЗаполненнаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаПланОбменаПустаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаПланОбменаЗаполненнаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаБизнесПроцессПустаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаБизнесПроцессЗаполненнаяСсылка")
		.ДобавитьТест("СсылкаВСтрокуКодаЗадачаПустаяСсылка")
