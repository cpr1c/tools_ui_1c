КонецПроцедуры

// Проверяет преобразование двоичных данных в строку кода.
Процедура ДвоичныеДанныеВСтрокуКода() Экспорт

	Данные = Base64Значение("YWJj");

	КодПоДанным = УИ_ГенераторКода.ДвоичныеДанныеВСтрокуКода(Данные);
	ДанныеПоКоду = ВычислитьВБезопасномРежиме(КодПоДанным);

	ЮТест.ОжидаетЧто(ДанныеПоКоду).Равно(Данные);

	Данные = ПолучитьОбщийМакет("УИТ_ТестДвоичныеДанные");

	КодПоДанным = УИ_ГенераторКода.ДвоичныеДанныеВСтрокуКода(Данные);
	ДанныеПоКоду = ВычислитьВБезопасномРежиме(КодПоДанным);

	ЮТест.ОжидаетЧто(ДанныеПоКоду).Равно(Данные);
КонецПроцедуры

// Проверяет преобразование пустой картинки в строку кода.
Процедура КартинкаВСтрокуКодаПустаяКартинка() Экспорт

	ПроверитьИсполнениеКода(УИ_ГенераторКода.КартинкаВСтрокуКода(Новый Картинка), Новый Картинка);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.КартинкаВСтрокуКода(Новый Картинка))
		.Равно("Новый Картинка");

КонецПроцедуры

// Проверяет преобразование заполненной картинки в строку кода.
//
// Ожидаемый base64 берется из той же картинки, что передается в генератор:
// платформа может перекодировать изображение при загрузке, поэтому исходные
// байты и результат ПолучитьДвоичныеДанные() сравнивать нельзя.
Процедура КартинкаВСтрокуКодаЗаполненнаяКартинка() Экспорт
	
	КартинкаДляТеста = Новый Картинка(ПолучитьОбщийМакет("УИТ_ТестоваяКартинка"));

	ПроверитьИсполнениеКода(УИ_ГенераторКода.КартинкаВСтрокуКода(КартинкаДляТеста),
		КартинкаДляТеста);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.КартинкаВСтрокуКода(КартинкаДляТеста))
		.Равно(ОжидаемыйКодКартинки(КартинкаДляТеста));

	КартинкаДляТеста = БиблиотекаКартинок.Документ;

	ПроверитьИсполнениеКода(УИ_ГенераторКода.КартинкаВСтрокуКода(КартинкаДляТеста),
		КартинкаДляТеста);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.КартинкаВСтрокуКода(КартинкаДляТеста))
		.Равно("БиблиотекаКартинок.Документ");

	КартинкаДляТеста = БиблиотекаКартинок.УИТ_КартинкаТест;

	ПроверитьИсполнениеКода(УИ_ГенераторКода.КартинкаВСтрокуКода(КартинкаДляТеста),
		КартинкаДляТеста);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.КартинкаВСтрокуКода(КартинкаДляТеста))
		.Равно("БиблиотекаКартинок.УИТ_КартинкаТест");

КонецПроцедуры

// Проверяет генерацию кода заполнения массива простыми значениями.
Процедура МассивВСтрокуКодаПростымиЗначениями() Экспорт

	Значение = Новый Массив;
	Значение.Добавить(1);
	Значение.Добавить("Текст");
	Значение.Добавить(Истина);

	ОжидаемыйКод = "М = Новый Массив;" + Символы.ПС
		+ "М.Добавить(1);" + Символы.ПС
		+ "М.Добавить(""Текст"");" + Символы.ПС
		+ "М.Добавить(Истина);";

	ПроверитьИсполнениеКодаКоллекции(УИ_ГенераторКода.МассивВСтрокуКода(Значение, "М"), "М", Значение);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.МассивВСтрокуКода(Значение, "М"))
		.Равно(ОжидаемыйКод);

КонецПроцедуры

// Проверяет генерацию кода для пустого массива.
