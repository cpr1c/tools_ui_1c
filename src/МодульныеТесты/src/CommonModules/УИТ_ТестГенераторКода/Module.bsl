// Проверяет генерацию имени переменной, если имя не передано.
Процедура МассивВСтрокуКодаБезИмениПеременной() Экспорт

	Значение = Новый Массив;
	Значение.Добавить(1);

	КодПервогоВызова = УИ_ГенераторКода.МассивВСтрокуКода(Значение, "");
	КодВторогоВызова = УИ_ГенераторКода.МассивВСтрокуКода(Значение, "");

	ИмяПеременной = Лев(КодПервогоВызова, СтрНайти(КодПервогоВызова, " ") - 1);

	ОжидаемыйКод = ИмяПеременной + " = Новый Массив;" + Символы.ПС
		+ ИмяПеременной + ".Добавить(1);";

	ЮТест.ОжидаетЧто(КодПервогоВызова, "Код с именем переменной по умолчанию")
		.Равно(ОжидаемыйКод);

	ПроверитьИсполнениеКодаКоллекции(КодПервогоВызова, ИмяПеременной, Значение);

	ЮТест.ОжидаетЧто(Лев(ИмяПеременной, 6), "Префикс имени переменной по умолчанию")
		.Равно("Массив");

	ЮТест.ОжидаетЧто(КодВторогоВызова, "Имена переменных в разных вызовах")
		.НеРавно(КодПервогоВызова);

КонецПроцедуры

