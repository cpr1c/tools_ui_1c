Процедура СтандартныйЗаголовокСДополнительнымиДанными() Экспорт

	ДополнительныеДанные = Новый Соответствие;
	ДополнительныеДанные.Вставить("Автор", "Иванов");
	ДополнительныеДанные.Вставить("Версия", "1.0");

	// Порядок обхода Соответствия не определен, поэтому ожидаемый текст
	// дополнительных данных строится тем же обходом, что и в генераторе.
	СтрокиДополнительныхДанных = Новый Массив;
	Для Каждого КлючЗначение Из ДополнительныеДанные Цикл
		СтрокиДополнительныхДанных.Добавить(СтрШаблон("//%1 - %2", КлючЗначение.Ключ, КлючЗначение.Значение));
	КонецЦикла;

	ОжидаемыйЗаголовок = ОжидаемыйЗаголовокКода("МойИнструмент",
		"Инструмент.epf",
		"ИмяЗаписи",
		ИмяПользователя(),
		СтрСоединить(СтрокиДополнительныхДанных, Символы.ПС));

	Заголовок = УИ_ГенераторКода.СтандартныйЗаголовокСгенерированногоКода("МойИнструмент",
		"Инструмент.epf",
		"ИмяЗаписи",
		ДополнительныеДанные);

	ЮТест.ОжидаетЧто(Заголовок)
		.Равно(ОжидаемыйЗаголовок);

КонецПроцедуры

