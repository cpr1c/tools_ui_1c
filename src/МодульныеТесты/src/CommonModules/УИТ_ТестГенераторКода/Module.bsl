		.ДобавитьТест("СтандартныйЗаголовокСДополнительнымиДанными");

	Возврат ЮТТесты;

КонецФункции

// Проверяет преобразование булева значения в строку кода.
Процедура БулевоВСтрокуКода() Экспорт

	ПроверитьИсполнениеКода(УИ_ГенераторКода.БулевоВСтрокуКода(Истина), Истина);
	ПроверитьИсполнениеКода(УИ_ГенераторКода.БулевоВСтрокуКода(Ложь), Ложь);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.БулевоВСтрокуКода(Истина), "Истина")
		.Равно("Истина");

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.БулевоВСтрокуКода(Ложь), "Ложь")
		.Равно("Ложь");

КонецПроцедуры

// Проверяет преобразование числа в строку кода без разделителей групп.
Процедура ЧислоВСтрокуКода() Экспорт

	ПроверитьИсполнениеКода(УИ_ГенераторКода.ЧислоВСтрокуКода(42), 42);
	ПроверитьИсполнениеКода(УИ_ГенераторКода.ЧислоВСтрокуКода(123.45), 123.45);
	ПроверитьИсполнениеКода(УИ_ГенераторКода.ЧислоВСтрокуКода(14123.45), 14123.45);
	ПроверитьИсполнениеКода(УИ_ГенераторКода.ЧислоВСтрокуКода(-7.5), -7.5);

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.ЧислоВСтрокуКода(42), "Целое число")
		.Равно("42");

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.ЧислоВСтрокуКода(123.45), "Дробное число")
		.Равно("123.45");
		
	ЮТест.ОжидаетЧто(УИ_ГенераторКода.ЧислоВСтрокуКода(14123.45), "Тысячи и более")
		.Равно("14123.45");

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.ЧислоВСтрокуКода(-7.5), "Отрицательное число")
		.Равно("-7.5");

КонецПроцедуры

// Проверяет экранирование кавычек при преобразовании строки в строку кода.
Процедура СтрокаВСтрокуКодаЭкранированиеКавычек() Экспорт

	ПроверитьИсполнениеКода(УИ_ГенераторКода.СтрокаВСтрокуКода("Привет"), "Привет");
	ПроверитьИсполнениеКода(УИ_ГенераторКода.СтрокаВСтрокуКода("Он сказал ""да"""), "Он сказал ""да""");

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.СтрокаВСтрокуКода("Привет"), "Строка без кавычек")
		.Равно("""Привет""");
		
	ЮТест.ОжидаетЧто(УИ_ГенераторКода.СтрокаВСтрокуКода("Он сказал ""да"""), "Строка с кавычками")
		.Равно("""Он сказал """"да""""""");

КонецПроцедуры

// Проверяет добавление символа продолжения строки для многострочной строки.
Процедура СтрокаВСтрокуКодаМногострочнаяСтрока() Экспорт

	ПроверитьИсполнениеКода(УИ_ГенераторКода.СтрокаВСтрокуКода("Первая строка" + Символы.ПС + "Вторая строка"),
		"Первая строка" + Символы.ПС + "Вторая строка");

	Кавычка = """";
	ОжидаемыйКод = Кавычка + "Первая строка" + Символы.ПС + "|Вторая строка" + Кавычка;

	ЮТест.ОжидаетЧто(УИ_ГенераторКода.СтрокаВСтрокуКода("Первая строка" + Символы.ПС + "Вторая строка"))
		.Равно(ОжидаемыйКод);

КонецПроцедуры

